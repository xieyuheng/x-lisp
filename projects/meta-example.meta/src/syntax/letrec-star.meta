(module letrec-star)

(define-test even-odd-test
  (letrec*
      ((even?
        (lambda (n)
          (if (equal? n 0)
            true
            (odd? (isub n 1)))))
       (odd?
        (lambda (n)
          (if (equal? n 0)
            false
            (even? (isub n 1))))))

    (assert (even? 0))
    (assert-not (even? 1))
    (assert (even? 2))
    (assert-not (even? 3))
    (assert (even? 4))

    (assert-not (odd? 0))
    (assert (odd? 1))
    (assert-not (odd? 2))
    (assert (odd? 3))
    (assert-not (odd? 4))))
