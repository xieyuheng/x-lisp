(module builtin)

(define-type (box-t E) (list-t E))

(claim make-box (polymorphic (E) (-> (box-t E))))
(define (make-box)
  (make-list))

(claim box-empty? (polymorphic (E) (-> (box-t E) bool-t)))
(define (box-empty? box)
  (list-empty? box))

(claim box-put! (polymorphic (E) (-> E (box-t E) (box-t E))))
(define (box-put! value box)
  (if (box-empty? box)
    (list-push! value box)
    (list-put! 0 value box)))

(claim box-get (polymorphic (E) (-> (box-t E) E)))
(define (box-get box)
  (if (box-empty? box)
    (error "box is empty")
    (car box)))

(claim box-get-maybe (polymorphic (E) (-> (box-t E) (maybe-t E))))
(define (box-get-maybe box)
  (if (box-empty? box)
    (nothing)
    (just (car box))))

(define-test box-test
  (let ((box (make-box)))
    (assert (box-empty? box))
    (assert-equal (nothing) (box-get-maybe box))
    (box-put! 42 box)
    (assert-not (box-empty? box))
    (assert-equal 42 (box-get box))
    (assert-equal (just 42) (box-get-maybe box))))
