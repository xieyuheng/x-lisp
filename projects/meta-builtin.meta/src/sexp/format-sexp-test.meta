(module builtin)

(define-test format-sexp-test
  (assert-equal "(a b c)" (format-sexp '(a b c)))
  (assert-equal "0.0" (format-sexp 0.0))
  (assert-equal "42.0" (format-sexp 42.0)))

(define-test format-sexp-string-escape-test
  (println (format-sexp "hello"))
  (println (format-sexp "a\"b"))
  (println (format-sexp "a\\b"))
  (println (format-sexp "a\nb"))
  (println (format-sexp "a\tb")))
