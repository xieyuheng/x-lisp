(module builtin)

(define-struct source-location-t
  (path string-t)
  (span source-span-t))

(define-struct source-span-t
  (start source-position-t)
  (end source-position-t))

(define-struct source-position-t
  (index int-t)
  (row int-t)
  (column int-t))

(declare-primitive-function format-message-with-source-location 2)
(claim format-message-with-source-location (-> string-t source-location-t string-t))
