(module builtin)

(define-data source-location-t
  (cons-source-location
   (path string-t)
   (span source-span-t)))

(define make-source-location cons-source-location)
(define source-location-path cons-source-location-path)
(define source-location-span cons-source-location-span)
(define source-location-put-path! cons-source-location-put-path!)
(define source-location-put-span! cons-source-location-put-span!)

(define-data source-span-t
  (cons-source-span
   (start source-position-t)
   (end source-position-t)))

(define make-source-span cons-source-span)
(define source-span-start cons-source-span-start)
(define source-span-end cons-source-span-end)
(define source-span-put-start! cons-source-span-put-start!)
(define source-span-put-end! cons-source-span-put-end!)

(define-data source-position-t
  (cons-source-position
   (index int-t)
   (row int-t)
   (column int-t)))

(define make-source-position cons-source-position)
(define source-position-index cons-source-position-index)
(define source-position-row cons-source-position-row)
(define source-position-column cons-source-position-column)
(define source-position-put-index! cons-source-position-put-index!)
(define source-position-put-row! cons-source-position-put-row!)
(define source-position-put-column! cons-source-position-put-column!)
