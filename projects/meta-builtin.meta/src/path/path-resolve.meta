(module builtin)

(claim path-resolve (-> string-t string-t))
(define (path-resolve path)
  (if (path-absolute? path)
    path
    (path-normalize (path-join (current-directory) path))))

(define-test path-resolve-test
  (assert-equal (path-resolve "/etc") "/etc")
  (assert-equal (path-resolve "/a/b") "/a/b")
  (assert (path-absolute? (path-resolve "foo")))
  (assert (path-absolute? (path-resolve "./bar")))
  (assert-equal (path-resolve "foo") (path-normalize (path-join (current-directory) "foo"))))
