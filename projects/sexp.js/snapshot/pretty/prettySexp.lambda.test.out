(lambda (f list)
  (= new-hash (@hash))
  (pipe list
    (list-each
     (lambda (value)
       (= key (f value))
       (= group (hash-get key new-hash))
       (if (null? group)
         (hash-put! key [value] new-hash)
         (list-push! value group)))))
  new-hash)
------------------------------|30
(lambda (f list)
  (= new-hash (@hash))
  (pipe list
    (list-each
     (lambda (value)
       (= key (f value))
       (= group
          (hash-get
           key
           new-hash))
       (if (null? group)
         (hash-put!
          key
          [value]
          new-hash)
         (list-push!
          value
          group)))))
  new-hash)
