#!/usr/bin/env bash

function call {
    ../stack-lisp.c/src/stack-lisp.exe call build/bundle.stack $@
}

function main {
    local command=$1; shift
    case $command in
        (check)
            local path=${1:-"project.sexp"}
            local dump_flag=$2
            local dump=""
            if [ "$dump_flag" = "--dump" ]; then
                dump="true"
            fi
            call meta/check-command $path $dump
            ;;
        (*)
            echo "unknown command: $command"
            exit 1
            ;;
    esac
}

main $@
