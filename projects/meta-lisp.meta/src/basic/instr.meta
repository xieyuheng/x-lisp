(module basic)

(define-enum instr-t
  (assign (dest symbol-t) (exp exp-t) (location source-location-t))
  (perform (exp exp-t) (location source-location-t))
  (test (exp exp-t) (location source-location-t))
  (branch (then-label symbol-t) (else-label symbol-t) (location source-location-t))
  (goto (label symbol-t) (location source-location-t))
  (return (exp exp-t) (location source-location-t)))

(claim format-instr (-> instr-t string-t))
(define (format-instr instr)
  (match instr
    ((assign dest exp location)
     (@string "(= " (symbol-to-string dest) " " (format-exp exp) ")"))
    ((perform exp location)
     (@string "(perform " (format-exp exp) ")"))
    ((test exp location)
     (@string "(test " (format-exp exp) ")"))
    ((branch then-label else-label location)
     (@string "(branch "
              (symbol-to-string then-label) " "
              (symbol-to-string else-label) ")"))
    ((goto label location)
     (@string "(goto " (symbol-to-string label) ")"))
    ((return exp location)
     (@string "(return " (format-exp exp) ")"))))
