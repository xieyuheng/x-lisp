(module basic)

(define-enum definition-t
  (primitive-function-declaration
   (mod mod-t)
   (name symbol-t)
   (arity int-t)
   (location source-location-t))
  (primitive-variable-declaration
   (mod mod-t)
   (name symbol-t)
   (location source-location-t))
  (function-definition
   (mod mod-t)
   (name symbol-t)
   (parameters (list-t symbol-t))
   (blocks (hash-t symbol-t block-t))
   (location source-location-t))
  (variable-definition
   (mod mod-t)
   (name symbol-t)
   (blocks (hash-t symbol-t block-t))
   (location source-location-t))
  (test-definition
   (mod mod-t)
   (name symbol-t)
   (blocks (hash-t symbol-t block-t))
   (location source-location-t)))

(claim definition-arity (-> definition-t int-t))
(define (definition-arity definition)
  (match definition
    ((primitive-function-declaration mod name arity location)
     arity)
    ((function-definition mod name parameters blocks location)
     (list-length parameters))
    (else
     (error "(definition-arity) can not get arity from non-function definition"))))
