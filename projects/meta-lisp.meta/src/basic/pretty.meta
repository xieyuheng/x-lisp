(module basic)

(define (basic-sexp-config)
  (ppml/make-sexp-config
    [(make-pair 'define-function 1)
     (make-pair 'define-variable 1)
     (make-pair 'define-test 1)
     (make-pair 'block 1)]))

(claim format-pretty-definition (-> int-t definition-t string-t))
(define (format-pretty-definition width definition)
  (ppml/format-pretty-sexp-by-format format-definition (basic-sexp-config) width definition))
