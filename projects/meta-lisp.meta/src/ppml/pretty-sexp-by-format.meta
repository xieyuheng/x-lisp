(module ppml)

(claim pretty-sexp-by-format
  (polymorphic (A)
    (-> (-> A string-t) sexp-config-t int-t A
        string-t)))

(define (pretty-sexp-by-format format config width data)
  (= code (format data))
  (= sexps (parse-sexps "[prettySexpByFormat]" code))
  (string-join "\n\n" (list-map (lambda (sexp) (pretty-sexp width sexp config)) sexps)))
