(module ppml)

(claim format-pretty-sexp (-> int-t sexp-t sexp-config-t string-t))
(define (format-pretty-sexp width sexp config)
  (format width (pretty-sexp sexp config)))

(claim pretty-sexp (-> sexp-t sexp-config-t node-t))
(define (pretty-sexp sexp config)
  (match sexp
    ((symbol-sexp content location)
     (text-node (format-as-sexp content)))
    ((keyword-sexp content location)
     (text-node (format-as-sexp content)))
    ((string-sexp content location)
     (text-node (format-as-sexp content)))
    ((int-sexp content location)
     (text-node (format-as-sexp content)))
    ((float-sexp content location)
     (text-node (format-as-sexp content)))
    ((list-sexp elements location)
     (if (list-empty? elements)
       (text-node "()")
       (let* ((first (list-head elements))
              (rest (list-tail elements)))
         (if (and (symbol-sexp? first)
                  (equal? (list-length rest) 1))
           (let ((name (symbol-sexp-content first)))
             (cond
               ((equal? name '@quote)
                (concat-node [(text "'") (pretty-sexp (list-head rest) config)]))
               ((equal? name '@unquote)
                (concat-node [(text ",") (pretty-sexp (list-head rest) config)]))
               ((equal? name '@quasiquote)
                (concat-node [(text "`") (pretty-sexp (list-head rest) config)]))
               (else (pretty-sexp-elements elements config))))
           (pretty-sexp-elements elements config)))))))

(define (pretty-sexp-elements elements config)
  (let ((first (list-head elements))
        (rest (list-tail elements)))
    (if (symbol-sexp? first)
      (let ((name (symbol-sexp-content first)))
        (cond
          ((equal? name '@set)
           (pretty-set rest config))
          ((equal? name '@square-bracket)
           (pretty-list rest config))
          (else
            (let ((header-length (sexp-config-keyword-header-length config name)))
              (if (int-greater-or-equal? header-length 0)
                (pretty-syntax name
                  (list-take header-length rest)
                  (list-drop header-length rest)
                  config)
                (pretty-application elements config))))))
      (pretty-application elements config))))

(define (pretty-set elements config)
  (let ((body-node (group
                     [(indent 1
                        [(flex (list-map (lambda (e) (pretty-sexp e config)) elements))])])))
    (group [(text "(@set") body-node (text ")")])))

(define (pretty-list elements config)
  (if (list-empty? elements)
    (group [(text "[") (text "]")])
    (let ((body-node (group
                       [(indent 1
                          [(flex (list-map (lambda (e) (pretty-sexp e config)) elements))])])))
      (group [(text "[") body-node (text "]")]))))

(define (pretty-syntax name header body config)
  (let ((head-node (indent 4
                     [(wrap (cons (text (symbol-to-string name))
                                  (list-map (lambda (e) (pretty-sexp e config)) header)))]))
        (body-node (if (list-empty? body)
                     (null-node)
                     (indent 2
                       [(br)
                        (flex (list-map (lambda (e) (pretty-sexp e config)) body))]))))
    (group [(text "(") head-node body-node (text ")")])))

(define (pretty-application elements config)
  (let* ((head (list-head elements))
         (rest (list-tail elements))
         (head-str (format-as-sexp head)))
    (if (and (symbol-sexp? head)
             (int-less-or-equal? (string-length (symbol-to-string (symbol-sexp-content head))) 3))
      (let* ((indentation (iadd (string-length head-str) 2))
             (body-node (if (list-empty? rest)
                          (text head-str)
                          (group
                            [(indent indentation
                               [(text head-str)
                                (text " ")
                                (flex (list-map (lambda (e) (pretty-sexp e config)) rest))])]))))
        (group [(text "(") body-node (text ")")]))
      (let ((body-node (group
                         [(indent 1
                            [(flex (list-map (lambda (e) (pretty-sexp e config)) elements))])])))
        (group [(text "(") body-node (text ")")])))))

(define (list-take n xs)
  (if (int-less-or-equal? n 0)
    []
    (if (list-empty? xs)
      []
      (cons (list-head xs) (list-take (isub n 1) (list-tail xs))))))

(define (list-drop n xs)
  (if (int-less-or-equal? n 0)
    xs
    (if (list-empty? xs)
      []
      (list-drop (isub n 1) (list-tail xs)))))
