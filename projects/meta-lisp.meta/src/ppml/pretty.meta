(module ppml)

(claim pretty-syntax
  (-> string-t (list-t node-t) (list-t node-t)
      node-t))

(define (pretty-syntax name header body)
  (= head-node (indent 4 [(wrap (cons (text name) header))]))
  (= body-node (if (list-empty? body) (nil) (indent 2 [(br) (flex body)])))
  (group [(text "(") head-node body-node (text ")")]))

(claim pretty-application
  (-> (maybe-t string-t) (list-t node-t)
      node-t))

(define (pretty-application op-maybe elements)
  (if (list-empty? elements)
    (group [(text "(") (text ")")])
    (match op-maybe
      ((just op)
       (= head (list-head elements))
       (= rest (list-tail elements))
       (if (int-less-or-equal? (string-length op) 3)
         (begin
           (= indentation (iadd (string-length op) 2))
           (= body-node
              (if (list-empty? rest)
                head
                (group [(indent indentation [head (text " ") (flex rest)])])))
           (group [(text "(") body-node (text ")")]))
         (begin
           (= body-node (group [(indent 1 [(flex elements)])]))
           (group [(text "(") body-node (text ")")]))))
      ((nothing)
       (= body-node (group [(indent 1 [(flex elements)])]))
       (group [(text "(") body-node (text ")")])))))

(claim pretty-list
  (-> (list-t node-t)
      node-t))

(define (pretty-list elements)
  (if (list-empty? elements)
    (group [(text "[") (text "]")])
    (let ((body-node (group [(indent 1 [(flex elements)])])))
      (group [(text "[") body-node (text "]")]))))
