(module meta)

(define (handle-check ctx)
  (let ((config-path (cli-option-get "--config" ctx))
        (options (make-hash)))
    (when (cli-option-has? "--dump" ctx)
      (hash-put! "dump" "true" options))
    (let ((project (load-project config-path)))
      (check-pipeline project options))))

(define (handle-build ctx)
  (let ((config-path (cli-option-get "--config" ctx))
        (options (make-hash)))
    (when (cli-option-has? "--dump" ctx)
      (hash-put! "dump" "true" options))
    (when (cli-option-has? "--basic" ctx)
      (hash-put! "basic" "true" options))
    (println "[build] not implemented")))

(define (handle-test ctx)
  (let ((config-path (cli-option-get "--config" ctx))
        (options (make-hash)))
    (when (cli-option-has? "--profile" ctx)
      (hash-put! "profile" "true" options))
    (when (cli-option-has? "--builtin" ctx)
      (hash-put! "builtin" "true" options))
    (println "[test] not implemented")))

(claim main (-> void-t))
(define (main)
  (define router (cli-make-router "meta-lisp" "0.1.0"))
  (cli-define-route router "check --config --dump")
  (cli-define-route router "build --config --dump --basic")
  (cli-define-route router "test --config --profile --builtin")
  (cli-define-handler router "check" handle-check)
  (cli-define-handler router "build" handle-build)
  (cli-define-handler router "test" handle-test)
  (cli-router-run router (current-command-line)))
