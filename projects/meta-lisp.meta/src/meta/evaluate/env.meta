(module meta)

(define-opaque-type env-t (hash-t symbol-t value-t)
  (empty-env (-> env-t))
  (env-names (-> env-t (list-t symbol-t)))
  (env-has? (-> symbol-t env-t bool-t))
  (env-lookup-value (-> symbol-t env-t value-t))
  (env-put (-> symbol-t value-t env-t env-t))
  (env-put-many (-> (list-t symbol-t) (list-t value-t) env-t env-t)))

(define empty-env make-hash)
(define env-names hash-keys)
(define env-has? hash-has?)
(define env-lookup-value hash-get)
(define env-put hash-put)
(define (env-put-many names values env)
  (hash-put-entries (list-map-zip make-hash-entry names values) env))
