(module meta)

(claim evaluate (-> symbol-t mod-t env-t exp-t value-t))

(define (evaluate mode mod env exp)
  (match exp
    ((var-exp name location)
     (if (env-has? name env)
       (env-lookup-value name env)
       (value-from-mod mode mod name)))
    ((qualified-var-exp mod-name name location)
     (let ((qualified-mod (project-lookup-mod (mod-project mod) mod-name)))
       (if (nothing? qualified-mod)
         (error "(evaluate) undefined module prefix")
         (let ((found-mod (just-value qualified-mod)))
           (value-from-mod mode found-mod name)))))
    ((arrow-exp arg-types ret-type location)
     (let ((arg-types (list-map (lambda (arg-type) (evaluate-type mode mod env arg-type)) arg-types))
           (ret-type (evaluate-type mode mod env ret-type)))
       (type-value (arrow-type arg-types ret-type))))
    ((polymorphic-exp parameters body location)
     (let* ((var-types (list-map (lambda (parameter) (var-type parameter 0)) parameters))
            (body-env (env-put-many parameters
                        (list-map (lambda (vt) (type-value vt)) var-types)
                        env))
           (body-type (evaluate-type mode mod body-env body)))
       (type-value (polymorphic-type var-types body-type))))
    ((apply-exp target args location)
     (let ((target (evaluate mode mod env target))
           (args (list-map (lambda (arg) (evaluate mode mod env arg)) args)))
       (apply-value mode target args)))
    (else (error "(evaluate) unhandled exp"))))

(claim value-from-mod (-> symbol-t mod-t symbol-t value-t))
(define (value-from-mod mode mod name)
  (let ((definition (mod-lookup-definition mod name)))
    (if (not (nothing? definition))
      (definition-to-value mode (just-value definition))
      (let ((claimed-type (mod-lookup-claimed-type mod name)))
        (if (not (nothing? claimed-type))
          (type-value (just-value claimed-type))
          (error "(evaluate) undefined variable"))))))

(claim definition-to-value (-> symbol-t definition-t value-t))
(define (definition-to-value mode definition)
  (match definition
    ((primitive-function-declaration mod name arity is-checked location)
     (error "(definition-to-value) can not handle declared primitive function"))
    ((primitive-variable-declaration mod name is-checked location)
     (error "(definition-to-value) can not handle declared primitive variable"))
    ((primitive-function-definition mod name arity fn is-checked location)
     (definition-value definition))
    ((function-definition mod name parameters body is-checked location)
     (definition-value definition))
    ((test-definition mod name body is-checked location)
     (definition-value definition))
     ((primitive-variable-definition mod name value is-checked location)
      value)
    ((type-definition mod name parameters body is-checked location)
     (if (list-empty? parameters)
       (let ((type (evaluate-type mode mod (empty-env) body)))
         (type-value type))
       (definition-value definition)))
    ((variable-definition mod name body is-checked location)
     (let ((type (evaluate-type mode mod (empty-env) body)))
       (type-value type)))
    ((algebraic-type-definition mod name type-constructor data-constructors is-checked location)
     (if (list-empty? (type-constructor-parameters type-constructor))
       (type-value (data-type type-constructor []))
       (definition-value definition)))
    ((opaque-type-definition mod name type-constructor representation-type interface-entries is-checked location)
     (if (equal? mode 'transparent)
       (if (list-empty? (type-constructor-parameters type-constructor))
         (let ((type (evaluate-type mode mod (empty-env) representation-type)))
           (type-value type))
         (definition-value definition))
       (if (list-empty? (type-constructor-parameters type-constructor))
         (type-value (data-type type-constructor []))
         (definition-value definition))))))

(claim evaluate-type (-> symbol-t mod-t env-t exp-t type-t))
(define (evaluate-type mode mod env exp)
  (let ((value (evaluate mode mod env exp)))
    (if (type-value? value)
      (type-value-type value)
      (error "(evaluate-type) expected a type value"))))
