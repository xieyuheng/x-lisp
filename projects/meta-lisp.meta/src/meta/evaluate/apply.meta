(module meta)

(claim apply-value (-> evaluation-mode-t value-t (list-t value-t) value-t))
(define (apply-value mode target new-args)
  (match target
    ((definition-value definition)
     (apply-definition mode definition new-args))
    ((curry-value curry-target curry-arity curry-args)
     (let ((all-args (list-append curry-args new-args)))
       (if (int-less? (list-length all-args) curry-arity)
         (curry-value curry-target curry-arity all-args)
         (let ((result (apply-value mode curry-target all-args)))
           (if (int-greater? (list-length new-args) (isub curry-arity (list-length curry-args)))
             (let ((extra-args (list-drop curry-arity all-args)))
               (apply-value mode result extra-args))
             result)))))
    (else (error "(apply) unhandled target"))))

(claim apply-definition (-> evaluation-mode-t definition-t (list-t value-t) value-t))
(define (apply-definition mode definition args)
  (match definition
    ((primitive-function-definition mod name arity fn is-checked location)
     (fn args))
     ((type-definition mod name parameters body is-checked location)
      (let ((env (env-put-many parameters args (empty-env mode))))
        (evaluate mod env body)))
     ((algebraic-type-definition mod name type-constructor data-constructors is-checked location)
      (let ((arg-types (list-map (lambda (arg)
                                   (if (type-value? arg)
                                     (type-value-type arg)
                                     (error "(apply-definition) expected type argument")))
                                 args)))
        (type-value (data-type type-constructor arg-types))))
     ((opaque-type-definition mod name type-constructor representation-type interface-entries is-checked location)
      (if (equal? mode (transparent-mode))
        (let ((env (env-put-many (type-constructor-parameters type-constructor) args (empty-env mode))))
          (evaluate mod env representation-type))
       (let ((arg-types (list-map (lambda (arg)
                                    (if (type-value? arg)
                                      (type-value-type arg)
                                      (error "(apply-definition) expected type argument")))
                                  args)))
         (type-value (data-type type-constructor arg-types)))))
    (else (error "(apply-definition) unhandled definition kind"))))
