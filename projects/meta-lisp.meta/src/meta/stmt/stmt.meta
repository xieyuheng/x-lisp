(module meta)

(define-enum stmt-t
  (import-stmt
   (mod-name symbol-t)
   (names (list-t symbol-t))
   (location source-location-t))
  (import-as-stmt
   (mod-name symbol-t)
   (prefix symbol-t)
   (location source-location-t))
  (import-all-stmt
   (mod-name symbol-t)
   (location source-location-t))
  (define-function-stmt
    (name symbol-t)
    (parameters (list-t symbol-t))
    (body exp-t)
    (location source-location-t))
  (define-variable-stmt
    (name symbol-t)
    (body exp-t)
    (location source-location-t))
  (define-test-stmt
    (name symbol-t)
    (body exp-t)
    (location source-location-t))
  (define-type-stmt
    (name symbol-t)
    (parameters (list-t symbol-t))
    (body exp-t)
    (location source-location-t))
  (define-enum-stmt
    (type-constructor type-constructor-t)
    (data-constructors (list-t pre-data-constructor-t))
    (location source-location-t))
  (define-algebraic-type-stmt
    (type-constructor type-constructor-t)
    (data-constructors (list-t algebraic-type-constructor-t))
    (location source-location-t))
  (define-struct-stmt
    (type-constructor type-constructor-t)
    (fields (list-t data-field-t))
    (location source-location-t))
  (define-struct-star-stmt
    (type-constructor type-constructor-t)
    (data-constructor pre-data-constructor-t)
    (location source-location-t))
  (define-record-type-stmt
    (type-constructor type-constructor-t)
    (data-constructor algebraic-type-constructor-t)
    (location source-location-t))
  (define-opaque-type-stmt
    (name symbol-t)
    (parameters (list-t symbol-t))
    (representation-type exp-t)
    (interface-entries (list-t interface-entry-t))
    (location source-location-t))
  (claim-stmt
   (name symbol-t)
   (type exp-t)
   (location source-location-t))
  (claim-type-stmt
   (name symbol-t)
   (location source-location-t))
  (admit-stmt
   (name symbol-t)
   (type exp-t)
   (location source-location-t))
  (private-stmt
   (names (list-t symbol-t))
   (location source-location-t))
  (exempt-stmt
   (names (list-t symbol-t))
   (location source-location-t))
  (declare-module-stmt
   (name symbol-t)
   (location source-location-t))
  (declare-error-module-stmt
   (name symbol-t)
   (location source-location-t))
  (declare-primitive-function-stmt
   (name symbol-t)
   (arity int-t)
   (location source-location-t))
  (declare-primitive-variable-stmt
   (name symbol-t)
   (location source-location-t)))
