(module meta)

(claim exp-free-names
  (-> (set-t symbol-t) exp-t
      (set-t symbol-t)))

(define (exp-free-names bound-names exp)
  (match exp
    ((symbol-exp content location) (make-set))
    ((keyword-exp content location) (make-set))
    ((string-exp content location) (make-set))
    ((int-exp content location) (make-set))
    ((float-exp content location) (make-set))
    ((qualified-var-exp mod-name name location) (make-set))
    ((quote-exp sexp location) (make-set))
    ((var-exp name location)
     (if (set-member? name bound-names)
       (make-set)
       (set-add name (make-set))))
    ((lambda-exp parameters body location)
     (= new-bound-names (set-union bound-names (list-to-set parameters)))
     (exp-free-names new-bound-names body))
    ((polymorphic-exp parameters body location)
     (= new-bound-names (set-union bound-names (list-to-set parameters)))
     (exp-free-names new-bound-names body))
    ((let1-exp name rhs body location)
     (= new-bound-names (set-add name bound-names))
     (set-union (exp-free-names bound-names rhs)
                (exp-free-names new-bound-names body)))
    ((let-exp bindings body location)
     (= binding-names (pipe bindings (list-map binding-name) list-to-set))
     (= new-bound-names (set-union bound-names binding-names))
     (set-union
      (set-union-many
       (pipe bindings
         (list-map binding-rhs)
         (list-map (exp-free-names bound-names))))
      (exp-free-names new-bound-names body)))
    ((let-star-exp bindings body location)
     (= new-bound-names bound-names)
     (= rhs-free-names (make-set))
     (pipe bindings
       (list-each
        (lambda (binding)
          (= free-names (exp-free-names new-bound-names (binding-rhs binding)))
          (set-each (swap set-add! rhs-free-names) free-names)
          (set-add! (binding-name binding) new-bound-names))))
     (exp-free-names new-bound-names body))
    ((letrec-exp bindings body location)
     ;; like (let) but always use new-bound-names instead of bound-names
     (= binding-names (pipe bindings (list-map binding-name) list-to-set))
     (= new-bound-names (set-union bound-names binding-names))
     (set-union
      (set-union-many
       (pipe bindings
         (list-map binding-rhs)
         (list-map (exp-free-names new-bound-names))))
      (exp-free-names new-bound-names body)))
    ((letrec-star-exp bindings body location)
     ;; same as (letrec)
     (= binding-names (pipe bindings (list-map binding-name) list-to-set))
     (= new-bound-names (set-union bound-names binding-names))
     (set-union
      (set-union-many
       (pipe bindings
         (list-map binding-rhs)
         (list-map (exp-free-names new-bound-names))))
      (exp-free-names new-bound-names body)))
    ;; TODO
    ((local-define-exp name parameters body location)
     (exp-free-names (set-add name bound-names) body))
    ((apply-exp target args location)
     (list-fold-left (lambda (s e) (set-union s (exp-free-names bound-names e)))
                     (exp-free-names bound-names target)
                     args))
    ((pipe-exp target steps location)
     (set-union (exp-free-names bound-names target)
                (list-fold-left (lambda (s e) (set-union s (exp-free-names bound-names e)))
                                (make-set) steps)))
    ((chain-exp steps location)
     (list-fold-left (lambda (s e) (set-union s (exp-free-names bound-names e)))
                     (make-set) steps))
    ((compose-exp steps location)
     (list-fold-left (lambda (s e) (set-union s (exp-free-names bound-names e)))
                     (make-set) steps))
    ((begin1-exp head body location)
     (set-union (exp-free-names bound-names head)
                (exp-free-names bound-names body)))
    ((begin-exp sequence location)
     (free-names-begin bound-names sequence))
    ((assign-exp name rhs location)
     (exp-free-names bound-names rhs))
    ((if-exp condition consequent alternative location)
     (set-union (exp-free-names bound-names condition)
                (set-union (exp-free-names bound-names consequent)
                           (exp-free-names bound-names alternative))))
    ((when-exp condition consequent location)
     (set-union (exp-free-names bound-names condition)
                (exp-free-names bound-names consequent)))
    ((unless-exp condition alternative location)
     (set-union (exp-free-names bound-names condition)
                (exp-free-names bound-names alternative)))
    ((and-exp exps location)
     (list-fold-left (lambda (s e) (set-union s (exp-free-names bound-names e)))
                     (make-set) exps))
    ((or-exp exps location)
     (list-fold-left (lambda (s e) (set-union s (exp-free-names bound-names e)))
                     (make-set) exps))
    ((cond-exp clauses location)
     (list-fold-left (lambda (s clause)
                       (set-union (exp-free-names bound-names (cond-clause-question clause))
                                  (set-union s (exp-free-names bound-names (cond-clause-answer clause)))))
                     (make-set) clauses))
    ((literal-list-exp elements location)
     (list-fold-left (lambda (s e) (set-union s (exp-free-names bound-names e)))
                     (make-set) elements))
    ((literal-set-exp elements location)
     (list-fold-left (lambda (s e) (set-union s (exp-free-names bound-names e)))
                     (make-set) elements))
    ((literal-hash-exp entries location)
     (list-fold-left (lambda (s entry)
                       (set-union (exp-free-names bound-names (hash-entry-key entry))
                                  (set-union s (exp-free-names bound-names (hash-entry-value entry)))))
                     (make-set) entries))
    ((arrow-exp arg-types ret-type location)
     (set-union (exp-free-names bound-names ret-type)
                (list-fold-left (lambda (s e) (set-union s (exp-free-names bound-names e)))
                                (make-set) arg-types)))
    ((the-exp type exp2 location)
     (set-union (exp-free-names bound-names type)
                (exp-free-names bound-names exp2)))
    ((match-exp targets clauses location)
     (let ((target-names (list-fold-left (lambda (s t) (set-union s (exp-free-names bound-names t)))
                                         (make-set) targets)))
       (list-fold-left (lambda (s clause)
                         (let ((clause-bound-names
                                (list-fold-left (lambda (s2 p) (set-union s2 (pattern-bound-names p)))
                                                (make-set)
                                                (match-clause-patterns clause))))
                           (set-union s (exp-free-names (set-union bound-names clause-bound-names)
                                                        (match-clause-body clause)))))
                       target-names clauses)))))

(define (free-names-begin bound-names sequence)
  (if (list-empty? sequence)
    (make-set)
    (let* ((exp (list-head sequence))
           (rest (list-tail sequence)))
      (match exp
        ((assign-exp name rhs location)
         (let ((rhs-names (exp-free-names bound-names rhs)))
           (set-union rhs-names (free-names-begin (set-add name bound-names) rest))))
        ((local-define-exp name parameters body location)
         (let ((body-names (exp-free-names (set-add name bound-names) body)))
           (set-union body-names (free-names-begin (set-add name bound-names) rest))))
        (else
         (set-union (exp-free-names bound-names exp)
                    (free-names-begin bound-names rest)))))))
