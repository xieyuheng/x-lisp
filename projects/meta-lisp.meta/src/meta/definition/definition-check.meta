(module meta)

;; NOTE: Ported from meta-lisp.js/src/meta/definition/definitionCheck.ts

(claim definition-check (-> mod-t definition-t void-t))
(define (definition-check mod definition)
  (let ((name (definition-name definition)))
    (if (set-member? name (mod-admitted mod))
      void
      (match definition
        ((algebraic-type-definition mod name type-constructor data-constructors is-checked location)
         (list-each
           (lambda (data-constructor)
             (list-each
               (lambda (field)
                 (try-check-type-exp mod (data-field-type field)
                   (type-constructor-parameters type-constructor)))
               (data-constructor-fields data-constructor)))
           data-constructors)
         (mod-put-definition! name
           (algebraic-type-definition mod name type-constructor data-constructors true location)
           mod)
         void)
        ((primitive-function-declaration mod name arity is-checked location)
         (if (nothing? (mod-lookup-claimed-type mod name))
           (file-write (current-stderr-file)
             (report-unclaimed-primitive-definition definition))
           (mod-put-definition! name
             (primitive-function-declaration mod name arity true location) mod))
         void)
        ((primitive-variable-declaration mod name is-checked location)
         (if (nothing? (mod-lookup-claimed-type mod name))
           (file-write (current-stderr-file)
             (report-unclaimed-primitive-definition definition))
           (mod-put-definition! name
             (primitive-variable-declaration mod name true location) mod))
         void)
        ((primitive-function-definition mod name arity fn is-checked location)
         (if (nothing? (mod-lookup-claimed-type mod name))
           (file-write (current-stderr-file)
             (report-unclaimed-primitive-definition definition))
           (mod-put-definition! name
             (primitive-function-definition mod name arity fn true location) mod))
         void)
        ((primitive-variable-definition mod name value is-checked location)
         (if (nothing? (mod-lookup-claimed-type mod name))
           (file-write (current-stderr-file)
             (report-unclaimed-primitive-definition definition))
           (mod-put-definition! name
             (primitive-variable-definition mod name value true location) mod))
         void)
        ((variable-definition mod name body is-checked location)
         (if (try-check-definition-body mod name body)
           void
           (try-infer-definition-body mod name body))
         (mod-put-definition! name
           (variable-definition mod name body true location) mod)
         void)
        ((test-definition mod name body is-checked location)
         (if (try-check-definition-body mod name body)
           void
           (try-infer-definition-body mod name body))
         (mod-put-definition! name
           (test-definition mod name body true location) mod)
         void)
        ((type-definition mod name parameters body is-checked location)
         (let ((checked-body
                 (if (list-empty? parameters)
                   body
                   (lambda-exp parameters body location))))
           (if (try-check-definition-body mod name checked-body)
             void
             (try-infer-definition-body mod name checked-body)))
         (mod-put-definition! name
           (type-definition mod name parameters body true location) mod)
         void)
        ((function-definition mod name parameters body is-checked location)
         (let ((checked-body (lambda-exp parameters body location)))
           (if (try-check-definition-body mod name checked-body)
             void
             (try-infer-definition-body mod name checked-body)))
         (mod-put-definition! name
           (function-definition mod name parameters body true location) mod)
         void)
        ((opaque-type-definition mod name type-constructor representation-type interface-entries is-checked location)
         (list-each
           (lambda (entry)
             (try-check-type-exp mod (interface-entry-type entry)
               (type-constructor-parameters type-constructor)))
           interface-entries)
         (try-check-type-exp mod representation-type
           (type-constructor-parameters type-constructor))
         (mod-put-definition! name
           (opaque-type-definition mod name type-constructor representation-type interface-entries true location) mod)
         void)))))

(define (try-check-exp mod ctx exp type)
  (let ((effect (check-assignable mod ctx exp type)))
    (match (effect (empty-subst))
      ((check-ok subst) void)
      ((check-error exp message)
       (file-write (current-stderr-file)
         (report-type-check-error exp message))))))

(define (try-check-type-exp mod exp type-parameters)
  (let ((ctx (ctx-put-many (empty-ctx) type-parameters
              (list-map (lambda (name) (type-type)) type-parameters))))
    (try-check-exp mod ctx exp (type-type))))

(define (try-check-definition-body mod name exp)
  (let ((opaque-type-exp (hash-get-maybe name (mod-opaque-claimed mod))))
    (if (not (nothing? opaque-type-exp))
      (let* ((opaque-type (evaluate-type 'transparent mod (empty-env) (just-value opaque-type-exp)))
             (found-names (find-opaque-names-by-interface-name mod name))
             (opaque-names (if (not (nothing? found-names)) (just-value found-names) (make-set))))
        (try-check-exp mod (make-ctx (make-hash) opaque-names) exp opaque-type)
        true)
      (let ((type (mod-lookup-claimed-type mod name)))
        (if (not (nothing? type))
          (begin
            (try-check-exp mod (empty-ctx) exp (just-value type))
            true)
          false)))))

(define (try-infer-definition-body mod name exp)
  (let* ((fresh-var-type (create-fresh-var-type name))
         (ctx (ctx-put (empty-ctx) name fresh-var-type)))
    (mod-put-inferred-type! mod name fresh-var-type)
    (let ((effect (infer mod ctx exp)))
      (match (effect (empty-subst))
        ((infer-error exp message)
         (file-write (current-stderr-file)
           (report-type-check-error exp message)))
        ((infer-ok subst type)
          (let* ((inferred-type (subst-deep-walk subst type))
                 (generalized-type (generalize-in-ctx (empty-ctx) inferred-type)))
           (mod-put-inferred-type! mod name generalized-type)))))))

(define (find-opaque-names-by-interface-name mod name)
  (find-opaque-helper (hash-entries (mod-definitions mod)) name))

(define (find-opaque-helper entries name)
  (if (list-empty? entries)
    (nothing)
    (let ((definition (hash-entry-value (list-first entries))))
      (match definition
        ((opaque-type-definition def-mod def-name type-constructor representation-type interface-entries is-checked location)
         (let ((found (list-find
                        (lambda (iface)
                          (equal? (interface-entry-name iface) name))
                        interface-entries)))
           (if (not (nothing? found))
             (just (list-to-set (list-map interface-entry-name interface-entries)))
             (find-opaque-helper (list-tail entries) name))))
        (else (find-opaque-helper (list-tail entries) name))))))

(define (report-type-check-error exp error-message)
  (format-message-with-source-location error-message (exp-location exp)))

(define (report-unclaimed-primitive-definition definition)
  (let* ((def-name (definition-name definition))
         (error-message (string-concat
                          ["unclaimed primitive definition: "
                           (symbol-to-string def-name)]))
         (location (definition->location definition)))
    (if (string? (source-location-path location))
      (format-message-with-source-location error-message location)
      (string-concat [(symbol-to-string (definition-mod-name definition))
                      " -- " error-message]))))

(define (definition->location definition)
  (match definition
    ((primitive-function-definition mod name arity fn is-checked location) location)
    ((primitive-variable-definition mod name value is-checked location) location)
    ((primitive-function-declaration mod name arity is-checked location) location)
    ((primitive-variable-declaration mod name is-checked location) location)
    ((function-definition mod name parameters body is-checked location) location)
    ((variable-definition mod name body is-checked location) location)
    ((test-definition mod name body is-checked location) location)
    ((type-definition mod name parameters body is-checked location) location)
    ((algebraic-type-definition mod name type-constructor data-constructors is-checked location) location)
    ((opaque-type-definition mod name type-constructor representation-type interface-entries is-checked location) location)))
