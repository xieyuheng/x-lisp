(module meta)

(define-enum definition-t
  (primitive-function-definition
   (mod mod-t)
   (name symbol-t)
   (arity int-t)
   (fn (-> (list-t value-t) value-t))
   (is-checked bool-t)
   (location source-location-t))
  (primitive-variable-definition
   (mod mod-t)
   (name symbol-t)
   (value value-t)
   (is-checked bool-t)
   (location source-location-t))
  (primitive-function-declaration
   (mod mod-t)
   (name symbol-t)
   (arity int-t)
   (is-checked bool-t)
   (location source-location-t))
  (primitive-variable-declaration
   (mod mod-t)
   (name symbol-t)
   (is-checked bool-t)
   (location source-location-t))
  (function-definition
   (mod mod-t)
   (name symbol-t)
   (parameters (list-t symbol-t))
   (body exp-t)
   (is-checked bool-t)
   (location source-location-t))
  (variable-definition
   (mod mod-t)
   (name symbol-t)
   (body exp-t)
   (is-checked bool-t)
   (location source-location-t))
  (test-definition
   (mod mod-t)
   (name symbol-t)
   (body exp-t)
   (is-checked bool-t)
   (location source-location-t))
  (type-definition
   (mod mod-t)
   (name symbol-t)
   (parameters (list-t symbol-t))
   (body exp-t)
   (is-checked bool-t)
   (location source-location-t))
  (algebraic-type-definition
   (mod mod-t)
   (name symbol-t)
   (type-constructor type-constructor-t)
   (data-constructors (list-t data-constructor-t))
   (is-checked bool-t)
   (location source-location-t))
  (opaque-type-definition
   (mod mod-t)
   (name symbol-t)
   (type-constructor type-constructor-t)
   (representation-type exp-t)
   (interface-entries (list-t interface-entry-t))
   (is-checked bool-t)
   (location source-location-t)))

(define-struct type-constructor-t
  (name symbol-t)
  (parameters (list-t symbol-t)))

(define-struct pre-data-constructor-t
  (name symbol-t)
  (fields (list-t data-field-t))
  (location source-location-t))

(define-struct data-constructor-t
  (mod mod-t)
  (type-name symbol-t)
  (name symbol-t)
  (fields (list-t data-field-t))
  (location source-location-t))

(claim data-constructor-equal? (-> data-constructor-t data-constructor-t bool-t))
(define (data-constructor-equal? a b)
  (and (same? (data-constructor-mod a) (data-constructor-mod b))
       (equal? (data-constructor-type-name a) (data-constructor-type-name b))
       (equal? (data-constructor-name a) (data-constructor-name b))))

(define-struct data-field-t
  (name symbol-t)
  (type exp-t)
  (location source-location-t))

(define-struct interface-entry-t
  (name symbol-t)
  (type exp-t)
  (location source-location-t))

(define-struct algebraic-type-field-t
  (name symbol-t)
  (type exp-t)
  (accessor-name symbol-t)
  (modifier-name (maybe-t symbol-t))
  (location source-location-t))

(define-struct algebraic-type-constructor-t
  (name symbol-t)
  (fields (list-t algebraic-type-field-t))
  (predicate symbol-t)
  (location source-location-t))
