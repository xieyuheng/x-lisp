(module meta)

(define-enum definition-t
  (primitive-function-definition
    (mod mod-t)
    (name symbol-t)
    (arity int-t)
    (fn (-> (list-t value-t) value-t))
    (location source-location-t))
  (primitive-variable-definition
    (mod mod-t)
    (name symbol-t)
    (value value-t)
    (location source-location-t))
  (primitive-function-declaration
    (mod mod-t)
    (name symbol-t)
    (arity int-t)
    (location source-location-t))
  (primitive-variable-declaration
    (mod mod-t)
    (name symbol-t)
    (location source-location-t))
  (function-definition
    (mod mod-t)
    (name symbol-t)
    (parameters (list-t symbol-t))
    (body term-t)
    (location source-location-t))
  (variable-definition
    (mod mod-t)
    (name symbol-t)
    (body term-t)
    (location source-location-t))
  (test-definition
    (mod mod-t)
    (name symbol-t)
    (body term-t)
    (location source-location-t))
  (type-definition
    (mod mod-t)
    (name symbol-t)
    (parameters (list-t symbol-t))
    (body term-t)
    (location source-location-t))
  (algebraic-type-definition
    (mod mod-t)
    (name symbol-t)
    (type-constructor type-constructor-t)
    (data-constructors (list-t data-constructor-t))
    (location source-location-t))
  (opaque-type-definition
    (mod mod-t)
    (name symbol-t)
    (type-constructor type-constructor-t)
    (representation-type term-t)
    (interface-entries (list-t interface-entry-t))
    (location source-location-t)))

(define-struct type-constructor-t
  (mod mod-t)
  (name symbol-t)
  (parameters (list-t symbol-t)))

(claim type-constructor-equal? (-> type-constructor-t type-constructor-t bool-t))
(define (type-constructor-equal? a b)
  (and (same? (type-constructor-mod a) (type-constructor-mod b))
       (equal? (type-constructor-name a) (type-constructor-name b))))

(define-struct data-constructor-t
  (mod mod-t)
  (type-name symbol-t)
  (name symbol-t)
  (fields (list-t data-field-t))
  (location source-location-t))

(claim data-constructor-equal? (-> data-constructor-t data-constructor-t bool-t))
(define (data-constructor-equal? a b)
  (and (same? (data-constructor-mod a) (data-constructor-mod b))
       (equal? (data-constructor-type-name a) (data-constructor-type-name b))
       (equal? (data-constructor-name a) (data-constructor-name b))))

(define-struct data-field-t
  (name symbol-t)
  (type term-t)
  (location source-location-t))

(define-struct interface-entry-t
  (name symbol-t)
  (type term-t)
  (location source-location-t))
