(module meta)

(claim check-assignable (-> mod-t ctx-t exp-t type-t check-effect-t))
(define (check-assignable mod ctx exp type)
  (infer-then-check (infer mod ctx exp)
    (lambda (inferred-type)
      (let ((inferred-type (type-freshen inferred-type))
            (type (type-freshen type)))
        (sequence-check-effect
          [(check-subst-instance mod exp inferred-type type)
           (check-unify mod exp inferred-type type)])))))

(claim check-subst-instance (-> mod-t exp-t type-t type-t check-effect-t))
(define (check-subst-instance mod exp inferred-type type)
  (lambda (subst)
    (let ((inferred-type (subst-deep-walk subst inferred-type))
          (type (subst-deep-walk subst type)))
      (if (is-substitution-instance type inferred-type)
        ((ok-check-effect) subst)
        (let ((pretty-unknown-subst (generate-pretty-unknown-subst [inferred-type type])))
          (let ((inferred-type (subst-deep-walk pretty-unknown-subst inferred-type))
                (type (subst-deep-walk pretty-unknown-subst type)))
            (let ((message (string-concat
                             ["expected type is not a substitution instance of inferred type"
                              "\n  inferred type: " (format-type inferred-type)
                              "\n  expected type: " (format-type type)])))
              ((error-check-effect exp message) subst))))))))

(claim check-by-infer (-> mod-t ctx-t exp-t type-t check-effect-t))
(define (check-by-infer mod ctx exp type)
  (infer-then-check (infer mod ctx exp)
    (lambda (inferred-type)
      (check-unify mod exp inferred-type type))))

(claim check-unify (-> mod-t exp-t type-t type-t check-effect-t))
(define (check-unify mod exp inferred-type type)
  (lambda (subst)
    (let ((new-subst (unify (just subst) inferred-type type)))
      (if (nothing? new-subst)
        (let ((inferred-type (subst-deep-walk subst inferred-type))
              (type (subst-deep-walk subst type)))
          (let ((pretty-unknown-subst (generate-pretty-unknown-subst [inferred-type type])))
            (let ((inferred-type (subst-deep-walk pretty-unknown-subst inferred-type))
                  (type (subst-deep-walk pretty-unknown-subst type)))
              (let ((message (string-concat
                               ["unification fail"
                                "\n  inferred type: " (format-type inferred-type)
                                "\n  expected type: " (format-type type)])))
                ((error-check-effect exp message) subst)))))
        ((ok-check-effect) (just-value new-subst))))))
