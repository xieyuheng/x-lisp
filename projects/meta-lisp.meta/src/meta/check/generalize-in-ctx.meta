(module meta)

(claim generalize-in-ctx (-> ctx-t type-t type-t))
(define (generalize-in-ctx ctx type)
  (let ((free-var-types-in-ctx (ctx-free-var-types ctx))
        (free-var-types (type-free-var-types (make-set) type)))
    (let ((free-var-types
            (list-reject (lambda (vt)
                           (list-some? (lambda (t) (var-type-equal? vt t))
                                       free-var-types-in-ctx))
                         free-var-types)))
      (if (list-empty? free-var-types)
        type
        (let ((deduped-var-types
                (dedup-var-types
                  (list-select (lambda (t) (var-type? t)) free-var-types))))
          (polymorphic-type-prettify-var-types
            (polymorphic-type deduped-var-types type)))))))
