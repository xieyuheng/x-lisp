(module meta)

(claim infer (-> mod-t ctx-t exp-t infer-effect-t))
(define (infer mod ctx exp)
  (lambda (subst)
    (match exp
      ((symbol-exp content location)
       ((ok-infer-effect (atom-type 'symbol)) subst))
      ((keyword-exp content location)
       ((ok-infer-effect (atom-type 'keyword)) subst))
      ((string-exp content location)
       ((ok-infer-effect (atom-type 'string)) subst))
      ((int-exp content location)
       ((ok-infer-effect (atom-type 'int)) subst))
      ((float-exp content location)
       ((ok-infer-effect (atom-type 'float)) subst))
      ((var-exp name location)
       (let ((ctx-type (ctx-lookup-type ctx name)))
         (if (not (nothing? ctx-type))
           ((ok-infer-effect (just-value ctx-type)) subst)
           ((infer-lookup mod ctx name exp) subst))))
      ((qualified-var-exp mod-name name location)
       (let ((qualified-mod (project-lookup-mod (mod-project mod) mod-name)))
         (if (nothing? qualified-mod)
           ((error-infer-effect exp
             (string-concat ["undefined module prefix"
                             "\n  module: " (symbol-to-string mod-name)
                             "\n  name: " (symbol-to-string name)])) subst)
           (let ((found-mod (just-value qualified-mod)))
             ((infer-lookup found-mod ctx name exp) subst)))))
      ((apply-exp target args location)
       ((infer-then-infer (infer mod ctx target)
          (lambda (target-type)
            (infer-apply-arrow-type mod ctx target-type args exp))) subst))
      ((lambda-exp parameters body location)
       (cond
         ((list-empty? parameters)
          (let* ((ret-type (create-fresh-var-type 'R))
                 (type (arrow-type [] ret-type)))
            ((check-then-infer
               (check-by-infer mod ctx body ret-type)
               (ok-infer-effect type)) subst)))
         ((equal? (list-length parameters) 1)
          (let* ((arg-type (create-fresh-var-type 'A))
                 (ret-type (create-fresh-var-type 'R))
                 (type (arrow-type [arg-type] ret-type))
                 (parameter (list-first parameters)))
            ((check-then-infer
               (check-by-infer mod (ctx-put ctx parameter arg-type) body ret-type)
               (ok-infer-effect type)) subst)))
         (else
          (let* ((arg-type (create-fresh-var-type 'A))
                 (ret-type (create-fresh-var-type 'R))
                 (type (arrow-type [arg-type] ret-type))
                 (parameter (list-first parameters))
                 (rest-parameters (list-tail parameters)))
            ((check-then-infer
               (check-by-infer mod (ctx-put ctx parameter arg-type)
                               (lambda-exp rest-parameters body location) ret-type)
               (ok-infer-effect type)) subst)))))
      ((and-exp exps location)
       ((check-then-infer
          (sequence-check-effect
            (list-map (lambda (sub-exp) (check-by-infer mod ctx sub-exp (atom-type 'bool))) exps))
          (ok-infer-effect (atom-type 'bool))) subst))
      ((or-exp exps location)
       ((check-then-infer
          (sequence-check-effect
            (list-map (lambda (sub-exp) (check-by-infer mod ctx sub-exp (atom-type 'bool))) exps))
          (ok-infer-effect (atom-type 'bool))) subst))
      ((the-exp the-type the-body location)
       (let ((type (evaluate-type 'opaque mod (empty-env) the-type)))
         ((check-then-infer
            (check-assignable mod ctx the-body type)
            (ok-infer-effect type)) subst)))
      ((if-exp condition consequent alternative location)
       (let ((type (create-fresh-var-type 'X)))
         ((check-then-infer
            (sequence-check-effect
              [(check-by-infer mod ctx condition (atom-type 'bool))
               (check-by-infer mod ctx consequent type)
               (check-by-infer mod ctx alternative type)])
            (ok-infer-effect type)) subst)))
      ((let1-exp name rhs body location)
       ((infer-then-infer (infer mod ctx rhs)
          (lambda (inferred-type)
            (lambda (subst2)
              (let* ((ctx2 (subst-deep-walk-ctx subst2 ctx))
                     (inferred-type2 (subst-deep-walk subst2 inferred-type))
                     (generalized-type (generalize-in-ctx ctx2 inferred-type2))
                     (new-ctx (ctx-put ctx2 name generalized-type)))
                ((infer mod new-ctx body) subst2))))) subst))
      ((begin1-exp head body location)
       ((infer-then-infer (infer mod ctx head)
          (lambda (head-type) (infer mod ctx body))) subst))
      ((literal-list-exp elements location)
       (let* ((element-type (create-fresh-var-type 'E))
              (type (list-type element-type)))
          ((check-then-infer
             (sequence-check-effect
               (list-map (lambda (element) (check-by-infer mod ctx element element-type)) elements))
             (ok-infer-effect type)) subst)))
      ((literal-set-exp elements location)
       (let* ((element-type (create-fresh-var-type 'E))
              (type (set-type element-type)))
          ((check-then-infer
             (sequence-check-effect
               (list-map (lambda (element) (check-by-infer mod ctx element element-type)) elements))
             (ok-infer-effect type)) subst)))
      ((literal-hash-exp entries location)
       (let* ((key-type (create-fresh-var-type 'K))
              (value-type (create-fresh-var-type 'V))
              (type (hash-type key-type value-type)))
         ((check-then-infer
            (sequence-check-effect
              (list-concat
                (list-map (lambda (entry)
                  (let ((hash-entry-key (hash-entry-key entry))
                        (hash-entry-value (hash-entry-value entry)))
                    [(check-by-infer mod ctx hash-entry-key key-type)
                     (check-by-infer mod ctx hash-entry-value value-type)]))
                  entries))))
          (ok-infer-effect type)) subst))
      ((arrow-exp arg-types ret-type location)
       (let ((type-t-val (type-type)))
         ((check-then-infer
            (sequence-check-effect
              (list-append
                (list-map (lambda (arg-type-exp) (check-by-infer mod ctx arg-type-exp type-t-val)) arg-types)
                [(check-by-infer mod ctx ret-type type-t-val)]))
            (ok-infer-effect type-t-val)) subst)))
      ((polymorphic-exp parameters body location)
       (let* ((type-t-val (type-type))
              (new-ctx (ctx-put-many ctx parameters
                          (list-map (lambda (param) type-t-val) parameters))))
         ((check-then-infer
            (check-by-infer mod new-ctx body type-t-val)
            (ok-infer-effect type-t-val)) subst)))
      (else
       ((error-infer-effect exp
          (string-concat ["not inferable exp: " (format-exp exp)])) subst)))))

(define (infer-lookup mod ctx name exp)
  (lambda (subst)
    ;; Check if name is in transparent-opaque-names
    (if (set-member? name (ctx-transparent-opaque-names ctx))
      (let ((opaque-type-exp (hash-get-maybe name (mod-opaque-claimed mod))))
        (if (not (nothing? opaque-type-exp))
          (let ((transparent-type (evaluate-type 'transparent mod (empty-env)
                                                   (just-value opaque-type-exp))))
            ((ok-infer-effect transparent-type) subst))
          ;; Fall through to claimed type lookup
          ((infer-lookup-checked mod ctx name exp) subst)))
      ((infer-lookup-checked mod ctx name exp) subst))))

(define (infer-lookup-checked mod ctx name exp)
  (lambda (subst)
    (let ((claimed-type (mod-lookup-claimed-type mod name)))
      (if (not (nothing? claimed-type))
        ((ok-infer-effect (just-value claimed-type)) subst)
        (let ((definition (mod-lookup-definition mod name)))
          (if (nothing? definition)
            ((error-infer-effect exp
               (string-concat ["undefined variable"
                               "\n  module: " (symbol-to-string (mod-name mod))
                               "\n  name: " (symbol-to-string name)])) subst)
            ;; Check for mutual-recursion: pre-allocated type
            (let ((inferred-type (mod-lookup-inferred-type mod name)))
              (if (not (nothing? inferred-type))
                ((ok-infer-effect (just-value inferred-type)) subst)
                ;; Check definition on demand
                (begin
                  (definition-check mod (just-value definition))
                  (let ((inferred-type (mod-lookup-inferred-type mod name)))
                    (if (not (nothing? inferred-type))
                      ((ok-infer-effect (just-value inferred-type)) subst)
                      ((error-infer-effect exp
                         (string-concat ["[typeInferLookup] internal error: infer fail after check"
                                         "\n  module name: " (symbol-to-string (mod-name mod))
                                         "\n  name: " (symbol-to-string name)])) subst))))))))))))

(define (infer-apply-arrow-type mod ctx type args original-exp)
  (lambda (subst)
    (if (list-empty? args)
      (let* ((ret-type (create-fresh-var-type 'R))
             (arrow-type (arrow-type [] ret-type))
             (new-subst (unify (just subst) type arrow-type)))
        (if (nothing? new-subst)
          ((error-infer-effect original-exp
             (string-concat ["expecting nullary arrow type"
                             "\n  expected type: " (format-type (subst-deep-walk subst type))])) subst)
          ((ok-infer-effect ret-type) (just-value new-subst))))
      (if (equal? (list-length args) 1)
        (let* ((arg-type (create-fresh-var-type 'A))
               (ret-type (create-fresh-var-type 'R))
               (arrow-type (arrow-type [arg-type] ret-type))
               (new-subst (unify (just subst) type arrow-type)))
          (if (nothing? new-subst)
            ((error-infer-effect original-exp
               (string-concat ["expecting arrow type"
                               "\n  expected type: " (format-type (subst-deep-walk subst type))
                               "\n  args: " (format-exps args)])) subst)
            (let ((arg (list-first args)))
              ((check-then-infer
                 (check-by-infer mod ctx arg arg-type)
                 (ok-infer-effect ret-type)) (just-value new-subst)))))
        (let* ((arg-type (create-fresh-var-type 'A))
               (ret-type (create-fresh-var-type 'R))
               (arrow-type (arrow-type [arg-type] ret-type))
               (new-subst (unify (just subst) type arrow-type)))
          (if (nothing? new-subst)
            ((error-infer-effect original-exp
               (string-concat ["expecting arrow type"
                               "\n  expected type: " (format-type (subst-deep-walk subst type))
                               "\n  args: " (format-exps args)])) subst)
            (let ((arg (list-first args))
                  (rest-args (list-tail args)))
              ((check-then-infer
                 (check-by-infer mod ctx arg arg-type)
                 (infer-apply-arrow-type mod ctx ret-type rest-args original-exp)) (just-value new-subst)))))))))
