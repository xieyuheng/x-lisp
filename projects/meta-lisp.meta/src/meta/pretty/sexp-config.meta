(module meta)

(claim meta-sexp-config (-> ppml/sexp-config-t))
(define (meta-sexp-config)
  (ppml/make-sexp-config
    [(make-pair 'define 1)
     (make-pair 'lambda 1)
     (make-pair 'if 1)
     (make-pair 'when 1)
     (make-pair 'unless 1)
     (make-pair 'cond 0)
     (make-pair 'and 0)
     (make-pair 'or 0)
     (make-pair 'begin 0)
     (make-pair 'define-test 1)
     (make-pair 'define-type 1)
     (make-pair 'claim 1)
     (make-pair 'admit 1)
     (make-pair 'let 0)
     (make-pair 'let* 0)
     (make-pair 'letrec 0)
     (make-pair 'letrec* 0)
     (make-pair 'match 1)
     (make-pair 'local-define 1)
     (make-pair 'setup 0)
     (make-pair 'polymorphic 1)
     (make-pair 'the 2)
     (make-pair '-> 0)
     (make-pair '*-> 0)
     (make-pair 'import 1)
     (make-pair 'import-as 2)
     (make-pair 'import-all 1)
     (make-pair 'private 0)
     (make-pair 'exempt 0)
     (make-pair 'declare-module 1)
     (make-pair 'declare-primitive-function 2)
     (make-pair 'declare-primitive-variable 1)
     (make-pair 'define-enum 1)
     (make-pair 'define-struct 1)
     (make-pair 'define-struct* 1)
     (make-pair 'define-algebraic-type 1)
     (make-pair 'define-record-type 1)
     (make-pair 'define-opaque-type 1)
     (make-pair 'code 1)]))
