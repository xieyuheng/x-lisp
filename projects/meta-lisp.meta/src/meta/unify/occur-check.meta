(module meta)

(claim occur-check (-> subst-t type-t type-t bool-t))
(define (occur-check subst var-type type)
  (occur-check-with-bound-ids (make-set) subst var-type type))

(define (occur-check-with-bound-ids bound-ids subst var-type type)
  (let ((type (subst-walk subst type)))
    (match type
      ((var-type name serial-number)
       (if (set-member? (var-type-id type) bound-ids)
         false
         (equal? (var-type-id type) (var-type-id var-type))))
      ((canonical-label-type serial-number) false)
      ((type-type) false)
      ((atom-type name) false)
      ((arrow-type arg-types ret-type)
       (or (list-some? (lambda (t) (occur-check-with-bound-ids bound-ids subst var-type t)) arg-types)
           (occur-check-with-bound-ids bound-ids subst var-type ret-type)))
      ((list-type element-type)
       (occur-check-with-bound-ids bound-ids subst var-type element-type))
      ((set-type element-type)
       (occur-check-with-bound-ids bound-ids subst var-type element-type))
      ((hash-type key-type value-type)
       (or (occur-check-with-bound-ids bound-ids subst var-type key-type)
           (occur-check-with-bound-ids bound-ids subst var-type value-type)))
      ((algebraic-type definition arg-types)
       (list-some? (lambda (t) (occur-check-with-bound-ids bound-ids subst var-type t)) arg-types))
      ((opaque-type definition arg-types)
       (list-some? (lambda (t) (occur-check-with-bound-ids bound-ids subst var-type t)) arg-types))
      ((polymorphic-type var-types body-type)
       (occur-check-with-bound-ids
         (list-fold-left (lambda (s vt) (set-add (var-type-id vt) s)) bound-ids var-types)
         subst var-type body-type)))))
