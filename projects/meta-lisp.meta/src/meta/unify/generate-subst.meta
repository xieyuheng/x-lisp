(module meta)

;; For reification: replace free var types with canonical labels.

(claim generate-canonical-label-subst (-> (list-t type-t) subst-t))
(define (generate-canonical-label-subst types)
  (let ((free-var-types (dedup-var-types
                          (list-concat
                            (list-map (lambda (t) (type-free-var-types (make-set) t)) types)))))
    (generate-canonical-label-subst-helper free-var-types (empty-subst))))

(define (generate-canonical-label-subst-helper var-types subst)
  (if (list-empty? var-types)
    subst
    (let* ((free-var-type (list-first var-types))
           (serial-number (iadd (subst-length subst) 1))
           (canonical-label (canonical-label-type serial-number))
           (new-subst (subst-extend subst free-var-type canonical-label)))
      (generate-canonical-label-subst-helper (list-tail var-types) new-subst))))

;; For error messages: replace free var types with pretty ?0, ?1, etc.

(claim generate-pretty-unknown-subst (-> (list-t type-t) subst-t))
(define (generate-pretty-unknown-subst types)
  (let ((free-var-types (dedup-var-types
                          (list-concat
                            (list-map (lambda (t) (type-free-var-types (make-set) t)) types)))))
    (generate-pretty-unknown-subst-helper free-var-types (empty-subst))))

(define (generate-pretty-unknown-subst-helper var-types subst)
  (if (list-empty? var-types)
    subst
    (let* ((free-var-type (list-first var-types))
           (pretty-name (generate-pretty-type-variable-name (subst-length subst)))
           (pretty-unknown (var-type pretty-name 0))
           (new-subst (subst-extend subst free-var-type pretty-unknown)))
      (generate-pretty-unknown-subst-helper (list-tail var-types) new-subst))))

(define (dedup-var-types types)
  (if (list-empty? types)
    []
    (let ((first (list-first types))
          (rest (list-tail types)))
      (if (list-some? (lambda (t) (var-type-equal? first t)) rest)
        (dedup-var-types rest)
        (cons first (dedup-var-types rest))))))
