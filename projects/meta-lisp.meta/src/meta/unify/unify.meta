(module meta)

(claim unify (-> (maybe-t subst-t) type-t type-t (maybe-t subst-t)))
(define (unify subst lhs rhs)
  (if (nothing? subst)
    (nothing)
    (let ((lhs (subst-walk (just-value subst) lhs))
          (rhs (subst-walk (just-value subst) rhs)))
      (unify-types (just-value subst) lhs rhs))))

(claim unify-many (-> (maybe-t subst-t) (list-t type-t) (list-t type-t) (maybe-t subst-t)))
(define (unify-many subst lhs rhs)
  (if (nothing? subst)
    (nothing)
    (if (not (equal? (list-length lhs) (list-length rhs)))
      (nothing)
      (unify-many-helper (just-value subst) lhs rhs))))

(define (unify-many-helper subst lhs rhs)
  (if (list-empty? lhs)
    (just subst)
    (let ((new-subst (unify (just subst) (list-first lhs) (list-first rhs))))
      (if (nothing? new-subst)
        (nothing)
        (unify-many-helper (just-value new-subst) (list-tail lhs) (list-tail rhs))))))

(define (unify-types subst lhs rhs)
  ;; Handle polymorphic types by freshening
  (match lhs
    ((polymorphic-type var-types body-type)
     (unify (just subst) (polymorphic-type-fresh-body-type lhs) rhs))
    (else
     (match rhs
       ((polymorphic-type var-types body-type)
        (unify (just subst) lhs (polymorphic-type-fresh-body-type rhs)))
       (else (unify-simple subst lhs rhs))))))

(define (unify-simple subst lhs rhs)
  (cond
    ;; Both are same VarType
    ((and (var-type? lhs) (var-type? rhs))
     (if (equal? (var-type-id lhs) (var-type-id rhs))
       (just subst)
       (unify-var-type subst lhs rhs)))
    ;; lhs is VarType
    ((var-type? lhs)
     (if (occur-check subst lhs rhs)
       (nothing)
       (just (subst-extend subst lhs rhs))))
    ;; rhs is VarType
    ((var-type? rhs)
     (if (occur-check subst rhs lhs)
       (nothing)
       (just (subst-extend subst rhs lhs))))
    ;; CanonicalLabelType
    ((and (canonical-label-type? lhs) (canonical-label-type? rhs))
     (if (equal? (canonical-label-type-serial-number lhs)
                 (canonical-label-type-serial-number rhs))
       (just subst)
       (nothing)))
    ;; TypeType
    ((and (type-type? lhs) (type-type? rhs))
     (just subst))
    ;; AtomType
    ((and (atom-type? lhs) (atom-type? rhs))
     (if (equal? (atom-type-name lhs) (atom-type-name rhs))
       (just subst)
       (nothing)))
    ;; ArrowType
    ((and (arrow-type? lhs) (arrow-type? rhs))
     (let ((curried-lhs (arrow-type-currying lhs))
           (curried-rhs (arrow-type-currying rhs)))
       (match curried-lhs
         ((arrow-type lhs-arg-types lhs-ret-type)
          (match curried-rhs
            ((arrow-type rhs-arg-types rhs-ret-type)
             (let ((new-subst (unify-many (just subst) lhs-arg-types rhs-arg-types)))
            (if (nothing? new-subst)
              (nothing)
              (unify new-subst lhs-ret-type rhs-ret-type))))
            (else (nothing))))
         (else (nothing)))))
    ;; ListType
    ((and (list-type? lhs) (list-type? rhs))
     (unify (just subst) (list-type-element-type lhs) (list-type-element-type rhs)))
    ;; SetType
    ((and (set-type? lhs) (set-type? rhs))
     (unify (just subst) (set-type-element-type lhs) (set-type-element-type rhs)))
    ;; HashType
    ((and (hash-type? lhs) (hash-type? rhs))
     (let ((new-subst (unify (just subst) (hash-type-key-type lhs) (hash-type-key-type rhs))))
        (if (nothing? new-subst)
          (nothing)
          (unify new-subst (hash-type-value-type lhs) (hash-type-value-type rhs)))))
    ;; AlgebraicType
    ((and (algebraic-type? lhs) (algebraic-type? rhs))
     (if (same? (algebraic-type-get-definition lhs) (algebraic-type-get-definition rhs))
       (unify-many (just subst)
                   (algebraic-type-arg-types lhs)
                   (algebraic-type-arg-types rhs))
       (nothing)))
    ;; OpaqueType
    ((and (opaque-type? lhs) (opaque-type? rhs))
     (if (same? (opaque-type-get-definition lhs) (opaque-type-get-definition rhs))
       (unify-many (just subst)
                   (opaque-type-arg-types lhs)
                   (opaque-type-arg-types rhs))
       (nothing)))
    (else (nothing))))

;; Helper for VarType case: check both sides are VarType but different IDs

(define (unify-var-type subst lhs rhs)
  (let ((lhs-walked (subst-walk subst lhs))
        (rhs-walked (subst-walk subst rhs)))
    (if (and (var-type? lhs-walked) (var-type? rhs-walked))
      (if (equal? (var-type-id lhs-walked) (var-type-id rhs-walked))
        (just subst)
        (if (occur-check subst lhs-walked rhs-walked)
          (nothing)
          (just (subst-extend subst lhs-walked rhs-walked))))
      (unify-types subst lhs-walked rhs-walked))))
