(module meta)

(claim format-type (-> type-t string-t))
(define (format-type type)
  (match type
    ((var-type name serial-number)
     (symbol-to-string name))
    ((canonical-label-type serial-number)
     (string-concat ["%" (int-to-string serial-number)]))
    ((type-type)
     "type-t")
    ((atom-type name)
     (symbol-to-string name))
    ((arrow-type arg-types ret-type)
     (let ((args-str (format-types arg-types)))
       (string-concat ["(-> " args-str " " (format-type ret-type) ")"])))
    ((list-type element-type)
     (string-concat ["(list-t " (format-type element-type) ")"]))
    ((set-type element-type)
     (string-concat ["(set-t " (format-type element-type) ")"]))
    ((hash-type key-type value-type)
     (string-concat ["(hash-t " (format-type key-type) " " (format-type value-type) ")"]))
    ((algebraic-type definition arg-types)
     (let ((defn-name (format-definition-short definition)))
       (if (list-empty? arg-types)
         defn-name
         (string-concat ["(" defn-name " " (format-types arg-types) ")"]))))
    ((opaque-type definition arg-types)
     (let ((defn-name (format-definition-short definition)))
       (if (list-empty? arg-types)
         defn-name
         (string-concat ["(" defn-name " " (format-types arg-types) ")"]))))
    ((polymorphic-type var-types body-type)
     (string-concat ["(polymorphic (" (format-types var-types) ") " (format-type body-type) ")"]))))

(claim format-types (-> (list-t type-t) string-t))
(define (format-types types)
  (string-join " " (list-map format-type types)))

(define (format-definition-short definition)
  (match definition
    ((primitive-function-definition mod name arity fn is-checked location)
     (symbol-to-string name))
    ((primitive-variable-definition mod name value is-checked location)
     (symbol-to-string name))
    ((primitive-function-declaration mod name arity is-checked location)
     (symbol-to-string name))
    ((primitive-variable-declaration mod name is-checked location)
     (symbol-to-string name))
    ((function-definition mod name parameters body is-checked location)
     (symbol-to-string name))
    ((variable-definition mod name body is-checked location)
     (symbol-to-string name))
    ((test-definition mod name body is-checked location)
     (symbol-to-string name))
    ((type-definition mod name parameters body is-checked location)
     (symbol-to-string name))
    ((algebraic-type-definition mod name type-constructor data-constructors is-checked location)
     (symbol-to-string name))
    ((opaque-type-definition mod name type-constructor representation-type interface-entries is-checked location)
     (symbol-to-string name))))
