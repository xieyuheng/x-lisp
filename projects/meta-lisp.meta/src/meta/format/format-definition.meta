(module meta)

(claim format-definition (-> definition-t string-t))
(define (format-definition definition)
  (match definition
    ((primitive-function-definition mod name arity fn is-checked location)
     (let ((claim-str (format-definition-claim mod name)))
       (string-concat [claim-str
                       "(declare-primitive-function "
                       (symbol-to-string name) " " (int-to-string arity) ")"])))
    ((primitive-function-declaration mod name arity is-checked location)
     (string-concat ["(declare-primitive-function " (symbol-to-string name) " " (int-to-string arity) ")"]))
    ((primitive-variable-definition mod name value is-checked location)
     (let ((claim-str (format-definition-claim mod name)))
       (string-concat [claim-str
                       "(declare-primitive-variable " (symbol-to-string name) ")"])))
    ((primitive-variable-declaration mod name is-checked location)
     (string-concat ["(declare-primitive-variable " (symbol-to-string name) ")"]))
    ((function-definition mod name parameters body is-checked location)
     (let ((claim-str (format-definition-claim mod name))
           (params-str (string-join " " (list-map symbol-to-string parameters)))
           (body-str (format-exp body)))
       (string-concat [claim-str "(define (" (symbol-to-string name) " "
                       params-str ") " body-str ")"])))
    ((variable-definition mod name body is-checked location)
     (let ((claim-str (format-definition-claim mod name))
           (body-str (format-exp body)))
       (string-concat [claim-str "(define " (symbol-to-string name) " " body-str ")"])))
    ((test-definition mod name body is-checked location)
     (let ((claim-str (format-definition-claim mod name))
           (body-str (format-exp body)))
       (string-concat [claim-str "(define-test " (symbol-to-string name) " " body-str ")"])))
    ((type-definition mod name parameters body is-checked location)
     (let ((claim-str (format-definition-claim mod name))
           (body-str (format-exp body)))
       (string-concat [claim-str "(define-type " (symbol-to-string name) " " body-str ")"])))
    ((algebraic-type-definition mod name type-constructor data-constructors is-checked location)
     (let ((tc-name (type-constructor-name type-constructor))
           (tc-params (type-constructor-parameters type-constructor))
           (ctors-str (string-join " " (list-map format-data-constructor data-constructors))))
       (if (list-empty? tc-params)
         (string-concat ["(define-enum " (symbol-to-string tc-name) " " ctors-str ")"])
         (string-concat ["(define-enum (" (symbol-to-string tc-name) " "
                         (string-join " " (list-map symbol-to-string tc-params)) ") "
                         ctors-str ")"]))))
    ((opaque-type-definition mod name type-constructor representation-type interface-entries is-checked location)
     (let ((tc-name (symbol-to-string name))
           (tc-params (type-constructor-parameters type-constructor))
           (repr-str (format-exp representation-type))
           (ifaces-str (string-join " " (list-map format-interface-entry interface-entries))))
       (if (list-empty? tc-params)
         (string-concat ["(define-opaque-type " tc-name " " repr-str " " ifaces-str ")"])
         (string-concat ["(define-opaque-type (" tc-name " "
                         (string-join " " (list-map symbol-to-string tc-params)) ") "
                          repr-str " " ifaces-str ")"]))))))

(define (format-data-constructor data-constructor)
  (let ((name-str (symbol-to-string (data-constructor-name data-constructor)))
        (fields (data-constructor-fields data-constructor)))
    (if (list-empty? fields)
      name-str
      (string-concat ["(" name-str " " (string-join " " (list-map format-data-field fields)) ")"]))))

(define (format-definition-claim mod name)
  (let ((claimed-entry (mod-lookup-claimed-entry mod name)))
    (if (not (nothing? claimed-entry))
      (let ((exp (claim-entry-exp (just-value claimed-entry))))
        (string-concat ["(claim " (symbol-to-string name) " " (format-exp exp) ") "]))
      (let ((inferred-type (mod-lookup-inferred-type mod name)))
        (if (not (nothing? inferred-type))
          (string-concat ["(claim " (symbol-to-string name) " "
                          (format-type (just-value inferred-type)) ") "])
          "")))))

(claim definition-mod-name (-> definition-t symbol-t))
(define (definition-mod-name definition)
  (match definition
    ((primitive-function-definition mod name arity fn is-checked location)
     (mod-name mod))
    ((primitive-variable-definition mod name value is-checked location)
     (mod-name mod))
    ((primitive-function-declaration mod name arity is-checked location)
     (mod-name mod))
    ((primitive-variable-declaration mod name is-checked location)
     (mod-name mod))
    ((function-definition mod name parameters body is-checked location)
     (mod-name mod))
    ((variable-definition mod name body is-checked location)
     (mod-name mod))
    ((test-definition mod name body is-checked location)
     (mod-name mod))
    ((type-definition mod name parameters body is-checked location)
     (mod-name mod))
    ((algebraic-type-definition mod name type-constructor data-constructors is-checked location)
     (mod-name mod))
    ((opaque-type-definition mod name type-constructor representation-type interface-entries is-checked location)
     (mod-name mod))))

(claim definition-name (-> definition-t symbol-t))
(define (definition-name definition)
  (match definition
    ((primitive-function-definition mod name arity fn is-checked location)
     name)
    ((primitive-variable-definition mod name value is-checked location)
     name)
    ((primitive-function-declaration mod name arity is-checked location)
     name)
    ((primitive-variable-declaration mod name is-checked location)
     name)
    ((function-definition mod name parameters body is-checked location)
     name)
    ((variable-definition mod name body is-checked location)
     name)
    ((test-definition mod name body is-checked location)
     name)
    ((type-definition mod name parameters body is-checked location)
     name)
    ((algebraic-type-definition mod name type-constructor data-constructors is-checked location)
     name)
    ((opaque-type-definition mod name type-constructor representation-type interface-entries is-checked location)
     name)))
