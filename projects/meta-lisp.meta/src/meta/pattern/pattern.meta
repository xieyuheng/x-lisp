(module meta)

(claim pattern-bound-names (-> exp-t (set-t symbol-t)))
(define (pattern-bound-names pattern)
  (if (var-exp? pattern)
    (set-add (var-exp-name pattern) (make-set))
    (if (data-pattern? pattern)
      (let ((args (apply-exp-args pattern)))
        (list-fold-left (lambda (s arg)
                          (set-union s (pattern-bound-names arg)))
                        (make-set) args))
      (error "unhandled pattern"))))

(claim var-pattern? (-> exp-t bool-t))
(define (var-pattern? exp)
  (var-exp? exp))

(claim var-pattern-name (-> exp-t symbol-t))
(define (var-pattern-name exp)
  (var-exp-name exp))

(claim data-pattern? (-> exp-t bool-t))
(define (data-pattern? exp)
  (if (not (apply-exp? exp))
    false
    (let ((target (apply-exp-target exp)))
      (and (or (var-exp? target)
               (qualified-var-exp? target))
           (list-every? (lambda (arg)
                          (or (var-exp? arg) (data-pattern? arg)))
                        (apply-exp-args exp))))))

(claim is-pattern? (-> exp-t bool-t))
(define (is-pattern? exp)
  (or (var-pattern? exp) (data-pattern? exp)))

(claim data-pattern-data-constructor (-> mod-t exp-t data-constructor-t))
(define (data-pattern-data-constructor mod exp)
  (if (not (data-pattern? exp))
    (error "[data-pattern-data-constructor] not a data pattern")
    (let ((target (apply-exp-target exp)))
      (match target
        ((var-exp name location)
         (let ((dcs (mod-data-constructors mod)))
           (if (hash-has? name dcs)
             (hash-get name dcs)
             (error (@string
                      "[data-pattern-data-constructor] undefined target name"
                      "\n  name: " (symbol-to-string name))))))
        ((qualified-var-exp mod-name name location)
         (match (project-lookup-mod (mod-project mod) mod-name)
           ((just found-mod)
            (let ((dcs (mod-data-constructors found-mod)))
              (if (hash-has? name dcs)
                (hash-get name dcs)
                (error (@string
                         "[data-pattern-data-constructor] undefined target name"
                         "\n  name: " (symbol-to-string name))))))
           ((nothing)
            (error (@string
                     "[data-pattern-data-constructor] undefined mod"
                     "\n  mod: " (symbol-to-string mod-name))))))))))
