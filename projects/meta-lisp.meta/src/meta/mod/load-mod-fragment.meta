(module meta)

(define (load-mod-fragment path)
  (= code (fs-read path))
  (= sexps (parse-located-sexps path code))
  (= stmts (list-map parse-stmt sexps))
  (= module-stmt
     (pipe stmts
       (list-find
        (lambda (stmt)
          (or (declare-module-stmt? stmt)
              (declare-error-module-stmt? stmt))))))
  (match module-stmt
    ((just (declare-module-stmt name location))
     (make-mod-fragment name false stmts))
    ((just (declare-error-module-stmt name location))
     (make-mod-fragment name true stmts))
    ((nothing)
     (error "(load-mod-fragment) expect (module) statement in fragment"))))
