(module meta)

(claim mod-fragment-names (-> mod-fragment-t (set-t symbol-t)))
(define (mod-fragment-names fragment)
  (collect-names-from-stmts (mod-fragment-stmts fragment) (make-set)))

(claim collect-names-from-stmts (-> (list-t stmt-t) (set-t symbol-t) (set-t symbol-t)))
(define (collect-names-from-stmts stmts names)
  (if (list-empty? stmts)
    names
    (let ((head (list-head stmts))
          (tail (list-tail stmts)))
      (let ((new-names (collect-name-from-stmt head names)))
        (collect-names-from-stmts tail new-names)))))

(claim collect-name-from-stmt (-> stmt-t (set-t symbol-t) (set-t symbol-t)))
(define (collect-name-from-stmt stmt names)
  (match stmt
    ((define-function-stmt name parameters body location)
     (set-add 'name names))
    ((define-variable-stmt name body location)
     (set-add name names))
    ((define-test-stmt name body location)
     (set-add name names))
    ((define-type-stmt name parameters body location)
     (set-add name names))
    ((claim-stmt name type location)
     (set-add name names))
    ((claim-type-stmt name location)
     (set-add name names))
    ((admit-stmt name type location)
     (set-add name names))
    ((declare-primitive-function-stmt name arity location)
     (set-add name names))
    ((declare-primitive-variable-stmt name location)
     (set-add name names))
    ((define-enum-stmt type-constructor data-constructors location)
     (set-add (type-constructor-name type-constructor) names))
    ((define-algebraic-type-stmt type-constructor data-constructors location)
     (set-add (type-constructor-name type-constructor) names))
    ((define-struct-stmt type-constructor fields location)
     (set-add (type-constructor-name type-constructor) names))
    ((define-struct-star-stmt type-constructor data-constructor location)
     (set-add (type-constructor-name type-constructor) names))
    ((define-record-type-stmt type-constructor data-constructor location)
     (set-add (type-constructor-name type-constructor) names))
    ((define-opaque-type-stmt name parameters representation-type interface-entries location)
     (set-add name names))
    (else names))
  )
