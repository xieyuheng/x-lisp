(module meta)

(define-struct* mod-t
  (cons-mod
   (name symbol-t)
   (stmts (list-t stmt-t))
   (admitted (set-t symbol-t))
   (definitions (hash-t symbol-t definition-t))
   (claimed (hash-t symbol-t claim-entry-t))
   (opaque-claimed (hash-t symbol-t exp-t))
   (inferred-types (hash-t symbol-t type-t))
   (data-constructors (hash-t symbol-t data-constructor-t))
   (project project-t)))

(define-struct claim-entry-t
  (exp exp-t)
  (type (maybe-t type-t)))

(define (make-mod name project)
  (cons-mod name [] (make-set) (make-hash) (make-hash) (make-hash) (make-hash) (make-hash) project))

(claim mod-put-definition! (-> symbol-t definition-t mod-t void-t))
(define (mod-put-definition! name definition mod)
  (hash-put! name definition (mod-definitions mod))
  void)

(claim mod-lookup-definition (-> mod-t symbol-t (maybe-t definition-t)))
(define (mod-lookup-definition mod name)
  (let ((definitions (mod-definitions mod)))
    (if (hash-has? name definitions)
      (just (hash-get name definitions))
      (nothing))))

(claim mod-lookup-claimed-type (-> mod-t symbol-t (maybe-t type-t)))
(define (mod-lookup-claimed-type mod name)
  (let ((claimed (mod-claimed mod)))
    (if (hash-has? name claimed)
      (let ((entry (hash-get name claimed)))
        (claim-entry-type entry))
      (nothing))))

(claim mod-lookup-claimed-entry (-> mod-t symbol-t (maybe-t claim-entry-t)))
(define (mod-lookup-claimed-entry mod name)
  (let ((claimed (mod-claimed mod)))
    (if (hash-has? name claimed)
      (just (hash-get name claimed))
      (nothing))))

(claim mod-lookup-inferred-type (-> mod-t symbol-t (maybe-t type-t)))
(define (mod-lookup-inferred-type mod name)
  (let ((inferred (mod-inferred-types mod)))
    (if (hash-has? name inferred)
      (just (hash-get name inferred))
      (nothing))))

(claim mod-claim (-> mod-t symbol-t exp-t void-t))
(define (mod-claim mod name exp)
  (let ((claimed (mod-claimed mod)))
    (if (hash-has? name claimed)
      (error (@string
               "[mod-claim] name already claimed"
               "\n  name: " (symbol-to-string name)))
      (hash-put! name (make-claim-entry exp (nothing)) claimed)))
  void)

(claim mod-define (-> mod-t symbol-t definition-t void-t))
(define (mod-define mod name definition)
  (let ((definitions (mod-definitions mod)))
    (if (hash-has? name definitions)
      (error (@string
               "[mod-define] name already defined"
               "\n  name: " (symbol-to-string name)))
      (hash-put! name definition definitions)))
  void)

(claim mod-put-inferred-type! (-> mod-t symbol-t type-t void-t))
(define (mod-put-inferred-type! mod name type)
  (hash-put! name type (mod-inferred-types mod))
  void)
