(module meta)

(claim term-traverse (-> (-> term-t term-t) term-t term-t))
(define (term-traverse f term)
  (match term
    ((symbol-term content location) term)
    ((keyword-term content location) term)
    ((string-term content location) term)
    ((int-term content location) term)
    ((float-term content location) term)
    ((var-term name location) term)
    ((qualified-var-term mod-name name location) term)
    ((quote-term sterm location) term)
    ((lambda-term parameters body location)
     (lambda-term parameters (f body) location))
    ((polymorphic-term parameters body location)
     (polymorphic-term parameters (f body) location))
    ((apply-term target args location)
     (apply-term (f target)
                (list-map f args)
                location))
    ((pipe-term target steps location)
     (pipe-term (f target)
               (list-map f steps)
               location))
    ((chain-term steps location)
     (chain-term (list-map f steps) location))
    ((compose-term steps location)
     (compose-term (list-map f steps) location))
    ((let1-term name rhs body location)
     (let1-term name (f rhs) (f body) location))
    ((let-term bindings body location)
     (let-term (list-map (lambda (b)
                          (make-binding (binding-name b) (f (binding-rhs b)) (binding-location b)))
                        bindings)
              (f body)
              location))
    ((let-star-term bindings body location)
     (let-star-term (list-map (lambda (b)
                               (make-binding (binding-name b) (f (binding-rhs b)) (binding-location b)))
                             bindings)
                   (f body)
                   location))
    ((letrec-term bindings body location)
     (letrec-term (list-map (lambda (b)
                             (make-binding (binding-name b) (f (binding-rhs b)) (binding-location b)))
                           bindings)
                 (f body)
                 location))
    ((local-define-term name parameters body location)
     (local-define-term name parameters (f body) location))
    ((letrec-star-term bindings body location)
     (letrec-star-term (list-map (lambda (b)
                                  (make-binding (binding-name b) (f (binding-rhs b)) (binding-location b)))
                                bindings)
                      (f body)
                      location))
    ((begin1-term head body location)
     (begin1-term (f head) (f body) location))
    ((begin-term sequence location)
     (begin-term (list-map f sequence) location))
    ((assign-term name rhs location)
     (assign-term name (f rhs) location))
    ((when-term condition consequent location)
     (when-term (f condition) (f consequent) location))
    ((unless-term condition alternative location)
     (unless-term (f condition) (f alternative) location))
    ((and-term terms location)
     (and-term (list-map f terms) location))
    ((or-term terms location)
     (or-term (list-map f terms) location))
    ((cond-term clauses location)
     (cond-term (list-map (lambda (clause)
                           (make-cond-clause (f (cond-clause-question clause))
                                             (f (cond-clause-answer clause))
                                             (cond-clause-location clause)))
                         clauses)
               location))
    ((if-term condition consequent alternative location)
     (if-term (f condition) (f consequent) (f alternative) location))
    ((list-term elements location)
     (list-term (list-map f elements) location))
    ((set-term elements location)
     (set-term (list-map f elements) location))
    ((hash-term entries location)
     (hash-term (list-map (lambda (entry)
                           (make-hash-entry (f (hash-entry-key entry))
                                            (f (hash-entry-value entry))))
                         entries)
               location))
    ((arrow-term arg-types ret-type location)
     (arrow-term (list-map f arg-types) (f ret-type) location))
    ((the-term type term2 location)
     (the-term (f type) (f term2) location))))
