(module meta)

(define-struct* project-t
  (cons-project
   (root-directory string-t)
   (config project-config-t)
   (fragments (hash-t string-t mod-fragment-t))))

(define (make-project root-directory config)
  (cons-project root-directory config (make-hash)))

(define (project-put-fragment! path fragment project)
  (hash-put! path fragment (project-fragments project)))

(define (project-source-directory project)
  (path-join
    (project-root-directory project)
    (build-config-source-directory (project-config-build (project-config project)))))
