(module meta)

(define (parse-project-config path string)
  (= sexps (parse-sexps path string))
  (parse-project-config-from-sexp (car sexps)))

(define (parse-build-config sexp)
  (= elements (list-sexp-elements sexp))
  (= hash (sexp-collect-key-value-hash elements))
  (make-build-config
    (string-sexp-content (hash-get :source-directory hash))
    (string-sexp-content (hash-get :output-directory hash))
    (string-sexp-content (hash-get :snapshot-directory hash))))

(define (parse-project-config-from-sexp sexp)
  (= elements (list-sexp-elements sexp))
  (= hash (sexp-collect-key-value-hash elements))
  (make-project-config
    (string-sexp-content (hash-get :name hash))
    (string-sexp-content (hash-get :version hash))
    (parse-build-config (hash-get :build hash))))
