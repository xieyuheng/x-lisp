(module meta)

(define (parse-project-config path string)
  (= json (parse-json string))
  (= entries (json-object-entries json))
  (make-project-config
    (json-string-value (hash-get "name" entries))
    (json-string-value (hash-get "version" entries))
    (parse-build-config (hash-get "build" entries))))

(define (parse-build-config json-value)
  (= entries (json-object-entries json-value))
  (make-build-config
    (json-string-value (hash-get "source-directory" entries))
    (json-string-value (hash-get "output-directory" entries))
    (json-string-value (hash-get "snapshot-directory" entries))))
