(module meta)

(define (project-dump-fragments project tag)
  (let ((config (meta-sexp-config))
        (width 80))
    (pipe (project-fragments project)
      (hash-each
       (lambda (path fragment)
         (= name (string-concat
                  [(symbol-to-string (mod-fragment-mod-name fragment))
                   "." (int-to-string (mod-fragment-serial-number fragment))]))
         (= stmts-code (format-fragment-stmts (mod-fragment-stmts fragment)))
         (= code (ppml/pretty-sexp-by-format (lambda (s) s) config width stmts-code))
         (= out-dir (path-join
                     (project-root-directory project)
                     (path-join (build-config-output-directory
                                 (project-config-build (project-config project)))
                                "dump")))
         (= frag-dir (path-join out-dir "fragments"))
         (= dump-path (string-concat [frag-dir "/" name "." tag ".dump"]))
         (fs-ensure-directory frag-dir)
         (fs-write dump-path (string-concat [";; " path "\n\n" code]))
         (println (string-concat
                   ["[" tag "] "
                    (path-relative-to-cwd dump-path)])))))))
