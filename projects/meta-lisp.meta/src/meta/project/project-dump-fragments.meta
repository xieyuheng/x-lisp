(module meta)

(define (project-dump-fragments project tag)
  (= width 80)
  (pipe (project-fragments project)
    (hash-each
      (lambda (path fragment)
        (= source-dir (project-source-directory project))
        (= name (path-relative source-dir path))
        (= code (pretty-fragment-stmts width (mod-fragment-stmts fragment)))
        (= out-dir (path-join
                     (project-root-directory project)
                     (path-join (build-config-output-directory
                                  (project-config-build (project-config project)))
                                "dump")))
        (= frag-dir (path-join out-dir "fragments"))
        (= dump-path (path-join frag-dir (@string name "." tag ".dump")))
        (= dump-dir (path-join dump-path ".."))
        (fs-ensure-directory dump-dir)
        (fs-write dump-path code)))))
