(module meta)

(define (project-load-fragments project directory)
  (= counters (make-hash))
  (pipe (fs-list-recursive directory)
    (list-each
     (lambda (name)
       (when (string-ends-with? ".meta" name)
         (= path (path-join directory name))
         (= fragment (load-mod-fragment path))
         (= mod-name (mod-fragment-mod-name fragment))
         (= count (if (hash-has? mod-name counters)
                      (hash-get mod-name counters)
                      0))
         (hash-put! mod-name (iadd count 1) counters)
         (mod-fragment-put-serial-number! count fragment)
         (project-put-fragment! path fragment project))))))
