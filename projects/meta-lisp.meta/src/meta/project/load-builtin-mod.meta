(module meta)

(define (load-builtin-mod project)
  (= root-directory (project-root-directory project))
  (= builtin-path (path-join root-directory "../meta-builtin.meta/src"))
  (= mod-name 'builtin)
  (match (project-lookup-mod project mod-name)
    ((just found) found)
    ((nothing)
     (= mod (make-new-mod mod-name project))
     (project-put-mod! mod-name mod project)
     (type-builtin mod)
     (project-load-fragments project builtin-path)
     mod)))
