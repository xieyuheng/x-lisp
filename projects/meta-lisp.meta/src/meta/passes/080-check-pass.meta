(module meta)

(define (check-pass project options)
  (hash-each-value
    (lambda (mod)
      (hash-each-value
        (lambda (definition)
          (definition-check mod definition))
        (mod-definitions mod)))
    (project-mods project))
  (when (hash-has? 'dump options)
    (project-dump-mods project "080-check")))
