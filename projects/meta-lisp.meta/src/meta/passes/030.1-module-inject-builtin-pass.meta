(module meta)

(define (no-location)
  (make-source-location
    ""
    (make-source-span
      (make-source-position 0 0 0)
      (make-source-position 0 0 0))))

(define (module-inject-builtin-pass project)
  (hash-each
    (lambda (path fragment)
      (unless (equal? (mod-fragment-mod-name fragment) 'builtin)
        (let ((stmts (mod-fragment-stmts fragment)))
          (mod-fragment-put-stmts!
            (cons (import-all-stmt 'builtin (no-location)) stmts)
            fragment))))
    (project-fragments project))
  void)
