(module meta)

(define (qualify-pass project options)
  (hash-each
    (lambda (mod-name mod)
      (hash-each
        (lambda (name definition)
          (mod-put-definition! name
            (qualify-definition definition)
            mod))
        (mod-definitions mod)))
    (project-mods project))
  (when (hash-has? 'dump options)
    (project-dump-mods project "070-qualify")))

(define (qualify-definition definition)
  (match definition
    ((primitive-function-declaration mod name arity is-checked location)
     definition)
    ((primitive-variable-declaration mod name is-checked location)
     definition)
    ((primitive-function-definition mod name arity fn is-checked location)
     definition)
    ((primitive-variable-definition mod name value is-checked location)
     definition)
    ((function-definition mod name parameters body is-checked location)
     (function-definition mod name parameters
       (qualify-free-var mod
         (list-fold-left (lambda (s p) (set-add p s)) (make-set) parameters)
         body)
       is-checked location))
    ((variable-definition mod name body is-checked location)
     (variable-definition mod name
       (qualify-free-var mod (make-set) body)
       is-checked location))
    ((test-definition mod name body is-checked location)
     (test-definition mod name
       (qualify-free-var mod (make-set) body)
       is-checked location))
    ((type-definition mod name parameters body is-checked location)
     (type-definition mod name parameters
       (qualify-free-var mod
         (list-fold-left (lambda (s p) (set-add p s)) (make-set) parameters)
         body)
       is-checked location))
    ((algebraic-type-definition mod name type-constructor data-constructors is-checked location)
     (let ((bound-names (list-fold-left
                          (lambda (s p) (set-add p s))
                          (make-set)
                          (type-constructor-parameters type-constructor))))
       (algebraic-type-definition mod name type-constructor
         (list-map (lambda (ctor)
                     (make-data-constructor
                       (data-constructor-mod ctor)
                       (data-constructor-type-name ctor)
                       (data-constructor-name ctor)
                       (list-map (lambda (field)
                                   (make-data-field
                                     (data-field-name field)
                                     (qualify-free-var mod bound-names (data-field-type field))
                                     (data-field-location field)))
                                 (data-constructor-fields ctor))
                       (data-constructor-location ctor)))
                   data-constructors)
         is-checked location)))
    ((opaque-type-definition mod name type-constructor representation-type interface-entries is-checked location)
     (let ((bound-names (list-fold-left
                          (lambda (s p) (set-add p s))
                          (make-set)
                          (type-constructor-parameters type-constructor))))
       (opaque-type-definition mod name type-constructor
         (qualify-free-var mod bound-names representation-type)
         (list-map (lambda (entry)
                     (make-interface-entry
                       (interface-entry-name entry)
                       (qualify-free-var mod bound-names (interface-entry-type entry))
                       (interface-entry-location entry)))
                   interface-entries)
         is-checked location)))))

(define (qualify-free-var mod bound-names exp)
  (match exp
    ((var-exp name location)
     (if (set-member? name bound-names)
       exp
       (qualified-var-exp (mod-name mod) name location)))
    ((lambda-exp parameters body location)
     (lambda-exp parameters
       (qualify-free-var mod
         (set-union bound-names
           (list-fold-left (lambda (s p) (set-add p s)) (make-set) parameters))
         body)
       location))
    ((polymorphic-exp parameters body location)
     (polymorphic-exp parameters
       (qualify-free-var mod
         (set-union bound-names
           (list-fold-left (lambda (s p) (set-add p s)) (make-set) parameters))
         body)
       location))
    ((let1-exp name rhs body location)
     (let1-exp name
       (qualify-free-var mod bound-names rhs)
       (qualify-free-var mod (set-add name bound-names) body)
       location))
    (else
      (exp-traverse (lambda (child) (qualify-free-var mod bound-names child)) exp))))
