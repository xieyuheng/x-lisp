(module meta)

(claim set-union-many (-> (list-t (set-t symbol-t)) (set-t symbol-t)))
(define (set-union-many sets)
  (list-fold-left set-union (make-set) sets))

(claim collect-defined-names (-> project-t (hash-t symbol-t (set-t symbol-t))))
(define (collect-defined-names project)
  (let ((result (make-hash)))
    (hash-each
      (lambda (path fragment)
        (let ((mod-name (mod-fragment-mod-name fragment))
              (names (mod-fragment-names fragment)))
          (if (hash-has? mod-name result)
            (hash-put! mod-name
              (set-union (hash-get mod-name result) names)
              result)
            (hash-put! mod-name names result))))
      (project-fragments project))
    result))

(claim collect-private-names (-> project-t (hash-t symbol-t (set-t symbol-t))))
(define (collect-private-names project)
  (let ((result (make-hash)))
    (hash-each
      (lambda (path fragment)
        (let ((mod-name (mod-fragment-mod-name fragment))
              (names (collect-private-names-from-stmts (mod-fragment-stmts fragment))))
          (if (hash-has? mod-name result)
            (hash-put! mod-name
              (set-union (hash-get mod-name result) names)
              result)
            (hash-put! mod-name names result))))
      (project-fragments project))
    result))

(define (collect-private-names-from-stmts stmts)
  (collect-private-names-loop stmts (make-set)))

(claim collect-private-names-loop (-> (list-t stmt-t) (set-t symbol-t) (set-t symbol-t)))
(define (collect-private-names-loop stmts names)
  (if (list-empty? stmts)
    names
    (let ((head (list-head stmts))
          (tail (list-tail stmts)))
      (let ((new-names (collect-private-name-from-stmt head names)))
        (collect-private-names-loop tail new-names)))))

(claim collect-private-name-from-stmt (-> stmt-t (set-t symbol-t) (set-t symbol-t)))
(define (collect-private-name-from-stmt stmt names)
  (if (private-stmt? stmt)
    (list-fold-left (lambda (s n) (set-add n s)) names (private-stmt-names stmt))
    names))

(claim ensure-mod-exists (-> project-t symbol-t source-location-t bool-t))
(define (ensure-mod-exists project mod-name location)
  (let ((found (list-find (lambda (f)
                            (equal? (mod-fragment-mod-name f) mod-name))
                          (hash-values (project-fragments project)))))
    (if (nothing? found)
      (let ((msg (string-concat ["undefined module: " (symbol-to-string mod-name)])))
        (writeln (format-message-with-source-location msg location))
        false)
      true)))

(claim execute-import
  (-> project-t
      (hash-t symbol-t (set-t symbol-t))
      (hash-t symbol-t (set-t symbol-t))
      symbol-t
      fragment-scope-t
      stmt-t
      fragment-scope-t))
(define (execute-import project defined-names private-names current-mod-name scope stmt)
  (match stmt
    ((import-stmt mod-name names location)
     (if (ensure-mod-exists project mod-name location)
       (let ((privates (if (hash-has? mod-name private-names)
                          (hash-get mod-name private-names)
                          (make-set))))
         (execute-import-names scope mod-name names privates))
       scope))
    ((import-as-stmt mod-name prefix location)
     (if (ensure-mod-exists project mod-name location)
       (begin
         (hash-put! prefix
           (make-prefix-entry mod-name)
           (fragment-scope-imported-prefixes scope))
         scope)
       scope))
    ((import-all-stmt mod-name location)
     (if (ensure-mod-exists project mod-name location)
       (let ((names (if (hash-has? mod-name defined-names)
                       (hash-get mod-name defined-names)
                       (make-set)))
             (privates (if (hash-has? mod-name private-names)
                          (hash-get mod-name private-names)
                          (make-set)))
             (current-names (if (hash-has? current-mod-name defined-names)
                               (hash-get current-mod-name defined-names)
                               (make-set))))
         (import-all-scope scope mod-name names privates current-names))
       scope))
    (else scope)))

(define (execute-import-names scope mod-name names privates)
  (if (list-empty? names)
    scope
    (let ((name (list-head names))
          (rest (list-tail names)))
      (if (set-member? name privates)
        (execute-import-names scope mod-name rest privates)
        (begin
          (hash-put! name
            (make-qualified-name-entry mod-name name)
            (fragment-scope-imported-names scope))
          (execute-import-names scope mod-name rest privates))))))

(define (import-all-scope scope mod-name names privates current-names)
  (let ((names-list (set-to-list names)))
    (import-all-scope-loop scope mod-name names-list privates current-names)))

(define (import-all-scope-loop scope mod-name names-list privates current-names)
  (if (list-empty? names-list)
    scope
    (let ((name (list-head names-list))
          (rest (list-tail names-list)))
      (if (or (set-member? name privates)
              (set-member? name current-names))
        (import-all-scope-loop scope mod-name rest privates current-names)
        (begin
          (hash-put! name
            (make-qualified-name-entry mod-name name)
            (fragment-scope-imported-names scope))
          (import-all-scope-loop scope mod-name rest privates current-names))))))

(claim module-analysis-pass (-> project-t mod-info-t))
(define (module-analysis-pass project)
  (let ((defined-names (collect-defined-names project))
        (private-names (collect-private-names project))
        (scopes (make-hash)))
    (hash-each
      (lambda (path fragment)
        (let ((scope (make-fragment-scope (make-hash) (make-hash))))
          (hash-put! path scope scopes)
          (analysis-process-stmts project defined-names private-names
                                  (mod-fragment-mod-name fragment) scope
                                  (mod-fragment-stmts fragment))
          void))
      (project-fragments project))
    (make-mod-info defined-names private-names scopes)))

(define (analysis-process-stmts project defined-names private-names current-mod-name scope stmts)
  (if (list-empty? stmts)
    scope
    (let ((new-scope (execute-import project defined-names private-names
                                     current-mod-name scope
                                     (list-head stmts))))
      (analysis-process-stmts project defined-names private-names
                              current-mod-name new-scope
                              (list-tail stmts)))))
