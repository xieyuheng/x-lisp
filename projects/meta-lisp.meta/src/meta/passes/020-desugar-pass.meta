(module meta)

(claim desugar-pass (-> project-t (hash-t symbol-t bool-t) void-t))
(define (desugar-pass project options)
  (hash-each
    (lambda (path fragment)
      (mod-fragment-put-stmts!
        (list-map desugar-stmt (mod-fragment-stmts fragment))
        fragment))
    (project-fragments project))
  (if (hash-has? 'dump options)
    (project-dump-fragments project "020-desugar")
    void)
  void)

(claim create-desugar-state (-> (hash-t string-t int-t)))
(define (create-desugar-state)
  (make-hash))

(define (desugar-stmt stmt)
  (match stmt
    ((define-function-stmt name parameters body location)
     (define-function-stmt name parameters
       (desugar (create-desugar-state) body) location))
    ((define-variable-stmt name body location)
     (define-variable-stmt name
       (desugar (create-desugar-state) body) location))
    ((define-test-stmt name body location)
     (define-test-stmt name
       (desugar (create-desugar-state) body) location))
    ((define-type-stmt name parameters body location)
     (define-type-stmt name parameters
       (desugar (create-desugar-state) body) location))
    ((claim-stmt name type location)
     (claim-stmt name
       (desugar (create-desugar-state) type) location))
    ((admit-stmt name type location)
     (admit-stmt name
       (desugar (create-desugar-state) type) location))
    ((define-algebraic-type-stmt type-constructor data-constructors location)
     (define-algebraic-type-stmt type-constructor
       (list-map (lambda (ctor)
                   (make-algebraic-type-constructor
                     (algebraic-type-constructor-name ctor)
                     (list-map (lambda (field)
                                 (make-algebraic-type-field
                                   (algebraic-type-field-name field)
                                   (desugar (create-desugar-state)
                                     (algebraic-type-field-type field))
                                   (algebraic-type-field-accessor-name field)
                                   (algebraic-type-field-modifier-name field)
                                   (algebraic-type-field-location field)))
                               (algebraic-type-constructor-fields ctor))
                     (algebraic-type-constructor-predicate ctor)
                     (algebraic-type-constructor-location ctor)))
                 data-constructors)
       location))
    (else stmt)))

(claim desugar (-> (hash-t string-t int-t) exp-t exp-t))
(define (desugar state exp)
  (match exp
    ((begin-exp sequence location)
     (desugar state (desugar-begin sequence location)))
    ((assign-exp name rhs location)
     (error "unexpected (=) outside (begin)"))
    ((local-define-exp name parameters body location)
     (error "unexpected local (define) outside (begin)"))
    ((when-exp condition consequent location)
     (if-exp (desugar state condition)
             (begin1-exp (desugar state consequent)
                         (qualified-var-exp 'builtin 'void location)
                         location)
             (qualified-var-exp 'builtin 'void location)
             location))
    ((unless-exp condition alternative location)
     (if-exp (desugar state condition)
             (qualified-var-exp 'builtin 'void location)
             (begin1-exp (desugar state alternative)
                         (qualified-var-exp 'builtin 'void location)
                         location)
             location))
    ((and-exp exps location)
     (desugar state (desugar-and exps location)))
    ((or-exp exps location)
     (desugar state (desugar-or exps location)))
    ((cond-exp clauses location)
     (desugar state (desugar-cond clauses location)))
    ((literal-list-exp elements location)
     (desugar state (desugar-list elements location)))
    ((literal-set-exp elements location)
     (desugar state (desugar-set elements location)))
    ((literal-hash-exp entries location)
     (desugar state (desugar-hash entries location)))
    ((quote-exp sexp location)
     (desugar state (desugar-quote sexp location)))
    ((pipe-exp target steps location)
     (desugar state (desugar-pipe target steps location)))
    ((chain-exp steps location)
     (desugar state (desugar-chain steps location)))
    ((compose-exp steps location)
     (desugar state (desugar-compose steps location)))
    ((begin1-exp head body location)
     (begin1-exp (desugar state head)
                 (desugar state body)
                 location))
    ((let-star-exp bindings body location)
     (desugar state (desugar-let-star bindings body location)))
    ((letrec-exp bindings body location)
     (desugar state (desugar-letrec state bindings body location)))
    ((letrec-star-exp bindings body location)
     (desugar state (desugar-letrec-star state bindings body location)))
    ((let-exp bindings body location)
     (desugar state (desugar-let state bindings body location)))
    ((lambda-exp parameters body location)
     (lambda-exp parameters (desugar state body) location))
    ((polymorphic-exp parameters body location)
     (polymorphic-exp parameters (desugar state body) location))
    (else
     (exp-traverse (lambda (child) (desugar state child)) exp))))

(define (desugar-begin sequence location)
  (if (list-empty? sequence)
    (error "unexpected empty (begin)")
    (let* ((head (list-head sequence))
           (rest (list-tail sequence)))
      (if (local-define-exp? head)
        (let* ((defines (collect-adjacent-defines sequence))
               (remaining (list-drop (list-length defines) sequence)))
          (letrec-star-exp
            (list-map (lambda (d)
                        (let ((loc (local-define-exp-location d)))
                          (if (list-empty? (local-define-exp-parameters d))
                            (make-binding (local-define-exp-name d)
                                          (local-define-exp-body d)
                                          loc)
                            (make-binding (local-define-exp-name d)
                                          (lambda-exp (local-define-exp-parameters d)
                                                      (local-define-exp-body d)
                                                      loc)
                                          loc))))
                      defines)
            (if (list-empty? remaining)
              (qualified-var-exp 'builtin 'void location)
              (desugar-begin remaining location))
            location))
        (if (list-empty? rest)
          head
          (if (assign-exp? head)
            (let1-exp (assign-exp-name head)
                      (assign-exp-rhs head)
                      (desugar-begin rest location)
                      location)
            (begin1-exp head (desugar-begin rest location) location)))))))

(define (collect-adjacent-defines sequence)
  (if (list-empty? sequence)
    []
    (let ((head (list-head sequence)))
      (if (local-define-exp? head)
        (cons head (collect-adjacent-defines (list-tail sequence)))
        []))))

(define (desugar-let-star bindings body location)
  (if (list-empty? bindings)
    body
    (let ((binding (list-head bindings))
          (rest (list-tail bindings)))
      (let1-exp (binding-name binding)
                (binding-rhs binding)
                (desugar-let-star rest body location)
                location))))

(define (desugar-let state bindings body location)
  (if (list-empty? bindings)
    body
    (if (list-empty? (list-tail bindings))
      (let1-exp (binding-name (list-head bindings))
                (binding-rhs (list-head bindings))
                body
                location)
      (let* ((tmp-names (list-map (lambda (b)
                                    (generate-fresh-name state (binding-name b)))
                                  bindings))
             (tmp-bindings (list-map-zip (lambda (b n)
                                           (make-binding n (binding-rhs b) (binding-location b)))
                                         bindings tmp-names))
             (new-bindings (list-map-zip (lambda (b n)
                                           (make-binding (binding-name b)
                                                         (var-exp n (binding-location b))
                                                         (binding-location b)))
                                         bindings tmp-names)))
        (let-star-exp (list-append tmp-bindings new-bindings)
                      body
                      location)))))

(define (desugar-letrec state bindings body location)
  (let* ((names (list-map binding-name bindings))
         (box-get-subst (lambda (exp b)
                          (exp-naive-subst exp
                            (binding-name b)
                            (apply-exp (qualified-var-exp 'builtin 'box-get location)
                                       [(var-exp (binding-name b) (binding-location b))]
                                       location))))
         (subst-all (lambda (exp)
                      (list-fold-left box-get-subst exp bindings)))
         (new-rhss (list-map subst-all (list-map binding-rhs bindings)))
         (new-body (subst-all body))
         (let-bindings (list-map (lambda (b)
                                   (make-binding (binding-name b)
                                                 (apply-exp (qualified-var-exp 'builtin 'make-box location)
                                                            [] location)
                                                 (binding-location b)))
                                 bindings))
         (fresh-names (list-map (lambda (b)
                                  (string-to-symbol
                                    (string-concat [(symbol-to-string (binding-name b)) ".value"])))
                                bindings)))
    (let-exp let-bindings
             (let-exp (list-map-zip3 (lambda (b n r)
                                       (make-binding n r (binding-location b)))
                                     bindings fresh-names new-rhss)
                      (make-box-puts bindings fresh-names new-body location)
                      location)
             location)))

(define (desugar-letrec-star state bindings body location)
  (let* ((box-get-subst (lambda (exp b)
                          (exp-naive-subst exp
                            (binding-name b)
                            (apply-exp (qualified-var-exp 'builtin 'box-get location)
                                       [(var-exp (binding-name b) (binding-location b))]
                                       location))))
         (subst-all (lambda (exp)
                      (list-fold-left box-get-subst exp bindings)))
         (new-rhss (list-map subst-all (list-map binding-rhs bindings)))
         (new-body (subst-all body))
         (let-bindings (list-map (lambda (b)
                                   (make-binding (binding-name b)
                                                 (apply-exp (qualified-var-exp 'builtin 'make-box location)
                                                            [] location)
                                                 (binding-location b)))
                                 bindings)))
    (let-exp let-bindings
             (make-box-puts-star bindings new-rhss new-body location)
             location)))

(define (make-box-puts bindings fresh-names body location)
  (if (list-empty? bindings)
    body
    (begin1-exp (apply-exp (qualified-var-exp 'builtin 'box-put! location)
                           [(var-exp (list-head fresh-names)
                                     (binding-location (list-head bindings)))
                            (var-exp (binding-name (list-head bindings))
                                     (binding-location (list-head bindings)))]
                           location)
                (make-box-puts (list-tail bindings) (list-tail fresh-names) body location)
                location)))

(define (make-box-puts-star bindings new-rhss body location)
  (if (list-empty? bindings)
    body
    (begin1-exp (apply-exp (qualified-var-exp 'builtin 'box-put! location)
                           [(var-exp (binding-name (list-head bindings))
                                     (binding-location (list-head bindings)))
                            (list-head new-rhss)]
                           location)
                (make-box-puts-star (list-tail bindings)
                                    (list-tail new-rhss) body location)
                location)))

(define (desugar-pipe target steps location)
  (list-fold-left (lambda (result step)
                    (apply-exp step [result] location))
                  target steps))

(define (desugar-chain steps location)
  (let* ((used-names (list-fold-left (lambda (s step)
                                        (set-union s (exp-free-names (make-set) step)))
                                      (make-set) steps))
         (target-name (string-to-symbol "target"))
         (target-var (var-exp target-name location)))
    (lambda-exp [target-name]
                (pipe-exp target-var steps location)
                location)))

(define (desugar-compose steps location)
  (desugar-chain (list-reverse steps) location))

(define (desugar-and exps location)
  (if (list-empty? exps)
    (qualified-var-exp 'builtin 'true location)
    (let ((head (list-head exps))
          (rest (list-tail exps)))
      (if (list-empty? rest)
        head
        (if-exp head (desugar-and rest location)
                (qualified-var-exp 'builtin 'false location)
                location)))))

(define (desugar-or exps location)
  (if (list-empty? exps)
    (qualified-var-exp 'builtin 'false location)
    (let ((head (list-head exps))
          (rest (list-tail exps)))
      (if (list-empty? rest)
        head
        (if-exp head
                (qualified-var-exp 'builtin 'true location)
                (desugar-or rest location)
                location)))))

(define (desugar-cond clauses location)
  (if (list-empty? clauses)
    (apply-exp (qualified-var-exp 'builtin 'error location)
               [(string-exp "cond mismatch" location)]
               location)
    (let ((head (list-head clauses))
          (rest (list-tail clauses)))
      (if-exp (cond-clause-question head)
              (cond-clause-answer head)
              (desugar-cond rest location)
              location))))

(define (desugar-list elements location)
  (desugar-begin
    (cons (assign-exp 'list
                      (apply-exp (qualified-var-exp 'builtin 'make-list location)
                                 [] location)
                      location)
          (list-append
            (list-map (lambda (e)
                        (apply-exp (qualified-var-exp 'builtin 'list-push! location)
                                   [e (var-exp 'list location)]
                                   location))
                      elements)
            [(var-exp 'list location)]))
    location))

(define (desugar-set elements location)
  (desugar-begin
    (cons (assign-exp 'set
                      (apply-exp (qualified-var-exp 'builtin 'make-set location)
                                 [] location)
                      location)
          (list-append
            (list-map (lambda (e)
                        (apply-exp (qualified-var-exp 'builtin 'set-add! location)
                                   [e (var-exp 'set location)]
                                   location))
                      elements)
            [(var-exp 'set location)]))
    location))

(define (desugar-hash entries location)
  (desugar-begin
    (cons (assign-exp 'hash
                      (apply-exp (qualified-var-exp 'builtin 'make-hash location)
                                 [] location)
                      location)
          (list-append
            (list-map (lambda (entry)
                        (apply-exp (qualified-var-exp 'builtin 'hash-put! location)
                                   [(hash-entry-key entry)
                                    (hash-entry-value entry)
                                    (var-exp 'hash location)]
                                   location))
                      entries)
            [(var-exp 'hash location)]))
    location))

(define (desugar-quote sexp location)
  (match sexp
    ((symbol-sexp content loc)
     (symbol-exp content location))
    ((string-sexp content loc)
     (string-exp content location))
    ((int-sexp content loc)
     (int-exp content location))
    ((float-sexp content loc)
     (float-exp content location))
    ((keyword-sexp content loc)
     (keyword-exp content location))
    ((list-sexp elements loc)
     (literal-list-exp (list-map (lambda (e) (desugar-quote e location)) elements)
                       location))))

(define (generate-fresh-name state name)
  (let ((name-str (symbol-to-string name)))
    (if (hash-has? name-str state)
      (let ((count (iadd (hash-get name-str state) 1)))
        (hash-put! name-str count state)
        (string-to-symbol (string-concat [name-str "." (int-to-string count)])))
      (let ((count 1))
        (hash-put! name-str count state)
        (string-to-symbol (string-concat [name-str "." (int-to-string count)]))))))

(define (list-map-zip f xs ys)
  (if (list-empty? xs)
    []
    (cons (f (list-head xs) (list-head ys))
          (list-map-zip f (list-tail xs) (list-tail ys)))))

(define (list-map-zip3 f xs ys zs)
  (if (list-empty? xs)
    []
    (cons (f (list-head xs) (list-head ys) (list-head zs))
          (list-map-zip3 f (list-tail xs) (list-tail ys) (list-tail zs)))))
