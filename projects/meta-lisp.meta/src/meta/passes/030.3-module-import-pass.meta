(module meta)

(claim scope-filter-bound-names (-> fragment-scope-t (set-t symbol-t) fragment-scope-t))
(define (scope-filter-bound-names scope bound-names)
  (let ((filtered-names (make-hash)))
    (hash-each
      (lambda (name entry)
        (unless (set-member? name bound-names)
          (hash-put! name entry filtered-names)))
      (fragment-scope-imported-names scope))
    (make-fragment-scope filtered-names (fragment-scope-imported-prefixes scope))))

(claim module-import-stmt (-> fragment-scope-t stmt-t stmt-t))
(define (module-import-stmt scope stmt)
  (match stmt
    ((claim-stmt name type location)
     (claim-stmt name (module-import-exp scope type) location))
    ((admit-stmt name type location)
     (admit-stmt name (module-import-exp scope type) location))
    ((define-function-stmt name parameters body location)
     (let* ((bound (list-fold-left (lambda (s p) (set-add p s)) (make-set) parameters))
            (new-scope (scope-filter-bound-names scope bound)))
       (define-function-stmt name parameters (module-import-exp new-scope body) location)))
    ((define-variable-stmt name body location)
     (define-variable-stmt name (module-import-exp scope body) location))
    ((define-test-stmt name body location)
     (define-test-stmt name (module-import-exp scope body) location))
    ((define-type-stmt name parameters body location)
     (let* ((bound (list-fold-left (lambda (s p) (set-add p s)) (make-set) parameters))
            (new-scope (scope-filter-bound-names scope bound)))
       (define-type-stmt name parameters (module-import-exp new-scope body) location)))
    ((define-algebraic-type-stmt type-constructor data-constructors location)
     (let* ((bound (list-fold-left (lambda (s p) (set-add p s))
                                    (make-set)
                                    (type-constructor-parameters type-constructor)))
            (new-scope (scope-filter-bound-names scope bound)))
       (define-algebraic-type-stmt
         type-constructor
         (list-map (lambda (ctor)
                     (make-algebraic-type-constructor
                       (algebraic-type-constructor-name ctor)
                       (list-map (lambda (field)
                                   (make-algebraic-type-field
                                     (algebraic-type-field-name field)
                                     (module-import-exp new-scope (algebraic-type-field-type field))
                                     (algebraic-type-field-accessor-name field)
                                     (algebraic-type-field-modifier-name field)
                                     (algebraic-type-field-location field)))
                                 (algebraic-type-constructor-fields ctor))
                       (algebraic-type-constructor-predicate ctor)
                       (algebraic-type-constructor-location ctor)))
                   data-constructors)
         location)))
    ((define-opaque-type-stmt name parameters representation-type interface-entries location)
     (let* ((bound (list-fold-left (lambda (s p) (set-add p s)) (make-set) parameters))
            (new-scope (scope-filter-bound-names scope bound)))
       (define-opaque-type-stmt
         name parameters
         (module-import-exp new-scope representation-type)
         (list-map (lambda (entry)
                     (make-interface-entry
                       (interface-entry-name entry)
                       (module-import-exp new-scope (interface-entry-type entry))
                       (interface-entry-location entry)))
                   interface-entries)
         location)))
    (else stmt)))

(claim module-import-exp (-> fragment-scope-t exp-t exp-t))
(define (module-import-exp scope exp)
  (match exp
    ((var-exp name location)
     (let ((imported (fragment-scope-imported-names scope)))
       (if (hash-has? name imported)
         (let ((entry (hash-get name imported)))
           (qualified-var-exp (qualified-name-entry-mod-name entry)
                             (qualified-name-entry-name entry)
                             location))
         exp)))
    ((qualified-var-exp mod-name name location)
     (let ((prefixes (fragment-scope-imported-prefixes scope)))
       (if (hash-has? mod-name prefixes)
         (let ((entry (hash-get mod-name prefixes)))
           (qualified-var-exp (prefix-entry-mod-name entry) name location))
         exp)))
    ((lambda-exp parameters body location)
     (let* ((bound (list-fold-left (lambda (s p) (set-add p s)) (make-set) parameters))
            (new-scope (scope-filter-bound-names scope bound)))
       (lambda-exp parameters (module-import-exp new-scope body) location)))
    ((polymorphic-exp parameters body location)
     (let* ((bound (list-fold-left (lambda (s p) (set-add p s)) (make-set) parameters))
            (new-scope (scope-filter-bound-names scope bound)))
       (polymorphic-exp parameters (module-import-exp new-scope body) location)))
    ((let1-exp name rhs body location)
     (let ((new-scope (scope-filter-bound-names scope (set-add name (make-set)))))
       (let1-exp name (module-import-exp scope rhs) (module-import-exp new-scope body) location)))
    ((match-exp targets clauses location)
     (match-exp
       (list-map (lambda (t) (module-import-exp scope t)) targets)
       (list-map (lambda (clause)
                   (let* ((bound (set-union-many
                                   (list-map pattern-bound-names
                                             (match-clause-patterns clause))))
                          (new-scope (scope-filter-bound-names scope bound)))
                     (make-match-clause
                       (list-map (lambda (p) (module-import-exp new-scope p))
                                 (match-clause-patterns clause))
                       (module-import-exp new-scope (match-clause-body clause))
                       (match-clause-location clause))))
                 clauses)
       location))
    (else
      (exp-traverse (lambda (child) (module-import-exp scope child)) exp))))

(claim module-import-pass (-> project-t mod-info-t void-t))
(define (module-import-pass project info)
  (hash-each
    (lambda (path fragment)
      (if (hash-has? path (mod-info-fragment-scopes info))
        (let ((scope (hash-get path (mod-info-fragment-scopes info))))
          (mod-fragment-put-stmts!
            (list-map (lambda (stmt) (module-import-stmt scope stmt))
                      (mod-fragment-stmts fragment))
            fragment))
        (let ((msg (string-concat
                    ["[ModuleImportPass] missing scope for: " path])))
          (error msg))))
    (project-fragments project))
  void)
