(module ppml)

(claim pretty-syntax
  (-> string-t (list-t node-t) (list-t node-t)
      node-t))

(define (pretty-syntax name header body)
  (let ((head-node (indent 4 [(wrap (cons (text name) header))]))
        (body-node (if (list-is-empty body) (nil) (indent 2 [(br) (flex body)]))))
    (group [(text "(") head-node body-node (text ")")])))

(claim pretty-vertical
  (-> string-t (list-t node-t) (list-t node-t)
      node-t))

(define (pretty-vertical name header body)
  (let ((head-node (indent 4 [(wrap (cons (text name) header))]))
        (body-node (if (list-is-empty body) (nil) (indent 2 [(hard-br) (hard-flex body)]))))
    (group [(text "(") head-node body-node (text ")")])))

(claim pretty-application
  (-> (maybe-t string-t) (list-t node-t)
      node-t))

(define (pretty-application op-maybe elements)
  (if (list-is-empty elements)
    (group [(text "(") (text ")")])
    (match op-maybe
      ((just op)
       (if (int-less-or-equal (string-length op) 3)
         (let ((indentation (iadd (string-length op) 2))
                (body-node
                  (if (list-is-empty (cdr elements))
                    (car elements)
                    (group [(indent indentation [(car elements) (text " ") (flex (cdr elements))])]))))
           (group [(text "(") body-node (text ")")]))
         (let ((body-node (group [(indent 1 [(flex elements)])])))
           (group [(text "(") body-node (text ")")]))))
      ((nothing)
       (let ((body-node (group [(indent 1 [(flex elements)])])))
         (group [(text "(") body-node (text ")")]))))))

(claim pretty-list
  (-> (list-t node-t)
      node-t))

(define (pretty-list elements)
  (if (list-is-empty elements)
    (group [(text "[") (text "]")])
    (let ((body-node (group [(indent 1 [(flex elements)])])))
      (group [(text "[") body-node (text "]")]))))
