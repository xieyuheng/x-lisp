(module ppml)

(define-enum node-t
  (null-node)
  (text-node (content text-t))
  (append-node (left node-t) (right node-t))
  (indent-node (length int-t) (child node-t))
  (break-node (space text-t))
  (hard-break-node)
  (group-node (child node-t)))

(define-struct entry-t
  (indentation int-t)
  (mode symbol-t)
  (node node-t))
