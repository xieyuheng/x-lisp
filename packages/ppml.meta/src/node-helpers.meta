(module ppml)

(claim nil (-> node-t))
(define (nil)
  (null-node))

(claim text (-> text-t node-t))
(define (text s)
  (text-node s))

(claim br (-> node-t))
(define (br)
  (break-node " "))

(claim hard-br (-> node-t))
(define (hard-br)
  (hard-break-node))

(claim concat-node (-> (list-t node-t) node-t))
(define (concat-node nodes)
  (if (list-is-empty nodes)
    (null-node)
    (if (list-is-empty (list-rest nodes))
      (list-head nodes)
      (append-node (list-head nodes) (concat-node (list-rest nodes))))))

(claim group (-> (list-t node-t) node-t))
(define (group nodes)
  (group-node (concat-node nodes)))

(claim indent (-> int-t (list-t node-t) node-t))
(define (indent length nodes)
  (indent-node length (concat-node nodes)))

(claim flex (-> (list-t node-t) node-t))
(define (flex nodes)
  (if (list-is-empty nodes)
    (null-node)
    (if (list-is-empty (list-rest nodes))
      (list-head nodes)
      (append-node (list-head nodes)
        (append-node (br)
          (flex (list-rest nodes)))))))

(claim hard-flex (-> (list-t node-t) node-t))
(define (hard-flex nodes)
  (if (list-is-empty nodes)
    (null-node)
    (if (list-is-empty (list-rest nodes))
      (list-head nodes)
      (append-node (list-head nodes)
        (append-node (hard-br)
          (hard-flex (list-rest nodes)))))))

(claim wrap (-> (list-t node-t) node-t))
(define (wrap nodes)
  (letrec ((wrap-acc (lambda (acc rest)
                       (if (list-is-empty rest)
                         acc
                         (wrap-acc (group [acc (br) (list-head rest)])
                                   (list-rest rest))))))
    (if (list-is-empty nodes)
      (null-node)
      (wrap-acc (list-head nodes) (list-rest nodes)))))
