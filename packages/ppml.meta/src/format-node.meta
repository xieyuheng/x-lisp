(module ppml)

(claim format-node (-> int-t node-t text-t))
(define (format-node width node)
  (layout width 0 (@list (make-entry 0 'inline node)) ""))

(define (layout width cursor targets result)
  (if (list-is-empty targets)
    result
    (let ((target (list-head targets))
           (rest (list-rest targets))
           (indentation (entry-indentation target))
           (mode (entry-mode target))
           (node (entry-node target)))
      (match node
        ((null-node)
         (layout width cursor rest result))
        ((text-node content)
         (layout width (iadd cursor (text-length content)) rest
                 (text-append result content)))
        ((append-node left right)
         (layout width cursor
                 (cons (make-entry indentation mode left)
                       (cons (make-entry indentation mode right) rest))
                 result))
        ((indent-node length child)
         (layout width cursor
                 (cons (make-entry (iadd indentation length) mode child) rest)
                 result))
        ((break-node space)
         (if (equal mode 'inline)
           (layout width (iadd cursor (text-length space)) rest
                   (text-append result space))
           (let ((new-line (text-append "\n" (text-repeat indentation " "))))
             (layout width indentation rest
                     (text-append result new-line)))))
        ((hard-break-node)
         (let ((new-line (text-append "\n" (text-repeat indentation " "))))
           (layout width indentation rest
                   (text-append result new-line))))
        ((group-node child)
         (if (fit-inline (isub width cursor) (@list child))
           (layout width cursor
                   (cons (make-entry indentation 'inline child) rest)
                   result)
           (layout width cursor
                   (cons (make-entry indentation 'block child) rest)
                   result)))))))

(define (fit-inline width nodes)
  (fit-inline-step width 0 nodes))

(define (fit-inline-step width cursor nodes)
  (if (list-is-empty nodes)
    true
    (let ((node (list-head nodes))
           (rest (list-rest nodes)))
      (match node
        ((null-node)
         (fit-inline-step width cursor rest))
        ((text-node content)
         (let ((new-cursor (iadd cursor (text-length content))))
           (if (int-greater new-cursor width)
             false
             (fit-inline-step width new-cursor rest))))
        ((append-node left right)
         (fit-inline-step width cursor (cons left (cons right rest))))
        ((indent-node length child)
         (fit-inline-step width cursor (cons child rest)))
        ((break-node space)
         (let ((new-cursor (iadd cursor (text-length space))))
           (if (int-greater new-cursor width)
             false
             (fit-inline-step width new-cursor rest))))
        ((hard-break-node)
         false)
        ((group-node child)
         (fit-inline-step width cursor (cons child rest)))))))
