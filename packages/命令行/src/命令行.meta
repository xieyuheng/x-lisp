(模块 命令行)

(定义结构 语境型
  (参数列表 (列表型 文本型))
  (选项散列 (散列型 文本型 文本型))
  (透传列表 (列表型 文本型)))

(定义结构 路由型
  (命令 文本型)
  (名称 文本型)
  (参数名列表 (列表型 文本型))
  (选项名列表 (列表型 文本型)))

(定义结构 路由器型
  (名称 文本型)
  (版本 文本型)
  (路由列表 (列表型 路由型))
  (处理函数散列 (散列型 文本型 (-> 语境型 空型))))

(声明 新建路由器 (-> 文本型 文本型 路由器型))

(定义 (新建路由器 名称 版本)
  (作路由器 名称 版本 (作列表) (作散列)))

(声明 解析路由 (-> 文本型 路由型))

(定义 (解析路由 命令)
  (令 ((词元列表 (列表剔除 文本为空白 (文本分割 " " 命令)))
       (分隔索引 (列表查找索引 (相等 "--") 词元列表))
       (主体 (若 (整数大于等于 分隔索引 0)
               (列表截取 分隔索引 词元列表)
               词元列表))
       (名称 (首 主体))
       (剩余 (余 主体))
       (首选项索引 (列表查找索引 (文本为前缀 "--") 剩余))
       (参数数 (若 (整数大于等于 首选项索引 0)
                 首选项索引
                 (列表长度 剩余)))
       (参数名列表 (列表截取 参数数 剩余))
       (选项名列表 (列表截去 参数数 剩余)))
    (作路由 命令 名称 参数名列表 选项名列表)))

(声明 路由匹配 (-> 路由型 (列表型 文本型) 语境型))

(定义 (路由匹配 路由 参数组)
  (定义 (循环 词元列表 参数列表 选项散列 透传列表 透传中)
    (若则
      ((列表为空 词元列表)
       (作语境 参数列表 选项散列 透传列表))
      ((相等 透传中 真)
       (列表末入 (首 词元列表) 透传列表)
       (循环 (余 词元列表) 参数列表 选项散列 透传列表 真))
      ((相等 (首 词元列表) "--") ;; -- 代表后面的参数要透传
       (循环 (余 词元列表) 参数列表 选项散列 透传列表 真))
      ((文本为前缀 "-" (首 词元列表))
       (若则
         ((列表为空 (余 词元列表))
          (散列存 (首 词元列表) "" 选项散列)
          (循环 (余 词元列表) 参数列表 选项散列 透传列表 假))
         ((文本为前缀 "-" (首 (余 词元列表)))
          (散列存 (首 词元列表) "" 选项散列)
          (循环 (余 词元列表) 参数列表 选项散列 透传列表 假))
         (否则
          (散列存 (首 词元列表) (首 (余 词元列表)) 选项散列)
          (循环 (余 (余 词元列表)) 参数列表 选项散列 透传列表 假))))
      (否则
       (列表末入 (首 词元列表) 参数列表)
       (循环 (余 词元列表) 参数列表 选项散列 透传列表 假))))
  (循环 参数组 (作列表) (作散列) (作列表) 假))

(声明 定义路由 (-> 路由器型 文本型 路由器型))

(定义 (定义路由 路由器 命令)
  (令 ((路由列表 (路由器路由列表 路由器)))
    (列表末入 (解析路由 命令) 路由列表)
    (路由器存路由列表 路由列表 路由器)))

(声明 定义处理函数 (-> 路由器型 文本型 (-> 语境型 空型) 路由器型))

(定义 (定义处理函数 路由器 名称 处理函数)
  (令 ((处理函数散列 (路由器处理函数散列 路由器)))
    (散列存 名称 处理函数 处理函数散列)
    (路由器存处理函数散列 处理函数散列 路由器)))

(声明 打印名称与版本 (-> 路由器型 空型))

(定义 (打印名称与版本 路由器)
  (打印行 (文本连接 " " [(路由器名称 路由器) (路由器版本 路由器)])))

(声明 打印命令 (-> 路由器型 空型))

(定义 (打印命令 路由器)
  (打印行 "命令：")
  (列表逐项 (函 (路由)
              (打印行 (文本追加 "  " (路由命令 路由))))
    (路由器路由列表 路由器)))

(声明 路由器运行 (-> 路由器型 (列表型 文本型) 空型))

(定义 (路由器运行 路由器 参数组)
  (若 (列表为空 参数组)
    (循序
      (打印名称与版本 路由器)
      (打印命令 路由器))
    (令 ((名称 (首 参数组))
         (词元列表 (余 参数组)))
      (匹配 (列表查找 (函 (路由) (相等 (路由名称 路由) 名称))
              (路由器路由列表 路由器))
        ((有 路由)
         (匹配 (散列取或有 名称 (路由器处理函数散列 路由器))
           ((有 处理函数) (处理函数 (路由匹配 路由 词元列表)))
           ((无)
            (打印行 (文本连接 " " ["未定义处理函数：" 名称]))
            (退出 1))))
        ((无)
         (打印行 (文本连接 " " ["未知命令：" 名称]))
         (打印名称与版本 路由器)
         (打印命令 路由器))))))

(声明 参数数 (-> 语境型 整数型))

(定义 (参数数 语境)
  (列表长度 (语境参数列表 语境)))

(声明 参数取 (-> 整数型 语境型 文本型))

(定义 (参数取 序号 语境)
  (列表取 序号 (语境参数列表 语境)))

(声明 选项有 (-> 文本型 语境型 真假型))

(定义 (选项有 名称 语境)
  (散列有 名称 (语境选项散列 语境)))

(声明 选项取 (-> 文本型 语境型 文本型))

(定义 (选项取 名称 语境)
  (散列取 名称 (语境选项散列 语境)))

(声明 透传数 (-> 语境型 整数型))

(定义 (透传数 语境)
  (列表长度 (语境透传列表 语境)))

(声明 透传取 (-> 整数型 语境型 文本型))

(定义 (透传取 序号 语境)
  (列表取 序号 (语境透传列表 语境)))
