(模块 命令行)

(定义测试 解析路由测试
  (令 ((路由 (解析路由 "add x y -- add two numbers")))
    (断言相等 "add x y -- add two numbers" (路由命令 路由))
    (断言相等 "add" (路由名称 路由))
    (断言相等 ["x" "y"] (路由参数名列表 路由))
    (断言 (列表为空 (路由选项名列表 路由)))))

(定义测试 解析路由选项测试
  (令 ((路由 (解析路由 "mul --x --y -- mul two numbers")))
    (断言相等 "mul --x --y -- mul two numbers" (路由命令 路由))
    (断言相等 "mul" (路由名称 路由))
    (断言 (列表为空 (路由参数名列表 路由)))
    (断言相等 ["--x" "--y"] (路由选项名列表 路由))))

(定义测试 解析路由简单测试
  (令 ((路由 (解析路由 "hello")))
    (断言相等 "hello" (路由名称 路由))
    (断言 (列表为空 (路由参数名列表 路由)))
    (断言 (列表为空 (路由选项名列表 路由)))))

(定义测试 路由匹配参数测试
  (令 ((路由 (解析路由 "add x y"))
       (语境 (路由匹配 路由 ["1" "2"])))
    (断言相等 2 (数参数 语境))
    (断言相等 "1" (取参数 0 语境))
    (断言相等 "2" (取参数 1 语境))
    (断言 (列表为空 (语境透传列表 语境)))))

(定义测试 路由匹配选项测试
  (令 ((路由 (解析路由 "cmd --verbose --name"))
       (语境 (路由匹配 路由 ["--verbose" "--name" "hello"])))
    (断言 (有选项 "--verbose" 语境))
    (断言 (有选项 "--name" 语境))
    (断言相等 "" (取选项 "--verbose" 语境))
    (断言相等 "hello" (取选项 "--name" 语境))))

(定义测试 路由匹配透传测试
  (令 ((路由 (解析路由 "cmd"))
       (语境 (路由匹配 路由 ["--" "check" "--verbose"])))
    (断言相等 0 (数参数 语境))
    (断言相等 2 (数透传 语境))
    (断言相等 "check" (取透传 0 语境))
    (断言相等 "--verbose" (取透传 1 语境))))

(定义测试 路由匹配混合测试
  (令 ((路由 (解析路由 "run file --entry"))
       (语境 (路由匹配 路由 ["prog.x86.exe" "--entry" "main" "--" "--verbose"])))
    (断言相等 1 (数参数 语境))
    (断言相等 "prog.x86.exe" (取参数 0 语境))
    (断言 (有选项 "--entry" 语境))
    (断言相等 "main" (取选项 "--entry" 语境))
    (断言相等 1 (数透传 语境))
    (断言相等 "--verbose" (取透传 0 语境))))

(定义测试 新建路由器测试
  (令 ((路由器 (新建路由器 "test" "0.1.0")))
    (断言相等 "test" (路由器名称 路由器))
    (断言相等 "0.1.0" (路由器版本 路由器))
    (断言 (列表为空 (路由器路由列表 路由器)))))

(定义测试 定义路由测试
  (令 ((路由器 (新建路由器 "test" "0.1.0"))
       (路由器 (定义路由 路由器 "add x y"))
       (路由器 (定义路由 路由器 "sub a b")))
    (断言相等 2 (列表长度 (路由器路由列表 路由器)))))

(定义测试 路由器运行测试
  (令 ((路由器 (新建路由器 "test" "0.1.0"))
       (路由器 (定义路由 路由器 "add x y"))
       (结果 (作列表)))
    (定义处理函数 路由器 "add"
      (函 (语境)
        (列表末入 (取参数 0 语境) 结果)
        (列表末入 (取参数 1 语境) 结果)
        空))
    (路由器运行 路由器 ["add" "3" "4"])
    (断言相等 ["3" "4"] 结果)))

(定义测试 路由器运行无命令测试
  (令 ((路由器 (新建路由器 "test" "0.1.0"))
       (路由器 (定义路由 路由器 "add x y")))
    (路由器运行 路由器 [])))
