(module example)

(define-test path-test
  (assert-equal "abc\n" (path-read "src/path/file-1.txt"))

  (path-write "src/path/file-2.txt" "123\n")
  (assert-equal "123\n" (path-read "src/path/file-2.txt"))

  (path-write "src/path/file-2.txt" "abc\n")
  (assert-equal "abc\n" (path-read "src/path/file-2.txt"))

  (let ((a (list-to-array (path-list "src"))))
    (array-sort a text-compare-lexical)
    (list-each (array-to-list a) println)
    (print "\n"))

  (let ((a (list-to-array (path-list-recursive "src"))))
    (array-sort a text-compare-lexical)
    (list-each (array-to-list a) println)
    (print "\n")))
