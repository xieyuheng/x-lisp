(module local-define-even-odd)

(define-test even-odd-test
  (define (is-even n) (if (equal n 0) true (is-odd (isub n 1))))
  (define (is-odd n) (if (equal n 0) false (is-even (isub n 1))))

  (assert (is-even 0))
  (assert-not (is-even 1))
  (assert (is-even 2))
  (assert-not (is-even 3))
  (assert (is-even 4))

  (assert-not (is-odd 0))
  (assert (is-odd 1))
  (assert-not (is-odd 2))
  (assert (is-odd 3))
  (assert-not (is-odd 4)))
