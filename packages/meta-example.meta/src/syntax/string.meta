(module example)

(define-test string-test
  (assert-equal "" (@string))
  (assert-equal "a" (@string "a"))
  (assert-equal "ab" (@string "a" "b"))
  (assert-equal "abc" (@string "a" "b" "c"))
  (assert-equal "hello world" (@string "hello" " " "world"))
  (assert-equal "hello! world!" (@string "hello! " "world!")))

(define-test string-with-variable-test
  (let ((x "hello")
        (y "world"))
    (assert-equal "helloworld" (@string x y))
    (assert-equal "hello, world" (@string x ", " y))
    (assert-equal "(--hello--)" (@string "(--" x "--)"))))
