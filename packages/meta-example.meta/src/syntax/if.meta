(module example)

(define-test if-test
  (assert-equal (if true 1 2) 1)
  (assert-equal (if false 1 2) 2)

  (assert (and true true true))
  (assert (not (and true true false)))

  (assert (or false false true))
  (assert (not (or false false false))))

(define-test if-bare-true-test
  (let ((flag true))
    (assert-equal (if flag 1 2) 1)))

(define-test if-bare-false-test
  (let ((flag false))
    (assert-equal (if flag 1 2) 2)))
