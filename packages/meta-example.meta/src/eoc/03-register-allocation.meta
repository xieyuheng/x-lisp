(module example)

(define-test eoc-03-01
  ;; figure-3.1
  (let ((v 1)
         (w 42)
         (x (iadd v 7))
         (y x)
         (z (iadd x w)))
    (println (iadd z (ineg y)))))

(define-test eoc-03-02
  ;; figure-3.2
  (let ((x (random-dice))
        (y (random-dice)))
    (println (iadd (iadd x y) 42))))
