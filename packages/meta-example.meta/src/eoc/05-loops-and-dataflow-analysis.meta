(module example)

(define-test eoc-05-01
  (println 1)
  (println 2)
  (println 3)
  void)

(define-test eoc-05-02
  (let ((x (begin
             (println 1)
             (println 2)
             (println 3)
             6)))
    (begin
      (println 4)
      (println 5)
      (println 6)
      (println (iadd x x))
      void)))

(define-test eoc-05-03
  (if (begin
        (println 1)
        (println 2)
        (println 3)
        (equal 1 2))
    (begin
      (println 111))
    (begin
      (println 222))))
