(module import-meta-math)

(import meta-math/math is-even is-odd)

(define-test even-test
  (assert (is-even 0))
  (assert-not (is-even 1))
  (assert (is-even 2))
  (assert-not (is-even 3))
  (assert (is-even 4)))

(define-test odd-test
  (assert-not (is-odd 0))
  (assert (is-odd 1))
  (assert-not (is-odd 2))
  (assert (is-odd 3))
  (assert-not (is-odd 4)))
