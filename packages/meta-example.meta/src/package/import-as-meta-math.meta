(module import-as-meta-math)

(import-as meta-math/math math)

(define-test even-test
  (assert (math/even? 0))
  (assert-not (math/even? 1))
  (assert (math/even? 2))
  (assert-not (math/even? 3))
  (assert (math/even? 4)))

(define-test odd-test
  (assert-not (math/odd? 0))
  (assert (math/odd? 1))
  (assert-not (math/odd? 2))
  (assert (math/odd? 3))
  (assert-not (math/odd? 4)))
