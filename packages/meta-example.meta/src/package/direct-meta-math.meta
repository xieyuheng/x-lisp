(module direct-meta-math)

(define-test even-test
  (assert (meta-math/math/is-even 0))
  (assert-not (meta-math/math/is-even 1))
  (assert (meta-math/math/is-even 2))
  (assert-not (meta-math/math/is-even 3))
  (assert (meta-math/math/is-even 4)))

(define-test odd-test
  (assert-not (meta-math/math/is-odd 0))
  (assert (meta-math/math/is-odd 1))
  (assert-not (meta-math/math/is-odd 2))
  (assert (meta-math/math/is-odd 3))
  (assert-not (meta-math/math/is-odd 4)))
