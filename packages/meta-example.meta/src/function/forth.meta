(module example)

(claim swap
  (all (A B C)
    (-> (-> A B C) B A C)))

(define (swap f x y) (f y x))

(claim drop
  (all (A B C)
    (-> (-> A B) (-> C A B))))

(define (drop f)
  (lambda (dropped x) (f x)))

(claim dup
  (all (A B)
    (-> (-> A A B) (-> A B))))

(define (dup f)
  (lambda (x) (f x x)))

(define-test forth-test
  (let ((f (lambda (x) x))
        (square (dup imul)))
    (println (square (f 1)))
    (println (square (f 2)))
    (println (square (f 3)))
    (println (square (f 4)))))
