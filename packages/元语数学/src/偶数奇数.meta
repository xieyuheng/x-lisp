(模块 元语数学)

;; 可以推断互递归函数的类型

(定义 (为偶数 数)
  (若 (相等 数 0)
    真
    (为奇数 (整数减 数 1))))

(定义 (为奇数 数)
  (若 (相等 数 0)
    假
    (为偶数 (整数减 数 1))))

(定义测试 偶数测试
  (断言 (为偶数 0))
  (断言非 (为偶数 1))
  (断言 (为偶数 2))
  (断言非 (为偶数 3))
  (断言 (为偶数 4)))

(定义测试 奇数测试
  (断言非 (为奇数 0))
  (断言 (为奇数 1))
  (断言非 (为奇数 2))
  (断言 (为奇数 3))
  (断言非 (为奇数 4)))
