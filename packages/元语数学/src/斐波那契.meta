(模块 数学)

(声明 斐波那契 (-> 整数型 整数型))

(定义 (斐波那契 数)
  (若 (整数小于等于 数 1)
    数
    (整数加
      (斐波那契 (整数减 数 1))
      (斐波那契 (整数减 数 2)))))

(定义测试 斐波那契测试
  (断言相等 0 (斐波那契 0))
  (断言相等 1 (斐波那契 1))
  (断言相等 1 (斐波那契 2))
  (断言相等 2 (斐波那契 3))
  (断言相等 3 (斐波那契 4))
  (断言相等 5 (斐波那契 5))
  (断言相等 8 (斐波那契 6))
  (断言相等 13 (斐波那契 7))
  (断言相等 21 (斐波那契 8))
  (断言相等 34 (斐波那契 9))
  ;; 746.298ms
  (断言相等 9227465 (斐波那契 35)))
