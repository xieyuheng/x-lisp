(module meta)

(define (stmt-location stmt)
  (match stmt
    ((import-stmt pkg-name mod-names names location) location)
    ((import-as-stmt pkg-name mod-name prefix location) location)
    ((import-all-stmt pkg-name mod-name location) location)
    ((define-function-stmt name parameters body location) location)
    ((define-variable-stmt name body location) location)
    ((define-test-stmt name body location) location)
    ((define-type-stmt name parameters body location) location)
    ((define-enum-stmt type-constructor data-constructors lang location) location)
    ((define-algebraic-type-stmt type-constructor data-constructors location) location)
    ((define-struct-stmt type-constructor fields lang location) location)
    ((define-record-type-stmt type-constructor data-constructor lang location) location)
    ((define-opaque-type-stmt type-constructor representation-type interface-entries location) location)
    ((claim-stmt name type location) location)
    ((claim-type-stmt name location) location)
    ((admit-stmt name type location) location)
    ((private-stmt names location) location)
    ((exempt-stmt names location) location)
    ((declare-module-stmt name location) location)
    ((declare-primitive-function-stmt name arity location) location)
    ((declare-primitive-variable-stmt name location) location)
    ((comment-stmt sexps location) location)))
