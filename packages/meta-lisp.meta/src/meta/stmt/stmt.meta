(module meta)

(define-enum lang-t
  (en)
  (zh))

(define-enum (stmt-t E)
  (import-stmt
    (pkg-name symbol-t)
    (mod-name symbol-t)
    (names (list-t symbol-t))
    (location source-location-t))
  (import-as-stmt
    (pkg-name symbol-t)
    (mod-name symbol-t)
    (prefix symbol-t)
    (location source-location-t))
  (import-all-stmt
    (pkg-name symbol-t)
    (mod-name symbol-t)
    (location source-location-t))
  (define-function-stmt
    (name symbol-t)
    (parameters (list-t symbol-t))
    (body E)
    (location source-location-t))
  (define-variable-stmt
    (name symbol-t)
    (body E)
    (location source-location-t))
  (define-test-stmt
    (name symbol-t)
    (body E)
    (location source-location-t))
  (define-type-stmt
    (name symbol-t)
    (parameters (list-t symbol-t))
    (body E)
    (location source-location-t))
  (define-enum-stmt
    (type-constructor pre-type-constructor-t)
    (data-constructors (list-t pre-data-constructor-t))
    (lang lang-t)
    (location source-location-t))
  (define-algebraic-type-stmt
    (type-constructor pre-type-constructor-t)
    (data-constructors (list-t (explicit-data-constructor-t E)))
    (location source-location-t))
  (define-struct-stmt
    (type-constructor pre-type-constructor-t)
    (fields (list-t pre-data-field-t))
    (lang lang-t)
    (location source-location-t))
  (define-struct-star-stmt
    (type-constructor pre-type-constructor-t)
    (data-constructor pre-data-constructor-t)
    (lang lang-t)
    (location source-location-t))
  (define-record-type-stmt
    (type-constructor pre-type-constructor-t)
    (data-constructor (explicit-data-constructor-t E))
    (lang lang-t)
    (location source-location-t))
  (define-opaque-type-stmt
    (type-constructor pre-type-constructor-t)
    (representation-type E)
    (interface-entries (list-t (pre-interface-entry-t E)))
    (location source-location-t))
  (claim-stmt
    (name symbol-t)
    (type E)
    (location source-location-t))
  (claim-type-stmt
    (name symbol-t)
    (location source-location-t))
  (admit-stmt
    (name symbol-t)
    (type E)
    (location source-location-t))
  (private-stmt
    (names (list-t symbol-t))
    (location source-location-t))
  (exempt-stmt
    (names (list-t symbol-t))
    (location source-location-t))
  (declare-module-stmt
    (name symbol-t)
    (location source-location-t))
  (declare-primitive-function-stmt
    (name symbol-t)
    (arity int-t)
    (location source-location-t))
  (declare-primitive-variable-stmt
    (name symbol-t)
    (location source-location-t))
  (comment-stmt
    (sexps (list-t sexp-t))
    (location source-location-t)))

(define-struct pre-type-constructor-t
  (name symbol-t)
  (parameters (list-t symbol-t))
  (location source-location-t))

(define-struct pre-data-constructor-t
  (name symbol-t)
  (fields (list-t pre-data-field-t))
  (location source-location-t))

(define-struct pre-data-field-t
  (name symbol-t)
  (type exp-t)
  (location source-location-t))

(define-struct (pre-interface-entry-t E)
  (name symbol-t)
  (type E)
  (location source-location-t))

(define-struct (explicit-data-field-t E)
  (name symbol-t)
  (type E)
  (accessor-name symbol-t)
  (modifier-name-maybe (maybe-t symbol-t))
  (location source-location-t))

(define-struct (explicit-data-constructor-t E)
  (name symbol-t)
  (fields (list-t (explicit-data-field-t E)))
  (predicate-name symbol-t)
  (location source-location-t))
