(module meta)

(define (check-pipeline root-package)
  (= closure (package-closure-in-topological-order root-package))

  (for-list closure expand-pass)
  (for-list closure module-prelude-pass)

  (= module-reports (make-hash))
  (for-list closure
    (lambda (package)
      (hash-put! (package-id package) (module-analysis-pass package) module-reports)))

  (= algebraic-reports (make-hash))
  (for-list closure
    (lambda (package)
      (hash-put! (package-id package) (algebraic-analysis-pass package) algebraic-reports)))

  (for-list closure
    (lambda (package)
      (lower-match-pass
        (hash-get (package-id package) module-reports)
        (hash-get (package-id package) algebraic-reports)
        package)))

  (for-list closure desugar-pass)

  (for-list closure
    (lambda (package)
      (module-import-pass (hash-get (package-id package) module-reports) package)))

  (for-list closure setup-pass)
  (for-list closure claim-pass)
  (for-list closure qualify-pass)
  void)
