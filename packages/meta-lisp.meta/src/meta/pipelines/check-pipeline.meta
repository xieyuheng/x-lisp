(module meta)

(define (check-pipeline package)
  (expand-pass package)
  (module-prelude-pass package)
  (= module-analysis-report (module-analysis-pass package))
  (= algebraic-analysis-report (algebraic-analysis-pass package))
  (lower-match-pass package module-analysis-report algebraic-analysis-report)
  (desugar-pass package)
  (module-import-pass module-analysis-report package)
  (execute-pass package)
  (claim-pass package)
  (qualify-pass package)
  void)
