(module meta)

(define-struct mod-t
  (name symbol-t)
  (stmts (list-t (stmt-t exp-t)))
  (admitted (set-t symbol-t))
  (definitions (hash-t symbol-t definition-t))
  (definition-states (hash-t symbol-t definition-state-t))
  (claimed (hash-t symbol-t claimed-entry-t))
  (opaque (set-t symbol-t))
  (inferred-types (hash-t symbol-t type-t))
  (data-constructors (hash-t symbol-t data-constructor-t))
  (package package-t))

(define-enum outcome-t
  (outcome-ok)
  (outcome-error))

(define (outcome-conj outcomes)
  (if (list-every? (equal? (outcome-ok)) outcomes)
    (outcome-ok)
    (outcome-error)))

(define (outcome-disj outcomes)
  (if (list-some? (equal? (outcome-ok)) outcomes)
    (outcome-ok)
    (outcome-error)))

(define-struct definition-state-t
  (is-checked bool-t)
  (outcome outcome-t))

(define-struct claimed-entry-t
  (term term-t)
  (type (maybe-t type-t)))

(define (empty-mod name package)
  (make-mod name []
    (make-set)
    (make-hash)
    (make-hash)
    (make-hash)
    (make-set)
    (make-hash)
    (make-hash)
    package))

(claim mod-put-definition!
  (-> symbol-t definition-t mod-t
      void-t))

(define (mod-put-definition! name definition mod)
  (hash-put! name definition (mod-definitions mod))
  void)

(claim mod-lookup-definition
  (-> mod-t symbol-t
      (maybe-t definition-t)))

(define (mod-lookup-definition mod name)
  (let ((definitions (mod-definitions mod)))
    (if (hash-has? name definitions)
      (just (hash-get name definitions))
      (nothing))))

(claim mod-lookup-claimed-type
  (-> mod-t symbol-t
      (maybe-t type-t)))

(define (mod-lookup-claimed-type mod name)
  (let ((claimed (mod-claimed mod)))
    (if (hash-has? name claimed)
      (let ((entry (hash-get name claimed)))
        (claimed-entry-type entry))
      (nothing))))

(claim mod-lookup-claimed-entry
  (-> mod-t symbol-t
      (maybe-t claimed-entry-t)))

(define (mod-lookup-claimed-entry mod name)
  (let ((claimed (mod-claimed mod)))
    (if (hash-has? name claimed)
      (just (hash-get name claimed))
      (nothing))))

(claim mod-lookup-inferred-type
  (-> mod-t symbol-t
      (maybe-t type-t)))

(define (mod-lookup-inferred-type mod name)
  (let ((inferred (mod-inferred-types mod)))
    (if (hash-has? name inferred)
      (just (hash-get name inferred))
      (nothing))))

(claim mod-claim
  (-> mod-t symbol-t term-t
      void-t))

(define (mod-claim mod name term)
  (match (hash-get-maybe name (mod-claimed mod))
    ((just previous)
     (error-with-location
       (@string
         "(mod-claim) name already claimed"
         "\n  name: " (symbol-to-string name)
         "\n"
         (format-message-with-source-location "previous claim"
           (term-location (claimed-entry-term previous))))
       (term-location term)))
    ((nothing)
     (hash-put! name (make-claimed-entry term (nothing)) (mod-claimed mod))
     void)))

(claim mod-admit
  (-> mod-t symbol-t
      void-t))

(define (mod-admit mod name)
  (set-add! name (mod-admitted mod))
  void)

(claim mod-define
  (-> mod-t symbol-t definition-t
      void-t))

(define (mod-define mod name definition)
  (let ((definitions (mod-definitions mod)))
    (if (hash-has? name definitions)
      (error (@string
               "[mod-define] name already defined"
               "\n  name: " (symbol-to-string name)))
      (hash-put! name definition definitions)))
  void)

(claim mod-put-inferred-type!
  (-> mod-t symbol-t type-t
      void-t))

(define (mod-put-inferred-type! mod name type)
  (hash-put! name type (mod-inferred-types mod))
  void)

(claim mod-is-checked
  (-> mod-t symbol-t
      bool-t))

(define (mod-is-checked mod name)
  (let ((states (mod-definition-states mod)))
    (if (hash-has? name states)
      (definition-state-is-checked (hash-get name states))
      false)))

(claim mod-mark-checked!
  (-> mod-t symbol-t
      void-t))

(define (mod-mark-checked! mod name)
  (hash-put! name (make-definition-state true (outcome-ok)) (mod-definition-states mod))
  void)

(claim mod-outcome
  (-> mod-t symbol-t
      outcome-t))

(define (mod-outcome mod name)
  (let ((states (mod-definition-states mod)))
    (if (hash-has? name states)
      (definition-state-outcome (hash-get name states))
      (outcome-ok))))

(claim mod-mark-outcome!
  (-> mod-t symbol-t outcome-t
      void-t))

(define (mod-mark-outcome! mod name value)
  (let ((states (mod-definition-states mod)))
    (if (hash-has? name states)
      (let ((state (hash-get name states)))
        (hash-put! name
          (make-definition-state
            (definition-state-is-checked state)
            value)
          states))
      (hash-put! name (make-definition-state false value) states)))
  void)
