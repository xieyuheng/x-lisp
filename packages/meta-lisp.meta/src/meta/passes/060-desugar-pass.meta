(module meta)

(claim desugar-pass
  (-> package-t
      void-t))

(define (desugar-pass package)
  (for-list (package-closure-in-topological-order package)
    desugar-package)
  (when (hash-has? "dump" (package-config-compiler (package-config package)))
    (package-dump-desugared-fragments package "060-desugar")))

(claim desugar-package
  (-> package-t
      void-t))

(define (desugar-package package)
  (ignore
    (package-put-fragments!
      (hash-map-value desugar-fragment (package-fragments package))
      package)))

(claim desugar-fragment
  (-> fragment-t
      fragment-t))

(define (desugar-fragment fragment)
  (match fragment
    ((make-fragment mod-name path stmts _)
     (= desugared-stmts (list-map desugar-stmt stmts))
     (make-fragment mod-name path stmts desugared-stmts))))

(claim desugar-stmt
  (-> (stmt-t exp-t)
      (stmt-t term-t)))

(define (desugar-stmt stmt)
  (match stmt
    ((define-function-stmt name parameters body location)
     (define-function-stmt name parameters (desugar body) location))
    ((define-variable-stmt name body location)
     (define-variable-stmt name (desugar body) location))
    ((define-test-stmt name body location)
     (define-test-stmt name (desugar body) location))
    ((define-type-stmt name parameters body location)
     (define-type-stmt name parameters (desugar body) location))
    ((claim-stmt name type location)
     (claim-stmt name (desugar type) location))
    ((admit-stmt name type location)
     (admit-stmt name (desugar type) location))
    ((define-algebraic-type-stmt type-constructor data-constructors location)
     (define-algebraic-type-stmt
       type-constructor
       (list-map desugar-explicit-data-constructor data-constructors)
       location))
    ((define-opaque-type-stmt type-constructor representation-type interface-entries location)
     (define-opaque-type-stmt
       type-constructor
       (desugar representation-type)
       (list-map desugar-pre-interface-entry interface-entries)
       location))
    ;; stmts contain no exp or term — pass through
    ((import-stmt pkg-name mod-name names location)
     (import-stmt pkg-name mod-name names location))
    ((import-as-stmt pkg-name mod-name prefix location)
     (import-as-stmt pkg-name mod-name prefix location))
    ((import-all-stmt pkg-name mod-name location)
     (import-all-stmt pkg-name mod-name location))
    ((claim-type-stmt name location)
     (claim-type-stmt name location))
    ((exempt-stmt names location)
     (exempt-stmt names location))
    ((private-stmt names location)
     (private-stmt names location))
    ((declare-module-stmt name location)
     (declare-module-stmt name location))
    ((declare-primitive-function-stmt name arity location)
     (declare-primitive-function-stmt name arity location))
    ((declare-primitive-variable-stmt name location)
     (declare-primitive-variable-stmt name location))
    ((comment-stmt sexps location)
     (comment-stmt sexps location))
    (else
     (error-with-location
       (@string "(desugar-stmt) unhandled stmt kind: " (format-stmt stmt))
       (stmt-location stmt)))))

(claim desugar-explicit-data-constructor
  (-> (explicit-data-constructor-t exp-t)
      (explicit-data-constructor-t term-t)))

(define (desugar-explicit-data-constructor ctor)
  (match ctor
    ((make-explicit-data-constructor name fields predicate-name location)
     (make-explicit-data-constructor
       name
       (list-map desugar-explicit-data-field fields)
       predicate-name
       location))))

(claim desugar-explicit-data-field
  (-> (explicit-data-field-t exp-t)
      (explicit-data-field-t term-t)))

(define (desugar-explicit-data-field field)
  (match field
    ((make-explicit-data-field name type accessor-name modifier-name-maybe location)
     (make-explicit-data-field
       name
       (desugar type)
       accessor-name
       modifier-name-maybe
       location))))

(claim desugar-pre-interface-entry
  (-> (pre-interface-entry-t exp-t)
      (pre-interface-entry-t term-t)))

(define (desugar-pre-interface-entry entry)
  (match entry
    ((make-pre-interface-entry name type location)
     (make-pre-interface-entry name (desugar type) location))))
