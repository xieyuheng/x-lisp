(module meta)

(claim setup-pass
  (-> package-t
      void-t))

(define (setup-pass package)
  (for-hash (package-fragments package)
    (lambda (path fragment)
      (let ((mod-name (fragment-mod-name fragment))
             (mod (maybe-else (empty-mod mod-name package) (package-lookup-mod package 'self mod-name))))
        (package-put-mod mod-name mod package)
        (for-list (fragment-desugared-stmts fragment)
          (setup-stmt mod)))))
  (when (hash-has "dump" (package-config-compiler (package-config package)))
    (package-dump-mods package "080-setup")))

(claim setup-stmt
  (-> mod-t (stmt-t term-t)
      void-t))

(define (setup-stmt mod stmt)
  (match stmt
    ((exempt-stmt names location)
     (for-list names (mod-admit mod)))
    ((claim-stmt name type location)
     (mod-claim mod name type))
    ((claim-type-stmt name location)
     (let ((type-term (make-type-term-from-parameters [] location)))
       (hash-put name (make-claimed-entry type-term (just (type-type))) (mod-claimed mod))
       void))
    ((admit-stmt name type location)
     (mod-claim mod name type)
     (mod-admit mod name))
    ((declare-primitive-function-stmt name arity location)
     (mod-define mod name
       (primitive-function-declaration mod name arity location)))
    ((declare-primitive-variable-stmt name location)
     (mod-define mod name
       (primitive-variable-declaration mod name location)))
    ((define-function-stmt name parameters body location)
     (mod-define mod name
       (function-definition mod name parameters body location)))
    ((define-variable-stmt name body location)
     (mod-define mod name
       (variable-definition mod name body location)))
    ((define-test-stmt name body location)
     (mod-define mod name
       (test-definition mod name body location)))
    ((define-type-stmt name parameters body location)
     (mod-claim mod name (make-type-term-from-parameters parameters location))
     (mod-define mod name
       (type-definition mod name parameters body location)))
    ((define-algebraic-type-stmt pre-type-constructor explicit-data-constructors location)
     (let ((name (pre-type-constructor-name pre-type-constructor))
            (type-constructor (make-type-constructor-from-pre mod pre-type-constructor))
            (parameters (type-constructor-parameters type-constructor))
            (data-constructors (list-map (make-data-constructor-from-explicit mod name) explicit-data-constructors)))
       (mod-claim mod name (make-type-term-from-parameters parameters location))
       (mod-define mod name
         (algebraic-type-definition mod name
           type-constructor
           data-constructors
           location))
       (for-list data-constructors
         (lambda (data-constructor)
           (hash-put (data-constructor-name data-constructor) data-constructor
             (mod-data-constructors mod))))))
    ((define-opaque-type-stmt pre-type-constructor representation-type pre-interface-entries location)
     (let ((name (pre-type-constructor-name pre-type-constructor))
            (type-constructor (make-type-constructor-from-pre mod pre-type-constructor))
            (parameters (type-constructor-parameters type-constructor)))
       (mod-claim mod name (make-type-term-from-parameters parameters location))
       (mod-define mod name
         (opaque-type-definition mod name type-constructor representation-type
           (list-map make-interface-entry-from-pre pre-interface-entries)
           location))
       (for-list pre-interface-entries
         (lambda (entry)
           (match entry
             ((make-pre-interface-entry name type location)
              (let ((wrapped-type (make-polymorphic-term-from-parameters parameters type location)))
                (mod-claim mod name wrapped-type)
                (set-add name (mod-opaque mod)))))))))
    (else void)))

(define (make-polymorphic-term-from-parameters parameters type location)
  (if (list-is-empty parameters)
    type
    (polymorphic-term parameters type location)))

(define (make-type-term-from-parameters parameters location)
  (let ((type-term (qualified-var-term 'meta-builtin 'builtin 'type-t location)))
    (if (list-is-empty parameters)
      type-term
      (arrow-term (list-map (constant type-term) parameters) type-term location))))

(define (make-type-constructor-from-pre mod pre-type-constructor)
  (match pre-type-constructor
    ((make-pre-type-constructor name parameters location)
     (make-type-constructor mod name parameters location))))

(define (make-data-constructor-from-explicit mod type-name explicit-data-constructor)
  (match explicit-data-constructor
    ((make-explicit-data-constructor name fields predicate-name location)
     (make-data-constructor mod type-name name
       (list-map make-data-field-from-explicit fields)
       location))))

(define (make-data-field-from-explicit field)
  (make-data-field
    (explicit-data-field-name field)
    (explicit-data-field-type field)
    (explicit-data-field-location field)))

(define (make-interface-entry-from-pre entry)
  (make-interface-entry
    (pre-interface-entry-name entry)
    (pre-interface-entry-type entry)
    (pre-interface-entry-location entry)))
