(module meta)

(claim qualify-pass
  (-> package-t
      void-t))

(define (qualify-pass package)
  (for-hash-value (package-mods package)
    (lambda (mod)
      (for-hash (mod-definitions mod)
        (lambda (name definition)
          (mod-put-definition! name
            (qualify-definition definition)
            mod)))))
  (when (hash-has "dump" (package-config-compiler (package-config package)))
    (package-dump-mods package "100-qualify")))

(claim qualify-definition
  (-> definition-t
      definition-t))

(define (qualify-definition definition)
  (match definition
    ((primitive-function-declaration mod name arity location) definition)
    ((primitive-variable-declaration mod name location) definition)
    ((function-definition mod name parameters body location)
     (function-definition mod name parameters
       (qualify-free-var mod (list-to-set parameters) body)
       location))
    ((variable-definition mod name body location)
     (variable-definition mod name
       (qualify-free-var mod (make-set) body)
       location))
    ((test-definition mod name body location)
     (test-definition mod name
       (qualify-free-var mod (make-set) body)
       location))
    ((type-definition mod name parameters body location)
     (type-definition mod name parameters
       (qualify-free-var mod (list-to-set parameters) body)
       location))
    ((algebraic-type-definition mod name type-constructor data-constructors location)
     (let ((bound-names (list-to-set (type-constructor-parameters type-constructor))))
       (algebraic-type-definition mod name type-constructor
         (list-map (qualify-data-constructor bound-names) data-constructors)
         location)))
    ((opaque-type-definition mod name type-constructor representation-type interface-entries location)
     (let ((bound-names (list-to-set (type-constructor-parameters type-constructor))))
       (opaque-type-definition mod name type-constructor
         (qualify-free-var mod bound-names representation-type)
         (list-map (qualify-interface-entry mod bound-names) interface-entries)
         location)))))

(define (qualify-data-constructor bound-names data-constructor)
  (match data-constructor
    ((make-data-constructor mod type-name name fields location)
     (make-data-constructor mod type-name name
       (list-map (qualify-data-field mod bound-names) fields)
       location))))

(define (qualify-data-field mod bound-names field)
  (match field
    ((make-data-field name type location)
     (make-data-field name (qualify-free-var mod bound-names type) location))))

(define (qualify-interface-entry mod bound-names entry)
  (match entry
    ((make-interface-entry name type location)
     (make-interface-entry name (qualify-free-var mod bound-names type) location))))

(claim qualify-free-var
  (-> mod-t (set-t symbol-t) term-t
      term-t))

(define (qualify-free-var mod bound-names term)
  (match term
    ((var-term name location)
     (if (set-is-member name bound-names)
       term
       (qualified-var-term
         (package-id (mod-package mod))
         (mod-name mod)
         name
         location)))
    ((lambda-term parameters body location)
     (lambda-term parameters
       (qualify-free-var mod (set-union bound-names (list-to-set parameters)) body)
       location))
    ((polymorphic-term parameters body location)
     (polymorphic-term parameters
       (qualify-free-var mod (set-union bound-names (list-to-set parameters)) body)
       location))
    ((let1-term name rhs body location)
     (let1-term name
       (qualify-free-var mod bound-names rhs)
       (qualify-free-var mod (set-add name bound-names) body)
       location))
    (else
     (term-traverse (qualify-free-var mod bound-names) term))))
