(module meta)

(claim lower-match-pass
  (-> module-analysis-report-t
      algebraic-analysis-report-t
      package-t
      void-t))

(define (lower-match-pass module-analysis-report algebraic-analysis-report package)
  (for-hash (package-fragments package)
    (lambda (path fragment)
      (= fragment-scopes (module-analysis-report-fragment-scopes module-analysis-report))
      (match (hash-get-maybe path fragment-scopes)
        ((nothing)
         (error-with-location
           (@string "(lower-match-pass) missing scope for: " path)
           (zero-location path)))
        ((just scope)
         (= ctx (make-desugar-match-ctx
                  scope
                  (fragment-mod-name fragment)
                  algebraic-analysis-report
                  (package-id package)))
         (fragment-put-stmts!
           (list-map (lower-match-stmt ctx) (fragment-stmts fragment))
           fragment)))))
  (when (hash-has? "dump" (package-config-compiler (package-config package)))
    (package-dump-fragments package "050-lower-match")))

(claim lower-match-stmt
  (-> desugar-match-ctx-t (stmt-t exp-t)
      (stmt-t exp-t)))

(define (lower-match-stmt ctx stmt)
  (match stmt
    ((define-function-stmt name parameters body location)
     (define-function-stmt name parameters (lower-match ctx body) location))
    ((define-variable-stmt name body location)
     (define-variable-stmt name (lower-match ctx body) location))
    ((define-test-stmt name body location)
     (define-test-stmt name (lower-match ctx body) location))
    ((define-type-stmt name parameters body location)
     (define-type-stmt name parameters (lower-match ctx body) location))
    (else stmt)))

(claim lower-match
  (-> desugar-match-ctx-t exp-t
      exp-t))

(define (lower-match ctx exp)
  (match exp
    ((match-exp targets clauses location)
     (desugar-match
       ctx
       (list-map (lower-match ctx) targets)
       (list-map (lower-match-clause ctx) clauses)
       (make-default-exp targets location)
       location))
    (else
     (exp-traverse (lower-match ctx) exp))))

(claim lower-match-clause
  (-> desugar-match-ctx-t match-clause-t
      match-clause-t))

(define (lower-match-clause ctx clause)
  (make-match-clause
    (list-map (lower-match ctx) (match-clause-patterns clause))
    (lower-match ctx (match-clause-body clause))
    (match-clause-location clause)))
