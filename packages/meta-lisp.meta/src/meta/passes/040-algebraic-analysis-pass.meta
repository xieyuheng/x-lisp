(module meta)

(define-type constructor-key-t text-t)

(define-struct data-constructor-info-t
  (pkg-name symbol-t)
  (mod-name symbol-t)
  (type-name symbol-t)
  (name symbol-t)
  (accessor-names (list-t symbol-t))
  (predicate-name symbol-t))

(define-struct algebraic-type-info-t
  (pkg-name symbol-t)
  (mod-name symbol-t)
  (name symbol-t)
  (constructor-names (list-t symbol-t)))

(define-struct algebraic-analysis-report-t
  (data-constructor-infos (hash-t text-t data-constructor-info-t))
  (algebraic-type-infos (hash-t text-t algebraic-type-info-t)))

(claim algebraic-key
  (-> symbol-t symbol-t symbol-t
      text-t))

(define (algebraic-key pkg-name mod-name name)
  (@text (symbol-to-text pkg-name) "/" (symbol-to-text mod-name) "/" (symbol-to-text name)))

(claim algebraic-analysis-pass
  (-> package-t
      algebraic-analysis-report-t))

(define (algebraic-analysis-pass package)
  (let ((report (make-algebraic-analysis-report (make-hash) (make-hash))))
    (for-hash-value (package-fragments package)
      (lambda (fragment)
        (for-list (fragment-stmts fragment)
          (algebraic-analysis-stmt report (package-id package) fragment))))
    (for-hash (package-dependencies package)
      (lambda (alias dep)
        (for-hash-value (package-fragments dep)
          (lambda (fragment)
            (for-list (fragment-stmts fragment)
              (algebraic-analysis-stmt report alias fragment))))))
    (when (hash-has "dump" (package-config-compiler (package-config package)))
      (dump-algebraic-analysis-report report package))
    report))

(claim algebraic-analysis-stmt
  (-> algebraic-analysis-report-t symbol-t fragment-t (stmt-t exp-t)
      void-t))

(define (algebraic-analysis-stmt report pkg-name fragment stmt)
  (match stmt
    ((define-algebraic-type-stmt type-constructor data-constructors location)
     (let ((type-name (pre-type-constructor-name type-constructor))
           (mod-name (fragment-mod-name fragment)))
       (for-list data-constructors
         (lambda (ctor)
           (let ((key (algebraic-key pkg-name mod-name (explicit-data-constructor-name ctor)))
                  (fields (explicit-data-constructor-fields ctor))
                  (data-constructor-info
                    (make-data-constructor-info
                      pkg-name mod-name type-name
                      (explicit-data-constructor-name ctor)
                      (list-map explicit-data-field-accessor-name fields)
                      (explicit-data-constructor-predicate-name ctor))))
             (hash-put key data-constructor-info
               (algebraic-analysis-report-data-constructor-infos report)))))
       (let ((constructor-names (list-map explicit-data-constructor-name data-constructors))
              (type-key (algebraic-key pkg-name mod-name type-name))
              (algebraic-type-info
                (make-algebraic-type-info pkg-name mod-name type-name constructor-names)))
         (hash-put type-key algebraic-type-info
           (algebraic-analysis-report-algebraic-type-infos report))
         void)))
    (else void)))

(define (dump-algebraic-analysis-report report package)
  (let ((dump-directory (path-join (package-output-directory package) "dump")))
    (path-ensure-directory dump-directory)
    (let ((dump-path (@text dump-directory "/040-algebraic-analysis-report.dump")))
      (path-ensure-file dump-path)
      (path-write dump-path (@text (format-algebraic-analysis-report report) "\n")))))

(define (format-algebraic-analysis-report report)
  (let ((lines (@list)))
    (list-push "(algebraic-analysis-report" lines)
    (list-push "  (data-constructor-infos" lines)
    (for-list (sort-entries-by-text-key (algebraic-analysis-report-data-constructor-infos report))
      (lambda (entry)
        (let ((key (pair-first entry))
              (info (pair-second entry)))
          (list-push (@text "    (\"" key "\"") lines)
          (list-push (@text "      (pkg-name " (symbol-to-text (data-constructor-info-pkg-name info)) ")") lines)
          (list-push (@text "      (mod-name " (symbol-to-text (data-constructor-info-mod-name info)) ")") lines)
          (list-push (@text "      (type-name " (symbol-to-text (data-constructor-info-type-name info)) ")") lines)
          (list-push (@text "      (name " (symbol-to-text (data-constructor-info-name info)) ")") lines)
          (list-push (@text "      (accessor-names " (text-join " " (list-map symbol-to-text (data-constructor-info-accessor-names info))) ")") lines)
          (list-push (@text "      (predicate-name " (symbol-to-text (data-constructor-info-predicate-name info)) ")") lines)
          (close-top lines))))
    (close-top lines)
    (list-push "  (algebraic-type-infos" lines)
    (for-list (sort-entries-by-text-key (algebraic-analysis-report-algebraic-type-infos report))
      (lambda (entry)
        (let ((key (pair-first entry))
              (info (pair-second entry)))
          (list-push (@text "    (\"" key "\"") lines)
          (list-push (@text "      (pkg-name " (symbol-to-text (algebraic-type-info-pkg-name info)) ")") lines)
          (list-push (@text "      (mod-name " (symbol-to-text (algebraic-type-info-mod-name info)) ")") lines)
          (list-push (@text "      (name " (symbol-to-text (algebraic-type-info-name info)) ")") lines)
          (list-push (@text "      (constructor-names " (text-join " " (list-map symbol-to-text (algebraic-type-info-constructor-names info))) ")") lines)
          (close-top lines))))
    (close-top lines)
    (close-top lines)
    (text-join "\n" lines)))
