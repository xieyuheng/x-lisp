(module meta)

(define-struct module-analysis-report-t
  (fragment-scopes (hash-t text-t fragment-scope-t))
  (outcome outcome-t))

;; - why: type aliases help us to understand the key type of hash-t.

(define-type mod-name-t symbol-t)
(define-type name-t symbol-t)
(define-type pkg-name-t symbol-t)
(define-type prefix-t symbol-t)

(define-type name-group-by-mod-t (hash-t mod-name-t (set-t name-t)))

(define-struct fragment-scope-t
  (mod-name mod-name-t)
  (imported-names (hash-t name-t qualified-name-t))
  (imported-prefixes (hash-t prefix-t qualified-prefix-t)))

(define (empty-fragment-scope mod-name)
  (make-fragment-scope mod-name (make-hash) (make-hash)))

(define-struct qualified-name-t
  (pkg-name symbol-t)
  (mod-name symbol-t)
  (name symbol-t))

(define-struct qualified-prefix-t
  (pkg-name symbol-t)
  (mod-name symbol-t))

(claim module-analysis-pass
  (-> package-t
      module-analysis-report-t))

(define (module-analysis-pass package)
  (let ((report (make-module-analysis-report (make-hash) (outcome-ok))))
    (for-hash (package-fragments package)
      (lambda (path fragment)
        (let ((scope (empty-fragment-scope (fragment-mod-name fragment))))
          (hash-put (module-analysis-report-fragment-scopes report) path scope)
          (for-list (fragment-stmts fragment)
            (lambda (stmt)
              (if (is-outcome-error (ensure-imported-mod-exists package stmt))
                (ignore (module-analysis-report-put-outcome report (outcome-error)))
                (execute-import package scope stmt)))))))
    (when (hash-has (package-config-compiler (package-config package)) "dump")
      (dump-module-analysis-report report package))
    report))

(claim collect-defined-names
  (-> package-t
      name-group-by-mod-t))

(define (collect-defined-names package)
  (collect-names-by-mod
    package
    (lambda (fragment)
      (set-to-list (fragment-names fragment)))))

(claim collect-private-names
  (-> package-t
      name-group-by-mod-t))

(define (collect-private-names package)
  (collect-names-by-mod
    package
    (lambda (fragment)
      (list-map-concat
        (fragment-stmts fragment)
        (lambda (stmt)
          (if (is-private-stmt stmt)
            (private-stmt-names stmt)
            (@list)))))))

(claim collect-names-by-mod
  (-> package-t
      (-> fragment-t (list-t name-t))
      name-group-by-mod-t))

(define (collect-names-by-mod package extract)
  (let ((result (make-hash)))
    (for-hash-value (package-fragments package)
      (lambda (fragment)
        (let ((mod-name (fragment-mod-name fragment)))
          (if (hash-has result mod-name)
            (let ((existing (hash-get result mod-name)))
              (for-list (extract fragment) (lambda (name) (set-add existing name))))
            (ignore (hash-put result mod-name (list-to-set (extract fragment))))))))
    result))

(claim lookup-package
  (-> package-t symbol-t
      package-t))

(define (lookup-package package pkg-name)
  (if (equal pkg-name 'self)
    package
    (hash-get (package-dependencies package) pkg-name)))

(claim lookup-mod-defined-names
  (-> package-t symbol-t symbol-t
      (set-t name-t)))

(define (lookup-mod-defined-names package pkg-name mod-name)
  (let ((target (lookup-package package pkg-name))
         (defined (collect-defined-names target)))
    (if (hash-has defined mod-name)
      (hash-get defined mod-name)
      (make-set))))

(claim lookup-mod-private-names
  (-> package-t symbol-t symbol-t
      (set-t name-t)))

(define (lookup-mod-private-names package pkg-name mod-name)
  (let ((target (lookup-package package pkg-name))
         (private (collect-private-names target)))
    (if (hash-has private mod-name)
      (hash-get private mod-name)
      (make-set))))

(claim lookup-mod-public-names
  (-> package-t symbol-t symbol-t
      (set-t name-t)))

(define (lookup-mod-public-names package pkg-name mod-name)
  (set-difference
    (lookup-mod-defined-names package pkg-name mod-name)
    (lookup-mod-private-names package pkg-name mod-name)))

(claim ensure-imported-mod-exists
  (-> package-t (stmt-t exp-t)
      outcome-t))

(define (ensure-imported-mod-exists package stmt)
  (match stmt
    ((import-stmt pkg-name mod-name _ location)
     (ensure-mod-exists package pkg-name mod-name location))
    ((import-as-stmt pkg-name mod-name _ location)
     (ensure-mod-exists package pkg-name mod-name location))
    ((import-all-stmt pkg-name mod-name location)
     (ensure-mod-exists package pkg-name mod-name location))
    (else (outcome-ok))))

(claim execute-import
  (-> package-t fragment-scope-t (stmt-t exp-t)
      void-t))

(define (execute-import package scope stmt)
  (match stmt
    ((import-stmt pkg-name mod-name names location)
     (let ((imported-private-names (lookup-mod-private-names package pkg-name mod-name)))
       (for-list names
         (lambda (name)
           (unless (set-has imported-private-names name)
             (hash-put (fragment-scope-imported-names scope)
               name
               (make-qualified-name pkg-name mod-name name)))))))
    ((import-as-stmt pkg-name mod-name prefix location)
     (hash-put (fragment-scope-imported-prefixes scope)
       prefix
       (make-qualified-prefix pkg-name mod-name))
     void)
    ((import-all-stmt pkg-name mod-name location)
     (let ((imported-public-names (lookup-mod-public-names package pkg-name mod-name))
           (current-defined-names (lookup-mod-defined-names package 'self (fragment-scope-mod-name scope))))
       (for-set imported-public-names
         (lambda (name)
           ;; - why: skip names already defined in the current module,
           ;;   so that local definitions can override imported ones.
           (unless (set-has current-defined-names name)
             (hash-put (fragment-scope-imported-names scope)
               name
               (make-qualified-name pkg-name mod-name name)))))))
    (else void)))

(claim ensure-mod-exists
  (-> package-t symbol-t symbol-t source-location-t
      outcome-t))

(define (ensure-mod-exists package pkg-name mod-name location)
  (if (equal pkg-name 'self)
    (if (not (has-fragment-of-mod-name (hash-values (package-fragments package)) mod-name))
      (let ((message (@text "undefined module: " (symbol-to-text mod-name))))
        (println (format-message-with-location message location))
        (outcome-error))
      (outcome-ok))
    (if (not (hash-has (package-dependencies package) pkg-name))
      (let ((message (@text "undefined package: " (symbol-to-text pkg-name))))
        (println (format-message-with-location message location))
        (outcome-error))
      (let ((dependency (hash-get (package-dependencies package) pkg-name)))
        (if (not (has-fragment-of-mod-name (hash-values (package-fragments dependency)) mod-name))
          (let ((message (@text "undefined module: " (symbol-to-text pkg-name) "/" (symbol-to-text mod-name))))
            (println (format-message-with-location message location))
            (outcome-error))
          (outcome-ok))))))

(claim has-fragment-of-mod-name
  (-> (list-t fragment-t) symbol-t
      bool-t))

(define (has-fragment-of-mod-name fragments mod-name)
  (list-some
    fragments
    (lambda (fragment)
      (equal (fragment-mod-name fragment) mod-name))))

(define (close-top lines)
  (let ((i (isub (array-length lines) 1)))
    (array-put lines i (@text (array-get lines i) ")"))))

(define (sort-entries-by-symbol-key entries)
  (let ((array (list-to-array (hash-entries entries))))
    (array-sort
      array
      (lambda (a b)
        (text-compare-lexical
          (symbol-to-text (pair-first a))
          (symbol-to-text (pair-first b)))))
    (array-to-list array)))

(define (sort-entries-by-text-key entries)
  (let ((array (list-to-array (hash-entries entries))))
    (array-sort
      array
      (lambda (a b)
        (text-compare-lexical (pair-first a) (pair-first b))))
    (array-to-list array)))

(define (format-name-value entry debug)
  (@text
    (symbol-to-text (pair-first entry)) " "
    (if debug
      (let ((names (pair-second entry)))
        (let ((array (list-to-array (set-to-list names))))
          (array-sort
            array
            (lambda (a b)
              (text-compare-lexical (symbol-to-text a) (symbol-to-text b))))
          (text-join (list-map (array-to-list array) symbol-to-text) " ")))
      (format (set-size (pair-second entry))))))

(claim format-module-analysis-report
  (-> module-analysis-report-t bool-t
      text-t))

(define (format-module-analysis-report result debug)
  (let ((lines (make-array)))
    (array-push lines "(module-analysis-report")
    (array-push lines "  (fragment-scopes")
    (for-list (sort-entries-by-text-key (module-analysis-report-fragment-scopes result))
      (lambda (entry)
        (let ((path (pair-first entry))
              (scope (pair-second entry)))
          (array-push lines (@text "    (\"" path "\""))
          (array-push
            lines
            (@text "      (mod-name " (symbol-to-text (fragment-scope-mod-name scope)) ")"))
          (if debug
            (begin
              (array-push lines "      (imported-names")
              (for-list (sort-entries-by-symbol-key (fragment-scope-imported-names scope))
                (lambda (entry)
                  (let ((name (pair-first entry))
                        (qualified-entry (pair-second entry)))
                    (array-push
                      lines
                      (@text "        (" (symbol-to-text name) " "
                               (symbol-to-text (qualified-name-pkg-name qualified-entry)) "/"
                               (symbol-to-text (qualified-name-mod-name qualified-entry)) "/"
                               (symbol-to-text (qualified-name-name qualified-entry)) ")")))))
              (close-top lines)
              (array-push lines "      (imported-prefixes")
              (for-list (sort-entries-by-symbol-key (fragment-scope-imported-prefixes scope))
                (lambda (entry)
                  (let ((prefix (pair-first entry))
                        (qualified-prefix (pair-second entry)))
                    (array-push
                      lines
                      (@text "        (" (symbol-to-text prefix) " "
                               (symbol-to-text (qualified-prefix-pkg-name qualified-prefix)) "/"
                               (symbol-to-text (qualified-prefix-mod-name qualified-prefix)) ")")))))
              (close-top lines))
            (begin
              (array-push
                lines
                (@text "      (imported-names " (format (hash-length (fragment-scope-imported-names scope))) ")"))
              (array-push
                lines
                (@text "      (imported-prefixes " (format (hash-length (fragment-scope-imported-prefixes scope))) ")"))))
          (close-top lines))))
    (close-top lines)
    (close-top lines)
    (text-join (array-to-list lines) "\n")))

(claim dump-module-analysis-report
  (-> module-analysis-report-t package-t
      void-t))

(define (dump-module-analysis-report result package)
  (let ((dump-directory (path-join (package-output-directory package) "dump")))
    (path-ensure-directory dump-directory)
    (let ((dump-path (@text dump-directory "/030-module-analysis-report.dump")))
      (path-ensure-file dump-path)
      (path-write dump-path (@text (format-module-analysis-report result false) "\n")))))
