(module meta)

(claim module-import-pass
  (-> module-analysis-report-t
      package-t
      void-t))

(define (module-import-pass report package)
  (let ((scopes (module-analysis-report-fragment-scopes report)))
    (for-hash (package-fragments package)
      (lambda (path fragment)
        (match (hash-get-maybe path scopes)
          ((just scope)
           (fragment-put-desugared-stmts
             (list-map (module-import-stmt scope) (fragment-desugared-stmts fragment))
             fragment))
          ((nothing)
           (error (@text "(module-import-pass) missing scope for: " path))))))
    (when (hash-has "dump" (package-config-compiler (package-config package)))
      (package-dump-desugared-fragments package "070-module-import"))))

(claim module-import-stmt
  (-> fragment-scope-t (stmt-t term-t)
      (stmt-t term-t)))

(define (module-import-stmt scope stmt)
  (match stmt
    ((claim-stmt name type location)
     (claim-stmt name (module-import-term scope type) location))
    ((admit-stmt name type location)
     (admit-stmt name (module-import-term scope type) location))
    ((define-function-stmt name parameters body location)
     (let ((bound-names (list-to-set parameters))
            (new-scope (scope-filter-bound-names scope bound-names)))
       (define-function-stmt name parameters (module-import-term new-scope body) location)))
    ((define-variable-stmt name body location)
     (define-variable-stmt name (module-import-term scope body) location))
    ((define-test-stmt name body location)
     (define-test-stmt name (module-import-term scope body) location))
    ((define-type-stmt name parameters body location)
     (define-type-stmt name parameters (module-import-term scope body) location))
    ((define-algebraic-type-stmt type-constructor data-constructors location)
     (let ((bound-names (list-to-set (pre-type-constructor-parameters type-constructor)))
            (new-scope (scope-filter-bound-names scope bound-names)))
       (define-algebraic-type-stmt
         type-constructor
         (list-map (module-import-explicit-data-constructor new-scope) data-constructors)
         location)))
    ((define-opaque-type-stmt type-constructor representation-type interface-entries location)
     (let ((bound-names (list-to-set (pre-type-constructor-parameters type-constructor)))
            (new-scope (scope-filter-bound-names scope bound-names)))
       (define-opaque-type-stmt type-constructor
         (module-import-term new-scope representation-type)
         (list-map (module-import-pre-interface-entry new-scope) interface-entries)
         location)))
    (else stmt)))

(define (module-import-explicit-data-constructor scope ctor)
  (match ctor
    ((make-explicit-data-constructor name fields predicate-name location)
     (make-explicit-data-constructor
       name
       (list-map (module-import-explicit-data-field scope) fields)
       predicate-name
       location))))

(define (module-import-explicit-data-field scope field)
  (match field
    ((make-explicit-data-field name type accessor-name modifier-name-maybe location)
     (make-explicit-data-field
       name
       (module-import-term scope type)
       accessor-name
       modifier-name-maybe
       location))))

(define (module-import-pre-interface-entry scope entry)
  (match entry
    ((make-pre-interface-entry name type location)
     (make-pre-interface-entry
       name
       (module-import-term scope type)
       location))))

(claim module-import-term
  (-> fragment-scope-t term-t
      term-t))

(define (module-import-term scope term)
  (match term
    ((var-term name location)
     (let ((imported-names (fragment-scope-imported-names scope)))
       (match (hash-get-maybe name imported-names)
         ((just entry)
          (qualified-var-term
            (qualified-name-pkg-name entry)
            (qualified-name-mod-name entry)
            (qualified-name-name entry)
            location))
         ((nothing) term))))
    ((qualified-var-term pkg-name mod-name name location)
     (let ((imported-prefixes (fragment-scope-imported-prefixes scope)))
       (match (hash-get-maybe mod-name imported-prefixes)
         ((just entry)
          (qualified-var-term
            (qualified-prefix-pkg-name entry)
            (qualified-prefix-mod-name entry)
            name
            location))
         ((nothing) term))))
    ((lambda-term parameters body location)
     (let ((bound-names (list-to-set parameters))
            (new-scope (scope-filter-bound-names scope bound-names)))
       (lambda-term
         parameters
         (module-import-term new-scope body)
         location)))
    ((polymorphic-term parameters body location)
     (let ((bound-names (list-to-set parameters))
            (new-scope (scope-filter-bound-names scope bound-names)))
       (polymorphic-term
         parameters
         (module-import-term new-scope body)
         location)))
    ((let1-term name rhs body location)
     (let ((bound-names (@set name))
            (new-scope (scope-filter-bound-names scope bound-names)))
       (let1-term
         name
         (module-import-term scope rhs)
         (module-import-term new-scope body)
         location)))
    (else (term-traverse (module-import-term scope) term))))

(claim scope-filter-bound-names
  (-> fragment-scope-t (set-t symbol-t)
      fragment-scope-t))

(define (scope-filter-bound-names scope bound-names)
  (match scope
    ((make-fragment-scope mod-name imported-names imported-prefixes)
     (make-fragment-scope
       mod-name
       (hash-reject-key (swap set-member bound-names) imported-names)
       imported-prefixes))))
