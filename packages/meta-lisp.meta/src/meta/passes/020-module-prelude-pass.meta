(module meta)

(define (module-prelude-pass package)
  (pipe (package-closure-in-topological-order package)
    (list-each module-prelude-package)))

(define (module-prelude-package package)
  (pipe (package-fragments package)
    (hash-each-value (module-prelude-fragment package))))

(define (module-prelude-fragment package fragment)
  (pipe (package-config-prelude (package-config package))
    (hash-each
      (lambda (package-name module-names)
        (pipe module-names
          (list-each
            (lambda (module-name)
              (list-push-front!
                (import-all-stmt
                  (string-to-symbol package-name)
                  (string-to-symbol module-name)
                  (zero-location (mod-fragment-path fragment)))
                (mod-fragment-stmts fragment)))))))))
