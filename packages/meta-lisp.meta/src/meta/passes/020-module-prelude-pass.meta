(module meta)

(claim module-prelude-pass
  (-> package-t
      void-t))

(define (module-prelude-pass package)
  (for-hash-value (package-fragments package)
    (module-prelude-fragment package)))

(claim module-prelude-fragment
  (-> package-t fragment-t
      void-t))

(define (module-prelude-fragment package fragment)
  (for-hash (package-config-prelude (package-config package))
    (lambda (package-name module-names)
      (for-list module-names
        (lambda (module-name)
          (list-push-front!
            (import-all-stmt
              (string-to-symbol package-name)
              (string-to-symbol module-name)
              (zero-location (fragment-path fragment)))
            (fragment-stmts fragment)))))))

(define (zero-location path)
  (make-source-location
    path
    (make-source-span
      (make-source-position 0 0 0)
      (make-source-position 0 0 0))))
