(module meta)

(claim expand-pass
  (-> package-t
      void-t))

(define (expand-pass package)
  (for-hash-value (package-fragments package)
    (lambda (fragment)
      (fragment-put-stmts
        (list-map-concat expand-stmt (fragment-stmts fragment))
        fragment)))
  (when (hash-has "dump" (package-config-compiler (package-config package)))
    (package-dump-fragments package "010-expand")))

(claim expand-stmt
  (-> (stmt-t exp-t)
      (list-t (stmt-t exp-t))))

(define (expand-stmt stmt)
  (match stmt
    ((define-enum-stmt type-constructor data-constructors lang location)
     (expand-define-algebraic-type
       (define-algebraic-type-stmt
         type-constructor
         (list-map (desugar-data-constructor lang) data-constructors)
         location)))
    ((define-struct-star-stmt type-constructor data-constructor lang location)
     (let ((type-name (pre-type-constructor-name type-constructor))
            (base-name (make-base-name lang type-name location))
            (ctor-name (pre-data-constructor-name data-constructor)))
       (expand-define-algebraic-type
         (define-algebraic-type-stmt
           type-constructor
           [(make-explicit-data-constructor
              ctor-name
              (list-map
                (desugar-data-field lang base-name)
                (pre-data-constructor-fields data-constructor))
              (make-data-predicate-name lang base-name)
              (pre-data-constructor-location data-constructor))]
           location))))
    ((define-struct-stmt type-constructor fields lang location)
     (let ((type-name (pre-type-constructor-name type-constructor))
            (base-name (make-base-name lang type-name location)))
       (expand-define-algebraic-type
         (define-algebraic-type-stmt
           type-constructor
           [(make-explicit-data-constructor
              (make-data-constructor-name lang base-name)
              (list-map (desugar-data-field lang base-name) fields)
              (make-data-predicate-name lang base-name)
              location)]
           location))))
    ((define-record-type-stmt type-constructor data-constructor lang location)
     (expand-define-algebraic-type
       (define-algebraic-type-stmt
         type-constructor
         [data-constructor]
         location)))
    ((define-algebraic-type-stmt type-constructor data-constructors location)
     (expand-define-algebraic-type stmt))
    (else [stmt])))

(claim make-base-name
  (-> lang-t symbol-t source-location-t
      symbol-t))

(define (make-base-name lang type-name location)
  (let ((suffix (if (is-zh lang) "型" "-t")))
    (let ((type-name-string (symbol-to-string type-name)))
      (unless (string-ends-with suffix type-name-string)
        (error-with-location
          (@string "(make-base-name) type-name must end with "
                   suffix
                   "\n  type-name: " type-name-string)
          location))
      (string-to-symbol
        (string-substring
          0 (isub (string-length type-name-string)
                  (string-length suffix))
          type-name-string)))))

(claim make-data-constructor-name
  (-> lang-t symbol-t
      symbol-t))

(define (make-data-constructor-name lang base)
  (string-to-symbol
    (if (is-zh lang)
      (@string "作" (symbol-to-string base))
      (@string "make-" (symbol-to-string base)))))

(claim make-data-accessor-name
  (-> lang-t symbol-t symbol-t
      symbol-t))

(define (make-data-accessor-name lang base field-name)
  (string-to-symbol
    (if (is-zh lang)
      (@string (symbol-to-string base) (symbol-to-string field-name))
      (@string (symbol-to-string base) "-" (symbol-to-string field-name)))))

(claim make-data-modifier-name
  (-> lang-t symbol-t symbol-t
      symbol-t))

(define (make-data-modifier-name lang base field-name)
  (string-to-symbol
    (if (is-zh lang)
      (@string (symbol-to-string base) "存" (symbol-to-string field-name))
      (@string (symbol-to-string base) "-put-" (symbol-to-string field-name)))))

(claim make-data-predicate-name
  (-> lang-t symbol-t
      symbol-t))

(define (make-data-predicate-name lang base)
  (string-to-symbol
    (if (is-zh lang)
      (@string "为" (symbol-to-string base))
      (@string "is-" (symbol-to-string base)))))

(claim make-type-exp
  (-> pre-type-constructor-t source-location-t
      exp-t))

(define (make-type-exp type-constructor location)
  (let ((parameters (pre-type-constructor-parameters type-constructor)))
    (if (list-is-empty parameters)
      (var-exp (pre-type-constructor-name type-constructor) location)
      (apply-exp
        (var-exp (pre-type-constructor-name type-constructor) location)
        (list-map (lambda (parameter) (var-exp parameter location)) parameters)
        location))))

(claim admit-with-type-parameters
  (-> symbol-t (list-t symbol-t) exp-t source-location-t
      (stmt-t exp-t)))

(define (admit-with-type-parameters name parameters type location)
  (if (list-is-empty parameters)
    (admit-stmt name type location)
    (admit-stmt name (polymorphic-exp parameters type location) location)))

(claim desugar-data-constructor
  (-> lang-t pre-data-constructor-t
      (explicit-data-constructor-t exp-t)))

(define (desugar-data-constructor lang ctor)
  (let ((ctor-name (pre-data-constructor-name ctor)))
    (make-explicit-data-constructor
      ctor-name
      (list-map
        (desugar-data-field lang ctor-name)
        (pre-data-constructor-fields ctor))
      (make-data-predicate-name lang ctor-name)
      (pre-data-constructor-location ctor))))

(claim desugar-data-field
  (-> lang-t symbol-t pre-data-field-t
      (explicit-data-field-t exp-t)))

(define (desugar-data-field lang base field)
  (let ((field-name (pre-data-field-name field)))
    (make-explicit-data-field
      field-name
      (pre-data-field-type field)
      (make-data-accessor-name lang base field-name)
      (just (make-data-modifier-name lang base field-name))
      (pre-data-field-location field))))

(claim expand-define-algebraic-type
  (-> (stmt-t exp-t)
      (list-t (stmt-t exp-t))))

(define (expand-define-algebraic-type stmt)
  (match stmt
    ((define-algebraic-type-stmt type-constructor data-constructors location)
     (list-concat
       [[stmt]
        (list-map-concat
          (lambda (ctor)
            (list-concat
              [(expand-constructor type-constructor ctor)
               (expand-predicate type-constructor ctor)
               (list-map-index-concat
                 (lambda (index field)
                   (list-append
                     (expand-accessor type-constructor ctor index field)
                     (expand-modifier type-constructor ctor index field)))
                 (explicit-data-constructor-fields ctor))]))
          data-constructors)]))))

(claim expand-constructor
  (-> pre-type-constructor-t (explicit-data-constructor-t exp-t)
      (list-t (stmt-t exp-t))))

(define (expand-constructor type-constructor ctor)
  (match ctor
    ((make-explicit-data-constructor name fields predicate-name location)
     [(admit-with-type-parameters
        name
        (pre-type-constructor-parameters type-constructor)
        (arrow-exp
          (list-map explicit-data-field-type fields)
          (make-type-exp type-constructor location)
          location)
        location)
      (define-function-stmt
        name
        (list-map explicit-data-field-name fields)
        (list-exp
          (cons (symbol-exp name location)
                (list-map
                  (lambda (field)
                    (var-exp (explicit-data-field-name field)
                             (explicit-data-field-location field)))
                  fields))
          location)
        location)])))

(claim expand-predicate
  (-> pre-type-constructor-t (explicit-data-constructor-t exp-t)
      (list-t (stmt-t exp-t))))

(define (expand-predicate type-constructor ctor)
  (match ctor
    ((make-explicit-data-constructor name fields predicate-name location)
     [(admit-with-type-parameters
        predicate-name
        (pre-type-constructor-parameters type-constructor)
        (arrow-exp
          [(make-type-exp type-constructor location)]
          (qualified-var-exp 'meta-builtin 'builtin 'bool-t location)
          location)
        location)
      (define-function-stmt
        predicate-name
        ['value]
        (and-exp
          [(apply-exp (qualified-var-exp 'meta-builtin 'builtin 'is-list location) [(var-exp 'value location)] location)
           (apply-exp
             (qualified-var-exp 'meta-builtin 'builtin 'equal location)
             [(apply-exp (qualified-var-exp 'meta-builtin 'builtin 'list-length location) [(var-exp 'value location)] location)
              (int-exp (iadd (list-length fields) 1) location)]
             location)
           (apply-exp
             (qualified-var-exp 'meta-builtin 'builtin 'equal location)
             [(apply-exp (qualified-var-exp 'meta-builtin 'builtin 'list-head location) [(var-exp 'value location)] location)
              (symbol-exp name location)]
             location)]
          location)
        location)])))

(claim expand-accessor
  (-> pre-type-constructor-t
      (explicit-data-constructor-t exp-t)
      int-t
      (explicit-data-field-t exp-t)
      (list-t (stmt-t exp-t))))

(define (expand-accessor type-constructor ctor index field)
  (match field
    ((make-explicit-data-field name type accessor-name _ location)
     (let ((type-exp (make-type-exp type-constructor location)))
       [(admit-with-type-parameters
          accessor-name
          (pre-type-constructor-parameters type-constructor)
          (arrow-exp [type-exp] type location)
          location)
        (define-function-stmt
          accessor-name
          ['target]
          (apply-exp
            (qualified-var-exp 'meta-builtin 'builtin 'list-get location)
            [(int-exp (iadd index 1) location)
             (var-exp 'target location)]
            location)
          location)]))))

(claim expand-modifier
  (-> pre-type-constructor-t
      (explicit-data-constructor-t exp-t)
      int-t
      (explicit-data-field-t exp-t)
      (list-t (stmt-t exp-t))))

(define (expand-modifier type-constructor ctor index field)
  (match field
    ((make-explicit-data-field name type _ modifier-name-maybe location)
     (match modifier-name-maybe
       ((nothing) [])
       ((just modifier-name)
        (let ((type-exp (make-type-exp type-constructor location)))
          [(admit-with-type-parameters
             modifier-name
             (pre-type-constructor-parameters type-constructor)
             (arrow-exp [type type-exp] type-exp location)
             location)
           (define-function-stmt
              modifier-name
              ['value 'target]
              (begin-exp
                [(apply-exp
                   (qualified-var-exp 'meta-builtin 'builtin 'list-put location)
                   [(int-exp (iadd index 1) location)
                    (var-exp 'value location)
                    (var-exp 'target location)]
                   location)
                 (var-exp 'target location)]
                location)
              location)]))))))
