(module meta)

(define (expand-pass package options)
  (pipe (package-fragments package)
    (hash-each
      (lambda (path fragment)
        (mod-fragment-put-stmts!
          (list-flat-map expand-stmt (mod-fragment-stmts fragment))
          fragment))))
  (when (hash-has? "dump" options)
    (package-dump-fragments package "010-expand")))

(define (expand-stmt stmt)
  (match stmt
    ((define-enum-stmt type-constructor data-constructors location)
     (expand-define-algebraic-type (desugar-define-enum stmt)))
    ((define-struct-star-stmt type-constructor data-constructor location)
     (expand-define-algebraic-type (desugar-define-struct-star stmt)))
    ((define-struct-stmt type-constructor fields location)
     (expand-define-algebraic-type (desugar-define-struct stmt)))
    ((define-record-type-stmt type-constructor data-constructor location)
     (expand-define-algebraic-type (define-algebraic-type-stmt type-constructor [data-constructor] location)))
    ((define-algebraic-type-stmt type-constructor data-constructors location)
     (expand-define-algebraic-type stmt))
    (else [stmt])))

(define (make-data-constructor-name base)
  (string-to-symbol
    (@string "make-" (symbol-to-string base))))

(define (make-data-accessor-name base field-name)
  (string-to-symbol
    (@string (symbol-to-string base) "-" (symbol-to-string field-name))))

(define (make-data-modifier-name base field-name)
  (string-to-symbol
    (@string (symbol-to-string base) "-put-" (symbol-to-string field-name) "!")))

(define (make-data-predicate-name base)
  (string-to-symbol
    (@string (symbol-to-string base) "?")))

(define (make-base-name name)
  (= name-str (symbol-to-string name))
  (string-to-symbol
    (string-substring 0 (isub (string-length name-str) 2) name-str)))

(define (get-data-type stmt location)
  (= type-constructor (define-algebraic-type-stmt-type-constructor stmt))
  (= parameters (pre-type-constructor-parameters type-constructor))
  (if (list-empty? parameters)
    (var-exp (pre-type-constructor-name type-constructor) location)
    (apply-exp
      (var-exp (pre-type-constructor-name type-constructor) location)
      (list-map (lambda (parameter) (var-exp parameter location)) parameters)
      location)))

(define (admit-with-parameters name parameters type location)
  (if (list-empty? parameters)
    (admit-stmt name type location)
    (admit-stmt name (polymorphic-exp parameters type location) location)))

(claim desugar-data-constructor
  (-> pre-data-constructor-t
      (explicit-data-constructor-t exp-t)))

(define (desugar-data-constructor ctor)
  (= ctor-name (pre-data-constructor-name ctor))
  (make-explicit-data-constructor
    ctor-name
    (list-map
      (desugar-data-field ctor-name)
      (pre-data-constructor-fields ctor))
    (make-data-predicate-name ctor-name)
    (pre-data-constructor-location ctor)))

(define (desugar-data-field ctor-name field)
  (= field-name (pre-data-field-name field))
  (= field-type (pre-data-field-type field))
  (= field-location (pre-data-field-location field))
  (make-explicit-data-field
    field-name
    field-type
    (make-data-accessor-name ctor-name field-name)
    (just (make-data-modifier-name ctor-name field-name))
    field-location))

(define (desugar-define-enum stmt)
  (= type-constructor (define-enum-stmt-type-constructor stmt))
  (= data-constructors (define-enum-stmt-data-constructors stmt))
  (= location (define-enum-stmt-location stmt))
  (define-algebraic-type-stmt
    type-constructor
    (list-map desugar-data-constructor data-constructors)
    location))

(define (desugar-define-struct-star stmt)
  (= type-constructor (define-struct-star-stmt-type-constructor stmt))
  (= type-name (pre-type-constructor-name type-constructor))
  (= data-constructor (define-struct-star-stmt-data-constructor stmt))
  (= location (define-struct-star-stmt-location stmt))
  (= type-name-str (symbol-to-string type-name))
  (unless (string-ends-with? "-t" type-name-str)
    (error (@string
             "[desugarDefineStructStar] type name must end with -t\n"
             "  type name: " type-name-str "\n")))
  (= base (make-base-name type-name))
  (= ctor-name (pre-data-constructor-name data-constructor))
  (= fields (pre-data-constructor-fields data-constructor))
  (= ctor-location (pre-data-constructor-location data-constructor))
  (define-algebraic-type-stmt
    type-constructor
    [(make-explicit-data-constructor
       ctor-name
       (pipe fields
         (list-map
           (lambda (field)
             (= field-name (pre-data-field-name field))
              (= field-type (pre-data-field-type field))
              (= field-location (pre-data-field-location field))
              (make-explicit-data-field
                field-name
                field-type
                (make-data-accessor-name base field-name)
                (just (make-data-modifier-name base field-name))
                field-location))))
        (make-data-predicate-name base)
        ctor-location)]
     location))

(define (desugar-define-struct stmt)
  (= type-constructor (define-struct-stmt-type-constructor stmt))
  (= type-name (pre-type-constructor-name type-constructor))
  (= fields (define-struct-stmt-fields stmt))
  (= location (define-struct-stmt-location stmt))
  (= type-name-str (symbol-to-string type-name))
  (unless (string-ends-with? "-t" type-name-str)
    (error (@string
             "[desugarDefineStruct] type name must end with -t\n"
             "  type name: " type-name-str "\n")))
  (= base (make-base-name type-name))
  (define-algebraic-type-stmt
    type-constructor
    [(make-explicit-data-constructor
       (make-data-constructor-name base)
       (pipe fields
         (list-map
           (lambda (field)
              (= field-name (pre-data-field-name field))
              (= field-type (pre-data-field-type field))
              (= field-location (pre-data-field-location field))
              (make-explicit-data-field
                field-name
                field-type
                (make-data-accessor-name base field-name)
                (just (make-data-modifier-name base field-name))
                field-location))))
        (make-data-predicate-name base)
        location)]
    location))

;; expand-define-algebraic-type

(define (expand-define-algebraic-type stmt)
  (= data-constructors (define-algebraic-type-stmt-data-constructors stmt))
  (list-concat
    [[stmt]
     (list-flat-map (lambda (ctor) (expand-constructor stmt ctor)) data-constructors)
     (list-flat-map (lambda (ctor) (expand-predicate stmt ctor)) data-constructors)
     (list-flat-map (lambda (ctor)
                      (expand-accessors-and-modifiers
                        stmt ctor 0
                        (explicit-data-constructor-fields ctor)))
                    data-constructors)]))

(define (expand-accessors-and-modifiers stmt ctor index fields)
  (if (list-empty? fields)
    []
    (begin
      (= field (list-head fields))
      (= rest (list-tail fields))
      (= modifier-name (explicit-data-field-modifier-name field))
      (= accessor-stmts (expand-accessor stmt ctor index field))
      (= modifier-stmts (if (nothing? modifier-name)
                          []
                          (expand-modifier stmt ctor index field)))
      (= rest-stmts (expand-accessors-and-modifiers stmt ctor
                                                    (iadd index 1) rest))
      (list-append accessor-stmts
                   (list-append modifier-stmts rest-stmts)))))

;; expand-constructor

(define (expand-constructor stmt ctor)
  (= ctor-name (explicit-data-constructor-name ctor))
  (= fields (explicit-data-constructor-fields ctor))
  (= ctor-location (explicit-data-constructor-location ctor))
  (= parameters (list-map (lambda (f) (explicit-data-field-name f)) fields))
  (= args (list-map (lambda (f)
                      (var-exp (explicit-data-field-name f)
                               (explicit-data-field-location f)))
                    fields))
  (= type-params (pre-type-constructor-parameters
                   (define-algebraic-type-stmt-type-constructor stmt)))
  [(admit-with-parameters
     ctor-name
     type-params
     (arrow-exp
       (list-map (lambda (f) (explicit-data-field-type f)) fields)
       (get-data-type stmt ctor-location)
       ctor-location)
     ctor-location)
   (define-function-stmt
     ctor-name
     parameters
     (list-exp
       (cons (symbol-exp ctor-name ctor-location) args)
       ctor-location)
     ctor-location)])

;; expand-predicate

(define (expand-predicate stmt ctor)
  (= predicate (explicit-data-constructor-predicate ctor))
  (= ctor-name (explicit-data-constructor-name ctor))
  (= ctor-location (explicit-data-constructor-location ctor))
  (= nfields (iadd (list-length (explicit-data-constructor-fields ctor)) 1))
  (= type-params (pre-type-constructor-parameters
                   (define-algebraic-type-stmt-type-constructor stmt)))
  [(admit-with-parameters
     predicate
     type-params
     (arrow-exp
       [(get-data-type stmt ctor-location)]
       (var-exp 'bool-t ctor-location)
       ctor-location)
     ctor-location)
   (define-function-stmt
     predicate
     ['value]
     (and-exp
       [(apply-exp
          (var-exp 'list? ctor-location)
          [(var-exp 'value ctor-location)]
          ctor-location)
        (apply-exp
          (var-exp 'equal? ctor-location)
          [(apply-exp
             (var-exp 'list-length ctor-location)
             [(var-exp 'value ctor-location)]
             ctor-location)
           (int-exp nfields ctor-location)]
          ctor-location)
        (apply-exp
          (var-exp 'equal? ctor-location)
          [(apply-exp
             (var-exp 'list-head ctor-location)
             [(var-exp 'value ctor-location)]
             ctor-location)
           (symbol-exp ctor-name ctor-location)]
          ctor-location)]
       ctor-location)
     ctor-location)])

;; expand-accessor

(define (expand-accessor stmt ctor index field)
  (= accessor-name (explicit-data-field-accessor-name field))
  (= field-type (explicit-data-field-type field))
  (= field-location (explicit-data-field-location field))
  (= position (iadd index 1))
  (= type-params (pre-type-constructor-parameters
                   (define-algebraic-type-stmt-type-constructor stmt)))
  [(admit-with-parameters
     accessor-name
     type-params
     (arrow-exp
       [(get-data-type stmt field-location)]
       field-type
       field-location)
     field-location)
   (define-function-stmt
     accessor-name
     ['target]
     (apply-exp
       (var-exp 'list-get field-location)
       [(int-exp position field-location)
        (var-exp 'target field-location)]
       field-location)
     field-location)])

;; expand-modifier

(define (expand-modifier stmt ctor index field)
  (= modifier-name (just-value (explicit-data-field-modifier-name field)))
  (= field-type (explicit-data-field-type field))
  (= field-location (explicit-data-field-location field))
  (= position (iadd index 1))
  (= type-params (pre-type-constructor-parameters
                   (define-algebraic-type-stmt-type-constructor stmt)))
  [(admit-with-parameters
     modifier-name
     type-params
     (arrow-exp
       [field-type (get-data-type stmt field-location)]
       (get-data-type stmt field-location)
       field-location)
     field-location)
   (define-function-stmt
     modifier-name
     ['value 'target]
     (apply-exp
       (var-exp 'list-put! field-location)
       [(int-exp position field-location)
        (var-exp 'value field-location)
        (var-exp 'target field-location)]
       field-location)
     field-location)])
