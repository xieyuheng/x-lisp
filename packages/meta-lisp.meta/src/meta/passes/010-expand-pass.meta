(module meta)

(define (expand-pass package options)
  (pipe (package-fragments package)
    (hash-each
      (lambda (path fragment)
        (mod-fragment-put-stmts!
          (list-flat-map expand-stmt (mod-fragment-stmts fragment))
          fragment))))
  (when (hash-has? "dump" options)
    (package-dump-fragments package "010-expand")))

(define (expand-stmt stmt)
  (match stmt
    ((define-enum-stmt type-constructor data-constructors location)
     (expand-define-algebraic-type
       (define-algebraic-type-stmt
         type-constructor
         (list-map desugar-data-constructor data-constructors)
         location)))
    ((define-struct-star-stmt type-constructor data-constructor location)
     (expand-define-algebraic-type
       (define-algebraic-type-stmt
         type-constructor
         [(desugar-data-constructor data-constructor)]
         location)))
    ((define-struct-stmt type-constructor fields location)
     (= type-name (pre-type-constructor-name type-constructor))
     (= base-name (make-base-name type-name location))
     (expand-define-algebraic-type
       (define-algebraic-type-stmt
         type-constructor
         [(make-explicit-data-constructor
            (make-data-constructor-name base-name)
            (list-map (desugar-data-field base-name) fields)
            (make-data-predicate-name base-name)
            location)]
         location)))
    ((define-record-type-stmt type-constructor data-constructor location)
     (expand-define-algebraic-type
       (define-algebraic-type-stmt
         type-constructor
         [data-constructor]
         location)))
    ((define-algebraic-type-stmt type-constructor data-constructors location)
     (expand-define-algebraic-type stmt))
    (else [stmt])))

(define (make-base-name type-name location)
  (= type-name-string (symbol-to-string type-name))
  (unless (string-ends-with? "-t" type-name-string)
    (error-with-location
      (@string "(make-base-name) type-name must end with -t"
               "\n  type-name: " type-name-string)
      location))
  (string-to-symbol
    (string-substring
      0 (isub (string-length type-name-string) 2)
      type-name-string)))

(define (make-data-constructor-name base)
  (string-to-symbol
    (@string "make-" (symbol-to-string base))))

(define (make-data-accessor-name base field-name)
  (string-to-symbol
    (@string (symbol-to-string base) "-" (symbol-to-string field-name))))

(define (make-data-modifier-name base field-name)
  (string-to-symbol
    (@string (symbol-to-string base) "-put-" (symbol-to-string field-name) "!")))

(define (make-data-predicate-name base)
  (string-to-symbol
    (@string (symbol-to-string base) "?")))

(claim make-type-exp
  (-> pre-type-constructor-t source-location-t
      exp-t))

(define (make-type-exp type-constructor location)
  (= parameters (pre-type-constructor-parameters type-constructor))
  (if (list-empty? parameters)
    (var-exp (pre-type-constructor-name type-constructor) location)
    (apply-exp
      (var-exp (pre-type-constructor-name type-constructor) location)
      (list-map (lambda (parameter) (var-exp parameter location)) parameters)
      location)))

(define (admit-with-type-parameters name parameters type location)
  (if (list-empty? parameters)
    (admit-stmt name type location)
    (admit-stmt name (polymorphic-exp parameters type location) location)))

(claim desugar-data-constructor
  (-> pre-data-constructor-t
      (explicit-data-constructor-t exp-t)))

(define (desugar-data-constructor ctor)
  (= ctor-name (pre-data-constructor-name ctor))
  (make-explicit-data-constructor
    ctor-name
    (list-map
      (desugar-data-field ctor-name)
      (pre-data-constructor-fields ctor))
    (make-data-predicate-name ctor-name)
    (pre-data-constructor-location ctor)))

(claim desugar-data-field
  (-> symbol-t pre-data-field-t
      (explicit-data-field-t exp-t)))

(define (desugar-data-field base field)
  (= field-name (pre-data-field-name field))
  (make-explicit-data-field
    field-name
    (pre-data-field-type field)
    (make-data-accessor-name base field-name)
    (just (make-data-modifier-name base field-name))
    (pre-data-field-location field)))

(define (expand-define-algebraic-type stmt)
  (match stmt
    ((define-algebraic-type-stmt type-constructor data-constructors location)
     (list-concat
       [[stmt]
        (pipe data-constructors (list-flat-map (expand-constructor type-constructor)))
        (pipe data-constructors (list-flat-map (expand-predicate type-constructor)))
        (pipe data-constructors
          (list-flat-map
            (lambda (ctor)
              (list-append
                (pipe (explicit-data-constructor-fields ctor)
                  (list-flat-map-index (expand-accessor stmt ctor)))
                (pipe (explicit-data-constructor-fields ctor)
                  (list-flat-map-index (expand-modifier stmt ctor)))))))]))))

(claim expand-constructor
  (-> pre-type-constructor-t (explicit-data-constructor-t exp-t)
      (list-t (stmt-t exp-t))))

(define (expand-constructor type-constructor ctor)
  (match ctor
    ((make-explicit-data-constructor name fields predicate-name location)
     [(admit-with-type-parameters
        name
        (pre-type-constructor-parameters type-constructor)
        (arrow-exp
          (list-map explicit-data-field-type fields)
          (make-type-exp type-constructor location)
          location)
        location)
      (define-function-stmt
        name
        (list-map explicit-data-field-name fields)
        (list-exp
          (cons (symbol-exp name location)
                (list-map
                  (lambda (field)
                    (var-exp (explicit-data-field-name field)
                             (explicit-data-field-location field)))
                  fields))
          location)
        location)])))

(claim expand-predicate
  (-> pre-type-constructor-t (explicit-data-constructor-t exp-t)
      (list-t (stmt-t exp-t))))

(define (expand-predicate type-constructor ctor)
  (match ctor
    ((make-explicit-data-constructor name fields predicate-name location)
     [(admit-with-type-parameters
        predicate-name
        (pre-type-constructor-parameters type-constructor)
        (arrow-exp
          [(make-type-exp type-constructor location)]
          (var-exp 'bool-t location)
          location)
        location)
      (define-function-stmt
        predicate-name
        ['value]
        (and-exp
          [(apply-exp (var-exp 'list? location) [(var-exp 'value location)] location)
           (apply-exp
             (var-exp 'equal? location)
             [(apply-exp (var-exp 'list-length location) [(var-exp 'value location)] location)
              (int-exp (iadd (list-length fields) 1) location)]
             location)
           (apply-exp
             (var-exp 'equal? location)
             [(apply-exp (var-exp 'list-head location) [(var-exp 'value location)] location)
              (symbol-exp name location)]
             location)]
          location)
        location)])))

(define (expand-accessor stmt ctor index field)
  (= accessor-name (explicit-data-field-accessor-name field))
  (= field-type (explicit-data-field-type field))
  (= field-location (explicit-data-field-location field))
  (= position (iadd index 1))
  (= type-parameters (pre-type-constructor-parameters
                       (define-algebraic-type-stmt-type-constructor stmt)))
  (= type-constructor (define-algebraic-type-stmt-type-constructor stmt))
  [(admit-with-type-parameters
     accessor-name
     type-parameters
     (arrow-exp
       [(make-type-exp type-constructor field-location)]
       field-type
       field-location)
     field-location)
   (define-function-stmt
     accessor-name
     ['target]
     (apply-exp
       (var-exp 'list-get field-location)
       [(int-exp position field-location)
        (var-exp 'target field-location)]
       field-location)
     field-location)])

(define (expand-modifier stmt ctor index field)
  (match (explicit-data-field-modifier-name field)
    ((nothing) [])
    ((just modifier-name)
     (= field-type (explicit-data-field-type field))
     (= field-location (explicit-data-field-location field))
     (= position (iadd index 1))
     (= type-parameters (pre-type-constructor-parameters
                          (define-algebraic-type-stmt-type-constructor stmt)))
     (= type-constructor (define-algebraic-type-stmt-type-constructor stmt))
     (= type-exp (make-type-exp type-constructor field-location))
     [(admit-with-type-parameters
        modifier-name
        type-parameters
        (arrow-exp [field-type type-exp] type-exp field-location)
        field-location)
      (define-function-stmt
        modifier-name
        ['value 'target]
        (apply-exp
          (var-exp 'list-put! field-location)
          [(int-exp position field-location)
           (var-exp 'value field-location)
           (var-exp 'target field-location)]
          field-location)
        field-location)])))
