(module meta)

(claim term-location (-> term-t source-location-t))
(define (term-location term)
  (match term
    ((symbol-term content location) location)
    ((keyword-term content location) location)
    ((string-term content location) location)
    ((int-term content location) location)
    ((float-term content location) location)
    ((var-term name location) location)
    ((qualified-var-term pkg-name mod-name name location) location)
    ((lambda-term parameters body location) location)
    ((polymorphic-term parameters body location) location)
    ((apply-term target args location) location)
    ((let1-term name rhs body location) location)
    ((begin1-term head body location) location)
    ((if-term condition consequent alternative location) location)
    ((arrow-term arg-types ret-type location) location)
    ((the-term type instance location) location)))

(claim claim-pass (-> package-t outcome-t))
(define (claim-pass package)
  (= errors (make-list))
  (for-list (package-closure-in-topological-order package)
    (lambda (ordered-package)
      (for-hash (package-mods ordered-package)
        (lambda (name mod)
          (for-hash (mod-claimed mod)
            (lambda (claimed-name entry)
              (unless (or (set-member? claimed-name (mod-admitted mod))
                          (hash-has? claimed-name (mod-definitions mod)))
                (= message
                   (@string
                     "undefined claimed name"
                     "\n  module: " (symbol-to-string (mod-name mod))
                     "\n  name: " (symbol-to-string claimed-name)
                     "\n  exp: " (format-term (claim-entry-exp entry))))
                (writeln
                  (format-message-with-source-location
                    message
                    (term-location (claim-entry-exp entry))))
                (list-push! claimed-name errors))))))))
  (if (list-empty? errors)
    (outcome-ok)
    (outcome-error)))
