(module meta)

(claim claim-pass
  (-> package-t
      outcome-t))

(define (claim-pass package)
  (let ((outcomes (make-list)))
    (for-hash-value (package-mods package)
      (lambda (mod)
        (for-hash (mod-claimed mod)
          (lambda (name entry)
            (list-push (setup-claimed-type mod name entry) outcomes)))))
    (outcome-conj outcomes)))

(define (setup-claimed-type mod name entry)
  (cond ((or (set-member name (mod-admitted mod))
             (hash-has name (mod-definitions mod)))
         (let ((type (evaluate-type mod (empty-env (opaque-mode)) (claimed-entry-term entry))))
           (claimed-entry-put-type (just type) entry)
           (outcome-ok)))
        (else
         (println
           (format-message-with-location
             (@text
               "undefined claimed name"
               "\n  module: " (symbol-to-text (mod-name mod))
               "\n  name: " (symbol-to-text name))
             (term-location (claimed-entry-term entry))))
         (outcome-error))))
