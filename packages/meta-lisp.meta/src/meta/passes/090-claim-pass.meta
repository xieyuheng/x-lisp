(module meta)

(claim claim-pass
  (-> package-t
      outcome-t))

(define (claim-pass package)
  (let ((outcomes (make-array)))
    (hash-each-value (package-mods package)
      (lambda (mod)
        (hash-each (mod-claimed mod)
          (lambda (name entry)
            (array-push outcomes (setup-claimed-type mod name entry))))))
    (outcome-conj (array-to-list outcomes))))

(define (setup-claimed-type mod name entry)
  (cond ((or (set-has (mod-admitted mod) name)
             (hash-has (mod-definitions mod) name))
         (let ((type (evaluate-type mod (empty-env (opaque-mode)) (claimed-entry-term entry))))
           (claimed-entry-put-type entry (just type))
           (outcome-ok)))
        (else
         (println
           (format-message-with-location
             (@text
               "undefined claimed name"
               "\n  module: " (symbol-to-text (mod-name mod))
               "\n  name: " (symbol-to-text name))
             (term-location (claimed-entry-term entry))))
         (outcome-error))))
