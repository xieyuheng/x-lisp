(module meta)

(claim pattern-bound-names (-> exp-t (set-t symbol-t)))
(define (pattern-bound-names pattern)
  (if (is-var-exp pattern)
    (set-add (var-exp-name pattern) (make-set))
    (if (is-data-pattern pattern)
      (let ((args (apply-exp-args pattern)))
        (list-fold-left (lambda (s arg)
                          (set-union s (pattern-bound-names arg)))
                        (make-set) args))
      (error "unhandled pattern"))))

(claim is-var-pattern (-> exp-t bool-t))
(define (is-var-pattern exp)
  (is-var-exp exp))

(claim var-pattern-name (-> exp-t symbol-t))
(define (var-pattern-name exp)
  (var-exp-name exp))

(claim is-data-pattern (-> exp-t bool-t))
(define (is-data-pattern exp)
  (if (not (is-apply-exp exp))
    false
    (let ((target (apply-exp-target exp)))
      (and (or (is-var-exp target)
               (is-qualified-var-exp target))
           (list-every (lambda (arg)
                          (or (is-var-exp arg) (is-data-pattern arg)))
                        (apply-exp-args exp))))))

(claim is-pattern (-> exp-t bool-t))
(define (is-pattern exp)
  (or (is-var-pattern exp) (is-data-pattern exp)))
