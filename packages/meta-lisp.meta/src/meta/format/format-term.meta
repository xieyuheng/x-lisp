(module meta)

(claim format-term (-> term-t text-t))
(define (format-term term)
  (match term
    ((symbol-term content location)
     (format-as-sexp content))
    ((keyword-term content location)
     (format-as-sexp content))
    ((text-term content location)
     (format-as-sexp content))
    ((int-term content location)
     (format-as-sexp content))
    ((float-term content location)
     (format-as-sexp content))
    ((var-term name location)
     (symbol-to-text name))
    ((qualified-var-term pkg-name mod-name name location)
     (@text (symbol-to-text mod-name) "/" (symbol-to-text name)))
    ((apply-term target args location)
     (let ((target-str (format-term target))
           (args-str (format-terms args)))
       (if (equal args-str "")
         (@text "(" target-str ")")
         (@text "(" target-str " " args-str ")"))))
    ((arrow-term arg-types ret-type location)
     (let ((args-str (format-terms arg-types)))
       (@text "(-> " args-str " " (format-term ret-type) ")")))
    ((all-term parameters body location)
     (@text "(all (" (text-join " " (list-map symbol-to-text parameters)) ") "
              (format-term body) ")"))
    ((lambda-term parameters body location)
     (@text "(lambda (" (text-join " " (list-map symbol-to-text parameters)) ") "
              (format-term body) ")"))
    ((let1-term name rhs body location)
     (@text "(let ((" (symbol-to-text name) " " (format-term rhs) ")) "
              (format-term body) ")"))
    ((begin1-term head body location)
     (@text "(begin " (format-term head) " " (format-term body) ")"))
    ((if-term condition consequent alternative location)
     (@text "(if " (format-term condition) " "
              (format-term consequent) " "
              (format-term alternative) ")"))
    ((the-term type instance location)
     (@text "(the " (format-term type) " " (format-term instance) ")"))))

(define (format-terms terms)
  (text-join " " (list-map format-term terms)))
