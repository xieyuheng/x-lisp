(module meta)

(claim format-type (-> type-t string-t))
(define (format-type type)
  (match type
    ((var-type name serial-number)
     (symbol-to-string name))
    ((canonical-label-type serial-number)
     (@string "%" (format-as-sexp serial-number)))
    ((type-type)
     "type-t")
    ((atom-type name)
     (symbol-to-string name))
    ((arrow-type arg-types ret-type)
     (= args-str (format-types arg-types))
     (@string "(-> " args-str " " (format-type ret-type) ")"))
    ((list-type element-type)
     (@string "(list-t " (format-type element-type) ")"))
    ((set-type element-type)
     (@string "(set-t " (format-type element-type) ")"))
    ((hash-type key-type value-type)
     (@string "(hash-t " (format-type key-type) " "
              (format-type value-type) ")"))
    ((data-type type-constructor arg-types)
     (= mod-name (mod-name (type-constructor-mod type-constructor)))
     (= name (type-constructor-name type-constructor))
     (if (list-empty? arg-types)
        (@string (symbol-to-string mod-name) "/" (symbol-to-string name))
        (@string "(" (symbol-to-string mod-name) "/" (symbol-to-string name) " "
                 (format-types arg-types) ")")))
    ((polymorphic-type var-types body-type)
     (@string "(polymorphic (" (format-types var-types) ") "
              (format-type body-type) ")"))))

(define (format-types types)
  (string-join " " (list-map format-type types)))
