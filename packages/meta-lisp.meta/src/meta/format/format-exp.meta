(module meta)

(claim format-exp (-> exp-t text-t))
(define (format-exp exp)
  (match exp
    ((symbol-exp content location)
     (format-as-sexp content))
    ((keyword-exp content location)
     (format-as-sexp content))
    ((text-exp content location)
     (format-as-sexp content))
    ((int-exp content location)
     (format-as-sexp content))
    ((float-exp content location)
     (format-as-sexp content))
    ((var-exp name location)
     (symbol-to-text name))
    ((qualified-var-exp pkg-name mod-name name location)
     (@text (symbol-to-text mod-name) "/" (symbol-to-text name)))
    ((apply-exp target args location)
     (let ((target-str (format-exp target))
           (args-str (format-exps args)))
       (if (equal args-str "")
         (@text "(" target-str ")")
         (@text "(" target-str " " args-str ")"))))
    ((arrow-exp arg-types ret-type location)
     (let ((args-str (format-exps arg-types)))
       (if (list-is-empty arg-types)
         (@text "(-> " (format-exp ret-type) ")")
         (@text "(-> " args-str " " (format-exp ret-type) ")"))))
    ((all-exp parameters body location)
     (@text "(all (" (text-join " " (list-map symbol-to-text parameters)) ") "
              (format-exp body) ")"))
    ((lambda-exp parameters body location)
     (@text "(lambda (" (text-join " " (list-map symbol-to-text parameters)) ") "
              (format-exp body) ")"))
    ((list-exp elements location)
     (if (list-is-empty elements)
       "[]"
       (@text "[" (format-exps elements) "]")))
    ((text-concat-exp elements location)
     (if (list-is-empty elements)
       "(@text)"
       (@text "(@text " (format-exps elements) ")")))
    ((set-exp elements location)
     (if (list-is-empty elements)
       "(@set)"
       (@text "(@set " (format-exps elements) ")")))
    ((hash-exp entries location)
     (@text "(@hash " (text-join " " (list-map format-hash-entry entries)) ")"))
    ((and-exp exps location)
     (@text "(and " (format-exps exps) ")"))
    ((let1-exp name rhs body location)
     (@text "(let ((" (symbol-to-text name) " " (format-exp rhs) ")) "
              (format-exp-body body) ")"))
    ((let-exp bindings body location)
     (@text "(let (" (format-bindings bindings) ") " (format-exp body) ")"))
    ((begin1-exp head body location)
     (@text "(begin " (format-exp head) " " (format-exp-body body) ")"))
    ((begin-exp sequence location)
     (@text "(begin " (format-exps sequence) ")"))
    ((quote-exp sexp location)
     (@text "'" (format-sexp sexp)))
    ((sexp-exp sexp location)
      (@text "(@sexp " (format-sexp sexp) ")"))
    ((comment-exp sexps location)
      (if (list-is-empty sexps)
        (@text "(@comment)")
        (@text "(@comment " (text-join " " (list-map format-sexp sexps)) ")")))
    ((letrec-exp bindings body location)
     (@text "(letrec (" (format-bindings bindings) ") " (format-exp body) ")"))
    ((local-define-exp name parameters body location)
     (if (list-is-empty parameters)
       (@text "(define " (symbol-to-text name) " " (format-exp body) ")")
       (@text "(define (" (symbol-to-text name) " "
                (text-join " " (list-map symbol-to-text parameters)) ") "
                (format-exp body) ")")))
    ((if-exp condition consequent alternative location)
     (@text "(if " (format-exp condition) " "
              (format-exp consequent) " "
              (format-exp alternative) ")"))
    ((when-exp condition consequent location)
     (@text "(when " (format-exp condition) " " (format-exp consequent) ")"))
    ((unless-exp condition alternative location)
     (@text "(unless " (format-exp condition) " " (format-exp alternative) ")"))
    ((or-exp exps location)
     (@text "(or " (format-exps exps) ")"))
    ((cond-exp clauses location)
     (@text "(cond " (text-join " " (list-map format-cond-clause clauses)) ")"))
    ((flow-exp target steps location)
     (@text "(flow " (format-exp target) " " (format-exps steps) ")"))
    ((chain-exp steps location)
     (@text "(chain " (format-exps steps) ")"))
    ((compose-exp steps location)
     (@text "(compose " (format-exps steps) ")"))
    ((the-exp type instance location)
     (@text "(the " (format-exp type) " " (format-exp instance) ")"))
    ((match-exp targets clauses location)
     (let ((clauses-str (text-join " " (list-map format-match-clause clauses))))
       (if (equal (list-length targets) 1)
         (@text "(match " (format-exp (car targets)) " " clauses-str ")")
         (@text "(multi-match (" (format-exps targets) ") " clauses-str ")"))))
    ))

(define (format-exps exps)
  (text-join " " (list-map format-exp exps)))

(claim format-exp-body (-> exp-t text-t))

(define (format-exp-body exp)
  (match exp
    ((begin1-exp head body location)
     (@text (format-exp head) " " (format-exp-body body)))
    ((let1-exp name rhs body location)
     (@text "(let ((" (symbol-to-text name) " " (format-exp rhs) ")) "
              (format-exp-body body) ")"))
    ((begin-exp sequence location)
     (format-exps sequence))
    (else (format-exp exp))))

(define (format-bindings bindings)
  (text-join " " (list-map format-binding bindings)))

(define (format-binding binding)
  (@text "(" (symbol-to-text (binding-name binding)) " "
           (format-exp (binding-rhs binding)) ")"))

(define (format-cond-clause clause)
  (@text "(" (format-exp (cond-clause-question clause)) " "
           (format-exp (cond-clause-answer clause)) ")"))

(define (format-match-clause clause)
  (let ((patterns (match-clause-patterns clause))
        (body (match-clause-body clause)))
    (if (equal (list-length patterns) 1)
      (@text "(" (format-exp (car patterns)) " " (format-exp body) ")")
      (@text "((" (format-exps patterns) ") " (format-exp body) ")"))))

(define (format-hash-entry entry)
  (@text (format-exp (pair-first entry)) " "
           (format-exp (pair-second entry))))
