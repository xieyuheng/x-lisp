(module meta)

(claim format-exp (-> exp-t string-t))
(define (format-exp exp)
  (match exp
    ((symbol-exp content location)
     (format-as-sexp content))
    ((keyword-exp content location)
     (format-as-sexp content))
    ((string-exp content location)
     (format-as-sexp content))
    ((int-exp content location)
     (format-as-sexp content))
    ((float-exp content location)
     (format-as-sexp content))
    ((var-exp name location)
     (symbol-to-string name))
    ((qualified-var-exp pkg-name mod-name name location)
     (@string (symbol-to-string mod-name) "/" (symbol-to-string name)))
    ((apply-exp target args location)
     (let ((target-str (format-exp target))
           (args-str (format-exps args)))
       (if (equal args-str "")
         (@string "(" target-str ")")
         (@string "(" target-str " " args-str ")"))))
    ((arrow-exp arg-types ret-type location)
     (let ((args-str (format-exps arg-types)))
       (if (list-is-empty arg-types)
         (@string "(-> " (format-exp ret-type) ")")
         (@string "(-> " args-str " " (format-exp ret-type) ")"))))
    ((polymorphic-exp parameters body location)
     (@string "(polymorphic (" (string-join " " (list-map symbol-to-string parameters)) ") "
              (format-exp body) ")"))
    ((lambda-exp parameters body location)
     (@string "(lambda (" (string-join " " (list-map symbol-to-string parameters)) ") "
              (format-exp body) ")"))
    ((list-exp elements location)
     (if (list-is-empty elements)
       "[]"
       (@string "[" (format-exps elements) "]")))
    ((string-concat-exp elements location)
     (if (list-is-empty elements)
       "(@string)"
       (@string "(@string " (format-exps elements) ")")))
    ((set-exp elements location)
     (if (list-is-empty elements)
       "(@set)"
       (@string "(@set " (format-exps elements) ")")))
    ((hash-exp entries location)
     (@string "(@hash " (string-join " " (list-map format-hash-entry entries)) ")"))
    ((and-exp exps location)
     (@string "(and " (format-exps exps) ")"))
    ((let1-exp name rhs body location)
     (@string "(let ((" (symbol-to-string name) " " (format-exp rhs) ")) "
              (format-exp-body body) ")"))
    ((let-exp bindings body location)
     (@string "(let (" (format-bindings bindings) ") " (format-exp body) ")"))
    ((begin1-exp head body location)
     (@string "(begin " (format-exp head) " " (format-exp-body body) ")"))
    ((begin-exp sequence location)
     (@string "(begin " (format-exps sequence) ")"))
    ((quote-exp sexp location)
     (@string "'" (format-sexp sexp)))
    ((sexp-exp sexp location)
      (@string "(@sexp " (format-sexp sexp) ")"))
    ((comment-exp sexps location)
      (if (list-is-empty sexps)
        (@string "(@comment)")
        (@string "(@comment " (string-join " " (list-map format-sexp sexps)) ")")))
    ((letrec-exp bindings body location)
     (@string "(letrec (" (format-bindings bindings) ") " (format-exp body) ")"))
    ((local-define-exp name parameters body location)
     (if (list-is-empty parameters)
       (@string "(define " (symbol-to-string name) " " (format-exp body) ")")
       (@string "(define (" (symbol-to-string name) " "
                (string-join " " (list-map symbol-to-string parameters)) ") "
                (format-exp body) ")")))
    ((if-exp condition consequent alternative location)
     (@string "(if " (format-exp condition) " "
              (format-exp consequent) " "
              (format-exp alternative) ")"))
    ((when-exp condition consequent location)
     (@string "(when " (format-exp condition) " " (format-exp consequent) ")"))
    ((unless-exp condition alternative location)
     (@string "(unless " (format-exp condition) " " (format-exp alternative) ")"))
    ((or-exp exps location)
     (@string "(or " (format-exps exps) ")"))
    ((cond-exp clauses location)
     (@string "(cond " (string-join " " (list-map format-cond-clause clauses)) ")"))
    ((pipe-exp target steps location)
     (@string "(pipe " (format-exp target) " " (format-exps steps) ")"))
    ((chain-exp steps location)
     (@string "(chain " (format-exps steps) ")"))
    ((compose-exp steps location)
     (@string "(compose " (format-exps steps) ")"))
    ((the-exp type instance location)
     (@string "(the " (format-exp type) " " (format-exp instance) ")"))
    ((match-exp targets clauses location)
     (let ((clauses-str (string-join " " (list-map format-match-clause clauses))))
       (if (equal (list-length targets) 1)
         (@string "(match " (format-exp (car targets)) " " clauses-str ")")
         (@string "(multi-match (" (format-exps targets) ") " clauses-str ")"))))
    ))

(define (format-exps exps)
  (string-join " " (list-map format-exp exps)))

(claim format-exp-body (-> exp-t string-t))

(define (format-exp-body exp)
  (match exp
    ((begin1-exp head body location)
     (@string (format-exp head) " " (format-exp-body body)))
    ((let1-exp name rhs body location)
     (@string "(let ((" (symbol-to-string name) " " (format-exp rhs) ")) "
              (format-exp-body body) ")"))
    ((begin-exp sequence location)
     (format-exps sequence))
    (else (format-exp exp))))

(define (format-bindings bindings)
  (string-join " " (list-map format-binding bindings)))

(define (format-binding binding)
  (@string "(" (symbol-to-string (binding-name binding)) " "
           (format-exp (binding-rhs binding)) ")"))

(define (format-cond-clause clause)
  (@string "(" (format-exp (cond-clause-question clause)) " "
           (format-exp (cond-clause-answer clause)) ")"))

(define (format-match-clause clause)
  (let ((patterns (match-clause-patterns clause))
        (body (match-clause-body clause)))
    (if (equal (list-length patterns) 1)
      (@string "(" (format-exp (car patterns)) " " (format-exp body) ")")
      (@string "((" (format-exps patterns) ") " (format-exp body) ")"))))

(define (format-hash-entry entry)
  (@string (format-exp (pair-first entry)) " "
           (format-exp (pair-second entry))))
