(module meta)

(claim format-value (-> value-t text-t))
(define (format-value value)
  (match value
    ((type-value type)
     (format-type type))
    ((curry-value target arity args)
     (let ((args-str (format-values args))
           (target-str (format-value target)))
       (if (equal args-str "")
         target-str
         (@text "(" target-str " " args-str ")"))))
    ((definition-value definition)
     (let ((mod-name (symbol-to-text (definition-mod-name definition)))
           (name (symbol-to-text (definition-name definition))))
       (@text mod-name "/" name)))))

(define (format-values values)
  (text-join " " (list-map format-value values)))
