(module meta)

(claim format-mod-stmts (-> mod-t text-t))
(define (format-mod-stmts mod)
  (text-join " " (list-map format-stmt (mod-stmts mod))))

(claim format-fragment-stmts (-> (list-t (stmt-t exp-t)) text-t))
(define (format-fragment-stmts stmts)
  (text-join "\n\n" (list-map format-stmt stmts)))

(claim format-mod-definitions (-> mod-t text-t))
(define (format-mod-definitions mod)
  (text-join " " (list-map format-definition (hash-values (mod-definitions mod)))))
