(module meta)

(claim format-definition (-> definition-t text-t))
(define (format-definition definition)
  (match definition
    ((primitive-function-declaration mod name arity location)
     (@text "(declare-primitive-function "
              (symbol-to-text name) " "
              (format-as-sexp arity) ")"))
    ((primitive-variable-declaration mod name location)
     (@text "(declare-primitive-variable " (symbol-to-text name) ")"))
    ((function-definition mod name parameters body location)
     (let ((claim-str (format-definition-claim mod name))
           (params-str (text-join " " (list-map symbol-to-text parameters)))
           (body-str (format-term body)))
       (@text claim-str
                "(define (" (symbol-to-text name) " "
                params-str ") " body-str ")")))
    ((variable-definition mod name body location)
     (let ((claim-str (format-definition-claim mod name))
           (body-str (format-term body)))
       (@text claim-str
                "(define " (symbol-to-text name)
                " " body-str ")")))
    ((test-definition mod name body location)
     (let ((claim-str (format-definition-claim mod name))
           (body-str (format-term body)))
       (@text claim-str "(define-test " (symbol-to-text name) " " body-str ")")))
    ((type-definition mod name parameters body location)
     (let ((claim-str (format-definition-claim mod name))
           (body-str (format-term body)))
       (@text claim-str "(define-type " (symbol-to-text name) " " body-str ")")))
    ((algebraic-type-definition mod name type-constructor data-constructors location)
     (let ((tc-name (type-constructor-name type-constructor))
           (tc-params (type-constructor-parameters type-constructor))
           (ctors-str (text-join " " (list-map format-data-constructor data-constructors))))
       (if (list-is-empty tc-params)
         (@text "(define-enum " (symbol-to-text tc-name) " " ctors-str ")")
         (@text "(define-enum (" (symbol-to-text tc-name) " "
                  (text-join " " (list-map symbol-to-text tc-params)) ") "
                  ctors-str ")"))))
    ((opaque-type-definition mod name type-constructor representation-type interface-entries location)
     (let ((tc-name (symbol-to-text name))
           (tc-params (type-constructor-parameters type-constructor))
           (repr-str (format-term representation-type))
           (ifaces-str (text-join " "
                         (list-map (lambda (entry)
                                     (@text "(" (symbol-to-text (interface-entry-name entry)) " "
                                              (format-term (interface-entry-type entry)) ")"))
                           interface-entries))))
       (if (list-is-empty tc-params)
         (@text "(define-opaque-type " tc-name " " repr-str " " ifaces-str ")")
         (@text "(define-opaque-type (" tc-name " "
                  (text-join " " (list-map symbol-to-text tc-params)) ") "
                  repr-str " " ifaces-str ")"))))))

(define (format-data-constructor data-constructor)
  (let ((name-str (symbol-to-text (data-constructor-name data-constructor)))
        (fields (data-constructor-fields data-constructor)))
    (if (list-is-empty fields)
      (@text "(" name-str ")")
      (@text "(" name-str " "
               (text-join " "
                 (list-map (lambda (field)
                             (let ((fn (symbol-to-text (data-field-name field)))
                                   (ft (format-term (data-field-type field))))
                               (if (equal ft "")
                                 fn
                                 (@text "(" fn " " ft ")"))))
                   fields)) ")"))))

(define (format-definition-claim mod name)
  (let ((claimed-entry (mod-lookup-claimed-entry mod name)))
    (if (not (is-nothing claimed-entry))
      (let ((term (claimed-entry-term (just-value claimed-entry))))
        (@text "(claim " (symbol-to-text name) " " (format-term term) ") "))
      (let ((inferred-type (mod-lookup-inferred-type mod name)))
        (if (not (is-nothing inferred-type))
          (@text "(claim " (symbol-to-text name) " "
                   (format-type (just-value inferred-type)) ") ")
          "")))))

(claim definition-mod-name (-> definition-t symbol-t))
(define (definition-mod-name definition)
  (match definition
    ((primitive-function-declaration mod name arity location)
     (mod-name mod))
    ((primitive-variable-declaration mod name location)
     (mod-name mod))
    ((function-definition mod name parameters body location)
     (mod-name mod))
    ((variable-definition mod name body location)
     (mod-name mod))
    ((test-definition mod name body location)
     (mod-name mod))
    ((type-definition mod name parameters body location)
     (mod-name mod))
    ((algebraic-type-definition mod name type-constructor data-constructors location)
     (mod-name mod))
    ((opaque-type-definition mod name type-constructor representation-type interface-entries location)
     (mod-name mod))))

(claim definition-name (-> definition-t symbol-t))
(define (definition-name definition)
  (match definition
    ((primitive-function-declaration mod name arity location)
     name)
    ((primitive-variable-declaration mod name location)
     name)
    ((function-definition mod name parameters body location)
     name)
    ((variable-definition mod name body location)
     name)
    ((test-definition mod name body location)
     name)
    ((type-definition mod name parameters body location)
     name)
    ((algebraic-type-definition mod name type-constructor data-constructors location)
     name)
    ((opaque-type-definition mod name type-constructor representation-type interface-entries location)
     name)))
