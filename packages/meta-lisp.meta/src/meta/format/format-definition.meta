(module meta)

(claim format-definition (-> definition-t string-t))
(define (format-definition definition)
  (match definition
    ((primitive-function-declaration mod name arity location)
     (@string "(declare-primitive-function "
               (symbol-to-string name) " "
               (format-as-sexp arity) ")"))
    ((primitive-variable-declaration mod name location)
     (@string "(declare-primitive-variable " (symbol-to-string name) ")"))
     ((function-definition mod name parameters body location)
      (= claim-str (format-definition-claim mod name))
      (= params-str (string-join " " (list-map symbol-to-string parameters)))
      (= body-str (format-term body))
      (@string claim-str
               "(define (" (symbol-to-string name) " "
               params-str ") " body-str ")"))
     ((variable-definition mod name body location)
      (= claim-str (format-definition-claim mod name))
      (= body-str (format-term body))
      (@string claim-str
               "(define " (symbol-to-string name)
               " " body-str ")"))
     ((test-definition mod name body location)
      (= claim-str (format-definition-claim mod name))
      (= body-str (format-term body))
      (@string claim-str "(define-test " (symbol-to-string name) " " body-str ")"))
     ((type-definition mod name parameters body location)
      (= claim-str (format-definition-claim mod name))
      (= body-str (format-term body))
      (@string claim-str "(define-type " (symbol-to-string name) " " body-str ")"))
     ((algebraic-type-definition mod name type-constructor data-constructors location)
     (= tc-name (type-constructor-name type-constructor))
     (= tc-params (type-constructor-parameters type-constructor))
     (= ctors-str (string-join " " (list-map format-data-constructor data-constructors)))
     (if (list-empty? tc-params)
       (@string "(define-enum " (symbol-to-string tc-name) " " ctors-str ")")
       (@string "(define-enum (" (symbol-to-string tc-name) " "
                (string-join " " (list-map symbol-to-string tc-params)) ") "
                ctors-str ")")))
     ((opaque-type-definition mod name type-constructor representation-type interface-entries location)
      (= tc-name (symbol-to-string name))
      (= tc-params (type-constructor-parameters type-constructor))
      (= repr-str (format-term representation-type))
      (= ifaces-str (string-join " " (list-map (lambda (entry)
          (@string "(" (symbol-to-string (interface-entry-name entry)) " "
                   (format-term (interface-entry-type entry)) ")"))
        interface-entries)))
      (if (list-empty? tc-params)
        (@string "(define-opaque-type " tc-name " " repr-str " " ifaces-str ")")
        (@string "(define-opaque-type (" tc-name " "
                 (string-join " " (list-map symbol-to-string tc-params)) ") "
                 repr-str " " ifaces-str ")")))))

(define (format-data-constructor data-constructor)
  (= name-str (symbol-to-string (data-constructor-name data-constructor)))
  (= fields (data-constructor-fields data-constructor))
  (if (list-empty? fields)
    name-str
    (@string "(" name-str " "
             (string-join " " (list-map (lambda (field)
                 (= fn (symbol-to-string (data-field-name field)))
                 (= ft (format-term (data-field-type field)))
                 (if (equal? ft "")
                   fn
                   (@string "(" fn " " ft ")")))
               fields)) ")")))

(define (format-definition-claim mod name)
  (= claimed-entry (mod-lookup-claimed-entry mod name))
  (if (not (nothing? claimed-entry))
    (let ((term (claimed-entry-term (just-value claimed-entry))))
      (@string "(claim " (symbol-to-string name) " " (format-term term) ") "))
    (let ((inferred-type (mod-lookup-inferred-type mod name)))
      (if (not (nothing? inferred-type))
        (@string "(claim " (symbol-to-string name) " "
                 (format-type (just-value inferred-type)) ") ")
        ""))))

(claim definition-mod-name (-> definition-t symbol-t))
(define (definition-mod-name definition)
  (match definition
    ((primitive-function-declaration mod name arity location)
     (mod-name mod))
    ((primitive-variable-declaration mod name location)
     (mod-name mod))
    ((function-definition mod name parameters body location)
     (mod-name mod))
    ((variable-definition mod name body location)
     (mod-name mod))
    ((test-definition mod name body location)
     (mod-name mod))
    ((type-definition mod name parameters body location)
     (mod-name mod))
    ((algebraic-type-definition mod name type-constructor data-constructors location)
     (mod-name mod))
    ((opaque-type-definition mod name type-constructor representation-type interface-entries location)
     (mod-name mod))))

(claim definition-name (-> definition-t symbol-t))
(define (definition-name definition)
  (match definition
    ((primitive-function-declaration mod name arity location)
     name)
    ((primitive-variable-declaration mod name location)
     name)
    ((function-definition mod name parameters body location)
     name)
    ((variable-definition mod name body location)
     name)
    ((test-definition mod name body location)
     name)
    ((type-definition mod name parameters body location)
     name)
    ((algebraic-type-definition mod name type-constructor data-constructors location)
     name)
    ((opaque-type-definition mod name type-constructor representation-type interface-entries location)
     name)))
