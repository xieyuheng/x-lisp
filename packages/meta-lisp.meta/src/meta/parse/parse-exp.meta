(module meta)

(claim parse-exp
  (-> sexp-t
      exp-t))

(define (parse-exp sexp)
  (match sexp
    ((symbol-sexp content location)
     (let ((text (symbol-to-text content)))
       (if (text-include text "/")
          (parse-qualified-var-exp text location)
          (var-exp content location))))
    ((text-sexp content location) (text-exp content location))
    ((int-sexp content location) (int-exp content location))
    ((float-sexp content location) (float-exp content location))
    ((list-sexp elements location) (parse-compound-exp elements location))))

(claim parse-qualified-var-exp
  (-> text-t source-location-t
      exp-t))

(define (parse-qualified-var-exp text location)
  (let ((parts (text-split text "/")))
    (cond
      ((equal (list-length parts) 3)
       (@comment
         <package-name>/<module-name>/<name>)
       (qualified-var-exp
         (text-to-symbol (list-get parts 0))
         (text-to-symbol (list-get parts 1))
         (text-to-symbol (list-get parts 2))
         location))
      ((equal (list-length parts) 2)
       (@comment
         <module-name>/<name>)
       (qualified-var-exp
         'self
         (text-to-symbol (list-get parts 0))
         (text-to-symbol (list-get parts 1))
         location))
      (else
       (let ((message "(parse-qualified-var-exp) qualified variable must have one or two /"))
         (error-with-location message location))))))

(define syntax-keywords
  (list-append
    '(lambda @quote if when unless and or cond match multi-match
      begin let letrec @list @set @hash @sexp @text
      -> the all define @comment)
    '(函 @引用 若 当 除非 且 或 若则 匹配 多元匹配
      循序 令 递归令 @列表 @集合 @散列 @符号算式 @文本
      -> 型例 泛型 定义 @注释)))

(claim parse-compound-exp
  (-> (list-t sexp-t) source-location-t
      exp-t))

(define (parse-compound-exp sexps location)
  (cond ((is-symbol-sexp (car sexps))
         (let ((tag (symbol-sexp-content (car sexps))))
           (if (list-some syntax-keywords (equal tag))
             (let ((keyword-location (symbol-sexp-location (car sexps))))
               (parse-special-form-exp tag (cdr sexps) location keyword-location))
             (parse-apply-exp (car sexps) (cdr sexps) location))))
        (else (parse-apply-exp (car sexps) (cdr sexps) location))))

(claim parse-apply-exp
  (-> sexp-t (list-t sexp-t) source-location-t
      exp-t))

(define (parse-apply-exp target args location)
  (apply-exp (parse-exp target)
             (list-map args parse-exp)
             location))

(claim parse-special-form-exp
  (-> symbol-t (list-t sexp-t) source-location-t source-location-t
      exp-t))

(define (parse-special-form-exp tag sexps location keyword-location)
  (cond
    ((list-has '(lambda 函) tag)
     (@comment
       (lambda (<parameter> ...)
         <body>))
     (lambda-exp (parse-parameters (car sexps))
       (parse-body (cdr sexps) location)
       keyword-location))
    ((list-has '(@quote @引用) tag)
     (@comment
       (@quote <sexp>))
     (quote-exp (car sexps) location))
    ((list-has '(@sexp @符号算式) tag)
     (@comment
       (@sexp <sexp>))
     (sexp-exp (car sexps) location))
    ((list-has '(if 若) tag)
     (@comment
       (if <condition>
         <consequent>
         <alternative>))
     (if-exp (parse-exp (car sexps))
       (parse-exp (list-get sexps 1))
       (parse-exp (list-get sexps 2))
       keyword-location))
    ((list-has '(when 当) tag)
     (@comment
       (when <condition>
         <body>))
     (when-exp (parse-exp (car sexps))
       (parse-body (cdr sexps) location)
       keyword-location))
    ((list-has '(unless 除非) tag)
     (@comment
       (unless <condition>
         <body>))
     (unless-exp (parse-exp (car sexps))
       (parse-body (cdr sexps) location)
       keyword-location))
    ((list-has '(and 且) tag)
     (@comment
       (and <exp> ...))
     (and-exp (list-map sexps parse-exp) keyword-location))
    ((list-has '(or 或) tag)
     (@comment
       (or <exp> ...))
     (or-exp (list-map sexps parse-exp) keyword-location))
    ((list-has '(cond 若则) tag)
     (@comment
       (cond
         (<question> <answer>)
         ...))
     (cond-exp (list-map sexps parse-cond-clause) keyword-location))
    ((list-has '(match 匹配) tag)
     (@comment
       (match <target>
         (<pattern> <body>)
         ...))
     (match-exp (@list (parse-exp (car sexps)))
       (list-map (cdr sexps) parse-match-clause)
       keyword-location))
    ((list-has '(multi-match 多元匹配) tag)
     (@comment
       (multi-match (<target> ...)
         ((<pattern> ...) <body>)
         ...))
     (match-exp (list-map (list-sexp-elements (car sexps)) parse-exp)
       (list-map (cdr sexps) parse-multi-match-clause)
       keyword-location))
    ((list-has '(begin 循序) tag)
     (@comment
       (begin <body>))
     (parse-body sexps keyword-location))
    ((list-has '(let 令) tag)
     (@comment
       (let ((<name> <exp>)
             ...)
         <body>))
     (let-exp (parse-bindings (car sexps))
       (parse-body (cdr sexps) location)
       keyword-location))
    ((list-has '(letrec 递归令) tag)
     (@comment
       (letrec ((<name> <exp>)
                ...)
         <body>))
     (letrec-exp (parse-bindings (car sexps))
       (parse-body (cdr sexps) location)
       keyword-location))
    ((list-has '(define 定义) tag)
     (cond ((is-list-sexp (car sexps))
            (@comment
              (define (<name> <parameter> ...) <body>))
            (local-define-exp
              (symbol-sexp-content (car (list-sexp-elements (car sexps))))
              (list-map (cdr (list-sexp-elements (car sexps))) symbol-sexp-content)
              (parse-body (cdr sexps) location)
              keyword-location))
           (else
            (@comment
              (define <name> <exp>))
            (local-define-exp
              (symbol-sexp-content (car sexps))
              (@list)
              (parse-body (cdr sexps) location)
              keyword-location))))
    ((list-has '(@list @列表) tag)
     (@comment
       (@list <exp> ...))
     (list-exp (list-map sexps parse-exp) location))
    ((list-has '(@array @数组) tag)
     (@comment
       (@array <exp> ...))
     (array-exp (list-map sexps parse-exp) location))
    ((list-has '(@text @文本) tag)
     (@comment
       (@text <exp> ...))
     (text-concat-exp (list-map sexps parse-exp) location))
    ((list-has '(@set @集合) tag)
     (@comment
       (@set <exp> ...))
     (set-exp (list-map sexps parse-exp) location))
    ((list-has '(@hash @散列) tag)
     (@comment
       (@hash <key> <value> ...))
     (hash-exp (parse-hash-entries sexps) location))
    ((equal tag '->)
     (@comment
       (-> <arg-type> ... <ret-type>))
     (arrow-exp (list-map (list-but-last sexps) parse-exp)
       (parse-exp (list-last sexps))
       location))
    ((list-has '(the 型例) tag)
     (@comment
       (the <type> <exp>))
     (the-exp (parse-exp (car sexps))
       (parse-exp (list-get sexps 1))
       location))
    ((list-has '(all 泛型) tag)
     (@comment
       (all (<type-parameter> ...)
         <type>))
     (all-exp (parse-parameters (car sexps))
       (parse-exp (list-get sexps 1))
       location))
    ((list-has '(@comment @注释) tag)
     (@comment
       (@comment <sexp> ...))
     (comment-exp sexps location))))

(claim parse-parameters
  (-> sexp-t
      (list-t symbol-t)))

(define (parse-parameters sexp)
  (let ((elements (list-sexp-elements sexp)))
    (list-map elements symbol-sexp-content)))

(claim parse-body
  (-> (list-t sexp-t) source-location-t
      exp-t))

(define (parse-body sexps location)
  (let ((exps (list-map sexps parse-exp)))
    (if (equal (list-length exps) 1)
      (car exps)
      (begin-exp exps location))))

(claim parse-cond-clause
  (-> sexp-t
      cond-clause-t))

(define (parse-cond-clause sexp)
  (match sexp
    ((list-sexp elements location)
     (if (and (is-symbol-sexp (car elements))
              (list-has '(else 否则) (symbol-sexp-content (car elements))))
       (make-cond-clause (qualified-var-exp 'meta-builtin 'builtin 'true location)
                         (parse-body (cdr elements) location)
                         location)
       (make-cond-clause (parse-exp (car elements))
                         (parse-body (cdr elements) location)
                         location)))))

(claim parse-match-clause
  (-> sexp-t
      match-clause-t))

(define (parse-match-clause sexp)
  (match sexp
    ((list-sexp elements location)
     (make-match-clause (@list (parse-exp (car elements)))
                        (parse-body (cdr elements) location)
                        location))))

(claim parse-multi-match-clause
  (-> sexp-t
      match-clause-t))

(define (parse-multi-match-clause sexp)
  (match sexp
    ((list-sexp elements location)
     (make-match-clause (list-map (list-sexp-elements (car elements)) parse-exp)
                        (parse-body (cdr elements) location)
                        location))))

(claim parse-binding
  (-> sexp-t
      binding-t))

(define (parse-binding sexp)
  (match sexp
    ((list-sexp elements location)
     (make-binding (symbol-sexp-content (car elements))
                   (parse-exp (car (cdr elements)))
                   location))))

(claim parse-bindings
  (-> sexp-t
      (list-t binding-t)))

(define (parse-bindings sexp)
  (list-map (list-sexp-elements sexp) parse-binding))

(claim parse-hash-entries
  (-> (list-t sexp-t)
      (list-t (pair-t exp-t exp-t))))

(define (parse-hash-entries sexps)
  (if (list-is-empty sexps)
    (@list)
    (let ((key (car sexps))
          (value (car (cdr sexps)))
          (rest (cdr (cdr sexps))))
      (cons (make-pair (parse-exp key) (parse-exp value))
        (parse-hash-entries rest)))))
