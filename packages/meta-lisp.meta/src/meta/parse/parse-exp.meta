(module meta)

(claim parse-exp
  (-> sexp-t
      exp-t))

(define (parse-exp sexp)
  (match sexp
    ((symbol-sexp content location)
     (= string (symbol-to-string content))
     (if (string-contains? "/" string)
       (parse-qualified-var-exp string location)
       (var-exp content location)))
    ((keyword-sexp content location) (keyword-exp content location))
    ((string-sexp content location) (string-exp content location))
    ((int-sexp content location) (int-exp content location))
    ((float-sexp content location) (float-exp content location))
    ((list-sexp elements location) (parse-compound-exp elements location))))

(claim parse-qualified-var-exp
  (-> string-t source-location-t
      exp-t))

(define (parse-qualified-var-exp string location)
  (= parts (string-split "/" string))
  (cond ((equal? (list-length parts) 3)
         (@comment <package-name>/<module-name>/<name>)
         (qualified-var-exp
           (string-to-symbol (list-get 0 parts))
           (string-to-symbol (list-get 1 parts))
           (string-to-symbol (list-get 2 parts))
           location))
        ((equal? (list-length parts) 2)
         (@comment <module-name>/<name>)
         (qualified-var-exp
           'self
           (string-to-symbol (list-get 0 parts))
           (string-to-symbol (list-get 1 parts))
           location))
        (else
          (= message "(parse-qualified-var-exp) qualified variable must have one or two /")
          (error-with-location message location))))

(define syntax-keywords
  ['lambda '@quote 'if 'when 'unless 'and 'or 'cond 'match 'match-many
   'begin 'let 'let* 'letrec 'letrec* '@list '@square-bracket '@set '@hash '@sexp '@string
   '-> 'the 'polymorphic 'pipe 'chain 'compose 'define '@comment])

(claim parse-compound-exp
  (-> (list-t sexp-t) source-location-t
      exp-t))

(define (parse-compound-exp elements location)
  (cond ((symbol-sexp? (list-head elements))
         (= tag (symbol-sexp-content (list-head elements)))
         (if (list-some? (equal? tag) syntax-keywords)
           (parse-special-form-exp tag elements location)
           (parse-apply-exp elements location)))
        (else (parse-apply-exp elements location))))

(claim parse-apply-exp
  (-> (list-t sexp-t) source-location-t
      exp-t))

(define (parse-apply-exp sexps location)
  (apply-exp (parse-exp (car sexps))
             (list-map parse-exp (cdr sexps))
             location))

(claim parse-special-form-exp
  (-> symbol-t (list-t sexp-t) source-location-t
      exp-t))

(define (parse-special-form-exp tag sexps location)
  (cond ((equal? tag 'lambda)
         (@comment (lambda (<parameter> ...)
                     <body>))
         (lambda-exp (parse-parameters (list-get 1 sexps))
                     (parse-body (list-drop 2 sexps) location)
                     location))
        ((equal? tag '@quote)
         (@comment (@quote <sexp>))
         (quote-exp (list-get 1 sexps) location))
        ((equal? tag '@sexp)
         (@comment (@sexp <sexp>))
         (sexp-exp (list-get 1 sexps) location))
        ((equal? tag 'if)
         (@comment (if <condition>
                     <consequent>
                     <alternative>))
         (if-exp (parse-exp (list-get 1 sexps))
                 (parse-exp (list-get 2 sexps))
                 (parse-exp (list-get 3 sexps))
                 location))
        ((equal? tag 'when)
         (@comment (when <condition>
                     <body>))
         (when-exp (parse-exp (list-get 1 sexps))
                   (parse-body (list-drop 2 sexps) location)
                   location))
        ((equal? tag 'unless)
         (@comment (unless <condition>
                     <body>))
         (unless-exp (parse-exp (list-get 1 sexps))
                     (parse-body (list-drop 2 sexps) location)
                     location))
        ((equal? tag 'and)
         (@comment (and <exp> ...))
         (and-exp (list-map parse-exp (list-drop 1 sexps)) location))
        ((equal? tag 'or)
         (@comment (or <exp> ...))
         (or-exp (list-map parse-exp (list-drop 1 sexps)) location))
        ((equal? tag 'cond)
         (@comment (cond
                     (<question> <answer>)
                     ...))
         (cond-exp (list-map parse-cond-clause (list-drop 1 sexps)) location))
        ((equal? tag 'match)
         (@comment (match <target>
                     (<pattern> <body>)
                     ...))
         (match-exp [(parse-exp (list-get 1 sexps))]
                    (list-map parse-match-clause (list-drop 2 sexps))
                    location))
        ((equal? tag 'match-many)
         (@comment (match-many (<target> ...)
                     ((<pattern> ...) <body>)
                     ...))
         (match-exp (list-map parse-exp (list-sexp-elements (list-get 1 sexps)))
                    (list-map parse-match-many-clause (list-drop 2 sexps))
                    location))
        ((equal? tag '=)
         (@comment (= <name> <exp>))
         (assign-exp (symbol-sexp-content (list-get 1 sexps))
                     (parse-exp (list-get 2 sexps))
                     location))
        ((equal? tag 'begin)
         (@comment (begin <body>))
         (parse-body (list-drop 1 sexps) location))
        ((equal? tag 'let)
         (@comment (let ((<name> <exp>)
                         ...)
                     <body>))
         (let-exp (parse-bindings (list-get 1 sexps))
                  (parse-body (list-drop 2 sexps) location)
                  location))
        ((equal? tag 'let*)
         (@comment (let* ((<name> <exp>)
                          ...)
                     <body>))
         (let-star-exp (parse-bindings (list-get 1 sexps))
                       (parse-body (list-drop 2 sexps) location)
                       location))
        ((equal? tag 'letrec)
         (@comment (letrec ((<name> <exp>)
                            ...)
                     <body>))
         (letrec-exp (parse-bindings (list-get 1 sexps))
                     (parse-body (list-drop 2 sexps) location)
                     location))
        ((equal? tag 'letrec*)
         (@comment (letrec* ((<name> <exp>)
                             ...)
                     <body>))
         (letrec-star-exp (parse-bindings (list-get 1 sexps))
                          (parse-body (list-drop 2 sexps) location)
                          location))
        ((equal? tag 'define)
         (= head (list-get 1 sexps))
         (= body (list-drop 2 sexps))
         (cond ((list-sexp? head)
                (@comment (define (<name> <parameter> ...) <body>))
                (local-define-exp
                  (symbol-sexp-content (list-head (list-sexp-elements head)))
                  (list-map symbol-sexp-content (list-drop 1 (list-sexp-elements head)))
                  (parse-body body location)
                  location))
               (else
                (@comment (define <name> <exp>))
                 (local-define-exp
                   (symbol-sexp-content head)
                   []
                   (parse-body body location)
                   location))))
        ((equal? tag '@list)
         (@comment (@list <exp> ...))
         (list-exp (list-map parse-exp (list-drop 1 sexps)) location))
        ((equal? tag '@square-bracket)
         (@comment [<exp> ...])
         (list-exp (list-map parse-exp (list-drop 1 sexps)) location))
        ((equal? tag '@string)
         (@comment (@string <exp> ...))
         (string-concat-exp (list-map parse-exp (list-drop 1 sexps)) location))
        ((equal? tag '@set)
         (@comment (@set <exp> ...))
         (set-exp (list-map parse-exp (list-drop 1 sexps)) location))
        ((equal? tag '@hash)
         (@comment (@hash <key> <value> ...))
         (hash-exp (parse-hash-entries (list-drop 1 sexps)) location))
        ((equal? tag '->)
         (@comment (-> <arg-type> ... <ret-type>))
         (arrow-exp (list-map parse-exp (list-init (list-drop 1 sexps)))
                    (parse-exp (list-last (list-drop 1 sexps)))
                    location))
        ((equal? tag 'the)
         (@comment (the <type> <exp>))
         (the-exp (parse-exp (list-get 1 sexps))
                  (parse-exp (list-get 2 sexps))
                  location))
        ((equal? tag 'polymorphic)
         (@comment (polymorphic (<type-parameter> ...)
                     <type>))
         (polymorphic-exp (parse-parameters (list-get 1 sexps))
                          (parse-exp (list-get 2 sexps))
                          location))
        ((equal? tag 'pipe)
         (@comment (pipe <init> <step> ...))
         (pipe-exp (parse-exp (list-get 1 sexps))
                   (list-map parse-exp (list-drop 2 sexps))
                   location))
        ((equal? tag 'chain)
         (@comment (chain <step> ...))
         (chain-exp (list-map parse-exp (list-drop 1 sexps)) location))
        ((equal? tag 'compose)
         (@comment (compose <step> ...))
         (compose-exp (list-map parse-exp (list-drop 1 sexps)) location))
         ((equal? tag '@comment)
          (@comment (@comment <sexp> ...))
          (comment-exp (list-drop 1 sexps) location))))

(claim parse-parameters
  (-> sexp-t
      (list-t symbol-t)))

(define (parse-parameters sexp)
  (let ((elements (list-sexp-elements sexp)))
    (list-map symbol-sexp-content elements)))

(claim parse-body
  (-> (list-t sexp-t) source-location-t
      exp-t))

(define (parse-body sexps location)
  (let ((exps (list-map parse-exp sexps)))
    (if (equal? (list-length exps) 1)
      (car exps)
      (begin-exp exps location))))

(claim parse-cond-clause
  (-> sexp-t
      cond-clause-t))

(define (parse-cond-clause sexp)
  (match sexp
    ((list-sexp elements location)
     (if (and (symbol-sexp? (list-head elements))
              (equal? (symbol-sexp-content (list-head elements)) 'else))
       (make-cond-clause (qualified-var-exp 'meta-builtin 'builtin 'true location)
                         (parse-body (list-drop 1 elements) location)
                         location)
       (make-cond-clause (parse-exp (list-head elements))
                         (parse-body (list-drop 1 elements) location)
                         location)))))

(claim parse-match-clause
  (-> sexp-t
      match-clause-t))

(define (parse-match-clause sexp)
  (match sexp
    ((list-sexp elements location)
     (make-match-clause [(parse-exp (list-head elements))]
                        (parse-body (list-drop 1 elements) location)
                        location))))

(claim parse-match-many-clause
  (-> sexp-t
      match-clause-t))

(define (parse-match-many-clause sexp)
  (match sexp
    ((list-sexp elements location)
     (make-match-clause (list-map parse-exp (list-sexp-elements (list-head elements)))
                        (parse-body (list-drop 1 elements) location)
                        location))))

(claim parse-binding
  (-> sexp-t
      binding-t))

(define (parse-binding sexp)
  (match sexp
    ((list-sexp elements location)
     (make-binding (symbol-sexp-content (list-get 0 elements))
                   (parse-exp (list-get 1 elements))
                   location))))

(claim parse-bindings
  (-> sexp-t
      (list-t binding-t)))

(define (parse-bindings sexp)
  (list-map parse-binding (list-sexp-elements sexp)))

(claim parse-hash-entries
  (-> (list-t sexp-t)
      (list-t (hash-entry-t exp-t exp-t))))

(define (parse-hash-entries sexps)
  (if (list-empty? sexps)
    []
    (let ((key (list-head sexps))
          (value (list-head (list-drop 1 sexps)))
          (rest (list-drop 2 sexps)))
      (cons (make-hash-entry (parse-exp key) (parse-exp value))
            (parse-hash-entries rest)))))
