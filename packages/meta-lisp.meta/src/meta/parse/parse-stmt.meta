(module meta)

(claim parse-stmt
  (-> sexp-t
      (stmt-t exp-t)))

(define (parse-stmt sexp)
  (match sexp
    ((list-sexp elements location)
     (= tag (symbol-sexp-content (list-head elements)))
     (parse-special-form-stmt tag elements location))))

(claim parse-special-form-stmt
  (-> symbol-t (list-t sexp-t) source-location-t
      (stmt-t exp-t)))

(define (parse-special-form-stmt tag sexps location)
  (cond ((equal? tag 'define)
         (parse-define-stmt sexps location))
        ((equal? tag 'define-test)
         (define-test-stmt
           (symbol-sexp-content (list-get 1 sexps))
           (parse-body (list-drop 2 sexps) location)
           location))
        ((equal? tag 'define-type)
         (parse-define-type-stmt sexps location))
        ((equal? tag 'exempt)
         (exempt-stmt
           (list-map symbol-sexp-content (list-drop 1 sexps))
           location))
        ((equal? tag 'private)
         (private-stmt
           (list-map symbol-sexp-content (list-drop 1 sexps))
           location))
        ((equal? tag 'module)
         (declare-module-stmt
           (symbol-sexp-content (list-get 1 sexps))
           location))
        ((equal? tag 'import)
         (import-stmt
           (symbol-sexp-content (list-get 1 sexps))
           (list-map symbol-sexp-content (list-drop 2 sexps))
           location))
        ((equal? tag 'import-as)
         (import-as-stmt
           (symbol-sexp-content (list-get 1 sexps))
           (symbol-sexp-content (list-get 2 sexps))
           location))
        ((equal? tag 'import-all)
         (import-all-stmt
           (symbol-sexp-content (list-get 1 sexps))
           location))
        ((equal? tag 'define-enum)
         (define-enum-stmt
           (parse-type-constructor (list-get 1 sexps))
           (list-map parse-pre-data-constructor (list-drop 2 sexps))
           location))
        ((equal? tag 'define-algebraic-type)
         (parse-define-algebraic-type-stmt sexps location))
        ((equal? tag 'define-struct)
         (define-struct-stmt
           (parse-type-constructor (list-get 1 sexps))
           (list-map parse-pre-data-field (list-drop 2 sexps))
           location))
        ((equal? tag 'define-struct*)
         (define-struct-star-stmt
           (parse-type-constructor (list-get 1 sexps))
           (parse-pre-data-constructor (list-get 2 sexps))
           location))
        ((equal? tag 'define-record-type)
         (parse-define-record-type-stmt sexps location))
        ((equal? tag 'define-opaque-type)
         (parse-define-opaque-type-stmt sexps location))
        ((equal? tag 'claim)
         (claim-stmt
           (symbol-sexp-content (list-get 1 sexps))
           (parse-exp (list-get 2 sexps))
           location))
        ((equal? tag 'claim-type)
         (claim-type-stmt
           (symbol-sexp-content (list-get 1 sexps))
           location))
        ((equal? tag 'admit)
         (admit-stmt
           (symbol-sexp-content (list-get 1 sexps))
           (parse-exp (list-get 2 sexps))
           location))
        ((equal? tag 'declare-primitive-function)
         (declare-primitive-function-stmt
           (symbol-sexp-content (list-get 1 sexps))
           (int-sexp-content (list-get 2 sexps))
           location))
        ((equal? tag 'declare-primitive-variable)
         (declare-primitive-variable-stmt
           (symbol-sexp-content (list-get 1 sexps))
           location))
        ((equal? tag '@comment)
         (comment-stmt
           (list-drop 1 sexps)
           location))))

(claim parse-define-stmt
  (-> (list-t sexp-t) source-location-t
      (stmt-t exp-t)))

(define (parse-define-stmt sexps location)
  (= second (list-get 1 sexps))
  (if (list-sexp? second)
    (define-function-stmt
      (symbol-sexp-content (list-head (list-sexp-elements second)))
      (list-map symbol-sexp-content (list-drop 1 (list-sexp-elements second)))
      (parse-body (list-drop 2 sexps) location)
      location)
    (define-variable-stmt
      (symbol-sexp-content second)
      (parse-body (list-drop 2 sexps) location)
      location)))

(claim parse-define-type-stmt
  (-> (list-t sexp-t) source-location-t
      (stmt-t exp-t)))

(define (parse-define-type-stmt sexps location)
  (= second (list-get 1 sexps))
  (if (list-sexp? second)
    (define-type-stmt
      (symbol-sexp-content (list-head (list-sexp-elements second)))
      (list-map symbol-sexp-content (list-drop 1 (list-sexp-elements second)))
      (parse-body (list-drop 2 sexps) location)
      location)
    (define-type-stmt
      (symbol-sexp-content second)
      []
      (parse-body (list-drop 2 sexps) location)
      location)))

(claim parse-define-algebraic-type-stmt
  (-> (list-t sexp-t) source-location-t
      (stmt-t exp-t)))

(define (parse-define-algebraic-type-stmt sexps location)
  (define-algebraic-type-stmt
    (parse-type-constructor (list-get 1 sexps))
    (list-map parse-algebraic-type-constructor (list-drop 2 sexps))
    location))

(claim parse-define-record-type-stmt
  (-> (list-t sexp-t) source-location-t
      (stmt-t exp-t)))

(define (parse-define-record-type-stmt sexps location)
  (= head (list-get 1 sexps))
  (= ctor-clause (list-get 2 sexps))
  (= predicate (list-get 3 sexps))
  (= accessors (list-get 4 sexps))
  (= ctor-list (list-sexp-elements ctor-clause))
  (= constructor-name (symbol-sexp-content (list-head ctor-list)))
  (= fields-raw (list-drop 1 ctor-list))
  (= accessor-list (list-sexp-elements accessors))
  (= accessor-map (build-accessor-map accessor-list location))
  (= fields
    (pipe fields-raw
      (list-map
        (lambda (field)
          (= field-list (list-sexp-elements field))
          (= name (symbol-sexp-content (list-head field-list)))
          (= type (parse-exp (list-head (list-drop 1 field-list))))
          (make-algebraic-type-field
            name type
            (if (hash-has? name accessor-map)
              (pair-first (hash-get name accessor-map))
              (string-to-symbol
                (@string (symbol-to-string constructor-name) "-" (symbol-to-string name))))
            (if (hash-has? name accessor-map)
              (pair-second (hash-get name accessor-map))
              (nothing))
            location)))))
  (define-record-type-stmt
    (parse-type-constructor head)
    (make-algebraic-type-constructor
      constructor-name fields
      (symbol-sexp-content predicate)
      location)
    location))

(claim build-accessor-map
  (-> (list-t sexp-t) source-location-t
      (hash-t symbol-t (pair-t symbol-t (maybe-t symbol-t)))))
(define (build-accessor-map accessors location)
  (if (list-empty? accessors)
    (@hash)
    (begin
      (= entry (list-sexp-elements (list-head accessors)))
      (= rest (list-drop 1 accessors))
      (= field-name (symbol-sexp-content (list-head entry)))
      (= accessor-name (symbol-sexp-content (list-head (list-drop 1 entry))))
      (= modifier-name (if (int-greater? (list-length entry) 2)
                         (just (symbol-sexp-content (list-head (list-drop 2 entry))))
                         (nothing)))
      (hash-put field-name
                (make-pair accessor-name modifier-name)
                (build-accessor-map rest location)))))

(claim parse-define-opaque-type-stmt
  (-> (list-t sexp-t) source-location-t
      (stmt-t exp-t)))

(define (parse-define-opaque-type-stmt sexps location)
  (= head (list-get 1 sexps))
  (= representation (list-get 2 sexps))
  (= ifaces (list-drop 3 sexps))
  (= type-constructor (parse-type-constructor head))
  (define-opaque-type-stmt
    (pre-type-constructor-name type-constructor)
    (pre-type-constructor-parameters type-constructor)
    (parse-exp representation)
    (list-map
      (lambda (iface)
        (= parts (list-sexp-elements iface))
        (make-pre-interface-entry
          (symbol-sexp-content (list-head parts))
          (parse-exp (list-head (list-drop 1 parts)))
          location))
      ifaces)
    location))

(claim parse-type-constructor
  (-> sexp-t
      pre-type-constructor-t))

(define (parse-type-constructor sexp)
  (match sexp
    ((list-sexp sexps location)
     (make-pre-type-constructor
       (symbol-sexp-content (list-head sexps))
       (list-map symbol-sexp-content (list-drop 1 sexps))))
    ((symbol-sexp content location)
     (make-pre-type-constructor content []))))

(claim parse-pre-data-constructor
  (-> sexp-t
      pre-data-constructor-t))

(define (parse-pre-data-constructor sexp)
  (match sexp
    ((list-sexp sexps location)
     (make-pre-data-constructor
       (symbol-sexp-content (list-head sexps))
       (list-map parse-pre-data-field (list-drop 1 sexps))
       location))))

(claim parse-pre-data-field
  (-> sexp-t
      pre-data-field-t))

(define (parse-pre-data-field sexp)
  (match sexp
    ((list-sexp sexps location)
     (make-pre-data-field
       (symbol-sexp-content (list-head sexps))
       (parse-exp (list-head (list-drop 1 sexps)))
       location))))

(claim parse-algebraic-type-constructor
  (-> sexp-t
      (algebraic-type-constructor-t exp-t)))

(define (parse-algebraic-type-constructor sexp)
  (match sexp
    ((list-sexp sexps location)
     (= group (list-get 0 sexps))
     (= predicate-sexp (list-get 1 sexps))
     (= accessors (list-get 2 sexps))
     (= group-list (list-sexp-elements group))
     (= accessor-list (list-sexp-elements accessors))
     (= accessor-map (build-accessor-map accessor-list location))
     (= name (symbol-sexp-content (list-head group-list)))
     (= fields-raw (list-drop 1 group-list))
     (= fields
       (pipe fields-raw
         (list-map
           (lambda (field)
             (= field-list (list-sexp-elements field))
             (= name (symbol-sexp-content (list-head field-list)))
             (= type (parse-exp (list-head (list-drop 1 field-list))))
             (make-algebraic-type-field
               name type
               (if (hash-has? name accessor-map)
                 (pair-first (hash-get name accessor-map))
                 (string-to-symbol
                   (@string (symbol-to-string name) "-" (symbol-to-string name))))
               (if (hash-has? name accessor-map)
                 (pair-second (hash-get name accessor-map))
                 (nothing))
               location)))))
     (make-algebraic-type-constructor
       name fields
       (symbol-sexp-content predicate-sexp)
       location))))
