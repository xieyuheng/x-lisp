(module meta)

(claim parse-stmt
  (-> sexp-t
      (stmt-t exp-t)))

(define (parse-stmt sexp)
  (match sexp
    ((list-sexp elements location)
     (= tag (symbol-sexp-content (car elements)))
     (parse-special-form-stmt tag (cdr elements) location))))

(claim parse-special-form-stmt
  (-> symbol-t (list-t sexp-t) source-location-t
      (stmt-t exp-t)))

(define (parse-special-form-stmt tag sexps location)
  (cond ((equal? tag 'define)
         (if (list-sexp? (car sexps))
           (define-function-stmt
             (symbol-sexp-content (car (list-sexp-elements (car sexps))))
             (list-map symbol-sexp-content (cdr (list-sexp-elements (car sexps))))
             (parse-body (cdr sexps) location)
             location)
           (define-variable-stmt
             (symbol-sexp-content (car sexps))
             (parse-body (cdr sexps) location)
             location)))
        ((equal? tag 'define-test)
         (define-test-stmt
           (symbol-sexp-content (car sexps))
           (parse-body (cdr sexps) location)
           location))
        ((equal? tag 'define-type)
         (if (list-sexp? (car sexps))
           (define-type-stmt
             (symbol-sexp-content (car (list-sexp-elements (car sexps))))
             (list-map symbol-sexp-content (cdr (list-sexp-elements (car sexps))))
             (parse-body (cdr sexps) location)
             location)
           (define-type-stmt
             (symbol-sexp-content (car sexps))
             []
             (parse-body (cdr sexps) location)
             location)))
        ((equal? tag 'exempt)
         (exempt-stmt
           (list-map symbol-sexp-content sexps)
           location))
        ((equal? tag 'private)
         (private-stmt
           (list-map symbol-sexp-content sexps)
           location))
        ((equal? tag 'module)
         (declare-module-stmt
           (symbol-sexp-content (car sexps))
           location))
        ((equal? tag 'import)
         (import-stmt
           (symbol-sexp-content (car sexps))
           (list-map symbol-sexp-content (cdr sexps))
           location))
        ((equal? tag 'import-as)
         (import-as-stmt
           (symbol-sexp-content (car sexps))
           (symbol-sexp-content (car (cdr sexps)))
           location))
        ((equal? tag 'import-all)
         (import-all-stmt
           (symbol-sexp-content (car sexps))
           location))
        ((equal? tag 'define-enum)
         (define-enum-stmt
           (parse-type-constructor (car sexps))
           (list-map parse-pre-data-constructor (cdr sexps))
           location))
        ((equal? tag 'define-algebraic-type)
         (define-algebraic-type-stmt
           (parse-type-constructor (car sexps))
           (list-map parse-algebraic-type-constructor (cdr sexps))
           location))
        ((equal? tag 'define-struct)
         (define-struct-stmt
           (parse-type-constructor (car sexps))
           (list-map parse-pre-data-field (cdr sexps))
           location))
        ((equal? tag 'define-struct*)
         (define-struct-star-stmt
           (parse-type-constructor (car sexps))
           (parse-pre-data-constructor (car (cdr sexps)))
           location))
        ((equal? tag 'define-record-type)
         (= head (list-get 0 sexps))
         (= ctor-clause (list-get 1 sexps))
         (= predicate (list-get 2 sexps))
         (= accessors (list-get 3 sexps))
         (= ctor-list (list-sexp-elements ctor-clause))
         (= constructor-name (symbol-sexp-content (car ctor-list)))
         (= fields-raw (cdr ctor-list))
         (= accessor-list (list-sexp-elements accessors))
         (= accessor-map (build-accessor-map accessor-list location))
         (= fields
           (pipe fields-raw
             (list-map
               (lambda (field)
                 (= field-list (list-sexp-elements field))
                 (= name (symbol-sexp-content (car field-list)))
                 (= type (parse-exp (car (cdr field-list))))
                 (make-algebraic-type-field
                   name type
                   (if (hash-has? name accessor-map)
                     (pair-first (hash-get name accessor-map))
                     (string-to-symbol
                       (@string (symbol-to-string constructor-name) "-" (symbol-to-string name))))
                   (if (hash-has? name accessor-map)
                     (pair-second (hash-get name accessor-map))
                     (nothing))
                   location)))))
         (define-record-type-stmt
           (parse-type-constructor head)
           (make-algebraic-type-constructor
             constructor-name fields
             (symbol-sexp-content predicate)
             location)
           location))
        ((equal? tag 'define-opaque-type)
         (= head (list-get 0 sexps))
         (= representation (list-get 1 sexps))
         (= ifaces (list-drop 2 sexps))
         (= type-constructor (parse-type-constructor head))
         (define-opaque-type-stmt
           (pre-type-constructor-name type-constructor)
           (pre-type-constructor-parameters type-constructor)
           (parse-exp representation)
           (list-map
             (lambda (iface)
               (= parts (list-sexp-elements iface))
               (make-pre-interface-entry
                 (symbol-sexp-content (car parts))
                 (parse-exp (car (cdr parts)))
                 location))
             ifaces)
           location))
        ((equal? tag 'claim)
         (claim-stmt
           (symbol-sexp-content (car sexps))
           (parse-exp (car (cdr sexps)))
           location))
        ((equal? tag 'claim-type)
         (claim-type-stmt
           (symbol-sexp-content (car sexps))
           location))
        ((equal? tag 'admit)
         (admit-stmt
           (symbol-sexp-content (car sexps))
           (parse-exp (car (cdr sexps)))
           location))
        ((equal? tag 'declare-primitive-function)
         (declare-primitive-function-stmt
           (symbol-sexp-content (car sexps))
           (int-sexp-content (car (cdr sexps)))
           location))
        ((equal? tag 'declare-primitive-variable)
         (declare-primitive-variable-stmt
           (symbol-sexp-content (car sexps))
           location))
        ((equal? tag '@comment)
         (comment-stmt sexps location))))

(claim build-accessor-map
  (-> (list-t sexp-t) source-location-t
      (hash-t symbol-t (pair-t symbol-t (maybe-t symbol-t)))))

(define (build-accessor-map accessors location)
  (if (list-empty? accessors)
    (make-hash)
    (begin
      (= entry (list-sexp-elements (car accessors)))
      (= rest (cdr accessors))
      (= field-name (symbol-sexp-content (car entry)))
      (= accessor-name (symbol-sexp-content (car (cdr entry))))
      (= modifier-name (if (int-greater? (list-length entry) 2)
                         (just (symbol-sexp-content (car (list-drop 2 entry))))
                         (nothing)))
      (hash-put field-name
                (make-pair accessor-name modifier-name)
                (build-accessor-map rest location)))))

(claim parse-type-constructor
  (-> sexp-t
      pre-type-constructor-t))

(define (parse-type-constructor sexp)
  (match sexp
    ((list-sexp sexps location)
     (make-pre-type-constructor
       (symbol-sexp-content (car sexps))
       (list-map symbol-sexp-content (cdr sexps))))
    ((symbol-sexp content location)
     (make-pre-type-constructor content []))))

(claim parse-pre-data-constructor
  (-> sexp-t
      pre-data-constructor-t))

(define (parse-pre-data-constructor sexp)
  (match sexp
    ((list-sexp sexps location)
     (make-pre-data-constructor
       (symbol-sexp-content (car sexps))
       (list-map parse-pre-data-field (cdr sexps))
       location))))

(claim parse-pre-data-field
  (-> sexp-t
      pre-data-field-t))

(define (parse-pre-data-field sexp)
  (match sexp
    ((list-sexp sexps location)
     (make-pre-data-field
       (symbol-sexp-content (car sexps))
       (parse-exp (car (cdr sexps)))
       location))))

(claim parse-algebraic-type-constructor
  (-> sexp-t
      (algebraic-type-constructor-t exp-t)))

(define (parse-algebraic-type-constructor sexp)
  (match sexp
    ((list-sexp sexps location)
     (= group (list-get 0 sexps))
     (= predicate-sexp (list-get 1 sexps))
     (= accessors (list-get 2 sexps))
     (= group-list (list-sexp-elements group))
     (= accessor-list (list-sexp-elements accessors))
     (= accessor-map (build-accessor-map accessor-list location))
     (= name (symbol-sexp-content (car group-list)))
     (= fields-raw (cdr group-list))
     (= fields
       (pipe fields-raw
         (list-map
           (lambda (field)
             (= field-list (list-sexp-elements field))
             (= name (symbol-sexp-content (car field-list)))
             (= type (parse-exp (car (cdr field-list))))
             (make-algebraic-type-field
               name type
               (if (hash-has? name accessor-map)
                 (pair-first (hash-get name accessor-map))
                 (string-to-symbol
                   (@string (symbol-to-string name) "-" (symbol-to-string name))))
               (if (hash-has? name accessor-map)
                 (pair-second (hash-get name accessor-map))
                 (nothing))
               location)))))
     (make-algebraic-type-constructor
       name fields
       (symbol-sexp-content predicate-sexp)
       location))))
