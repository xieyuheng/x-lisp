(module meta)

(claim parse-stmt
  (-> sexp-t
      (stmt-t exp-t)))

(define (parse-stmt sexp)
  (match sexp
    ((list-sexp elements location)
     (unless (is-symbol-sexp (car elements))
       (error-with-location "(parse-stmt) head of stmt should be a symbol" (sexp-location sexp)))
     (let ((tag (symbol-sexp-content (car elements))))
       (parse-special-form-stmt tag (cdr elements) location)))
    (else
      (error-with-location "(parse-stmt) unhandled sexp" (sexp-location sexp)))))

(claim parse-special-form-stmt
  (-> symbol-t (list-t sexp-t) source-location-t
      (stmt-t exp-t)))

(define (parse-special-form-stmt tag sexps location)
  (cond
    ((list-member tag '(define 定义))
     (cond ((is-list-sexp (car sexps))
            (@comment
              (define (<name> <parameter> ...)
                <body>))
            (define-function-stmt
              (symbol-sexp-content (car (list-sexp-elements (car sexps))))
              (list-map symbol-sexp-content (cdr (list-sexp-elements (car sexps))))
              (parse-body (cdr sexps) location)
              location))
           (else
            (@comment
              (define <name> <exp>))
            (define-variable-stmt
              (symbol-sexp-content (car sexps))
              (parse-body (cdr sexps) location)
              location))))
    ((list-member tag '(define-test 定义测试))
     (@comment
       (define-test <test-name> <body>))
     (define-test-stmt
       (symbol-sexp-content (car sexps))
       (parse-body (cdr sexps) location)
       location))
    ((list-member tag '(define-type 定义类型))
     (cond ((is-list-sexp (car sexps))
            (@comment
              (define-type (<type-name> <type-parameter> ...)
                <body>))
            (define-type-stmt
              (symbol-sexp-content (car (list-sexp-elements (car sexps))))
              (list-map symbol-sexp-content (cdr (list-sexp-elements (car sexps))))
              (parse-body (cdr sexps) location)
              location))
           (else
            (@comment
              (define-type <type-name>
                <body>))
            (define-type-stmt
              (symbol-sexp-content (car sexps))
              []
              (parse-body (cdr sexps) location)
              location))))
    ((list-member tag '(exempt 豁免))
     (@comment
       (exempt <name> ...))
     (exempt-stmt
       (list-map symbol-sexp-content sexps)
       location))
    ((list-member tag '(private 私有))
     (@comment
       (private <name> ...))
     (private-stmt
       (list-map symbol-sexp-content sexps)
       location))
    ((list-member tag '(module 模块))
     (@comment
       (module <module-name>))
     (declare-module-stmt
       (symbol-sexp-content (car sexps))
       location))
    ((list-member tag '(import 导入))
     (@comment
       (import <module-name> <name> ...))
     (let ((source (parse-import-source (car sexps))))
       (import-stmt
         (pair-first source)
         (pair-second source)
         (list-map symbol-sexp-content (cdr sexps))
         location)))
    ((list-member tag '(import-as 导入为))
     (@comment
       (import-as <module-name> <prefix>))
     (let ((source (parse-import-source (car sexps))))
       (import-as-stmt
         (pair-first source)
         (pair-second source)
         (symbol-sexp-content (car (cdr sexps)))
         location)))
    ((list-member tag '(import-all 全导入))
     (@comment
       (import-all <module-name>))
     (let ((source (parse-import-source (car sexps))))
       (import-all-stmt
         (pair-first source)
         (pair-second source)
         location)))
    ((list-member tag '(define-enum 定义枚举))
     (@comment
       (define-enum <type-name>
         (<constructor-name> (<field-name> <type>) ...)
         ...)
       (define-enum (<type-name> <type-parameter> ...)
         (<constructor-name> (<field-name> <type>) ...)
         ...))
     (define-enum-stmt
       (parse-pre-type-constructor (car sexps))
       (list-map parse-pre-data-constructor (cdr sexps))
       location))
    ((list-member tag '(define-algebraic-type 定义代数类型))
     (@comment
       (define-algebraic-type <type-name>
         ((<constructor-name> (<field-name> <type>) ...)
          <predicate-name>
          (<field-name> <accessor-name> <modifier-name>)
          ...)
         ...)
       (define-algebraic-type (<type-name> <type-parameter> ...)
         ((<constructor-name> (<field-name> <type>) ...)
          <predicate-name>
          (<field-name> <accessor-name> <modifier-name>)
          ...)
         ...))
     (define-algebraic-type-stmt
       (parse-pre-type-constructor (car sexps))
       (list-map (lambda (sexp)
                   (match sexp
                     ((list-sexp elements location)
                      (parse-explicit-data-constructor elements location))))
         (cdr sexps))
       location))
    ((list-member tag '(define-struct 定义结构))
     (@comment
       (define-struct <type-name>
         (<field-name> <type>)
         ...)
       (define-struct (<type-name> <type-parameter> ...)
         (<field-name> <type>)
         ...))
     (define-struct-stmt
       (parse-pre-type-constructor (car sexps))
       (list-map parse-pre-data-field (cdr sexps))
       location))
    ((list-member tag '(define-struct* 定义结构*))
     (@comment
       (define-struct* <type-name>
         (<constructor-name>
           (<field-name> <type>)
           ...))
       (define-struct* (<type-name> <type-parameter> ...)
         (<constructor-name>
           (<field-name> <type>)
           ...)))
     (define-struct-star-stmt
       (parse-pre-type-constructor (car sexps))
       (parse-pre-data-constructor (car (cdr sexps)))
       location))
    ((list-member tag '(define-record-type 定义记录类型))
     (@comment
       (define-record-type <type-name>
         (<constructor-name> (<field-name> <type>) ...)
         <predicate-name>
         (<field-name> <accessor-name> <modifier-name>)
         ...)
       (define-record-type (<type-name> <type-parameter> ...)
         (<constructor-name> (<field-name> <type>) ...)
         <predicate-name>
         (<field-name> <accessor-name> <modifier-name>)
         ...))
     (define-record-type-stmt
       (parse-pre-type-constructor (car sexps))
       (parse-explicit-data-constructor (cdr sexps) location)
       location))
    ((list-member tag '(define-opaque-type 定义黑盒类型))
     (@comment
       (define-opaque-type <type-name> <representation-type>
         (<interface-name> <interface-type>)
         ...)
       (define-opaque-type (<type-name> <type-parameter> ...) <representation-type>
         (<interface-name> <interface-type>)
         ...))
     (let ((type-constructor (parse-pre-type-constructor (car sexps))))
       (define-opaque-type-stmt
         type-constructor
         (parse-exp (car (cdr sexps)))
         (list-map parse-pre-interface-entry (cdr (cdr sexps)))
         location)))
    ((list-member tag '(claim 声明))
     (@comment
       (claim <name> <type>))
     (claim-stmt
       (symbol-sexp-content (car sexps))
       (parse-exp (car (cdr sexps)))
       location))
    ((list-member tag '(claim-type 声明类型))
     (@comment
       (claim-type <type-name>))
     (claim-type-stmt
       (symbol-sexp-content (car sexps))
       location))
    ((list-member tag '(admit 承认))
     (equal tag 'admit)
     (@comment
       (admit <name> <type>))
     (admit-stmt
       (symbol-sexp-content (car sexps))
       (parse-exp (car (cdr sexps)))
       location))
    ((list-member tag '(declare-primitive-function 声明原语函数))
     (@comment
       (declare-primitive-function <name> <arity>))
     (declare-primitive-function-stmt
       (symbol-sexp-content (car sexps))
       (int-sexp-content (car (cdr sexps)))
       location))
    ((list-member tag '(declare-primitive-variable 声明原语变量))
     (@comment
       (declare-primitive-variable <name>))
     (declare-primitive-variable-stmt
       (symbol-sexp-content (car sexps))
       location))
    ((list-member tag '(@comment @注释))
     (@comment
       (@comment <sexp> ...))
     (comment-stmt sexps location))))

(claim parse-pre-type-constructor
  (-> sexp-t
      pre-type-constructor-t))

(define (parse-pre-type-constructor sexp)
  (match sexp
    ((list-sexp sexps location)
     (make-pre-type-constructor
       (symbol-sexp-content (car sexps))
       (list-map symbol-sexp-content (cdr sexps))
       location))
    ((symbol-sexp content location)
     (make-pre-type-constructor content [] location))))

(claim parse-pre-data-constructor
  (-> sexp-t
      pre-data-constructor-t))

(define (parse-pre-data-constructor sexp)
  (match sexp
    ((list-sexp sexps location)
     (make-pre-data-constructor
       (symbol-sexp-content (car sexps))
       (list-map parse-pre-data-field (cdr sexps))
       location))))

(claim parse-pre-data-field
  (-> sexp-t
      pre-data-field-t))

(define (parse-pre-data-field sexp)
  (match sexp
    ((list-sexp sexps location)
     (make-pre-data-field
       (symbol-sexp-content (car sexps))
       (parse-exp (car (cdr sexps)))
       location))))

(define (parse-pre-interface-entry sexp)
  (match sexp
    ((list-sexp elements location)
     (make-pre-interface-entry
       (symbol-sexp-content (car elements))
       (parse-exp (car (cdr elements)))
       location))))

(claim parse-import-source
  (-> sexp-t
      (pair-t symbol-t symbol-t)))

(define (parse-import-source sexp)
  (let ((raw (symbol-sexp-content sexp))
         (raw-string (symbol-to-string raw))
         (parts (string-split "/" raw-string)))
    (if (equal (list-length parts) 1)
      (make-pair 'self raw)
      (make-pair (string-to-symbol (list-get 0 parts))
        (string-to-symbol (list-get 1 parts))))))

(claim parse-explicit-data-constructor
  (-> (list-t sexp-t) source-location-t
      (explicit-data-constructor-t exp-t)))

(define (parse-explicit-data-constructor sexps location)
  (@comment
    ((<constructor-name> (<field-name> <type>) ...)
     <predicate-name>
     (<field-name> <accessor-name> <modifier-name>)
     ...))
  (let ((data-constructor (parse-pre-data-constructor (car sexps)))
        (field-interface-table (cdr (cdr sexps))))
    (make-explicit-data-constructor
      (pre-data-constructor-name data-constructor)
      (list-map
        (resolve-explicit-data-field field-interface-table)
        (pre-data-constructor-fields data-constructor))
      (symbol-sexp-content (car (cdr sexps)))
      location)))

(claim resolve-explicit-data-field
  (-> (list-t sexp-t) pre-data-field-t
      (explicit-data-field-t exp-t)))

(define (resolve-explicit-data-field table data-field)
  (match data-field
    ((make-pre-data-field name type location)
     (make-explicit-data-field
       name type
       (find-field-accessor-name name table location)
       (find-field-modifier-name name table location)
       location))))

(claim find-field-accessor-name
  (-> symbol-t (list-t sexp-t) source-location-t
      symbol-t))

(define (find-field-accessor-name name table location)
  (if (list-is-empty table)
    (error-with-location "(find-field-accessor-name) missing field interface" location)
    (let ((entry (list-sexp-elements (car table))))
      (if (equal (symbol-sexp-content (car entry)) name)
        (symbol-sexp-content (car (cdr entry)))
        (find-field-accessor-name name (cdr table) location)))))

(claim find-field-modifier-name
  (-> symbol-t (list-t sexp-t) source-location-t
      (maybe-t symbol-t)))

(define (find-field-modifier-name name table location)
  (if (list-is-empty table)
    (error-with-location "(find-field-modifier-name) missing field interface" location)
    (let ((entry (list-sexp-elements (car table))))
      (if (equal (symbol-sexp-content (car entry)) name)
        (if (int-greater (list-length entry) 2)
          (just (symbol-sexp-content (car (list-drop 2 entry))))
          (nothing))
        (find-field-modifier-name name (cdr table) location)))))
