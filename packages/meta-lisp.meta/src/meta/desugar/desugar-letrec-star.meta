(module meta)

(@comment
  desugar (letrec*) to (let) using box

  (letrec* ((x1 e1)
            (x2 e2)
            ...
            (xn en))
    body)

  let [e1 e2 ... en] and body
  have their [x1 x2 ... xn]
  replaced with [(box-get x1) (box-get x2) ... (box-get xn)]

  (let ((x1 (make-box))
        (x2 (make-box))
        ...
        (xn (make-box)))
    (box-put! e1 x1)
    (box-put! e2 x2)
    ...
    (box-put! en xn)
    body))

(claim desugar-letrec-star
  (-> (list-t binding-t) exp-t source-location-t
      exp-t))

(define (desugar-letrec-star bindings body location)
  (= subst-pairs (list-map make-subst-pair bindings))
  (let-exp
    (list-map make-box-binding bindings)
    (begin-exp
      (list-append
        (list-map (make-box-put-exp subst-pairs) bindings)
        [(exp-naive-subst-many body subst-pairs)])
      location)
    location))

(claim make-box-binding
  (-> binding-t
      binding-t))

(define (make-box-binding binding)
  (match binding
    ((make-binding name rhs location)
     (make-binding
       name
       (apply-exp
         (qualified-var-exp 'meta-builtin 'builtin 'make-box location)
         []
         location)
       location))))

(claim make-box-put-exp
  (-> (list-t (pair-t symbol-t exp-t)) binding-t
      exp-t))

(define (make-box-put-exp subst-pairs binding)
  (match binding
    ((make-binding name rhs location)
     (apply-exp
       (qualified-var-exp 'meta-builtin 'builtin 'box-put! location)
       [(exp-naive-subst-many rhs subst-pairs)
        (var-exp name location)]
       location))))

(claim make-subst-pair
  (-> binding-t
      (pair-t symbol-t exp-t)))

(define (make-subst-pair binding)
  (match binding
    ((make-binding name rhs location)
     (make-pair name (make-box-get-exp binding)))))

(claim make-box-get-exp
  (-> binding-t
      exp-t))

(define (make-box-get-exp binding)
  (match binding
    ((make-binding name _ location)
     (apply-exp
       (qualified-var-exp 'meta-builtin 'builtin 'box-get location)
       [(var-exp name location)]
       location))))

(claim exp-naive-subst-many
  (-> exp-t (list-t (pair-t symbol-t exp-t))
      exp-t))

(define (exp-naive-subst-many exp pairs)
  (list-fold-left exp-naive-subst-pair exp pairs))

(claim exp-naive-subst-pair
  (-> exp-t (pair-t symbol-t exp-t)
      exp-t))

(define (exp-naive-subst-pair exp pair)
  (match pair
    ((make-pair name rhs)
     (exp-naive-subst exp name rhs))))
