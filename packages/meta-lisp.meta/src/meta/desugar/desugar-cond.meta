(module meta)

(claim desugar-cond
  (-> (list-t cond-clause-t) source-location-t
      exp-t))

(define (desugar-cond clauses location)
  (if (list-is-empty clauses)
    (apply-exp
      (qualified-var-exp 'meta-builtin 'builtin 'error location)
      [(text-exp "cond mismatch" location)]
      location)
    (let ((head-clause (car clauses))
          (rest-clauses (cdr clauses)))
      (if-exp
        (cond-clause-question head-clause)
        (cond-clause-answer head-clause)
        (desugar-cond rest-clauses location)
        location))))
