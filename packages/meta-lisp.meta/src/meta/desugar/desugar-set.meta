(module meta)

(claim desugar-set
  (-> (list-t exp-t) source-location-t
      exp-t))

(define (desugar-set elements location)
  (let ((used-names (set-union-many (list-map elements exp-occurred-names)))
         (fresh-name (generate-relative-fresh-name used-names 'set))
         (make (apply-exp
                 (qualified-var-exp 'meta-builtin 'builtin 'make-set location)
                 (@list)
                 location))
         (body (list-fold-right
                 elements
                 (var-exp fresh-name location)
                 (lambda (element acc)
                   (begin1-exp
                     (apply-exp
                        (qualified-var-exp 'meta-builtin 'builtin 'set-add location)
                       (@list (var-exp fresh-name location) element)
                       location)
                     acc
                     location)))))
    (let1-exp fresh-name make body location)))
