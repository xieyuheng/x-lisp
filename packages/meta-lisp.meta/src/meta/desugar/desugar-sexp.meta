(module meta)

(claim desugar-sexp
  (-> sexp-t
      exp-t))

(define (desugar-sexp sexp)
  (match sexp
    ((symbol-sexp content location)
     (apply-exp
       (qualified-var-exp 'meta-builtin 'builtin 'symbol-sexp location)
       (@list (symbol-exp content location) (desugar-location location))
       location))
    ((text-sexp content location)
     (apply-exp
       (qualified-var-exp 'meta-builtin 'builtin 'text-sexp location)
       (@list (text-exp content location) (desugar-location location))
       location))
    ((int-sexp content location)
     (apply-exp
       (qualified-var-exp 'meta-builtin 'builtin 'int-sexp location)
       (@list (int-exp content location) (desugar-location location))
       location))
    ((float-sexp content location)
     (apply-exp
       (qualified-var-exp 'meta-builtin 'builtin 'float-sexp location)
       (@list (float-exp content location) (desugar-location location))
       location))
    ((list-sexp elements location)
     (apply-exp
       (qualified-var-exp 'meta-builtin 'builtin 'list-sexp location)
       (@list (list-exp (list-map desugar-sexp elements) location)
        (desugar-location location))
       location))))
