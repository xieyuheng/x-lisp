(module meta)

(claim desugar-sexp
  (-> sexp-t
      exp-t))

(define (desugar-sexp sexp)
  (match sexp
    ((symbol-sexp content location)
     (apply-exp
       (qualified-var-exp 'meta-builtin 'builtin 'symbol-sexp location)
       [(symbol-exp content location) (desugar-location location)]
       location))
    ((text-sexp content location)
     (apply-exp
       (qualified-var-exp 'meta-builtin 'builtin 'text-sexp location)
       [(text-exp content location) (desugar-location location)]
       location))
    ((int-sexp content location)
     (apply-exp
       (qualified-var-exp 'meta-builtin 'builtin 'int-sexp location)
       [(int-exp content location) (desugar-location location)]
       location))
    ((float-sexp content location)
     (apply-exp
       (qualified-var-exp 'meta-builtin 'builtin 'float-sexp location)
       [(float-exp content location) (desugar-location location)]
       location))
    ((keyword-sexp content location)
     (apply-exp
       (qualified-var-exp 'meta-builtin 'builtin 'keyword-sexp location)
       [(keyword-exp content location) (desugar-location location)]
       location))
    ((list-sexp elements location)
     (apply-exp
       (qualified-var-exp 'meta-builtin 'builtin 'list-sexp location)
       [(list-exp (list-map desugar-sexp elements) location)
        (desugar-location location)]
       location))))
