(module meta)

(claim desugar (-> exp-t term-t))
(define (desugar exp)
  (match exp
    ((begin-exp sequence location)
     (desugar (desugar-begin sequence location)))
    ((assign-exp name rhs location)
     (error-with-location
       (string-concat ["[desugar] (=) must occur in the head of (begin)"
                       "\n  exp: " (format-exp exp)])
       location))
    ((local-define-exp name parameters body location)
     (error-with-location
       (string-concat ["[desugar] local (define) must occur in the body of (begin)"
                       "\n  exp: " (format-exp exp)])
       location))
    ((when-exp condition consequent location)
     (if-term (desugar condition)
       (begin1-term
         (desugar consequent)
         (qualified-var-term 'meta-builtin 'builtin 'void location)
         location)
       (qualified-var-term 'meta-builtin 'builtin 'void location)
       location))
    ((unless-exp condition alternative location)
     (if-term (desugar condition)
       (qualified-var-term 'meta-builtin 'builtin 'void location)
       (begin1-term
         (desugar alternative)
         (qualified-var-term 'meta-builtin 'builtin 'void location)
         location)
       location))
    ((and-exp exps location)
     (desugar (desugar-and exps location)))
    ((or-exp exps location)
     (desugar (desugar-or exps location)))
    ((cond-exp clauses location)
     (desugar (desugar-cond clauses location)))
    ((list-exp elements location)
     (desugar (desugar-list elements location)))
    ((set-exp elements location)
     (desugar (desugar-set elements location)))
    ((string-concat-exp elements location)
     (desugar (desugar-string-concat elements location)))
    ((hash-exp entries location)
     (desugar (desugar-hash entries location)))
    ((quote-exp sexp location)
     (desugar (desugar-quote sexp location)))
    ((sexp-exp sexp location)
     (desugar (desugar-sexp sexp)))
    ((comment-exp sexps location)
     (qualified-var-term 'meta-builtin 'builtin 'void location))
    ((pipe-exp target steps location)
     (desugar (desugar-pipe target steps location)))
    ((chain-exp steps location)
     (desugar (desugar-chain steps location)))
    ((compose-exp steps location)
     (desugar (desugar-compose steps location)))
    ((begin1-exp head body location)
     (begin1-term (desugar head) (desugar body) location))
    ((let-star-exp bindings body location)
     (desugar (desugar-let-star bindings body location)))
    ((letrec-exp bindings body location)
     (desugar (desugar-letrec bindings body location)))
    ((letrec-star-exp bindings body location)
     (desugar (desugar-letrec-star bindings body location)))
    ((let-exp bindings body location)
     (desugar (desugar-let bindings body location)))
    ((lambda-exp parameters body location)
     (lambda-term parameters (desugar body) location))
    ((polymorphic-exp parameters body location)
     (polymorphic-term parameters (desugar body) location))
    ;; Core forms — bridge to Term
    ((symbol-exp content location)
     (symbol-term content location))
    ((keyword-exp content location)
     (keyword-term content location))
    ((string-exp content location)
     (string-term content location))
    ((int-exp content location)
     (int-term content location))
    ((float-exp content location)
     (float-term content location))
    ((var-exp name location)
     (var-term name location))
    ((qualified-var-exp pkg-name mod-name name location)
     (qualified-var-term pkg-name mod-name name location))
    ((apply-exp target args location)
     (apply-term (desugar target)
       (list-map desugar args)
       location))
    ((let1-exp name rhs body location)
     (let1-term name (desugar rhs) (desugar body) location))
    ((if-exp condition consequent alternative location)
     (if-term (desugar condition)
       (desugar consequent)
       (desugar alternative)
       location))
    ((arrow-exp arg-types ret-type location)
     (arrow-term (list-map desugar arg-types)
       (desugar ret-type)
       location))
    ((the-exp type instance location)
     (the-term (desugar type) (desugar instance) location))
    ;; Should not appear after LowerMatchPass
    ((match-exp targets clauses location)
     (error-with-location
       "[desugar] unexpected MatchExp"
       location))))
