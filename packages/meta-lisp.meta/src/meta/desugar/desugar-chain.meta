(module meta)

(claim desugar-chain
  (-> (list-t exp-t) source-location-t
      exp-t))

(define (desugar-chain steps location)
  (let ((used-names (set-union-many (list-map exp-occurred-names steps)))
         (fresh-name (generate-relative-fresh-name used-names 'target)))
    (lambda-exp
      [fresh-name]
      (pipe-exp (var-exp fresh-name location) steps location)
      location)))
