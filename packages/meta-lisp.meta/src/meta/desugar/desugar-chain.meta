(module meta)

(claim desugar-chain (-> (list-t exp-t) source-location-t exp-t))
(define (desugar-chain steps location)
  (= used-names
     (list-fold-left (lambda (s e) (set-union s (exp-occurred-names e)))
       (make-set) steps))
  (= target-name (generate-relative-fresh-name 'target used-names))
  (= target (var-exp target-name location))
  (lambda-exp [target-name]
    (pipe-exp target steps location)
    location))
