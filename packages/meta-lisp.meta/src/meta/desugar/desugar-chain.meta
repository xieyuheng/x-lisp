(module meta)

(claim desugar-chain
  (-> (list-t exp-t) source-location-t
      exp-t))

(define (desugar-chain steps location)
  (= used-names (set-union-many (list-map exp-occurred-names steps)))
  (= fresh-name (generate-relative-fresh-name 'target used-names))
  (lambda-exp
    [fresh-name]
    (pipe-exp (var-exp fresh-name location) steps location)
    location))
