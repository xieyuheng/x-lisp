(module meta)

(claim desugar-list
  (-> (list-t exp-t) source-location-t
      exp-t))

(define (desugar-list elements location)
  (list-fold-right
    (lambda (element acc)
      (apply-exp
        (qualified-var-exp 'meta-builtin 'builtin 'cons location)
        (@list element acc)
        location))
    (apply-exp
      (qualified-var-exp 'meta-builtin 'builtin 'make-list location)
      (@list)
      location)
    elements))