(module meta)

(@comment
  desugar (match), the basic idea is:

  (match target
    ((ctor1 v11 v12 ...) body1)
    ((ctor2 v21 v22 ...) body2)
    ...)

  =>

  (cond
    ((is-ctor1 target)
     (let ((v11 (ctor1-accessor1 target))
            (v12 (ctor1-accessor2 target))
            ...)
       body1))
    ((is-ctor2 target)
     (let ((v21 (ctor2-accessor1 target))
            (v22 (ctor2-accessor2 target))
            ...)
       body2))
    ...)

  we first need to generalize

  (match target
    (pattern body)
    ...)

  to

  (match-many (target ...)
    ((pattern ...) body)
    ...)

  when all clause heads are var patterns:

  (match-many (target <target> ...)
    ((v1 <pattern> ...) <body>)
    ((v2 <pattern> ...) <body>)
    ...)

  =>

  (match-many (<target> ...)
    ((<pattern> ...) (let ((v1 target)) <body>))
    ((<pattern> ...) (let ((v2 target)) <body>))
    ...)

  when all clause heads are data patterns:

  (match-many (target <target> ...)
    (((ctor1 x1 ...) <pattern> ...) <body>)
    (((ctor1 y1 ...) <pattern> ...) <body>)
    (((ctor2 x2 ...) <pattern> ...) <body>)
    (((ctor2 y2 ...) <pattern> ...) <body>)
    ...)

  first group by head constructors:

  (match-many (target <target> ...)
    (((ctor1 x1 ...) <pattern> ...) <body>)
    (((ctor1 y1 ...) <pattern> ...) <body>)
    ...)

  (match-many (target <target> ...)
    (((ctor2 x2 ...) <pattern> ...) <body>)
    (((ctor2 y2 ...) <pattern> ...) <body>)
    ...)

  then spread the pattern vars in the data patterns:

  (match-many ((ctor1-accessor1 target) ... <target> ...)
    ((x1 ... <pattern> ...) <body>)
    ((y1 ... <pattern> ...) <body>)
    ...)

  (match-many ((ctor2-accessor1 target) ... <target> ...)
    ((x2 ... <pattern> ...) <body>)
    ((y2 ... <pattern> ...) <body>)
    ...)

  to handled mixed head patterns,
  we first group clauses by head pattern kind.)

(define-struct desugar-match-ctx-t
  (scope fragment-scope-t)
  (current-mod-name symbol-t)
  (algebraic-analysis-report algebraic-analysis-report-t)
  (pkg-name symbol-t))

(claim desugar-match
  (-> desugar-match-ctx-t (list-t exp-t) (list-t match-clause-t) exp-t source-location-t
      exp-t))

(define (desugar-match ctx targets clauses default-exp location)
  (for-list clauses
    (lambda (clause)
      (unless (equal (list-length (match-clause-patterns clause)) (list-length targets))
        (error-with-location
          (@string "(desugar-match) targets length mismatch"
                   "\n  targets: " (format-exps targets)
                   "\n  patterns: " (format-exps (match-clause-patterns clause)))
          location))))
  (cond
    ((list-is-empty clauses) default-exp)
    ((list-is-empty targets) (match-clause-body (car clauses)))
    ((list-every is-var-pattern-clause clauses)
     (desugar-match
       ctx (cdr targets)
       (list-map (desugar-var-pattern-clause (car targets)) clauses)
       default-exp location))
    ((list-every is-data-pattern-clause clauses)
     (cond-exp
       (list-map
         (lambda (group)
           (desugar-data-pattern-clause-group
             ctx group targets default-exp location))
         (group-clauses-by-data-pattern ctx clauses))
       location))
    (else
     (list-fold-right
       (lambda (group folded)
         (desugar-match ctx targets group folded location))
       default-exp
       (group-clauses-by-pattern-kind clauses)))))

(define (desugar-var-pattern-clause target clause)
  (@comment
    target ((v1 <pattern> ...) <body>)
    =>
    ((<pattern> ...) (let ((v1 target)) <body>)))
  (match clause
    ((make-match-clause patterns body location)
     (let ((pattern (car patterns)))
       (unless (is-var-exp pattern)
         (error-with-location
           "(desugar-var-pattern-clause) expect var-pattern"
           (exp-location pattern)))
       (make-match-clause
         (cdr patterns)
         (let1-exp (var-exp-name pattern) target body location)
         location)))))

(define (is-var-pattern-clause clause)
  (and (not (list-is-empty (match-clause-patterns clause)))
       (is-var-pattern (car (match-clause-patterns clause)))))

(define (is-data-pattern-clause clause)
  (and (not (list-is-empty (match-clause-patterns clause)))
       (is-data-pattern (car (match-clause-patterns clause)))))

(define-struct data-pattern-clause-group-t
  (info data-constructor-info-t)
  (clauses (list-t match-clause-t)))

(claim group-clauses-by-data-pattern
  (-> desugar-match-ctx-t (list-t match-clause-t)
      (list-t data-pattern-clause-group-t)))

(define (group-clauses-by-data-pattern ctx clauses)
  (let ((report (desugar-match-ctx-algebraic-analysis-report ctx))
         (infos (algebraic-analysis-report-data-constructor-infos report)))
    (match (lookup-same-algebraic-type-info ctx clauses)
      ((make-algebraic-type-info pkg-name mod-name name constructor-names)
       (swap list-map constructor-names
         (lambda (ctor-name)
           (let ((key (algebraic-key pkg-name mod-name ctor-name))
                  (data-constructor-info (hash-get key infos)))
             (make-data-pattern-clause-group
               data-constructor-info
               (list-select
                 (clause-starts-with-data-constructor ctx data-constructor-info)
                 clauses)))))))))

(define (clause-starts-with-data-constructor ctx info clause)
  (let ((pattern (car (match-clause-patterns clause))))
    (if (not (is-data-pattern pattern))
      false
      (match (resolve-data-pattern-qualified-name ctx pattern)
        ((make-qualified-name pkg-name mod-name name)
         (and (equal (data-constructor-info-pkg-name info) pkg-name)
              (equal (data-constructor-info-mod-name info) mod-name)
              (equal (data-constructor-info-name info) name)))))))

(define (desugar-data-pattern-clause-group ctx group targets default-exp location)
  (@comment
    (match-many (target <target> ...)
      (((ctor1 x1 ...) <pattern> ...) <body>)
      (((ctor1 y1 ...) <pattern> ...) <body>)
      ...)
    then spread the pattern vars in the data patterns:
    (match-many ((ctor1-accessor1 target) ... <target> ...)
      ((x1 ... <pattern> ...) <body>)
      ((y1 ... <pattern> ...) <body>)
      ...))
  (match group
    ((make-data-pattern-clause-group
       (make-data-constructor-info
         pkg-name mod-name type-name name
         accessor-names predicate-name)
       clauses)
      (define (spread-target target)
        (list-map
          (lambda (accessor-name)
            (apply-exp
              (qualified-var-exp pkg-name mod-name accessor-name location)
              [target]
              (exp-location target)))
          accessor-names))
      (make-cond-clause
        (apply-exp
          (qualified-var-exp pkg-name mod-name predicate-name location)
          [(car targets)]
          (exp-location (car targets)))
       (desugar-match
         ctx
         (list-append (spread-target (car targets)) (cdr targets))
         (list-map clause-spread-first-data-pattern clauses)
         default-exp location)
       location))))

(define (clause-spread-first-data-pattern clause)
  (match clause
    ((make-match-clause patterns body location)
     (define (spread-data-pattern pattern)
       (unless (is-data-pattern pattern)
         (error-with-location
           (@string "(spread-data-pattern) expect data pattern"
                    "\n  pattern: " (format-exp pattern))
           (exp-location pattern)))
       (apply-exp-args pattern))
     (make-match-clause
       (list-append (spread-data-pattern (car patterns)) (cdr patterns))
       body
       location))))

(define (resolve-data-pattern-qualified-name ctx pattern)
  (unless (is-data-pattern pattern)
    (error-with-location
      "(resolve-data-pattern-qualified-name) expect data-pattern"
      (exp-location pattern)))
  (let ((target (apply-exp-target pattern)))
    (match target
      ((qualified-var-exp pkg-name mod-name name location)
       (make-qualified-name pkg-name mod-name name))
      ((var-exp name location)
       (let ((scope (desugar-match-ctx-scope ctx))
              (imported-names (fragment-scope-imported-names scope)))
         (match (hash-get-maybe name imported-names)
           ((just qualified-name) qualified-name)
           ((nothing)
            (make-qualified-name
              (desugar-match-ctx-pkg-name ctx)
              (desugar-match-ctx-current-mod-name ctx)
              name)))))
      (else
       (error-with-location
         "(resolve-data-pattern-qualified-name) unhandled target"
         (exp-location target))))))

(define (lookup-same-algebraic-type-info ctx clauses)
  (let ((info (lookup-algebraic-type-info-from-clause ctx (car clauses))))
    (for-list (cdr clauses)
      (lambda (clause)
        (unless (equal info (lookup-algebraic-type-info-from-clause ctx clause))
          (error-with-location
            "(lookup-same-algebraic-type-info) algebraic-type-info mismatch"
            (match-clause-location clause)))))
    info))

(define (lookup-algebraic-type-info-from-clause ctx clause)
  (let ((pattern (car (match-clause-patterns clause))))
    (unless (is-data-pattern pattern)
      (error-with-location
        "(lookup-algebraic-type-info-from-clause) expect data pattern"
        (exp-location pattern)))
    (let ((info (lookup-data-constructor-info-from-pattern ctx pattern))
          (report (desugar-match-ctx-algebraic-analysis-report ctx)))
      (hash-get
        (algebraic-key
          (data-constructor-info-pkg-name info)
          (data-constructor-info-mod-name info)
          (data-constructor-info-type-name info))
        (algebraic-analysis-report-algebraic-type-infos report)))))

(define (lookup-data-constructor-info-from-pattern ctx pattern)
  (unless (is-data-pattern pattern)
    (error-with-location
      "(lookup-data-constructor-info-from-pattern) expect data pattern"
      (exp-location pattern)))
  (match (resolve-data-pattern-qualified-name ctx pattern)
    ((make-qualified-name pkg-name mod-name name)
     (let ((report (desugar-match-ctx-algebraic-analysis-report ctx)))
       (hash-get
         (algebraic-key pkg-name mod-name name)
         (algebraic-analysis-report-data-constructor-infos report))))))

(claim group-clauses-by-pattern-kind
  (-> (list-t match-clause-t)
      (list-t (list-t match-clause-t))))

(define (group-clauses-by-pattern-kind clauses)
  (let ((groups []))
    (for-list clauses
      (lambda (clause)
        (if (list-is-empty groups)
          (ignore (list-push [clause] groups))
          (let ((last (list-last groups)))
            (if (same-pattern-kind clause (list-first last))
              (ignore (list-push clause last))
              (ignore (list-push [clause] groups)))))))
    groups))

(define (same-pattern-kind x y)
  (or (equal (is-var-pattern-clause x) (is-var-pattern-clause y))
      (equal (is-data-pattern-clause x) (is-data-pattern-clause y))))

(define (make-default-exp targets location)
  (apply-exp
    (qualified-var-exp 'meta-builtin 'builtin 'error-with-location location)
    [(string-concat-exp
       (list-concat
         [[(string-exp "pattern mismatch on:" location)]
          (list-map-concat
            (lambda (target)
              [(string-exp " " location)
               (apply-exp
                 (qualified-var-exp 'meta-builtin 'builtin 'format location)
                 [target]
                 location)])
            targets)])
       location)
     (desugar-location location)]
    location))
