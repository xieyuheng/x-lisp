(module meta)

(@comment
  desugar (letrec) to (let) using box

  (letrec ((x1 e1)
           (x2 e2)
           ...
           (xn en))
    body)

  let (@list e1 e2 ... en) and body
  have their (@list x1 x2 ... xn)
  replaced with (@list (box-get x1) (box-get x2) ... (box-get xn))

  (let ((x1 (make-box))
        (x2 (make-box))
        ...
        (xn (make-box)))
    (box-put x1 e1)
    (box-put x2 e2)
    ...
    (box-put xn en)
    body))

(claim desugar-letrec
  (-> (list-t binding-t) exp-t source-location-t
      exp-t))

(define (desugar-letrec bindings body location)
  (let ((box-bindings (list-map bindings make-box-binding))
         (box-get-exps (list-map bindings make-box-get-exp))
         (names (list-map bindings binding-name))
         (exp-box-get-subst (lambda (exp) (exp-naive-subst-many exp names box-get-exps)))
         (new-rhs-exps
           (list-map
             bindings
             (lambda (binding)
               (exp-box-get-subst (binding-rhs binding)))))
         (box-put-exps (list-zip-map new-rhs-exps bindings make-box-put-exp)))
    (let-exp
      box-bindings
      (begin-exp (list-append box-put-exps (@list (exp-box-get-subst body))) location)
      location)))

(define (make-box-binding binding)
  (match binding
    ((make-binding name _ location)
     (make-binding
       name
       (apply-exp
         (qualified-var-exp 'meta-builtin 'builtin 'make-box location)
         (@list)
         location)
       location))))

(define (make-box-get-exp binding)
  (match binding
    ((make-binding name rhs location)
     (apply-exp
       (qualified-var-exp 'meta-builtin 'builtin 'box-get location)
       (@list (var-exp name location))
       location))))

(define (make-box-put-exp value-exp binding)
  (match binding
    ((make-binding name _ location)
     (apply-exp
        (qualified-var-exp 'meta-builtin 'builtin 'box-put location)
       (@list (var-exp name location) value-exp)
       location))))

(claim exp-naive-subst-many
  (-> exp-t (list-t symbol-t) (list-t exp-t)
      exp-t))

(define (exp-naive-subst-many exp names rhs-exps)
  (list-fold-left (list-zip names rhs-exps) exp exp-naive-subst-pair))

(claim exp-naive-subst-pair
  (-> exp-t (pair-t symbol-t exp-t)
      exp-t))

(define (exp-naive-subst-pair exp pair)
  (exp-naive-subst exp (pair-first pair) (pair-second pair)))
