(module meta)

(@comment
  desugar (letrec) to (let) using box

  (letrec ((x1 e1)
           (x2 e2)
           ...
           (xn en))
    body)

  let [e1 e2 ... en] and body
  have their [x1 x2 ... xn]
  replaced with [(box-get x1) (box-get x2) ... (box-get xn)]
  and let [t1 t2 ... tn] be fresh names

  (let ((x1 (make-box))
        (x2 (make-box))
        ...
        (xn (make-box)))
    (let ((t1 e1)
          (t2 e2)
          ...
          (tn en))
      (box-put! t1 x1)
      (box-put! t2 x2)
      ...
      (box-put! tn xn)
      body)))


(claim desugar-letrec
  (-> (list-t binding-t) exp-t source-location-t
      exp-t))

(define (desugar-letrec bindings body location)
  (= used-names
     (set-union
       (exp-occurred-names body)
       (set-union-many
         (list-map (compose exp-occurred-names binding-rhs) bindings))))
  (= names (list-map binding-name bindings))
  (= box-get-exps (make-box-get-exps bindings))
  (= exp-unbox (lambda (exp) (exp-naive-subst-many exp names box-get-exps)))
  (= new-rhs-exps (list-map (compose exp-unbox binding-rhs) bindings))
  (= tmp-bindings (make-tmp-bindings used-names bindings new-rhs-exps))
  (= tmp-var-exps (list-map make-binding-var-exp tmp-bindings))
  (= box-put-exps (make-box-put-exps tmp-var-exps bindings))
  (let-exp
    (list-map make-box-binding bindings)
    (let-exp
      tmp-bindings
      (begin-exp (list-append box-put-exps [(exp-unbox body)]) location)
      location)
    location))

(define (make-tmp-bindings used-names bindings rhs-exps)
  (swap list-map (list-zip bindings rhs-exps)
    (lambda (pair)
      (match pair
        ((make-pair (make-binding name _ location) rhs-exp)
         (make-binding
           (generate-relative-fresh-name (symbol-append name '.value) used-names)
           rhs-exp
           location))))))

(define (make-binding-var-exp binding)
  (match binding
    ((make-binding name _ location)
     (var-exp name location))))
