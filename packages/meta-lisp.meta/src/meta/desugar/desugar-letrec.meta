(module meta)

(@comment
  desugar (letrec) to (let) using box

  (letrec ((x1 e1)
           (x2 e2)
           ...
           (xn en))
    body)

  let [e1 e2 ... en] and body
  have their [x1 x2 ... xn]
  replaced with [(box-get x1) (box-get x2) ... (box-get xn)]

  (let ((x1 (make-box))
        (x2 (make-box))
        ...
        (xn (make-box)))
    (box-put e1 x1)
    (box-put e2 x2)
    ...
    (box-put en xn)
    body))

(claim desugar-letrec
  (-> (list-t binding-t) exp-t source-location-t
      exp-t))

(define (desugar-letrec bindings body location)
  (let ((box-bindings (list-map make-box-binding bindings))
         (box-get-exps (list-map make-box-get-exp bindings))
         (names (list-map binding-name bindings))
         (exp-box-get-subst (lambda (exp) (exp-naive-subst-many exp names box-get-exps)))
         (new-rhs-exps (list-map (compose exp-box-get-subst binding-rhs) bindings))
         (box-put-exps (list-zip-map make-box-put-exp new-rhs-exps bindings)))
    (let-exp
      box-bindings
      (begin-exp (list-append box-put-exps [(exp-box-get-subst body)]) location)
      location)))

(define (make-box-binding binding)
  (match binding
    ((make-binding name _ location)
     (make-binding
       name
       (apply-exp
         (qualified-var-exp 'meta-builtin 'builtin 'make-box location)
         []
         location)
       location))))

(define (make-box-get-exp binding)
  (match binding
    ((make-binding name rhs location)
     (apply-exp
       (qualified-var-exp 'meta-builtin 'builtin 'box-get location)
       [(var-exp name location)]
       location))))

(define (make-box-put-exp value-exp binding)
  (match binding
    ((make-binding name _ location)
     (apply-exp
        (qualified-var-exp 'meta-builtin 'builtin 'box-put location)
       [value-exp (var-exp name location)]
       location))))

(claim exp-naive-subst-many
  (-> exp-t (list-t symbol-t) (list-t exp-t)
      exp-t))

(define (exp-naive-subst-many exp names rhs-exps)
  (list-fold-left exp-naive-subst-pair exp (list-zip names rhs-exps)))

(claim exp-naive-subst-pair
  (-> exp-t (pair-t symbol-t exp-t)
      exp-t))

(define (exp-naive-subst-pair exp pair)
  (exp-naive-subst exp (pair-first pair) (pair-second pair)))
