(module meta)

(claim desugar-letrec (-> (list-t binding-t) exp-t source-location-t exp-t))
(define (desugar-letrec bindings body location)
  (= used-names (exp-occurred-names body))
  (= used-names
     (list-fold-left (lambda (s b) (set-union s (exp-occurred-names (binding-rhs b))))
       used-names bindings))
  (define box-get-exps
    (list-map (lambda (b)
                (let ((loc (binding-location b)))
                  (apply-exp
                    (qualified-var-exp 'meta-builtin 'builtin 'box-get loc)
                    [(var-exp (binding-name b) loc)]
                    loc)))
      bindings))
  (define (subst-all exp bindings-box-get)
    (if (list-empty? bindings-box-get)
      exp
      (let ((pair (list-first bindings-box-get))
            (rest (list-tail bindings-box-get)))
        (subst-all
          (exp-naive-subst exp (pair-first pair) (pair-second pair))
          rest))))
  (define pairs
    (list-map-zip (lambda (b box-get)
                    (make-pair (binding-name b) box-get))
      bindings box-get-exps))
  (define new-rhses (list-map (lambda (rhs) (subst-all rhs pairs))
                     (list-map binding-rhs bindings)))
  (define new-body (subst-all body pairs))
  (define let-bindings
    (list-map (lambda (b)
                (let ((loc (binding-location b)))
                  (make-binding (binding-name b)
                    (apply-exp
                      (qualified-var-exp 'meta-builtin 'builtin 'make-box loc)
                      [] loc)
                    loc)))
      bindings))
  (define fresh-names
    (list-map (lambda (b)
                (generate-relative-fresh-name
                  (string-to-symbol
                    (@string (symbol-to-string (binding-name b)) ".value"))
                  used-names))
      bindings))
  (define inner-bindings
    (list-map-index (lambda (index b)
                      (make-binding (list-get index fresh-names)
                        (list-get index new-rhses)
                        (binding-location b)))
      bindings))
  (define result new-body)
  (define n (list-length bindings))
  (define (build-result i)
    (if (int-less? i 0)
      result
      (begin
        (define b (list-get i bindings))
        (= result
           (begin1-exp
             (apply-exp
               (qualified-var-exp 'meta-builtin 'builtin 'box-put! (binding-location b))
               [(var-exp (list-get i fresh-names) (binding-location b))
                (var-exp (binding-name b) (binding-location b))]
               (binding-location b))
             result
             (binding-location b)))
        (build-result (isub i 1)))))
  (build-result (isub n 1))
  (= result (let-exp inner-bindings result location))
  (let-exp let-bindings result location))
