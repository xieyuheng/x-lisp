(module meta)

(claim desugar-let-star
  (-> (list-t binding-t) exp-t source-location-t
      exp-t))

(define (desugar-let-star bindings body location)
  (cond
    ((list-empty? bindings) body)
    ((list-empty? (cdr bindings))
     (let ((binding (car bindings)))
       (let1-exp
         (binding-name binding)
         (binding-rhs binding)
         body
         location)))
    (else
     (let ((binding (car bindings))
           (rest-bindings (cdr bindings)))
       (let1-exp
         (binding-name binding)
         (binding-rhs binding)
         (desugar-let-star rest-bindings body location)
         location)))))
