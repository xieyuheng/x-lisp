(module meta)

(claim generate-relative-fresh-name
  (-> (set-t symbol-t) symbol-t
      symbol-t))

(define (generate-relative-fresh-name used-names name)
  (if (set-has used-names name)
    (generate-relative-fresh-name-loop used-names name 1)
    name))

(define (generate-relative-fresh-name-loop used-names name n)
  (let ((candidate (symbol-append name (int-to-suffix-symbol n))))
    (if (set-has used-names candidate)
      (generate-relative-fresh-name-loop used-names name (iadd 1 n))
      candidate)))

(define (int-to-suffix-symbol n)
  (text-to-symbol (text-append "." (format-int n))))
