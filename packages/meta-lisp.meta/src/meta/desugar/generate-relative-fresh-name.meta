(module meta)

(claim generate-relative-fresh-name
  (-> (set-t symbol-t) symbol-t
      symbol-t))

(define (generate-relative-fresh-name used-names name)
  (cond ((not (set-member? name used-names)) name)
        (else
         (define (loop n)
           (let ((candidate
                   (string-to-symbol
                     (string-concat
                       [(symbol-to-string name) "." (format-as-sexp n)]))))
             (if (set-member? candidate used-names)
               (loop (iadd 1 n))
               candidate)))
         (loop 1))))
