(module meta)

(define (load-fragment path)
  (let ((code (path-read path))
         (sexps
          (parse-sexps path (make-source-position 0 0 0) code))
         (stmts (list-map sexps parse-stmt))
         (module-stmt (list-find stmts is-declare-module-stmt)))
    (match module-stmt
      ((just (declare-module-stmt name location))
       (make-fragment name path stmts (@list)))
      ((nothing)
       (error "(load-fragment) expect (module) statement in fragment")))))
