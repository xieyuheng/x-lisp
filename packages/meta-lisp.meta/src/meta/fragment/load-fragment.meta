(module meta)

(define (load-fragment path)
  (let ((code (fs-read path))
         (sexps (parse-sexps path code))
         (stmts (list-map parse-stmt sexps))
         (module-stmt (list-find declare-module-stmt? stmts)))
    (match module-stmt
      ((just (declare-module-stmt name location))
       (make-fragment name path stmts []))
      ((nothing)
       (error "(load-fragment) expect (module) statement in fragment")))))
