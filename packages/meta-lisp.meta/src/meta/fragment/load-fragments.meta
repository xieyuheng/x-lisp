(module meta)

(define (load-fragments path)
  (cond
    ((text-has-suffix path ".md")
     (match (load-markdown-fragment path)
       ((just fragment) (@list fragment))
       ((nothing) (@list))))
    ((text-has-suffix path ".meta")
     (@list (load-meta-fragment path)))
    (else
     (error (@text "[load-fragments] unexpected source file extension: " path)))))
