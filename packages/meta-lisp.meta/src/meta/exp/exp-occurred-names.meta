(module meta)

(claim exp-occurred-names
  (-> exp-t
      (set-t symbol-t)))

(define (exp-occurred-names exp)
  (match exp
    ((symbol-exp content location) (make-set))
    ((keyword-exp content location) (make-set))
    ((text-exp content location) (make-set))
    ((int-exp content location) (make-set))
    ((float-exp content location) (make-set))
    ((qualified-var-exp pkg-name mod-name name location) (make-set))
    ((quote-exp sexp location) (make-set))
    ((sexp-exp sexp location) (make-set))
    ((comment-exp content location) (make-set))
    ((var-exp name location) (@set name))
    ((lambda-exp parameters body location)
     (set-union (list-to-set parameters) (exp-occurred-names body)))
    ((all-exp parameters body location)
     (set-union (list-to-set parameters) (exp-occurred-names body)))
    ((let1-exp name rhs body location)
     (set-union-many [(@set name) (exp-occurred-names rhs) (exp-occurred-names body)]))
    ((let-exp bindings body location)
     (set-union
       (set-union-many (list-map binding-occurred-names bindings))
       (exp-occurred-names body)))
    ((letrec-exp bindings body location)
     (set-union
       (set-union-many (list-map binding-occurred-names bindings))
       (exp-occurred-names body)))
    ((local-define-exp name parameters body location)
     (set-union-many [(@set name) (list-to-set parameters) (exp-occurred-names body)]))
    ((apply-exp target args location)
     (set-union
       (exp-occurred-names target)
       (set-union-many (list-map exp-occurred-names args))))
    ((flow-exp target steps location)
     (set-union
       (exp-occurred-names target)
       (set-union-many (list-map exp-occurred-names steps))))
    ((chain-exp steps location)
     (set-union-many (list-map exp-occurred-names steps)))
    ((compose-exp steps location)
     (set-union-many (list-map exp-occurred-names steps)))
    ((begin1-exp head body location)
     (set-union (exp-occurred-names head) (exp-occurred-names body)))
    ((begin-exp sequence location)
     (set-union-many (list-map exp-occurred-names sequence)))
    ((if-exp condition consequent alternative location)
     (set-union-many
       [(exp-occurred-names condition)
        (exp-occurred-names consequent)
        (exp-occurred-names alternative)]))
    ((when-exp condition consequent location)
     (set-union
       (exp-occurred-names condition)
       (exp-occurred-names consequent)))
    ((unless-exp condition alternative location)
     (set-union
       (exp-occurred-names condition)
       (exp-occurred-names alternative)))
    ((and-exp exps location)
     (set-union-many (list-map exp-occurred-names exps)))
    ((or-exp exps location)
     (set-union-many (list-map exp-occurred-names exps)))
    ((cond-exp clauses location)
     (set-union-many
       (list-map
         (lambda (clause)
           (set-union
             (exp-occurred-names (cond-clause-question clause))
             (exp-occurred-names (cond-clause-answer clause))))
         clauses)))
    ((list-exp elements location)
     (set-union-many (list-map exp-occurred-names elements)))
    ((text-concat-exp elements location)
     (set-union-many (list-map exp-occurred-names elements)))
    ((set-exp elements location)
     (set-union-many (list-map exp-occurred-names elements)))
    ((hash-exp entries location)
     (set-union-many
       (list-map
         (lambda (entry)
           (set-union
             (exp-occurred-names (pair-first entry))
             (exp-occurred-names (pair-second entry))))
         entries)))
    ((arrow-exp arg-types ret-type location)
     (set-union
       (set-union-many (list-map exp-occurred-names arg-types))
       (exp-occurred-names ret-type)))
    ((the-exp type instance location)
     (set-union (exp-occurred-names type) (exp-occurred-names instance)))
    ((match-exp targets clauses location)
     (set-union
       (set-union-many (list-map exp-occurred-names targets))
       (set-union-many
         (list-map
           (lambda (clause)
             (set-union
               (set-union-many (list-map exp-occurred-names (match-clause-patterns clause)))
               (exp-occurred-names (match-clause-body clause))))
           clauses))))))

(define (binding-occurred-names binding)
  (match binding
    ((make-binding name rhs location)
     (set-union (@set name) (exp-occurred-names rhs)))))
