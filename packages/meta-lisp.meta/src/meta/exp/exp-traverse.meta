(module meta)

(claim exp-traverse (-> (-> exp-t exp-t) exp-t exp-t))
(define (exp-traverse f exp)
  (match exp
    ((symbol-exp content location) exp)
    ((keyword-exp content location) exp)
    ((string-exp content location) exp)
    ((int-exp content location) exp)
    ((float-exp content location) exp)
    ((var-exp name location) exp)
    ((qualified-var-exp pkg-name mod-name name location) exp)
    ((quote-exp sexp location) exp)
    ((sexp-exp sexp location) exp)
    ((comment-exp content location) exp)
    ((lambda-exp parameters body location)
     (lambda-exp parameters (f body) location))
    ((polymorphic-exp parameters body location)
     (polymorphic-exp parameters (f body) location))
    ((apply-exp target args location)
     (apply-exp (f target) (list-map f args) location))
    ((pipe-exp target steps location)
     (pipe-exp (f target) (list-map f steps) location))
    ((chain-exp steps location)
     (chain-exp (list-map f steps) location))
    ((compose-exp steps location)
     (compose-exp (list-map f steps) location))
    ((let1-exp name rhs body location)
     (let1-exp name (f rhs) (f body) location))
    ((let-exp bindings body location)
     (let-exp (list-map
                (lambda (b)
                  (make-binding (binding-name b) (f (binding-rhs b)) (binding-location b)))
                bindings)
              (f body)
              location))
    ((let-star-exp bindings body location)
     (let-star-exp (list-map (lambda (b)
                               (make-binding (binding-name b) (f (binding-rhs b)) (binding-location b)))
                             bindings)
                   (f body)
                   location))
    ((letrec-exp bindings body location)
     (letrec-exp (list-map (lambda (b)
                             (make-binding (binding-name b) (f (binding-rhs b)) (binding-location b)))
                           bindings)
                 (f body)
                 location))
    ((local-define-exp name parameters body location)
     (local-define-exp name parameters (f body) location))
    ((letrec-star-exp bindings body location)
     (letrec-star-exp (list-map (lambda (b)
                                  (make-binding (binding-name b) (f (binding-rhs b)) (binding-location b)))
                                bindings)
                      (f body)
                      location))
    ((begin1-exp head body location)
     (begin1-exp (f head) (f body) location))
    ((begin-exp sequence location)
     (begin-exp (list-map f sequence) location))
    ((assign-exp name rhs location)
     (assign-exp name (f rhs) location))
    ((when-exp condition consequent location)
     (when-exp (f condition) (f consequent) location))
    ((unless-exp condition alternative location)
     (unless-exp (f condition) (f alternative) location))
    ((and-exp exps location)
     (and-exp (list-map f exps) location))
    ((or-exp exps location)
     (or-exp (list-map f exps) location))
    ((cond-exp clauses location)
     (cond-exp (list-map (lambda (clause)
                           (make-cond-clause (f (cond-clause-question clause))
                                             (f (cond-clause-answer clause))
                                             (cond-clause-location clause)))
                         clauses)
               location))
    ((if-exp condition consequent alternative location)
     (if-exp (f condition) (f consequent) (f alternative) location))
    ((list-exp elements location)
     (list-exp (list-map f elements) location))
    ((string-concat-exp elements location)
     (string-concat-exp (list-map f elements) location))
    ((set-exp elements location)
     (set-exp (list-map f elements) location))
    ((hash-exp entries location)
     (hash-exp (list-map (lambda (entry)
                           (make-hash-entry (f (hash-entry-key entry))
                                            (f (hash-entry-value entry))))
                         entries)
               location))
    ((arrow-exp arg-types ret-type location)
     (arrow-exp (list-map f arg-types) (f ret-type) location))
    ((the-exp type exp2 location)
     (the-exp (f type) (f exp2) location))
    ((match-exp targets clauses location)
     (match-exp (list-map f targets)
                (list-map (lambda (clause)
                            (make-match-clause
                              (list-map f (match-clause-patterns clause))
                              (f (match-clause-body clause))
                              (match-clause-location clause)))
                          clauses)
                location))))
