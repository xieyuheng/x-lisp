(module meta)

(claim exp-location
  (-> exp-t
      source-location-t))

(define (exp-location exp)
  (match exp
    ((symbol-exp content location) location)
    ((keyword-exp content location) location)
    ((text-exp content location) location)
    ((int-exp content location) location)
    ((float-exp content location) location)
    ((var-exp name location) location)
    ((qualified-var-exp pkg-name mod-name name location) location)
    ((apply-exp target args location) location)
    ((pipe-exp target steps location) location)
    ((chain-exp steps location) location)
    ((compose-exp steps location) location)
    ((lambda-exp parameters body location) location)
    ((let1-exp name rhs body location) location)
    ((let-exp bindings body location) location)
    ((letrec-exp bindings body location) location)
    ((local-define-exp name parameters body location) location)
    ((begin1-exp head body location) location)
    ((begin-exp sequence location) location)
    ((if-exp condition consequent alternative location) location)
    ((when-exp condition consequent location) location)
    ((unless-exp condition alternative location) location)
    ((and-exp exps location) location)
    ((or-exp exps location) location)
    ((cond-exp clauses location) location)
    ((list-exp elements location) location)
    ((text-concat-exp elements location) location)
    ((set-exp elements location) location)
    ((hash-exp entries location) location)
    ((quote-exp sexp location) location)
    ((sexp-exp sexp location) location)
    ((arrow-exp arg-types ret-type location) location)
    ((the-exp type exp location) location)
    ((polymorphic-exp parameters body location) location)
    ((match-exp targets clauses location) location)
    ((comment-exp content location) location)))
