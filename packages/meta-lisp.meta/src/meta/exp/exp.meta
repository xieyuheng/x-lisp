(module meta)

(define-enum exp-t
  (symbol-exp (content symbol-t) (location source-location-t))
  (keyword-exp (content keyword-t) (location source-location-t))
  (string-exp (content string-t) (location source-location-t))
  (int-exp (content int-t) (location source-location-t))
  (float-exp (content float-t) (location source-location-t))
  (var-exp (name symbol-t) (location source-location-t))
  (qualified-var-exp (pkg-name symbol-t) (mod-name symbol-t) (name symbol-t) (location source-location-t))
  (lambda-exp (parameters (list-t symbol-t)) (body exp-t) (location source-location-t))
  (apply-exp (target exp-t) (args (list-t exp-t)) (location source-location-t))
  (pipe-exp (target exp-t) (steps (list-t exp-t)) (location source-location-t))
  (chain-exp (steps (list-t exp-t)) (location source-location-t))
  (compose-exp (steps (list-t exp-t)) (location source-location-t))
  (let1-exp (name symbol-t) (rhs exp-t) (body exp-t) (location source-location-t))
  (let-exp (bindings (list-t binding-t)) (body exp-t) (location source-location-t))
  (letrec-exp (bindings (list-t binding-t)) (body exp-t) (location source-location-t))
  (local-define-exp (name symbol-t) (parameters (list-t symbol-t)) (body exp-t) (location source-location-t))
  (begin1-exp (head exp-t) (body exp-t) (location source-location-t))
  (begin-exp (sequence (list-t exp-t)) (location source-location-t))
  (if-exp (condition exp-t) (consequent exp-t) (alternative exp-t) (location source-location-t))
  (when-exp (condition exp-t) (consequent exp-t) (location source-location-t))
  (unless-exp (condition exp-t) (alternative exp-t) (location source-location-t))
  (and-exp (exps (list-t exp-t)) (location source-location-t))
  (or-exp (exps (list-t exp-t)) (location source-location-t))
  (cond-exp (clauses (list-t cond-clause-t)) (location source-location-t))
  (list-exp (elements (list-t exp-t)) (location source-location-t))
  (string-concat-exp (elements (list-t exp-t)) (location source-location-t))
  (set-exp (elements (list-t exp-t)) (location source-location-t))
  (hash-exp (entries (list-t (pair-t exp-t exp-t))) (location source-location-t))
  (quote-exp (sexp sexp-t) (location source-location-t))
  (sexp-exp (sexp sexp-t) (location source-location-t))
  (arrow-exp (arg-types (list-t exp-t)) (ret-type exp-t) (location source-location-t))
  (the-exp (type exp-t) (instance exp-t) (location source-location-t))
  (polymorphic-exp (parameters (list-t symbol-t)) (body exp-t) (location source-location-t))
  (match-exp (targets (list-t exp-t)) (clauses (list-t match-clause-t)) (location source-location-t))
  (comment-exp (sexps (list-t sexp-t)) (location source-location-t)))

(define-struct binding-t
  (name symbol-t)
  (rhs exp-t)
  (location source-location-t))

(define-struct cond-clause-t
  (question exp-t)
  (answer exp-t)
  (location source-location-t))

(define-struct match-clause-t
  (patterns (list-t exp-t))
  (body exp-t)
  (location source-location-t))
