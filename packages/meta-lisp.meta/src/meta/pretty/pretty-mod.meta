(module meta)

(import-as ppml/ppml ppml)

(claim pretty-mod-definitions (-> int-t mod-t text-t))
(define (pretty-mod-definitions width mod)
  (text-join (list-map
      (list-map-concat (hash-values (mod-definitions mod))
        pretty-definition)
      (lambda (node) (ppml/format-node width node)))
    "\n\n"))

(claim pretty-mod-stmts (-> int-t mod-t text-t))
(define (pretty-mod-stmts width mod)
  (text-join (list-map
      (mod-stmts mod)
      (lambda (stmt) (ppml/format-node width (pretty-stmt pretty-exp stmt))))
    "\n\n"))

(claim pretty-fragment-stmts (-> int-t (list-t (stmt-t exp-t)) text-t))
(define (pretty-fragment-stmts width stmts)
  (text-join (list-map
      stmts
      (lambda (stmt) (ppml/format-node width (pretty-stmt pretty-exp stmt))))
    "\n\n"))

(claim pretty-fragment-desugared-stmts (-> int-t (list-t (stmt-t term-t)) text-t))
(define (pretty-fragment-desugared-stmts width stmts)
  (text-join (list-map
      stmts
      (lambda (stmt) (ppml/format-node width (pretty-stmt pretty-term stmt))))
    "\n\n"))

(claim pretty-definitions (-> int-t (list-t definition-t) text-t))
(define (pretty-definitions width definitions)
  (text-join (list-map
      (list-map-concat definitions pretty-definition)
      (lambda (node) (ppml/format-node width node)))
    "\n\n"))
