(module meta)

(import-as ppml/ppml ppml)

(claim pretty-mod-definitions (-> int-t mod-t string-t))
(define (pretty-mod-definitions width mod)
  (string-join "\n\n"
    (list-map
      (lambda (node) (ppml/format-node width node))
      (list-flat-map pretty-definition
        (hash-values (mod-definitions mod))))))

(claim pretty-mod-stmts (-> int-t mod-t string-t))
(define (pretty-mod-stmts width mod)
  (string-join "\n\n"
    (list-map
      (lambda (stmt) (ppml/format-node width (pretty-stmt pretty-exp stmt)))
      (mod-stmts mod))))

(claim pretty-fragment-stmts (-> int-t (list-t (stmt-t exp-t)) string-t))
(define (pretty-fragment-stmts width stmts)
  (string-join "\n\n"
    (list-map
      (lambda (stmt) (ppml/format-node width (pretty-stmt pretty-exp stmt)))
      stmts)))

(claim pretty-definitions (-> int-t (list-t definition-t) string-t))
(define (pretty-definitions width definitions)
  (string-join "\n\n"
    (list-map
      (lambda (node) (ppml/format-node width node))
      (list-flat-map pretty-definition definitions))))
