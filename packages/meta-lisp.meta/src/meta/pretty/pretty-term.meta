(module meta)

(import-as ppml/ppml ppml)

(claim pretty-term (-> term-t ppml/node-t))
(define (pretty-term term)
  (match term
    ((symbol-term content location)
     (ppml/text (format-as-sexp content)))
    ((text-term content location)
     (ppml/text (format-as-sexp content)))
    ((int-term content location)
     (ppml/text (format-as-sexp content)))
    ((float-term content location)
     (ppml/text (format-as-sexp content)))
    ((var-term name location)
     (ppml/text (symbol-to-text name)))
    ((qualified-var-term pkg-name mod-name name location)
      (ppml/text (@text (symbol-to-text pkg-name) "/" (symbol-to-text mod-name) "/" (symbol-to-text name))))
    ((lambda-term parameters body location)
     (let ((param-nodes (list-map (lambda (p) (ppml/text (symbol-to-text p))) parameters)))
       (let ((params-node
               (if (list-is-empty parameters)
                 (ppml/pretty-application (nothing) param-nodes)
                 (ppml/pretty-application (just (symbol-to-text (list-head parameters))) param-nodes))))
          (ppml/pretty-syntax "lambda"
            (@list params-node)
            (@list (pretty-term body))))))
    ((apply-term target args location)
     (let ((target-op (term-op-text target))
           (all-elements (cons (pretty-term target) (list-map pretty-term args))))
       (ppml/pretty-application target-op all-elements)))
    ((let1-term name rhs body location)
     (let ((name-str (symbol-to-text name))
           (rhs-node (pretty-term rhs)))
       (ppml/pretty-syntax "let"
         (@list (ppml/pretty-application (nothing)
            (@list (ppml/pretty-application (just name-str)
               (@list (ppml/text name-str) rhs-node)))))
         (@list (pretty-term body)))))
    ((begin1-term head body location)
     (ppml/pretty-syntax "begin"
       (@list)
       (@list (pretty-term head) (pretty-term body))))
    ((if-term condition consequent alternative location)
     (ppml/pretty-syntax "if"
       (@list (pretty-term condition))
       (@list (pretty-term consequent)
        (pretty-term alternative))))
    ((arrow-term arg-types ret-type location)
     (let ((all-elements (cons (ppml/text "->")
                               (list-append (list-map pretty-term arg-types)
                                            (@list (pretty-term ret-type))))))
       (ppml/pretty-application (just "->") all-elements)))
    ((the-term type instance location)
     (ppml/pretty-syntax "the"
       (@list (pretty-term type) (pretty-term instance))
       (@list)))
    ((all-term parameters body location)
     (let ((param-nodes (list-map (lambda (p) (ppml/text (symbol-to-text p))) parameters)))
       (let ((params-node
               (if (list-is-empty parameters)
                 (ppml/pretty-application (nothing) param-nodes)
                 (ppml/pretty-application (just (symbol-to-text (list-head parameters))) param-nodes))))
         (ppml/pretty-syntax "all"
           (@list params-node)
           (@list (pretty-term body))))))))

(claim term-op-text (-> term-t (maybe-t text-t)))
(define (term-op-text term)
  (match term
    ((symbol-term content location) (just (format-as-sexp content)))
    ((var-term name location) (just (symbol-to-text name)))
    ((qualified-var-term pkg-name mod-name name location)
      (just (@text (symbol-to-text pkg-name) "/" (symbol-to-text mod-name) "/" (symbol-to-text name))))
    (else (nothing))))

