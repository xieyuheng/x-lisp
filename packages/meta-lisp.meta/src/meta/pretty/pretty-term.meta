(module meta)

(import-as ppml/ppml ppml)

(claim pretty-term (-> term-t ppml/node-t))
(define (pretty-term term)
  (match term
    ((symbol-term content location)
     (ppml/text (format-as-sexp content)))
    ((keyword-term content location)
     (ppml/text (format-as-sexp content)))
    ((string-term content location)
     (ppml/text (format-as-sexp content)))
    ((int-term content location)
     (ppml/text (format-as-sexp content)))
    ((float-term content location)
     (ppml/text (format-as-sexp content)))
    ((var-term name location)
     (ppml/text (symbol-to-string name)))
    ((qualified-var-term pkg-name mod-name name location)
      (ppml/text (@string (symbol-to-string pkg-name) "/" (symbol-to-string mod-name) "/" (symbol-to-string name))))
    ((lambda-term parameters body location)
     (let ((param-nodes (list-map (lambda (p) (ppml/text (symbol-to-string p))) parameters)))
       (let ((params-node
               (if (list-empty? parameters)
                 (ppml/pretty-application (nothing) param-nodes)
                 (ppml/pretty-application (just (symbol-to-string (list-head parameters))) param-nodes))))
          (ppml/pretty-syntax "lambda"
            [params-node]
            [(pretty-term body)]))))
    ((apply-term target args location)
     (let ((target-op (term-op-string target))
           (all-elements (cons (pretty-term target) (list-map pretty-term args))))
       (ppml/pretty-application target-op all-elements)))
    ((let1-term name rhs body location)
     (let ((name-str (symbol-to-string name))
           (rhs-node (pretty-term rhs)))
       (ppml/pretty-syntax "let"
         [(ppml/pretty-application (nothing)
            [(ppml/pretty-application (just name-str)
               [(ppml/text name-str) rhs-node])])]
         [(pretty-term body)])))
    ((begin1-term head body location)
     (ppml/pretty-syntax "begin"
       []
       [(pretty-term head) (pretty-term body)]))
    ((if-term condition consequent alternative location)
     (ppml/pretty-syntax "if"
       [(pretty-term condition)]
       [(pretty-term consequent)
        (pretty-term alternative)]))
    ((arrow-term arg-types ret-type location)
     (let ((all-elements (cons (ppml/text "->")
                               (list-append (list-map pretty-term arg-types)
                                            [(pretty-term ret-type)]))))
       (ppml/pretty-application (just "->") all-elements)))
    ((the-term type instance location)
     (ppml/pretty-syntax "the"
       [(pretty-term type) (pretty-term instance)]
       []))
    ((polymorphic-term parameters body location)
     (let ((param-nodes (list-map (lambda (p) (ppml/text (symbol-to-string p))) parameters)))
       (let ((params-node
               (if (list-empty? parameters)
                 (ppml/pretty-application (nothing) param-nodes)
                 (ppml/pretty-application (just (symbol-to-string (list-head parameters))) param-nodes))))
         (ppml/pretty-syntax "polymorphic"
           [params-node]
           [(pretty-term body)]))))))

(claim term-op-string (-> term-t (maybe-t string-t)))
(define (term-op-string term)
  (match term
    ((symbol-term content location) (just (format-as-sexp content)))
    ((keyword-term content location) (just (format-as-sexp content)))
    ((var-term name location) (just (symbol-to-string name)))
    ((qualified-var-term pkg-name mod-name name location)
      (just (@string (symbol-to-string pkg-name) "/" (symbol-to-string mod-name) "/" (symbol-to-string name))))
    (else (nothing))))

