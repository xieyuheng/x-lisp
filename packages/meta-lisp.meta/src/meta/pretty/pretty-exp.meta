(module meta)

(claim pretty-exp (-> exp-t ppml/node-t))
(define (pretty-exp exp)
  (match exp
    ((symbol-exp content location)
     (ppml/text (format-as-sexp content)))
    ((keyword-exp content location)
     (ppml/text (format-as-sexp content)))
    ((string-exp content location)
     (ppml/text (format-as-sexp content)))
    ((int-exp content location)
     (ppml/text (format-as-sexp content)))
    ((float-exp content location)
     (ppml/text (format-as-sexp content)))
    ((var-exp name location)
     (ppml/text (symbol-to-string name)))
    ((qualified-var-exp mod-name name location)
     (ppml/text (@string (symbol-to-string mod-name) "/" (symbol-to-string name))))
    ((lambda-exp parameters body location)
     (let ((params-str (string-join " " (list-map symbol-to-string parameters))))
       (ppml/pretty-syntax "lambda"
         [(ppml/text (@string "(" params-str ")"))]
         [(pretty-exp body)])))
    ((apply-exp target args location)
     (let ((target-op (exp-op-string target))
           (all-elements (cons (pretty-exp target) (list-map pretty-exp args))))
       (ppml/pretty-application target-op all-elements)))
    ((pipe-exp target steps location)
     (ppml/pretty-application (just "pipe")
       (cons (pretty-exp target) (list-map pretty-exp steps))))
    ((chain-exp steps location)
     (ppml/pretty-application (just "chain")
       (list-map pretty-exp steps)))
    ((compose-exp steps location)
     (ppml/pretty-application (just "compose")
       (list-map pretty-exp steps)))
    ((let1-exp name rhs body location)
     (ppml/pretty-syntax "let"
       []
       [(ppml/group
          [(ppml/text "(")
           (ppml/text (symbol-to-string name))
           (ppml/text " ")
           (pretty-exp rhs)
           (ppml/text ")")])
        (pretty-exp body)]))
    ((let-exp bindings body location)
     (ppml/pretty-syntax "let"
       []
       [(pretty-bindings bindings)
        (pretty-exp body)]))
    ((let-star-exp bindings body location)
     (ppml/pretty-syntax "let*"
       []
       [(pretty-bindings bindings)
        (pretty-exp body)]))
    ((letrec-exp bindings body location)
     (ppml/pretty-syntax "letrec"
       []
       [(pretty-bindings bindings)
        (pretty-exp body)]))
    ((letrec-star-exp bindings body location)
     (ppml/pretty-syntax "letrec*"
       []
       [(pretty-bindings bindings)
        (pretty-exp body)]))
    ((local-define-exp name parameters body location)
     (let ((name-str (symbol-to-string name))
           (params-str (string-join " " (list-map symbol-to-string parameters))))
       (if (list-empty? parameters)
         (ppml/pretty-syntax "define" [(ppml/text name-str)] [(pretty-exp body)])
         (ppml/pretty-syntax "define"
           [(ppml/text (@string "(" name-str " " params-str ")"))]
           [(pretty-exp body)]))))
    ((begin1-exp head body location)
     (ppml/pretty-syntax "begin"
       []
       [(pretty-exp head)
        (pretty-exp body)]))
    ((begin-exp sequence location)
     (ppml/pretty-syntax "begin"
       []
       (list-map pretty-exp sequence)))
    ((assign-exp name rhs location)
     (ppml/pretty-syntax "="
       [(ppml/text (symbol-to-string name))]
       [(pretty-exp rhs)]))
    ((if-exp condition consequent alternative location)
     (ppml/pretty-syntax "if"
       []
       [(pretty-exp condition)
        (pretty-exp consequent)
        (pretty-exp alternative)]))
    ((when-exp condition consequent location)
     (ppml/pretty-syntax "when"
       []
       [(pretty-exp condition)
        (pretty-exp consequent)]))
    ((unless-exp condition alternative location)
     (ppml/pretty-syntax "unless"
       []
       [(pretty-exp condition)
        (pretty-exp alternative)]))
    ((and-exp exps location)
     (ppml/pretty-syntax "and"
       []
       (list-map pretty-exp exps)))
    ((or-exp exps location)
     (ppml/pretty-syntax "or"
       []
       (list-map pretty-exp exps)))
    ((cond-exp clauses location)
     (ppml/pretty-syntax "cond"
       []
       (list-map pretty-cond-clause clauses)))
    ((list-exp elements location)
     (ppml/pretty-list (list-map pretty-exp elements)))
    ((string-concat-exp elements location)
     (if (list-empty? elements)
       (ppml/group [(ppml/text "(@string") (ppml/text ")")])
       (ppml/pretty-syntax "@string" [] (list-map pretty-exp elements))))
    ((set-exp elements location)
     (ppml/pretty-syntax "@set" [] (list-map pretty-exp elements)))
    ((hash-exp entries location)
     (ppml/pretty-syntax "@hash" [] (list-map pretty-hash-entry entries)))
    ((quote-exp sexp location)
     (ppml/text (@string "'" (format-sexp sexp))))
    ((sexp-exp sexp location)
     (ppml/pretty-application (just "@sexp")
       [(ppml/text (format-sexp sexp))]))
    ((arrow-exp arg-types ret-type location)
     (ppml/pretty-application (just "->")
       (list-append (list-map pretty-exp arg-types)
                    [(pretty-exp ret-type)])))
    ((the-exp type instance location)
     (ppml/pretty-syntax "the"
       [(pretty-exp type)]
       [(pretty-exp instance)]))
    ((polymorphic-exp parameters body location)
     (let ((params-str (string-join " " (list-map symbol-to-string parameters))))
       (ppml/pretty-syntax "polymorphic"
         [(ppml/text (@string "(" params-str ")"))]
         [(pretty-exp body)])))
    ((match-exp targets clauses location)
     (if (equal? (list-length targets) 1)
       (ppml/pretty-syntax "match"
         [(list-head (list-map pretty-exp targets))]
         (list-map pretty-match-clause clauses))
       (ppml/pretty-syntax "match-many"
         [(ppml/group
            [(ppml/text "(")
             (ppml/flex (list-map pretty-exp targets))
             (ppml/text ")")])]
         (list-map pretty-match-clause clauses))))
    ((comment-exp content location)
     (ppml/pretty-application (just "@comment")
       [(ppml/text (format-sexp content))]))))

;; Helpers

(claim exp-op-string (-> exp-t (maybe-t string-t)))
(define (exp-op-string exp)
  (match exp
    ((symbol-exp content location) (just (format-as-sexp content)))
    ((keyword-exp content location) (just (format-as-sexp content)))
    ((var-exp name location) (just (symbol-to-string name)))
    ((qualified-var-exp mod-name name location)
     (just (@string (symbol-to-string mod-name) "/" (symbol-to-string name))))
    (else (nothing))))

(define (pretty-bindings bindings)
  (ppml/group
    [(ppml/text "(")
     (ppml/flex (list-map pretty-binding bindings))
     (ppml/text ")")]))

(define (pretty-binding binding)
  (ppml/group
    [(ppml/text "(")
     (ppml/text (symbol-to-string (binding-name binding)))
     (ppml/text " ")
     (pretty-exp (binding-rhs binding))
     (ppml/text ")")]))

(define (pretty-cond-clause clause)
  (ppml/group
    [(ppml/text "(")
     (pretty-exp (cond-clause-question clause))
     (ppml/text " ")
     (pretty-exp (cond-clause-answer clause))
     (ppml/text ")")]))

(define (pretty-match-clause clause)
  (let ((patterns (match-clause-patterns clause))
        (body (match-clause-body clause)))
    (if (equal? (list-length patterns) 1)
      (ppml/group
        [(ppml/text "(")
         (pretty-exp (list-head patterns))
         (ppml/text " ")
         (pretty-exp body)
         (ppml/text ")")])
      (ppml/group
        [(ppml/text "((")
         (ppml/flex (list-map pretty-exp patterns))
         (ppml/text ") ")
         (pretty-exp body)
         (ppml/text ")")]))))

(define (pretty-hash-entry entry)
  (ppml/group
    [(pretty-exp (hash-entry-key entry))
     (ppml/text " ")
     (pretty-exp (hash-entry-value entry))]))
