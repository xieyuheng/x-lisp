(module meta)

(import-as ppml/ppml ppml)

(claim pretty-exp (-> exp-t ppml/node-t))
(define (pretty-exp exp)
  (match exp
    ((symbol-exp content location)
     (ppml/text (@text "'" (symbol-to-text content))))
    ((text-exp content location)
     (ppml/text (format-as-sexp content)))
    ((int-exp content location)
     (ppml/text (format-as-sexp content)))
    ((float-exp content location)
     (ppml/text (format-as-sexp content)))
    ((var-exp name location)
     (ppml/text (symbol-to-text name)))
    ((qualified-var-exp pkg-name mod-name name location)
      (ppml/text (@text (symbol-to-text pkg-name) "/" (symbol-to-text mod-name) "/" (symbol-to-text name))))
    ((lambda-exp parameters body location)
     (let ((params-str (text-join " " (list-map symbol-to-text parameters))))
       (ppml/pretty-syntax "lambda"
         (@list (ppml/text (@text "(" params-str ")")))
         (pretty-exp-body body))))
    ((apply-exp target args location)
     (let ((target-op (exp-op-text target))
           (all-elements (cons (pretty-exp target) (list-map pretty-exp args))))
       (ppml/pretty-application target-op all-elements)))
    ((flow-exp target steps location)
     (ppml/pretty-syntax "flow"
       (@list (pretty-exp target))
       (list-map pretty-exp steps)))
    ((chain-exp steps location)
     (ppml/pretty-syntax "chain"
       (@list)
       (list-map pretty-exp steps)))
    ((compose-exp steps location)
     (ppml/pretty-syntax "compose"
       (@list)
       (list-map pretty-exp steps)))
    ((let1-exp name rhs body location)
     (let ((name-str (symbol-to-text name))
           (rhs-node (pretty-exp rhs)))
       (ppml/pretty-syntax "let"
         (@list (ppml/pretty-application (nothing)
            (@list (ppml/pretty-application (just name-str)
               (@list (ppml/text name-str) rhs-node)))))
         (pretty-exp-body body))))
    ((let-exp bindings body location)
     (ppml/pretty-syntax "let"
       (@list (pretty-bindings bindings))
       (pretty-exp-body body)))
    ((letrec-exp bindings body location)
     (ppml/pretty-syntax "letrec"
       (@list (pretty-bindings bindings))
       (pretty-exp-body body)))
    ((local-define-exp name parameters body location)
     (let ((name-str (symbol-to-text name))
           (param-nodes (list-map (lambda (p) (ppml/text (symbol-to-text p))) parameters)))
       (let ((def-node (ppml/pretty-application (just name-str)
                         (cons (ppml/text name-str) param-nodes))))
         (ppml/pretty-syntax "define"
           (@list def-node)
           (pretty-exp-body body)))))
    ((begin1-exp head body location)
     (ppml/pretty-syntax "begin"
       (@list)
       (@list (pretty-exp head) (pretty-exp body))))
    ((begin-exp sequence location)
     (if (equal (list-length sequence) 1)
       (pretty-exp (car sequence))
       (ppml/pretty-syntax "begin"
         (@list)
         (list-map pretty-exp sequence))))
    ((if-exp condition consequent alternative location)
     (ppml/pretty-syntax "if"
       (@list (pretty-exp condition))
       (@list (pretty-exp consequent)
        (pretty-exp alternative))))
    ((when-exp condition consequent location)
     (ppml/pretty-syntax "when"
       (@list (pretty-exp condition))
       (@list (pretty-exp consequent))))
    ((unless-exp condition alternative location)
     (ppml/pretty-syntax "unless"
       (@list (pretty-exp condition))
       (@list (pretty-exp alternative))))
    ((and-exp exps location)
     (ppml/pretty-application (just "and")
       (cons (ppml/text "and")
             (list-map pretty-exp exps))))
    ((or-exp exps location)
     (ppml/pretty-application (just "or")
       (cons (ppml/text "or")
             (list-map pretty-exp exps))))
    ((cond-exp clauses location)
     (ppml/pretty-syntax "cond"
       (@list)
       (list-map pretty-cond-clause clauses)))
    ((list-exp elements location)
      (ppml/pretty-list (list-map pretty-exp elements)))
    ((text-concat-exp elements location)
     (if (list-is-empty elements)
       (ppml/group (@list (ppml/text "(@text") (ppml/text ")")))
       (ppml/pretty-syntax "@text" (@list) (list-map pretty-exp elements))))
    ((set-exp elements location)
     (ppml/pretty-syntax "@set" (@list) (list-map pretty-exp elements)))
    ((hash-exp entries location)
     (ppml/pretty-syntax "@hash" (@list) (list-map pretty-hash-entry entries)))
    ((quote-exp sexp location)
     (ppml/text (@text "'" (format-sexp sexp))))
    ((sexp-exp sexp location)
     (ppml/pretty-application (just "@sexp")
       (@list (ppml/text (format-sexp sexp)))))
    ((arrow-exp arg-types ret-type location)
     (let ((all-elements (cons (ppml/text "->")
                               (list-append (list-map pretty-exp arg-types)
                                            (@list (pretty-exp ret-type))))))
       (ppml/pretty-application (just "->") all-elements)))
    ((the-exp type instance location)
     (ppml/pretty-syntax "the"
       (@list (pretty-exp type))
       (@list (pretty-exp instance))))
    ((all-exp parameters body location)
     (let ((params-str (text-join " " (list-map symbol-to-text parameters))))
       (ppml/pretty-syntax "all"
         (@list (ppml/text (@text "(" params-str ")")))
         (@list (pretty-exp body)))))
    ((match-exp targets clauses location)
     (if (equal (list-length targets) 1)
       (ppml/pretty-syntax "match"
         (@list (list-head (list-map pretty-exp targets)))
         (list-map pretty-match-clause clauses))
       (ppml/pretty-syntax "multi-match"
         (@list (ppml/group
            (@list (ppml/text "(")
             (ppml/flex (list-map pretty-exp targets))
             (ppml/text ")"))))
         (list-map pretty-match-clause clauses))))
    ((comment-exp sexps location)
     (ppml/pretty-application (just "@comment")
       (list-map (lambda (sexp) (ppml/text (format-sexp sexp))) sexps)))))

;; Helpers

(claim exp-op-text (-> exp-t (maybe-t text-t)))
(define (exp-op-text exp)
  (match exp
    ((symbol-exp content location) (just (@text "'" (symbol-to-text content))))
    ((var-exp name location) (just (symbol-to-text name)))
    ((qualified-var-exp pkg-name mod-name name location)
      (just (@text (symbol-to-text pkg-name) "/" (symbol-to-text mod-name) "/" (symbol-to-text name))))
    (else (nothing))))

(claim pretty-exp-body (-> exp-t (list-t ppml/node-t)))

(define (pretty-exp-body exp)
  (match exp
    ((begin-exp sequence location)
     (list-map pretty-exp sequence))
    (else
      (@list (pretty-exp exp)))))

(define (pretty-bindings bindings)
  (ppml/pretty-application (nothing)
    (list-map pretty-binding bindings)))

(define (pretty-binding binding)
  (let ((name-str (symbol-to-text (binding-name binding)))
        (rhs-node (pretty-exp (binding-rhs binding))))
    (ppml/pretty-application (just name-str)
      (@list (ppml/text name-str) rhs-node))))

(define (pretty-cond-clause clause)
  (ppml/pretty-application (nothing)
    (@list (pretty-exp (cond-clause-question clause))
     (pretty-exp (cond-clause-answer clause)))))

(define (pretty-match-clause clause)
  (let ((patterns (match-clause-patterns clause))
        (body (pretty-exp-body (match-clause-body clause))))
    (if (equal (list-length patterns) 1)
      (ppml/pretty-application (nothing)
        (cons (pretty-exp (list-head patterns)) body))
      (let ((patterns-node (ppml/pretty-application (nothing)
                             (list-map pretty-exp patterns))))
        (ppml/pretty-application (nothing)
          (cons patterns-node body))))))

(define (pretty-hash-entry entry)
  (ppml/group
    (@list (pretty-exp (pair-first entry))
     (ppml/text " ")
     (pretty-exp (pair-second entry)))))
