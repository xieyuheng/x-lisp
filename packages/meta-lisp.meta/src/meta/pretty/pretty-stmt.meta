(module meta)

(import-as ppml/ppml ppml)

(claim pretty-stmt
  (polymorphic (E)
    (-> (-> E ppml/node-t) (stmt-t E) ppml/node-t)))

(define (pretty-stmt pretty-body stmt)
  (match stmt
    ((import-stmt pkg-name mod-name names location)
     (let ((mod-name-str (symbol-to-string mod-name))
            (pkg-name-str (symbol-to-string pkg-name))
            (full (if (equal pkg-name-str "self")
                    mod-name-str
                    (@string pkg-name-str "/" mod-name-str))))
       (ppml/pretty-syntax "import"
         [(ppml/text full)]
         (list-map (lambda (n) (ppml/text (symbol-to-string n))) names))))
    ((import-as-stmt pkg-name mod-name prefix location)
     (let ((mod-name-str (symbol-to-string mod-name))
            (pkg-name-str (symbol-to-string pkg-name))
            (full (if (equal pkg-name-str "self")
                    mod-name-str
                    (@string pkg-name-str "/" mod-name-str))))
       (ppml/pretty-syntax "import-as"
         [(ppml/text full)
          (ppml/text (symbol-to-string prefix))] [])))
    ((import-all-stmt pkg-name mod-name location)
     (let ((mod-name-str (symbol-to-string mod-name))
            (pkg-name-str (symbol-to-string pkg-name))
            (full (if (equal pkg-name-str "self")
                    mod-name-str
                    (@string pkg-name-str "/" mod-name-str))))
       (ppml/pretty-syntax "import-all"
         [(ppml/text full)] [])))
    ((define-function-stmt name parameters body location)
     (let ((name-str (symbol-to-string name))
            (param-nodes (list-map (lambda (p) (ppml/text (symbol-to-string p))) parameters))
            (def-node (ppml/pretty-application (just name-str)
                        (cons (ppml/text name-str) param-nodes))))
       (ppml/pretty-syntax "define"
         [def-node]
         [(pretty-body body)])))
    ((define-variable-stmt name body location)
     (ppml/pretty-syntax "define"
       [(ppml/text (symbol-to-string name))]
       [(pretty-body body)]))
    ((define-test-stmt name body location)
     (ppml/pretty-syntax "define-test"
       [(ppml/text (symbol-to-string name))]
       [(pretty-body body)]))
    ((define-type-stmt name parameters body location)
     (let ((name-str (symbol-to-string name))
           (params-str (string-join " " (list-map symbol-to-string parameters))))
       (ppml/pretty-syntax "define-type"
         [(if (list-is-empty parameters)
            (ppml/text name-str)
            (ppml/text (@string "(" name-str " " params-str ")")))]
         [(pretty-body body)])))
    ((define-enum-stmt type-constructor data-constructors lang location)
     (ppml/pretty-syntax "define-enum"
       [(pretty-pre-type-constructor type-constructor)]
       (list-map pretty-pre-data-constructor data-constructors)))
    ((define-algebraic-type-stmt type-constructor data-constructors location)
     (ppml/pretty-syntax "define-algebraic-type"
       [(pretty-pre-type-constructor type-constructor)]
       (list-map (lambda (ctor) (pretty-explicit-data-constructor pretty-body ctor))
                 data-constructors)))
    ((define-struct-stmt type-constructor fields lang location)
     (ppml/pretty-syntax "define-struct"
       [(pretty-pre-type-constructor type-constructor)]
       (list-map pretty-pre-data-field fields)))
    ((define-struct-star-stmt type-constructor data-constructor lang location)
     (ppml/pretty-syntax "define-struct*"
       [(pretty-pre-type-constructor type-constructor)]
       [(pretty-pre-data-constructor data-constructor)]))
    ((define-record-type-stmt type-constructor data-constructor lang location)
     (ppml/pretty-syntax "define-record-type"
       [(pretty-pre-type-constructor type-constructor)]
       [(pretty-explicit-data-constructor pretty-body data-constructor)]))
    ((define-opaque-type-stmt type-constructor representation-type interface-entries location)
     (ppml/pretty-syntax "define-opaque-type"
       [(pretty-pre-type-constructor type-constructor)
        (pretty-body representation-type)]
       (list-map (lambda (e) (pretty-pre-interface-entry pretty-body e))
                 interface-entries)))
    ((claim-stmt name type location)
     (ppml/pretty-syntax "claim"
       [(ppml/text (symbol-to-string name))]
       [(pretty-body type)]))
    ((claim-type-stmt name location)
     (ppml/pretty-syntax "claim-type"
       [(ppml/text (symbol-to-string name))] []))
    ((admit-stmt name type location)
     (ppml/pretty-syntax "admit"
       [(ppml/text (symbol-to-string name))]
       [(pretty-body type)]))
    ((private-stmt names location)
     (ppml/pretty-syntax "private" []
       (list-map (lambda (n) (ppml/text (symbol-to-string n))) names)))
    ((exempt-stmt names location)
     (ppml/pretty-syntax "exempt" []
       (list-map (lambda (n) (ppml/text (symbol-to-string n))) names)))
    ((declare-module-stmt name location)
     (ppml/pretty-syntax "module"
       [(ppml/text (symbol-to-string name))] []))
    ((declare-primitive-function-stmt name arity location)
     (ppml/pretty-syntax "declare-primitive-function"
       [(ppml/text (symbol-to-string name))
        (ppml/text (format-as-sexp arity))] []))
    ((declare-primitive-variable-stmt name location)
     (ppml/pretty-syntax "declare-primitive-variable"
       [(ppml/text (symbol-to-string name))] []))
    ((comment-stmt sexps location)
     (ppml/pretty-application (just "@comment")
       (list-map (lambda (sexp) (ppml/text (format-sexp sexp))) sexps)))))

;; Helpers

(define (pretty-pre-type-constructor tc)
  (let ((name (ppml/text (symbol-to-string (pre-type-constructor-name tc))))
        (params (pre-type-constructor-parameters tc)))
    (if (list-is-empty params)
      name
      (ppml/pretty-application (just (symbol-to-string (pre-type-constructor-name tc)))
        (cons name (list-map (lambda (p) (ppml/text (symbol-to-string p))) params))))))

(define (pretty-pre-data-constructor ctor)
  (let ((name (ppml/text (symbol-to-string (pre-data-constructor-name ctor))))
        (fields (pre-data-constructor-fields ctor)))
    (if (list-is-empty fields)
      name
      (ppml/pretty-application (just (symbol-to-string (pre-data-constructor-name ctor)))
        (cons name (list-map pretty-pre-data-field fields))))))

(define (pretty-pre-data-field field)
  (let ((name (ppml/text (symbol-to-string (pre-data-field-name field))))
        (type-node (pretty-exp (pre-data-field-type field))))
    (ppml/pretty-application (just (symbol-to-string (pre-data-field-name field)))
      [name type-node])))

(define (pretty-explicit-data-constructor pretty-body ctor)
  (let ((name-str (symbol-to-string (explicit-data-constructor-name ctor)))
        (fields (explicit-data-constructor-fields ctor))
        (pred-str (symbol-to-string (explicit-data-constructor-predicate-name ctor))))
    (let ((field-group (ppml/pretty-application (just name-str)
                          (cons (ppml/text name-str)
                                (list-map (lambda (f) (pretty-explicit-data-field pretty-body f)) fields))))
          (accessor-nodes (list-map (lambda (f) (pretty-explicit-data-accessor pretty-body f)) fields)))
      (ppml/pretty-application (nothing)
        (list-concat [[field-group (ppml/text pred-str)] accessor-nodes])))))

(define (pretty-explicit-data-accessor pretty-body field)
  (let ((name-str (symbol-to-string (explicit-data-field-name field)))
        (accessor-str (symbol-to-string (explicit-data-field-accessor-name field)))
        (modifier (explicit-data-field-modifier-name-maybe field)))
    (match modifier
      ((just modifier-name)
       (ppml/group
         [(ppml/text "(")
          (ppml/text name-str)
          (ppml/text " ")
          (ppml/text accessor-str)
          (ppml/text " ")
          (ppml/text (symbol-to-string modifier-name))
          (ppml/text ")")]))
      ((nothing)
       (ppml/group
         [(ppml/text "(")
          (ppml/text name-str)
          (ppml/text " ")
          (ppml/text accessor-str)
          (ppml/text ")")])))))

(define (pretty-explicit-data-field pretty-body field)
  (let ((name (ppml/text (symbol-to-string (explicit-data-field-name field))))
        (type-node (pretty-body (explicit-data-field-type field))))
    (ppml/pretty-application (just (symbol-to-string (explicit-data-field-name field)))
      [name type-node])))

(define (pretty-pre-interface-entry pretty-body entry)
  (let ((name (ppml/text (symbol-to-string (pre-interface-entry-name entry))))
        (type-node (pretty-body (pre-interface-entry-type entry))))
    (ppml/pretty-application (just (symbol-to-string (pre-interface-entry-name entry)))
      [name type-node])))
