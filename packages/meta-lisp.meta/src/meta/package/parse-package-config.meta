(module meta)

(define (parse-package-config path text)
  (let ((json (parse-json text))
         (entries (object-json-entries json)))
    (make-package-config
      (text-json-value (hash-get entries "name"))
      (text-json-value (hash-get entries "version"))
      (parse-entry entries)
      (parse-build-config (hash-get entries "build"))
      (parse-dependencies entries)
      (parse-prelude entries)
      (parse-compiler entries))))

(define (parse-dependencies entries)
  (if (hash-has entries "dependencies")
    (let ((dep-entries (object-json-entries (hash-get entries "dependencies"))))
      (hash-map-value dep-entries text-json-value))
    (make-hash)))

(define (parse-prelude entries)
  (if (hash-has entries "prelude")
    (let ((prelude-entries (object-json-entries (hash-get entries "prelude"))))
      (hash-map-value
        prelude-entries
        (lambda (v)
          (let ((arr (array-json-elements v)))
            (list-map (array-to-list arr) text-json-value)))))
    (make-hash)))

(define (parse-entry entries)
  (if (hash-has entries "entry")
    (just (text-json-value (hash-get entries "entry")))
    (nothing)))

(define (parse-compiler entries)
  (if (hash-has entries "compiler")
    (let ((compiler-entries (object-json-entries (hash-get entries "compiler"))))
      (hash-map-value compiler-entries text-json-value))
    (make-hash)))

(define (parse-build-config json-value)
  (let ((entries (object-json-entries json-value)))
    (make-build-config
      (text-json-value (hash-get entries "source-directory"))
      (text-json-value (hash-get entries "output-directory")))))
