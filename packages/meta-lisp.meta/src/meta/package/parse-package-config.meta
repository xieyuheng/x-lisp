(module meta)

(define (parse-package-config path text)
  (let ((json (parse-json text))
         (entries (object-json-entries json)))
    (make-package-config
      (text-json-value (hash-get "name" entries))
      (text-json-value (hash-get "version" entries))
      (parse-entry entries)
      (parse-build-config (hash-get "build" entries))
      (parse-dependencies entries)
      (parse-prelude entries)
      (parse-compiler entries))))

(define (parse-dependencies entries)
  (if (hash-has "dependencies" entries)
    (let ((dep-entries (object-json-entries (hash-get "dependencies" entries))))
      (hash-map-value text-json-value dep-entries))
    (make-hash)))

(define (parse-prelude entries)
  (if (hash-has "prelude" entries)
    (let ((prelude-entries (object-json-entries (hash-get "prelude" entries))))
      (hash-map-value
        (lambda (v)
          (let ((arr (array-json-elements v)))
            (list-map text-json-value arr)))
        prelude-entries))
    (make-hash)))

(define (parse-entry entries)
  (if (hash-has "entry" entries)
    (just (text-json-value (hash-get "entry" entries)))
    (nothing)))

(define (parse-compiler entries)
  (if (hash-has "compiler" entries)
    (let ((compiler-entries (object-json-entries (hash-get "compiler" entries))))
      (hash-map-value text-json-value compiler-entries))
    (make-hash)))

(define (parse-build-config json-value)
  (let ((entries (object-json-entries json-value)))
    (make-build-config
      (text-json-value (hash-get "source-directory" entries))
      (text-json-value (hash-get "output-directory" entries))
      (text-json-value (hash-get "snapshot-directory" entries)))))
