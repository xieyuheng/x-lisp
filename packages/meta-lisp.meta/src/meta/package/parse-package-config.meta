(module meta)

(define (parse-package-config path string)
  (let* ((json (parse-json string))
         (entries (json-object-entries json)))
    (make-package-config
      (json-string-value (hash-get "name" entries))
      (json-string-value (hash-get "version" entries))
      (parse-entry entries)
      (parse-build-config (hash-get "build" entries))
      (parse-dependencies entries)
      (parse-prelude entries)
      (parse-compiler entries))))

(define (parse-dependencies entries)
  (if (hash-has? "dependencies" entries)
    (let ((dep-entries (json-object-entries (hash-get "dependencies" entries))))
      (hash-map-value json-string-value dep-entries))
    (make-hash)))

(define (parse-prelude entries)
  (if (hash-has? "prelude" entries)
    (let ((prelude-entries (json-object-entries (hash-get "prelude" entries))))
      (hash-map-value
        (lambda (v)
          (let ((arr (json-array-elements v)))
            (list-map json-string-value arr)))
        prelude-entries))
    (make-hash)))

(define (parse-entry entries)
  (if (hash-has? "entry" entries)
    (just (json-string-value (hash-get "entry" entries)))
    (nothing)))

(define (parse-compiler entries)
  (if (hash-has? "compiler" entries)
    (let ((compiler-entries (json-object-entries (hash-get "compiler" entries))))
      (hash-map-value json-string-value compiler-entries))
    (make-hash)))

(define (parse-build-config json-value)
  (let ((entries (json-object-entries json-value)))
    (make-build-config
      (json-string-value (hash-get "source-directory" entries))
      (json-string-value (hash-get "output-directory" entries))
      (json-string-value (hash-get "snapshot-directory" entries)))))
