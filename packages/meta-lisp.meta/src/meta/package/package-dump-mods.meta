(module meta)

(define (package-dump-mods package tag)
  (hash-each-value
    (package-dump-mod package tag)
    (package-mods package)))

(define (package-dump-mod package tag mod)
  (= width 80)
  (= code (pretty-mod-definitions width mod))
  (= name (symbol-to-string (mod-name mod)))
  (= dump-directory (path-join (package-output-directory package) "dump"))
  (= dump-path (@string dump-directory "/modules/" name "." tag ".dump"))
  (println (@string "[" tag "] " (path-relative-to-cwd dump-path)))
  (fs-ensure-file dump-path)
  (fs-write dump-path code))
