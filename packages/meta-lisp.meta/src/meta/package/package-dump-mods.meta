(module meta)

(define (package-dump-mods package tag)
  (hash-each-value
    (package-dump-mod package tag)
    (package-mods package)))

(define (package-dump-mod package tag mod)
  (= width 80)
  (= code (pretty-mod-definitions width mod))
  (package-dump-code package mod tag code))

(define (package-dump-code package mod tag code)
  (= directory (path-join (package-output-directory package) "dump/modules"))
  (= mod-name-string (symbol-to-string (mod-name mod)))
  (= dump-path (@string directory "/" mod-name-string "." tag ".dump"))
  (writeln (@string "[" tag "] " (path-relative-to-cwd dump-path)))
  (fs-ensure-file dump-path)
  (fs-write dump-path code))
