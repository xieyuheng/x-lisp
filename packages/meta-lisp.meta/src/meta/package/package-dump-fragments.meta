(module meta)

(define (package-dump-fragments package tag)
  (hash-each
    (package-dump-fragment package tag)
    (package-fragments package)))

(define (package-dump-fragment package tag path fragment)
  (let* ((width 80)
         (code (pretty-fragment-stmts width (fragment-stmts fragment)))
         (source-directory (package-source-directory package))
         (name (path-relative source-directory path))
         (dump-directory (path-join (package-output-directory package) "dump"))
         (dump-path (@string dump-directory "/fragments/" name "." tag ".dump")))
    (println (@string "[" tag "] " (path-relative-to-cwd dump-path)))
    (fs-ensure-file dump-path)
    (fs-write dump-path code)))
