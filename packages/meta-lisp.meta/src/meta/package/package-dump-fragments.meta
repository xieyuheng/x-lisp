(module meta)

(define (package-dump-fragments package tag)
  (hash-each-value
    (package-fragments package)
    (lambda (fragment)
      (package-dump-fragment package tag fragment))))

(define (package-dump-fragment package tag fragment)
  (let ((width 80)
         (code (pretty-fragment-stmts width (fragment-stmts fragment)))
         (name (package-fragment-dump-name package fragment))
         (dump-directory (path-join (package-output-directory package) "dump"))
         (dump-path (@text dump-directory "/fragments/" name "." tag ".dump")))
    (println (@text "[" tag "] " (path-relative-to-cwd dump-path)))
    (path-ensure-file dump-path)
    (path-write dump-path code)))
