(module meta)

(define (package-load-fragments package directory)
  (list-each
    (path-list-recursive directory)
    (lambda (name)
      (when (or (text-has-suffix name ".meta")
                (text-has-suffix name ".md"))
        (let ((path (path-join directory name)))
          (list-each
            (load-fragments path)
            (lambda (fragment)
              (package-put-fragment fragment package))))))))
