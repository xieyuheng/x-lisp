(module meta)

(define-struct* package-t
  (cons-package
    (id symbol-t)
    (root-directory string-t)
    (config package-config-t)
    (fragments (hash-t string-t fragment-t))
    (mods (hash-t symbol-t mod-t))
    (dependencies (hash-t symbol-t package-t))))

(define (make-package id root-directory config)
  (cons-package id root-directory config (make-hash) (make-hash) (make-hash)))

(define (package-put-fragment! path fragment package)
  (hash-put! path fragment (package-fragments package)))

(define (package-source-directory package)
  (path-join
    (package-root-directory package)
    (build-config-source-directory
      (package-config-build
        (package-config package)))))

(define (package-output-directory package)
  (path-join
    (package-root-directory package)
    (build-config-output-directory
      (package-config-build
        (package-config package)))))

(define (package-snapshot-directory package)
  (path-join
    (package-root-directory package)
    (build-config-snapshot-directory
      (package-config-build
        (package-config package)))))

(claim package-lookup-mod (-> package-t symbol-t (maybe-t mod-t)))
(define (package-lookup-mod package name)
  (= mods (package-mods package))
  (if (hash-has? name mods)
    (just (hash-get name mods))
    (nothing)))

(define (package-put-mod! name mod package)
  (hash-put! name mod (package-mods package)))

(claim package-closure-in-topological-order
  (-> package-t
      (list-t package-t)))

(define (package-closure-in-topological-order package)
  (= results [])
  (= seen (@set))
  (define (collect package)
    (unless (set-member? (package-id package) seen)
      (set-add! (package-id package) seen)
      (hash-each-value collect (package-dependencies package))
      (list-push! package results)))
  (collect package)
  results)
