(module meta)

(define-struct package-t
  (id symbol-t)
  (root-directory text-t)
  (config package-config-t)
  (fragments (hash-t text-t fragment-t))
  (mods (hash-t symbol-t mod-t))
  (dependencies (hash-t symbol-t package-t)))

(define (empty-package id root-directory config)
  (make-package id root-directory config (make-hash) (make-hash) (make-hash)))

(define (package-put-fragment path fragment package)
  (hash-put (package-fragments package) path fragment))

(define (package-source-directory package)
  (path-join
    (package-root-directory package)
    (build-config-source-directory
      (package-config-build
        (package-config package)))))

(define (package-output-directory package)
  (path-join
    (package-root-directory package)
    (build-config-output-directory
      (package-config-build
        (package-config package)))))

(claim package-lookup-mod (-> package-t symbol-t symbol-t (maybe-t mod-t)))
(define (package-lookup-mod package pkg-name name)
  (let ((mods (if (or (equal pkg-name 'self)
                      (equal pkg-name (package-id package)))
                (package-mods package)
                (package-mods
                  (hash-get (package-dependencies package) pkg-name)))))
    (if (hash-has mods name)
      (just (hash-get mods name))
      (nothing))))

(define (package-put-mod name mod package)
  (hash-put (package-mods package) name mod))

(claim package-closure-in-topological-order
  (-> package-t
      (list-t package-t)))

(define (package-closure-in-topological-order package)
  (let ((results (make-array))
        (seen (@set)))
    (define (collect package)
      (unless (set-has seen (package-id package))
        (set-add seen (package-id package))
        (hash-each-value (package-dependencies package) collect)
        (array-push results package)))
    (collect package)
    (array-to-list results)))
