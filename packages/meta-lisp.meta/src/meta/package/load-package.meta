(module meta)

(define package-cache (make-hash))

(define (load-package id config-path)
  (let ((resolved-path (path-resolve config-path)))
    (match (hash-get-maybe package-cache resolved-path)
      ((just pkg) pkg)
      ((nothing)
       (let ((config (load-package-config config-path))
              (root-directory (path-directory-name resolved-path))
              (package (empty-package (actual-id config id) root-directory config)))
         (if (equal (package-config-name config) "meta-builtin")
           (setup-builtin-package package)
           (validate-builtin config))
         (load-dependencies package root-directory config)
         (validate-prelude package config)
         (let ((source-directory (package-source-directory package)))
           (package-load-fragments package source-directory)
           (hash-put package-cache resolved-path package)
           package))))))

(define (actual-id config id)
  (if (equal (package-config-name config) "meta-builtin")
    'meta-builtin
    id))

(define (setup-builtin-package package)
  (setup-primitive)
  (let ((mod (empty-mod 'builtin package)))
    (package-put-mod 'builtin mod package)
    void))

(define (validate-builtin config)
  (unless (hash-has (package-config-dependencies config) "meta-builtin")
    (error "[loadPackage] missing required dependency \"meta-builtin\"")))

(define package-serial-numbers (make-hash))

(define (dependency-id dep-resolved)
  (match (hash-get-maybe package-serial-numbers dep-resolved)
    ((just id) id)
    ((nothing)
     (let ((id (text-to-symbol (text-append "pkg-" (format (hash-length package-serial-numbers))))))
       (hash-put package-serial-numbers dep-resolved id)
       id))))

(define (load-dependencies package root-directory config)
  (hash-each
    (package-config-dependencies config)
    (lambda (alias dep-path)
      (let ((dep-resolved
              (path-resolve
                (path-join (path-join root-directory dep-path) "meta-package.json"))))
        (if (equal alias "meta-builtin")
          (hash-put (package-dependencies package)
            'meta-builtin
            (load-package 'meta-builtin dep-resolved))
          (hash-put (package-dependencies package)
            (text-to-symbol alias)
            (load-package (dependency-id dep-resolved) dep-resolved)))))))

(define (validate-prelude package config)
  (hash-each-key
    (package-config-prelude config)
    (lambda (pkg-name)
      (unless (hash-has (package-dependencies package) (text-to-symbol pkg-name))
        (error
          (text-append "[loadPackage] prelude references unknown package: " pkg-name))))))
