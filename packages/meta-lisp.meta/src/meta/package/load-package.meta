(module meta)

(define (load-package id config-path)
  (= config (load-package-config config-path))
  (= root-directory (path-directory-name config-path))
  (if (equal? (package-config-name config) "meta-builtin")
    (load-builtin-package)
    (let ((package (make-package id root-directory config)))
      (= builtin (load-builtin-package))
      (hash-put! "meta-builtin" builtin (package-dependencies package))
      (hash-each
        (lambda (alias dep-path)
          (unless (equal? alias "meta-builtin")
            (= resolved (path-join (path-join root-directory dep-path) "meta-package.json"))
            (= dep-pkg (load-package alias resolved))
            (hash-put! alias dep-pkg (package-dependencies package))))
        (package-config-dependencies config))
      (hash-each-key
        (lambda (pkg-name)
          (unless (hash-has? pkg-name (package-dependencies package))
            (error
              (string-append "[loadPackage] prelude references unknown package: " pkg-name))))
        (package-config-prelude config))
      (= source-directory (package-source-directory package))
      (package-load-fragments package source-directory)
      package)))
