(module meta)

(define-struct build-config-t
  (source-directory text-t)
  (output-directory text-t)
  (snapshot-directory text-t))

(define-struct package-config-t
  (name text-t)
  (version text-t)
  (entry (maybe-t text-t))
  (build build-config-t)
  (dependencies (hash-t text-t text-t))
  (prelude (hash-t text-t (list-t text-t)))
  (compiler (hash-t text-t text-t)))
