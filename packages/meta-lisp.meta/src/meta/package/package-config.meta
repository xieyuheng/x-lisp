(module meta)

(define-struct build-config-t
  (source-directory string-t)
  (output-directory string-t)
  (snapshot-directory string-t))

(define-struct package-config-t
  (name string-t)
  (version string-t)
  (entry (maybe-t string-t))
  (build build-config-t)
  (dependencies (hash-t string-t string-t))
  (prelude (hash-t string-t (list-t string-t)))
  (compiler (hash-t string-t string-t)))
