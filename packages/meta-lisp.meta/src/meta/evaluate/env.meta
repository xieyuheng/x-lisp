(module meta)

(define-enum evaluation-mode-t
  (opaque-mode)
  (transparent-mode))

(define-struct env-t
  (mode evaluation-mode-t)
  (bindings (hash-t symbol-t value-t)))

(define (empty-env mode)
  (make-env mode (make-hash)))

(define (env-names env)
  (hash-keys (env-bindings env)))

(define (env-has name env)
  (hash-has name (env-bindings env)))

(define (env-lookup-value name env)
  (hash-get name (env-bindings env)))

(define (env-put name value env)
  (make-env (env-mode env) (hash-put-copy name value (env-bindings env))))

(define (env-put-many names values env)
  (make-env (env-mode env)
    (hash-put-entries-copy
      (list-zip-map make-hash-entry names values)
      (env-bindings env))))
