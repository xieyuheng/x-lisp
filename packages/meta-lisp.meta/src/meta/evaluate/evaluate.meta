(module meta)

(claim evaluate
  (-> mod-t env-t term-t
      value-t))

(define (evaluate mod env term)
  (match term
    ((var-term name location)
     (if (env-has name env)
       (env-lookup-value name env)
       (let ((definition (mod-lookup-definition mod name)))
         (if (not (is-nothing definition))
           (definition-to-value (env-mode env) (just-value definition))
           (error-with-location "(evaluate) undefined variable"
             (term-location term))))))
    ((qualified-var-term pkg-name mod-name name location)
     (let ((qualified-mod (package-lookup-mod (mod-package mod) pkg-name mod-name)))
       (if (is-nothing qualified-mod)
         (error-with-location "(evaluate) undefined module prefix"
           (term-location term))
         (let ((found-mod (just-value qualified-mod))
                (definition (mod-lookup-definition found-mod name)))
           (if (not (is-nothing definition))
             (definition-to-value (env-mode env) (just-value definition))
             (error-with-location "(evaluate) undefined qualified variable"
               (term-location term)))))))
    ((arrow-term arg-types ret-type location)
     (let ((arg-types (list-map (lambda (arg-type) (evaluate-type mod env arg-type)) arg-types))
           (ret-type (evaluate-type mod env ret-type)))
       (type-value (arrow-type arg-types ret-type))))
    ((all-term parameters body location)
     (let ((var-types (list-map (lambda (parameter) (var-type parameter 0)) parameters))
            (body-env (env-put-many parameters
                        (list-map (lambda (vt) (type-value vt)) var-types)
                        env))
            (body-type (evaluate-type mod body-env body)))
       (type-value (all-type var-types body-type))))
    ((apply-term target args location)
     (let ((target (evaluate mod env target))
           (args (list-map (lambda (arg) (evaluate mod env arg)) args)))
       (apply-value (env-mode env) target args)))
    ((the-term type instance location)
     (evaluate mod env instance))
    (else
     (error-with-location "(evaluate) unhandled term"
       (term-location term)))))

(claim definition-to-value
  (-> evaluation-mode-t definition-t
      value-t))

(define (definition-to-value mode definition)
  (match definition
    ((primitive-function-declaration mod name arity location)
     (match (lookup-primitive-function name)
       ((just fn) (definition-value definition))
       ((nothing)
        (error (@text "(definition-to-value) no implementation for primitive function: "
                        (symbol-to-text name))))))
    ((primitive-variable-declaration mod name location)
     (match (lookup-primitive-variable name)
       ((just value) value)
       ((nothing)
        (error (@text "(definition-to-value) no value for primitive variable: "
                        (symbol-to-text name))))))
    ((function-definition mod name parameters body location)
     (definition-value definition))
    ((test-definition mod name body location)
     (definition-value definition))
    ((type-definition mod name parameters body location)
     (if (list-is-empty parameters)
       (let ((type (evaluate-type mod (empty-env mode) body)))
         (type-value type))
       (definition-value definition)))
    ((variable-definition mod name body location)
     (let ((type (evaluate-type mod (empty-env mode) body)))
       (type-value type)))
    ((algebraic-type-definition mod name type-constructor data-constructors location)
     (if (list-is-empty (type-constructor-parameters type-constructor))
       (type-value (data-type type-constructor (@list)))
       (definition-value definition)))
    ((opaque-type-definition mod name type-constructor representation-type interface-entries location)
     (if (equal mode (transparent-mode))
       (if (list-is-empty (type-constructor-parameters type-constructor))
         (let ((type (evaluate-type mod (empty-env mode) representation-type)))
           (type-value type))
         (definition-value definition))
       (if (list-is-empty (type-constructor-parameters type-constructor))
         (type-value (data-type type-constructor (@list)))
         (definition-value definition))))))

(claim evaluate-type
  (-> mod-t env-t term-t
      type-t))

(define (evaluate-type mod env term)
  (let ((value (evaluate mod env term)))
    (if (is-type-value value)
      (type-value-type value)
      (error-with-location "(evaluate-type) expected a type value"
        (term-location term)))))
