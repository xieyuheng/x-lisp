(module meta)

(claim term-traverse
  (-> (-> term-t term-t) term-t
      term-t))

(define (term-traverse f term)
  (match term
    ((symbol-term content location) term)
    ((text-term content location) term)
    ((int-term content location) term)
    ((float-term content location) term)
    ((var-term name location) term)
    ((qualified-var-term pkg-name mod-name name location) term)
    ((lambda-term parameters body location)
     (lambda-term parameters (f body) location))
    ((all-term parameters body location)
     (all-term parameters (f body) location))
    ((apply-term target args location)
     (apply-term (f target) (list-map f args) location))
    ((let1-term name rhs body location)
     (let1-term name (f rhs) (f body) location))
    ((begin1-term head body location)
     (begin1-term (f head) (f body) location))
    ((if-term condition consequent alternative location)
     (if-term (f condition) (f consequent) (f alternative) location))
    ((arrow-term arg-types ret-type location)
     (arrow-term (list-map f arg-types) (f ret-type) location))
    ((the-term type term2 location)
     (the-term (f type) (f term2) location))))
