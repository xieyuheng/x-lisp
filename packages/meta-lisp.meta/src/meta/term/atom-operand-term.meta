(module meta)

(claim atom-operand-term? (-> term-t bool-t))

(define (atom-operand-term? term)
  (match term
    ((symbol-term content location) true)
    ((keyword-term content location) true)
    ((string-term content location) true)
    ((int-term content location) true)
    ((float-term content location) true)
    ((var-term name location) true)
    ((qualified-var-term pkg-name mod-name name location) true)
    ((lambda-term parameters body location)
     (atom-operand-term? body))
    ((apply-term target args location)
     ;; subterms of apply-term should be atom-term
     (and (atom-term? target) (list-every? atom-term? args)))
    ((let1-term name rhs body location)
     (and (atom-operand-term? rhs) (atom-operand-term? body)))
    ((begin1-term head body location)
     (and (atom-operand-term? head) (atom-operand-term? body)))
    ((if-term condition consequent alternative location)
     (and (atom-operand-term? condition)
          (atom-operand-term? consequent)
          (atom-operand-term? alternativet)))
    ((arrow-term arg-types ret-type location)
     (and (list-every? atom-operand-term? arg-types)
          (atom-operand-term? ret-type)))
    ((the-term type instance location)
     (and (atom-operand-term? type)
          (atom-operand-term? instance)))
    ((polymorphic-term parameters body location)
     (atom-operand-term? body))))
