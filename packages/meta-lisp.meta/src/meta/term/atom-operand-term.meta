(module meta)

(claim is-atom-operand-term (-> term-t bool-t))

(define (is-atom-operand-term term)
  (match term
    ((symbol-term content location) true)
    ((text-term content location) true)
    ((int-term content location) true)
    ((float-term content location) true)
    ((var-term name location) true)
    ((qualified-var-term pkg-name mod-name name location) true)
    ((lambda-term parameters body location)
     (is-atom-operand-term body))
    ((apply-term target args location)
     ;; subterms of apply-term should be atom-term
     (and (is-atom-term target) (list-every is-atom-term args)))
    ((let1-term name rhs body location)
     (and (is-atom-operand-term rhs) (is-atom-operand-term body)))
    ((begin1-term head body location)
     (and (is-atom-operand-term head) (is-atom-operand-term body)))
    ((if-term condition consequent alternative location)
     (and (is-atom-operand-term condition)
          (is-atom-operand-term consequent)
          (is-atom-operand-term alternative)))
    ((arrow-term arg-types ret-type location)
     (and (list-every is-atom-operand-term arg-types)
          (is-atom-operand-term ret-type)))
    ((the-term type instance location)
     (and (is-atom-operand-term type)
          (is-atom-operand-term instance)))
    ((all-term parameters body location)
     (is-atom-operand-term body))))
