(module meta)

(claim term-free-names
  (-> (set-t symbol-t) term-t
      (set-t symbol-t)))

(define (term-free-names bound-names term)
  (match term
    ((symbol-term content location) (make-set))
    ((keyword-term content location) (make-set))
    ((string-term content location) (make-set))
    ((int-term content location) (make-set))
    ((float-term content location) (make-set))
    ((qualified-var-term pkg-name mod-name name location) (make-set))
    ((var-term name location)
     (if (set-member name bound-names)
       (make-set)
       (set-copy-add name (make-set))))
    ((lambda-term parameters body location)
     (term-free-names (set-union bound-names (list-to-set parameters)) body))
    ((polymorphic-term parameters body location)
     (term-free-names (set-union bound-names (list-to-set parameters)) body))
    ((let1-term name rhs body location)
     (set-union (term-free-names bound-names rhs)
                (term-free-names (set-copy-add name bound-names) body)))
    ((apply-term target args location)
     (set-union
       (term-free-names bound-names target)
       (set-union-many (list-map (term-free-names bound-names) args))))
    ((begin1-term head body location)
     (set-union (term-free-names bound-names head)
                (term-free-names bound-names body)))
    ((if-term condition consequent alternative location)
     (set-union (term-free-names bound-names condition)
                (set-union (term-free-names bound-names consequent)
                           (term-free-names bound-names alternative))))
    ((arrow-term arg-types ret-type location)
     (set-union
       (set-union-many (list-map (term-free-names bound-names) arg-types))
       (term-free-names bound-names ret-type)))
    ((the-term type instance location)
     (set-union (term-free-names bound-names type)
                (term-free-names bound-names instance)))))
