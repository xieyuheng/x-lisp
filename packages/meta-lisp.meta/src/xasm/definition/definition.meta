(module xasm)

(define-enum definition-t
  (primitive-function-declaration
   (name symbol-t)
   (arity int-t)
   (location source-location-t))
  (primitive-variable-declaration
   (name symbol-t)
   (location source-location-t))
  (function-definition
   (name symbol-t)
   (arity int-t)
   (instrs (list-t instr-t))
   (location source-location-t))
  (variable-definition
   (name symbol-t)
   (instrs (list-t instr-t))
   (location source-location-t))
  (test-definition
   (name symbol-t)
   (instrs (list-t instr-t))
   (location source-location-t)))
