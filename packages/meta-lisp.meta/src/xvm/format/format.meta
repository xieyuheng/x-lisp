(module xvm)

(claim format-definition (-> definition-t string-t))
(define (format-definition definition)
  (match definition
    ((primitive-function-declaration name arity location)
     (@string "(declare-primitive-function "
               (symbol-to-string name) " "
               (format-as-sexp arity) ")"))
    ((primitive-variable-declaration name location)
     (@string "(declare-primitive-variable "
               (symbol-to-string name) ")"))
    ((function-definition name arity instrs location)
     (@string "(define-function "
              (symbol-to-string name) " "
              (format-as-sexp arity) " "
              (string-join " " (list-map format-instr instrs)) ")"))
    ((variable-definition name instrs location)
     (@string "(define-variable "
              (symbol-to-string name) " "
              (string-join " " (list-map format-instr instrs)) ")"))
    ((test-definition name instrs location)
     (@string "(define-test "
              (symbol-to-string name) " "
              (string-join " " (list-map format-instr instrs)) ")"))))

(claim format-instr (-> instr-t string-t))
(define (format-instr instr)
  (let ((op (instr-op instr))
        (operands (instr-operands instr)))
    (if (equal? (symbol-to-string op) "label")
      (string-join " " (list-map format-operand operands))
      (if (list-empty? operands)
        (@string "(" (symbol-to-string op) ")")
        (let ((operands-str (string-join " " (list-map format-operand operands))))
          (@string "(" (symbol-to-string op) " " operands-str ")"))))))

(claim format-operand (-> operand-t string-t))
(define (format-operand operand)
  (match operand
    ((symbol-operand content location)
     (format-as-sexp content))
    ((keyword-operand content location)
     (format-as-sexp content))
    ((string-operand content location)
     (format-as-sexp content))
    ((int-operand content location)
     (format-as-sexp content))
    ((float-operand content location)
     (format-as-sexp content))
    ((var-operand name location)
     (symbol-to-string name))))
