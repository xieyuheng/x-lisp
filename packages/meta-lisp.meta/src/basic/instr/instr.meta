(module basic)

(define-enum instr-t
  (assign-instr (dest symbol-t) (exp exp-t) (location source-location-t))
  (perform-instr (exp exp-t) (location source-location-t))
  (test-instr (exp exp-t) (location source-location-t))
  (branch-instr (then-label symbol-t) (else-label symbol-t) (location source-location-t))
  (goto-instr (label symbol-t) (location source-location-t))
  (return-instr (exp exp-t) (location source-location-t)))

(claim format-instr (-> instr-t string-t))
(define (format-instr instr)
  (match instr
    ((assign-instr dest exp location)
     (@string "(= " (symbol-to-string dest) " " (format-exp exp) ")"))
    ((perform-instr exp location)
     (@string "(perform " (format-exp exp) ")"))
    ((test-instr exp location)
     (@string "(test " (format-exp exp) ")"))
    ((branch-instr then-label else-label location)
     (@string "(branch "
              (symbol-to-string then-label) " "
              (symbol-to-string else-label) ")"))
    ((goto-instr label location)
     (@string "(goto " (symbol-to-string label) ")"))
    ((return-instr exp location)
     (@string "(return " (format-exp exp) ")"))))
