(module basic)

(define-struct* mod-t
  (make-mod
   (definitions (hash-t symbol-t definition-t))))

(define (empty-mod)
  (make-mod (make-hash)))

(claim mod-lookup-definition (-> mod-t symbol-t (maybe-t definition-t)))
(define (mod-lookup-definition mod name)
  (let ((definitions (mod-definitions mod)))
    (if (hash-has? name definitions)
      (just (hash-get name definitions))
      (nothing))))
