(module meta)

(define (main)
  (define router (cli-make-router "meta-lisp" "0.1.0"))
  (cli-define-route router "check --config --dump")
  (cli-define-route router "build --config --dump --basic")
  (cli-define-route router "test --config --profile --builtin")
  (cli-define-handler router "check" handle-check)
  (cli-define-handler router "build" handle-build)
  (cli-define-handler router "test" handle-test)
  (cli-router-run router (current-command-line)))

(define (get-config-path ctx)
  (if (cli-option-has? "--config" ctx)
    (cli-option-get "--config" ctx)
    (path-join (current-directory) "meta-package.json")))

(define (handle-check ctx)
  (= config-path (get-config-path ctx))
  (= package (load-package "self" config-path))
  (= compiler (package-config-compiler (package-config package)))
  (when (cli-option-has? "--dump" ctx) (hash-put! "dump" "true" compiler))
  (check-pipeline package))

(define (handle-build ctx)
  (= config-path (get-config-path ctx))
  (= package (load-package "self" config-path))
  (= compiler (package-config-compiler (package-config package)))
  (when (cli-option-has? "--dump" ctx) (hash-put! "dump" "true" compiler))
  (when (cli-option-has? "--basic" ctx) (hash-put! "basic" "true" compiler))
  (build-pipeline package))

(define (handle-test ctx)
  (= config-path (get-config-path ctx))
  (= package (load-package "self" config-path))
  (= compiler (package-config-compiler (package-config package)))
  (when (cli-option-has? "--profile" ctx) (hash-put! "profile" "true" compiler))
  (when (cli-option-has? "--builtin" ctx) (hash-put! "builtin" "true" compiler))
  (println "[test] not implemented"))
