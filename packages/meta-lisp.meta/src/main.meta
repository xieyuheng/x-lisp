(module main)

(import-as cli/cli cli)

(define (main)
  (define router (cli/new-router "meta-lisp" "0.1.0"))
  (cli/define-route router "check --config --dump")
  (cli/define-route router "build --config --dump")
  (cli/define-handler router "check" handle-check)
  (cli/define-handler router "build" handle-build)
  (cli/router-run router (current-command-line)))

(define (get-config-path ctx)
  (if (cli/option-has "--config" ctx)
    (cli/option-get "--config" ctx)
    (path-join (current-directory) "meta-package.json")))

(define (handle-check ctx)
  (let ((config-path (get-config-path ctx))
         (package (meta/load-package 'self config-path))
         (compiler (meta/package-config-compiler (meta/package-config package))))
    (when (cli/option-has "--dump" ctx) (hash-put compiler "dump" "true"))
    (compiler/check-pipeline package)))

(define (handle-build ctx)
  (let ((config-path (get-config-path ctx))
         (package (meta/load-package 'self config-path))
         (compiler (meta/package-config-compiler (meta/package-config package))))
    (when (cli/option-has "--dump" ctx) (hash-put compiler "dump" "true"))
    (compiler/build-pipeline package)))


