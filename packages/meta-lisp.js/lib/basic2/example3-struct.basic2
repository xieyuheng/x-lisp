(define-struct point-t (x int64-t) (y int64-t))

(claim origin point-t)
(define-variable origin)

(claim set-origin (-> void-t))

(define-function set-origin
  (block body
    (= x-offset (offset-of :struct-type point-t :path (x)))
    (= origin-addr (address :name origin))
    (= x-pointer (padd origin-addr x-offset))
    (= zero (int64 :content 0))
    (store x-pointer zero :content-type int64-t)
    (= y-offset (offset-of :struct-type point-t :path (y)))
    (= y-pointer (padd origin-addr y-offset))
    (store y-pointer zero :content-type int64-t)
    (return)))

(claim printf (-> pointer-t int64-t))
