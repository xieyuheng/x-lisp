(define-function (apply-twice f x)
  (apply-1 f x)
  (load-result once)
  (apply-1 f once)
  (load-result twice)
  (return twice))

(define-function (inc n)
  (load one 1)
  (iadd result n one)
  (return result))

(define-function (main)
  (load f (fn inc))
  (load x 10)
  (call-2 (fn apply-twice) f x)
  (load-result result)
  (return result))

(default-entry main)