(declare-primitive-function meta-builtin/builtin/equal)

(define-function (factorial n)
  (load-int one 1)
  (int-less-or-equal base n one)
  (branch base (label base-case) (label recur-case))
  base-case
  (load-int result 1)
  (return result)
  recur-case
  (isub m n one)
  (call-1 (fn factorial) m)
  (load-result sub)
  (imul result n sub)
  (return result))

(define-function (main)
  (load-int n 5)
  (call-1 (fn factorial) n)
  (load-result result)
  (load-int expected 120)
  (call-2 (prim meta-builtin/builtin/equal) result expected)
  (return-void))
