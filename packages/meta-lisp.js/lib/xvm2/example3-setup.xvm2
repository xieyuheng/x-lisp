(declare-variable *version*)
(declare-variable *name*)

(define-function (©setup.*version*)
  (load value 42)
  (return value))

(define-function (©setup.*name*)
  (load value 'meta-lisp)
  (return value))

(define-function (©setup-variables)
  (call-0 (fn ©setup.*version*))
  (load-result version)
  (global-store (global *version*) version)
  (call-0 (fn ©setup.*name*))
  (load-result name)
  (global-store (global *name*) name)
  (return-void))

(define-function (main)
  (call-0 (fn ©setup-variables))
  (global-load v (global *version*))
  (return v))

(default-entry main)