(模块 例子)

(定义测试 若则测试
  (断言相等
    1
    (若则
      ((相等 1 1) 1)
      (否则 2)))

  (断言相等
    2
    (若则
      ((相等 1 2) 1)
      (否则 2)))

  (若则
    ((相等 1 1) (断言 真))
    (否则 (断言 假)))

  (若则
    ((相等 1 2) (断言 假))
    (否则 (断言 真))))

(定义测试 若则真测试
  (令 ((真假 真))
    (若则 (真假
            (断言 真))
          (否则
           (断言 假)))))

(定义测试 若则假测试
  (令 ((真假 假))
    (若则 (真假
            (断言 假))
          (否则
           (断言 真)))))

(定义测试 若则显式相等假测试
  (令 ((真假 假))
    (若则 ((相等 真假 真)
           (断言 假))
          (否则
           (断言 真)))))
