(模块 例子)

(定义测试 文本测试
  (断言相等 "" (@文本))
  (断言相等 "a" (@文本 "a"))
  (断言相等 "ab" (@文本 "a" "b"))
  (断言相等 "abc" (@文本 "a" "b" "c"))
  (断言相等 "hello world" (@文本 "hello" " " "world"))
  (断言相等 "hello! world!" (@文本 "hello! " "world!")))

(定义测试 带变量文本测试
  (令 ((甲 "hello")
       (乙 "world"))
    (断言相等 "helloworld" (@文本 甲 乙))
    (断言相等 "hello, world" (@文本 甲 ", " 乙))
    (断言相等 "(--hello--)" (@文本 "(--" 甲 "--)"))))
