(模块 例子)

(定义 (求值并打印 项)
  (打印行 (求值 项 (空环境))))

(定义测试 函数演算解释器测试
  (求值并打印
    (函项 '甲 (变量项 '甲)))

  (求值并打印
    (作用项
      (函项 '甲 (变量项 '甲))
      (函项 '甲 (变量项 '甲))))

  (求值并打印
    (作用项
      (作用项
        (函项 '甲 (变量项 '甲))
        (函项 '甲 (变量项 '甲)))
      (作用项
        (函项 '甲 (变量项 '甲))
        (函项 '甲 (变量项 '甲)))))

  (求值并打印
    (令项
      '恒等 (函项 '甲 (变量项 '甲))
      (变量项 '恒等)))

  (求值并打印
    (令项
      '恒等 (函项 '甲 (变量项 '甲))
      (作用项 (变量项 '恒等) (变量项 '恒等))))

  (求值并打印
    (令项
      '恒等 (函项 '甲 (变量项 '甲))
      (作用项
        (作用项 (变量项 '恒等) (变量项 '恒等))
        (作用项 (变量项 '恒等) (变量项 '恒等))))))
