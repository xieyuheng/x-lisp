(模块 例子)

(定义测试 路径测试
  (断言相等 "abc\n" (路径读 "src/路径/file-1.txt"))

  (路径写 "src/路径/file-2.txt" "123\n")
  (断言相等 "123\n" (路径读 "src/路径/file-2.txt"))

  (路径写 "src/路径/file-2.txt" "abc\n")
  (断言相等 "abc\n" (路径读 "src/路径/file-2.txt"))

  (令 ((数组 (列表转数组 (路径列表 "src"))))
    (数组排序 数组 文本字典序比较)
    (列表逐项 (数组转列表 数组) 打印行)
    (打印 "\n"))

  (令 ((数组 (列表转数组 (路径递归列表 "src"))))
    (数组排序 数组 文本字典序比较)
    (列表逐项 (数组转列表 数组) 打印行)
    (打印 "\n")))