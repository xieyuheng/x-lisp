(module builtin)

(claim list-fold-right
  (polymorphic (E R)
    (-> (-> E R R)
        R (list-t E)
        R)))

(define (list-fold-right op folded list)
  (if (list-empty? list)
    folded
    (list-fold-right
     op (op (list-last list) folded)
     (list-init list))))

(define-test list-fold-right-test
  (assert-equal 10 (list-fold-right iadd 0 [1 2 3 4]))
  (assert-equal [1 2 3 4] (list-fold-right cons [] [1 2 3 4])))
