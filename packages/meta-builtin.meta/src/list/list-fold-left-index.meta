(module builtin)

(claim list-fold-left-index
  (polymorphic (E R)
    (-> (-> int-t R E R) R (list-t E) R)))

(define (list-fold-left-index op e list)
  (list-fold-left-index-aux op e list 0))

(claim list-fold-left-index-aux
  (polymorphic (E R)
    (-> (-> int-t R E R) R (list-t E) int-t R)))

(define (list-fold-left-index-aux op e list i)
  (if (list-empty? list)
    e
    (list-fold-left-index-aux
     op (op i e (car list))
     (cdr list)
     (iadd i 1))))

(define-test list-fold-left-index-test
  (assert-equal
    (list-fold-left-index (lambda (i acc x) (iadd acc (imul i x))) 0 [10 20 30])
    80)
  (assert-equal
    (list-fold-left-index (lambda (i acc _) (cons i acc)) [] ['a 'b 'c])
    [2 1 0])
  (assert-equal
    (list-fold-left-index (lambda (i acc x) (iadd acc x)) 0 [])
    0))
