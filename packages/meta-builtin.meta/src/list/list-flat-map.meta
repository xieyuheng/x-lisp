(module builtin)

(claim list-flat-map
  (polymorphic (A B)
    (-> (-> A (list-t B))
        (list-t A)
        (list-t B))))

(define (list-flat-map f xs)
  (list-concat (list-map f xs)))

(define-test list-flat-map-test
  (assert-equal [1 2 3 4]
    (list-flat-map (lambda (x) [x (iadd x 1)]) [1 3]))
  (assert-equal []
    (list-flat-map (lambda (x) []) [1 2 3]))
  (assert-equal [3 2 1 6 5 4]
    (list-flat-map list-reverse [[1 2 3] [4 5 6]])))
