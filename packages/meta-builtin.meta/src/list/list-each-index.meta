(module builtin)

(claim list-each-index
  (polymorphic (A Any)
    (-> (-> int-t A Any) (list-t A) void-t)))

(define (list-each-index f list)
  (list-each-index-aux f list 0))

(claim list-each-index-aux
  (polymorphic (A Any)
    (-> (-> int-t A Any) (list-t A) int-t void-t)))

(define (list-each-index-aux f list i)
  (if (list-empty? list)
    void
    (begin
      (f i (car list))
      (list-each-index-aux f (cdr list) (iadd i 1)))))

(define-test list-each-index-test
  (= results [])
  (list-each-index
   (lambda (i x)
     (list-push! (make-pair i x) results))
   ['a 'b 'c])
  (assert-equal results
    [(make-pair 0 'a) (make-pair 1 'b) (make-pair 2 'c)]))
