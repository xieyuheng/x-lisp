(module builtin)

(define-struct cli-ctx-t
  (args (list-t string-t))
  (options (hash-t string-t string-t))
  (passthrough (list-t string-t)))

(define-struct cli-route-t
  (command string-t)
  (name string-t)
  (arg-names (list-t string-t))
  (option-names (list-t string-t)))

(define-struct cli-router-t
  (name string-t)
  (version string-t)
  (routes (list-t cli-route-t))
  (handlers (hash-t string-t (-> cli-ctx-t void-t))))

(claim cli-make-router (-> string-t string-t cli-router-t))
(define (cli-make-router name version)
  (make-cli-router name version (make-list) (make-hash)))

(claim cli-parse-route (-> string-t cli-route-t))
(define (cli-parse-route command)
  (let* ((tokens (list-reject string-blank? (string-split " " command)))
         (dash-idx (list-find-index (lambda (t) (equal? t "--")) tokens))
         (main (if (int-greater-or-equal? dash-idx 0)
                 (list-take dash-idx tokens)
                 tokens))
         (name (car main))
         (rest (cdr main))
         (first-opt-idx (list-find-index (lambda (t) (string-starts-with? "--" t)) rest))
         (arg-count (if (int-greater-or-equal? first-opt-idx 0) first-opt-idx (list-length rest)))
         (args (list-take arg-count rest))
         (options (list-drop arg-count rest)))
    (make-cli-route command name args options)))

(claim cli-route-match (-> cli-route-t (list-t string-t) cli-ctx-t))
(define (cli-route-match route argv)
  (define (loop tokens args options passthrough in-passthrough?)
    (cond ((list-empty? tokens)
           (make-cli-ctx args options passthrough))
          (;; in-passthrough?
           (equal? in-passthrough? true)
           (loop (cdr tokens) args options
                 (list-push! (car tokens) passthrough) true))
          ((equal? (car tokens) "--")
           (loop (cdr tokens) args options passthrough true))
          ((string-starts-with? "-" (car tokens))
           (let ((token (car tokens))
                 (rest (cdr tokens)))
             (cond ((list-empty? rest)
                    (loop rest args (hash-put! token "" options) passthrough false))
                   ((string-starts-with? "-" (car rest))
                    (loop rest args (hash-put! token "" options) passthrough false))
                   (else
                    (loop (cdr rest) args (hash-put! token (car rest) options) passthrough false)))))
          (else
           (loop (cdr tokens) (list-push! (car tokens) args)
                 options passthrough false))))
  (loop argv (make-list) (make-hash) (make-list) false))

(claim cli-define-route (-> cli-router-t string-t cli-router-t))
(define (cli-define-route router command)
  (cli-router-put-routes!
    (list-push! (cli-parse-route command) (cli-router-routes router))
    router))

(claim cli-define-handler (-> cli-router-t string-t (-> cli-ctx-t void-t) cli-router-t))
(define (cli-define-handler router name handler)
  (cli-router-put-handlers!
    (hash-put! name handler (cli-router-handlers router))
    router))

(claim cli-print-name-and-version (-> cli-router-t void-t))
(define (cli-print-name-and-version router)
  (println (string-join " " [(cli-router-name router) (cli-router-version router)])))

(claim cli-print-commands (-> cli-router-t void-t))
(define (cli-print-commands router)
  (println "commands:")
  (list-each (lambda (route)
               (println (string-append "  " (cli-route-command route))))
             (cli-router-routes router)))

(claim cli-router-run (-> cli-router-t (list-t string-t) void-t))
(define (cli-router-run router argv)
  (if (list-empty? argv)
    (begin
      (cli-print-name-and-version router)
      (cli-print-commands router))
    (let ((name (car argv))
          (tokens (cdr argv)))
      (match (list-find (lambda (r) (equal? (cli-route-name r) name))
                        (cli-router-routes router))
        ((just route)
         (match (hash-get-maybe name (cli-router-handlers router))
           ((just handler) (handler (cli-route-match route tokens)))
           ((nothing)
            (println (string-join " " ["[cli] undefined handler:" name]))
            (exit 1))))
        ((nothing)
         (println (string-join " " ["unknown command:" name]))
         (cli-print-name-and-version router)
         (cli-print-commands router))))))

(claim cli-arg-count (-> cli-ctx-t int-t))
(define (cli-arg-count ctx)
  (list-length (cli-ctx-args ctx)))

(claim cli-arg-get (-> int-t cli-ctx-t string-t))
(define (cli-arg-get i ctx)
  (list-get i (cli-ctx-args ctx)))

(claim cli-option-has? (-> string-t cli-ctx-t bool-t))
(define (cli-option-has? name ctx)
  (hash-has? name (cli-ctx-options ctx)))

(claim cli-option-get (-> string-t cli-ctx-t string-t))
(define (cli-option-get name ctx)
  (hash-get name (cli-ctx-options ctx)))

(claim cli-passthrough-count (-> cli-ctx-t int-t))
(define (cli-passthrough-count ctx)
  (list-length (cli-ctx-passthrough ctx)))

(claim cli-passthrough-get (-> int-t cli-ctx-t string-t))
(define (cli-passthrough-get i ctx)
  (list-get i (cli-ctx-passthrough ctx)))
