(module builtin)

(define-test cli-parse-route-test
  (let ((route (cli-parse-route "add x y -- add two numbers")))
    (assert-equal "add x y -- add two numbers" (cli-route-command route))
    (assert-equal "add" (cli-route-name route))
    (assert-equal ["x" "y"] (cli-route-arg-names route))
    (assert (list-empty? (cli-route-option-names route)))))

(define-test cli-parse-route-option-test
  (let ((route (cli-parse-route "mul --x --y -- mul two numbers")))
    (assert-equal "mul --x --y -- mul two numbers" (cli-route-command route))
    (assert-equal "mul" (cli-route-name route))
    (assert (list-empty? (cli-route-arg-names route)))
    (assert-equal ["--x" "--y"] (cli-route-option-names route))))

(define-test cli-parse-route-simple-test
  (let ((route (cli-parse-route "hello")))
    (assert-equal "hello" (cli-route-name route))
    (assert (list-empty? (cli-route-arg-names route)))
    (assert (list-empty? (cli-route-option-names route)))))

(define-test cli-route-match-args-test
  (let ((route (cli-parse-route "add x y"))
         (ctx (cli-route-match route ["1" "2"])))
    (assert-equal 2 (cli-arg-count ctx))
    (assert-equal "1" (cli-arg-get 0 ctx))
    (assert-equal "2" (cli-arg-get 1 ctx))
    (assert (list-empty? (cli-ctx-passthrough ctx)))))

(define-test cli-route-match-options-test
  (let ((route (cli-parse-route "cmd --verbose --name"))
         (ctx (cli-route-match route ["--verbose" "--name" "hello"])))
    (assert (cli-option-has? "--verbose" ctx))
    (assert (cli-option-has? "--name" ctx))
    (assert-equal "" (cli-option-get "--verbose" ctx))
    (assert-equal "hello" (cli-option-get "--name" ctx))))

(define-test cli-route-match-passthrough-test
  (let ((route (cli-parse-route "cmd"))
         (ctx (cli-route-match route ["--" "check" "--profile"])))
    (assert-equal 0 (cli-arg-count ctx))
    (assert-equal 2 (cli-passthrough-count ctx))
    (assert-equal "check" (cli-passthrough-get 0 ctx))
    (assert-equal "--profile" (cli-passthrough-get 1 ctx))))

(define-test cli-route-match-mixed-test
  (let ((route (cli-parse-route "run file --entry"))
         (ctx (cli-route-match route ["prog.xexe" "--entry" "main" "--" "--verbose"])))
    (assert-equal 1 (cli-arg-count ctx))
    (assert-equal "prog.xexe" (cli-arg-get 0 ctx))
    (assert (cli-option-has? "--entry" ctx))
    (assert-equal "main" (cli-option-get "--entry" ctx))
    (assert-equal 1 (cli-passthrough-count ctx))
    (assert-equal "--verbose" (cli-passthrough-get 0 ctx))))

(define-test cli-make-router-test
  (let ((router (cli-make-router "test" "0.1.0")))
    (assert-equal "test" (cli-router-name router))
    (assert-equal "0.1.0" (cli-router-version router))
    (assert (list-empty? (cli-router-routes router)))))

(define-test cli-define-route-test
  (let ((router (cli-make-router "test" "0.1.0"))
         (router (cli-define-route router "add x y"))
         (router (cli-define-route router "sub a b")))
    (assert-equal 2 (list-length (cli-router-routes router)))))

(define-test cli-router-run-test
  (let ((router (cli-make-router "test" "0.1.0"))
         (router (cli-define-route router "add x y"))
         (result (make-list)))
    (cli-define-handler router "add"
      (lambda (ctx)
        (list-push! (cli-arg-get 0 ctx) result)
        (list-push! (cli-arg-get 1 ctx) result)
        void))
    (cli-router-run router ["add" "3" "4"])
    (assert-equal ["3" "4"] result)))

(define-test cli-router-run-test-no-command
  (let ((router (cli-make-router "test" "0.1.0"))
         (router (cli-define-route router "add x y")))
    (cli-router-run router [])))
