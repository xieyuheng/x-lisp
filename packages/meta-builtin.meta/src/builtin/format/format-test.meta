(module builtin)

(define-test format-int-test
  (assert-equal "42" (format-int 42))
  (assert-equal "-1" (format-int -1)))

(define-test format-float-test
  (assert-equal "42.0" (format-float 42.0))
  (assert-equal "0.0" (format-float 0.0)))

(define-test format-symbol-test
  (assert-equal "'hello" (format-symbol 'hello)))

(define-test format-bool-test
  (assert-equal "#t" (format-bool true))
  (assert-equal "#f" (format-bool false)))

(define-test format-text-test
  (assert-equal "\"abc\"" (format-text "abc")))

(define-test format-void-test
  (assert-equal "#void" (format-void void)))
