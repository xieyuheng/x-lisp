(module builtin)

(declare-primitive-function format-as-sexp 1)

(claim format-as-sexp (all (A) (-> A text-t)))

(claim format-int (-> int-t text-t))
(define (format-int x) (format-as-sexp x))

(claim format-float (-> float-t text-t))
(define (format-float x) (format-as-sexp x))

(claim format-symbol (-> symbol-t text-t))
(define (format-symbol x) (text-append "'" (format-as-sexp x)))

(claim format-bool (-> bool-t text-t))
(define (format-bool x) (format-as-sexp x))

(claim format-text (-> text-t text-t))
(define (format-text x) (format-as-sexp x))

(claim format-void (-> void-t text-t))
(define (format-void x) (format-as-sexp x))
