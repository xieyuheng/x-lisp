(module builtin)

(claim int-product
  (-> (list-t int-t)
      int-t))

(define (int-product xs)
  (if (list-is-empty xs)
    1
    (imul (car xs) (int-product (cdr xs)))))

(define-test int-product-test
  (assert-equal 1 (int-product (@list)))
  (assert-equal 6 (int-product (@list 1 2 3)))
  (assert-equal 24 (int-product (@list 1 2 3 4))))
