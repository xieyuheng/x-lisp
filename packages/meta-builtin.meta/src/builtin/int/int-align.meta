(module builtin)

(claim int-align (-> int-t int-t int-t))

(define (int-align n alignment)
  (let ((remainder (imod n alignment)))
    (if (equal 0 remainder)
      n
      (iadd (isub n remainder) alignment))))

(define-test int-align-test
  (assert-equal 0 (int-align 0 16))
  (assert-equal 16 (int-align 8 16))
  (assert-equal 16 (int-align 16 16))
  (assert-equal 32 (int-align 24 16)))
