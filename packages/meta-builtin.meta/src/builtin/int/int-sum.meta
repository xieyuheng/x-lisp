(module builtin)

(claim int-sum
  (-> (list-t int-t)
      int-t))

(define (int-sum xs)
  (if (list-is-empty xs)
    0
    (iadd (car xs) (int-sum (cdr xs)))))

(define-test int-sum-test
  (assert-equal 0 (int-sum (@list)))
  (assert-equal 6 (int-sum (@list 1 2 3)))
  (assert-equal 10 (int-sum (@list 1 2 3 4))))
