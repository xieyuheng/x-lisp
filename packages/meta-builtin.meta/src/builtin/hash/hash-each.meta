(module builtin)

(claim hash-each-value
  (polymorphic (K V Any)
    (-> (-> V Any) (hash-t K V)
        void-t)))

(define (hash-each-value f hash)
  (list-each f (hash-values hash)))

(claim hash-each-key
  (polymorphic (K V Any)
    (-> (-> K Any) (hash-t K V)
        void-t)))

(define (hash-each-key f hash)
  (list-each f (hash-keys hash)))

(claim hash-each-entry
  (polymorphic (K V Any)
    (-> (-> (pair-t K V) Any) (hash-t K V)
        void-t)))

(define (hash-each-entry f hash)
  (list-each f (hash-entries hash)))

(claim hash-each
  (polymorphic (K V Any)
    (-> (-> K V Any) (hash-t K V)
        void-t)))

(define (hash-each f hash)
  (list-each (lambda (entry)
               (f (pair-first entry) (pair-second entry)))
             (hash-entries hash)))

(define-test hash-each-value-test
  (hash-each-value
    (lambda (value) (println value))
    (@hash 1 2 3 4)))

(define-test hash-each-key-test
  (hash-each-key
    (lambda (key) (println key))
    (@hash 1 2 3 4)))

(define-test hash-each-entry-test
  (hash-each-entry
    (lambda (entry) (println entry))
    (@hash 1 2 3 4)))

(define-test hash-each-test
  (hash-each
    (lambda (key value)
      (println key)
      (println value))
    (@hash 1 2 3 4)))
