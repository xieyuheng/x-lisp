(module builtin)

(claim hash-each-value
  (all (K V Any)
    (-> (hash-t K V) (-> V Any)
        void-t)))

(define (hash-each-value hash f)
  (list-each (hash-values hash) f))

(claim hash-each-key
  (all (K V Any)
    (-> (hash-t K V) (-> K Any)
        void-t)))

(define (hash-each-key hash f)
  (list-each (hash-keys hash) f))

(claim hash-each-entry
  (all (K V Any)
    (-> (hash-t K V) (-> (pair-t K V) Any)
        void-t)))

(define (hash-each-entry hash f)
  (list-each (hash-entries hash) f))

(claim hash-each
  (all (K V Any)
    (-> (hash-t K V) (-> K V Any)
        void-t)))

(define (hash-each hash f)
  (list-each (hash-entries hash)
    (lambda (entry) (f (pair-first entry) (pair-second entry)))))

(define-test hash-each-value-test
  (hash-each-value
    (@hash 1 2 3 4)
    (lambda (value) (println value))))

(define-test hash-each-key-test
  (hash-each-key
    (@hash 1 2 3 4)
    (lambda (key) (println key))))

(define-test hash-each-entry-test
  (hash-each-entry
    (@hash 1 2 3 4)
    (lambda (entry) (println entry))))

(define-test hash-each-test
  (hash-each
    (@hash 1 2 3 4)
    (lambda (key value)
      (println key)
      (println value))))
