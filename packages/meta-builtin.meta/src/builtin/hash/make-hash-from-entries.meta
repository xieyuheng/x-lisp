(module builtin)

(claim make-hash-from-entries
  (polymorphic (K V)
    (-> (list-t (pair-t K V))
        (hash-t K V))))

(define (make-hash-from-entries entries)
  (hash-copy-put-entries entries (@hash)))

(define-test make-hash-from-entries-test
  (assert-equal
    (@hash 'a 1 'b 2)
    (make-hash-from-entries
     [(make-pair 'a 1)
      (make-pair 'b 2)])))
