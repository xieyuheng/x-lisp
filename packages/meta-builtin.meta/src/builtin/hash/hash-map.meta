(module builtin)

(claim hash-map-key
  (all (K1 K2 V)
    (-> (-> K1 K2) (hash-t K1 V)
        (hash-t K2 V))))

(define (hash-map-key f hash)
  (make-hash-from-entries
    (list-map (lambda (entry)
                (make-pair (f (pair-first entry)) (pair-second entry)))
      (hash-entries hash))))

(define-test hash-map-key-test
  (assert-equal
    (@hash 2 2 4 4)
    (hash-map-key (iadd 1) (@hash 1 2 3 4))))

(claim hash-map-value
  (all (K V1 V2)
    (-> (-> V1 V2) (hash-t K V1)
        (hash-t K V2))))

(define (hash-map-value f hash)
  (make-hash-from-entries
    (list-map (lambda (entry)
                (make-pair (pair-first entry) (f (pair-second entry))))
      (hash-entries hash))))

(define-test hash-map-value-test
  (assert-equal
    (@hash 1 3 3 5)
    (hash-map-value (iadd 1) (@hash 1 2 3 4))))

(claim hash-map-entry
  (all (K1 V1 K2 V2)
    (-> (-> (pair-t K1 V1)
            (pair-t K2 V2))
        (hash-t K1 V1)
        (hash-t K2 V2))))

(define (hash-map-entry f hash)
  (make-hash-from-entries
    (list-map f (hash-entries hash))))

(define-test hash-map-entry-test
  (assert-equal
    (@hash 2 3 4 5)
    (hash-map-entry
      (lambda (entry)
        (make-pair
          (iadd 1 (pair-first entry))
          (iadd 1 (pair-second entry))))
      (@hash 1 2 3 4))))

(claim hash-map
  (all (K1 V1 K2 V2)
    (-> (-> K1 V1 (pair-t K2 V2))
        (hash-t K1 V1)
        (hash-t K2 V2))))

(define (hash-map f hash)
  (make-hash-from-entries
    (list-map
      (lambda (entry)
        (f (pair-first entry) (pair-second entry)))
      (hash-entries hash))))

(define-test hash-map-test
  (assert-equal
    (@hash 2 3 4 5)
    (hash-map
      (lambda (key value)
        (make-pair (iadd 1 key) (iadd 1 value)))
      (@hash 1 2 3 4))))
