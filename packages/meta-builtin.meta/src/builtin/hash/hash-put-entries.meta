(module builtin)

(claim hash-copy-put-entries
  (all (K V)
    (-> (list-t (pair-t K V)) (hash-t K V)
        (hash-t K V))))

(define (hash-copy-put-entries entries hash)
  (hash-put-entries entries (hash-copy hash)))

(claim hash-put-entries
  (all (K V)
    (-> (list-t (pair-t K V)) (hash-t K V)
        (hash-t K V))))

(define (hash-put-entries entries hash)
  (if (list-is-empty entries)
    hash
    (let ((entry (car entries)))
      (hash-put (pair-first entry) (pair-second entry) hash)
      (hash-put-entries (cdr entries) hash))))

(define-test hash-put-entries-test
  (assert-equal
    (@hash 'a 1 'b 2)
    (hash-copy-put-entries [(make-pair 'a 1)
                            (make-pair 'b 2)]
      (@hash)))

  (let ((hash (@hash)))
    (assert-equal
      (@hash 'a 1 'b 2)
      (hash-put-entries [(make-pair 'a 1)
                         (make-pair 'b 2)]
        hash))
    (assert-equal
      (@hash 'a 1 'b 2) hash)))
