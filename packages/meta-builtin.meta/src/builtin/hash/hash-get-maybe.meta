(module builtin)

(claim hash-get-maybe
  (all (K V)
    (-> (hash-t K V) K
        (maybe-t V))))

(define (hash-get-maybe hash key)
  (if (hash-has hash key)
    (just (hash-get hash key))
    (nothing)))

(define-test hash-get-maybe-test
  (assert-equal (just "b") (hash-get-maybe (@hash 1 "a" 2 "b" 3 "c") 2))
  (assert-equal (nothing) (hash-get-maybe (@hash 1 "a" 2 "b" 3 "c") 4)))
