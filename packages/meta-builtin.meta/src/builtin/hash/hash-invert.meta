(module builtin)

(claim hash-invert
  (all (K V)
    (-> (hash-t K V)
        (hash-t V K))))

(define (hash-invert hash)
  (hash-map hash
    (lambda (k v) (make-pair v k))))

(define-test hash-invert-test
  (assert-equal
    (@hash 2 1 4 3)
    (hash-invert (@hash 1 2 3 4))))

(claim hash-invert-group
  (all (K V)
    (-> (hash-t K V)
        (hash-t V (set-t K)))))

(define (hash-invert-group hash)
  (let ((new-hash (@hash)))
    (hash-each-value
      hash
      (lambda (value)
        (let ((keys (hash-keys (hash-select-value hash (equal value)))))
          (hash-put new-hash value (list-to-set keys)))))
    new-hash))

(define-test hash-invert-group-test
  (assert-equal
    (@hash 2 (@set 1 2)
           4 (@set 3 4))
    (hash-invert-group
      (@hash 1 2
             3 4
             2 2
             4 4))))
