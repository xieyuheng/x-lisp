(module builtin)

(define-test text-test
  (println "abc")

  (assert-equal 2 (text-length "中文"))

  (assert (text-is-empty ""))
  (assert-not (text-is-empty " "))

  (assert (text-is-blank ""))
  (assert (text-is-blank " "))
  (assert (text-is-blank "  "))
  (assert (text-is-blank " \n "))
  (assert (text-is-blank " \n\t "))
  (assert-not (text-is-blank " \n.\t "))

  (assert-equal "abcdef" (text-append "abc" "def"))

  (assert-equal (@list "a" "b" "c") (text-chars "abc"))

  (assert-equal (@list "123" "456" "789") (text-lines "123\n456\n789\n"))
  (assert-equal (@list "123" "456" "789") (text-lines "123\n456\n789"))
  (assert-equal (@list "123" "" "789") (text-lines "123\n\n789\n"))
  (assert-equal (@list "123" "" "789") (text-lines "123\n\n789"))

  (assert-equal "中" (text-slice "中文" 0 1))
  (assert-equal "文" (text-slice "中文" 1 2)))

(define-test text-join-test
  (assert-equal "a.b.c" (text-join (@list "a" "b" "c") "."))
  (assert-equal "a..b..c" (text-join (@list "a" "b" "c") "..")))

(define-test text-split-test
  (assert-equal (@list "a" "b" "c") (text-split "a.b.c" "."))
  (assert-equal (@list "a" "b" "c") (text-split "a..b..c" "..")))

(define-test text-replace-test
  (assert-equal "a/b/c" (text-replace "a.b.c" "." "/")))

(define-test text-has-prefix-test
  (assert (text-has-prefix "abc" ""))
  (assert (text-has-prefix "abc" "a"))
  (assert (text-has-prefix "abc" "ab"))
  (assert (text-has-prefix "abc" "abc"))
  (assert-not (text-has-prefix "abc" "abc~"))
  (assert-not (text-has-prefix "abc" "b"))

  (assert (text-has-suffix "abc" ""))
  (assert (text-has-suffix "abc" "c"))
  (assert (text-has-suffix "abc" "bc"))
  (assert (text-has-suffix "abc" "abc"))
  (assert-not (text-has-suffix "abc" "~abc"))
  (assert-not (text-has-suffix "abc" "b")))

(define-test text-to-upper-case-test
  (assert-equal "ABC" (text-to-upper-case "abc"))
  (assert-equal "abc" (text-to-lower-case "ABC")))

(define-test text-get-code-point-test
  (assert-equal 97 (text-get-code-point "abc" 0))
  (assert-equal 98 (text-get-code-point "abc" 1))
  (assert-equal 99 (text-get-code-point "abc" 2)))

(define-test text-include-test
  (assert (text-include "aabbcc" "bb"))
  (assert (text-include "aabbcc" "ab"))
  (assert-not (text-include "aabbcc" "ba")))

(define-test text-find-index-test
  (assert-equal 0 (text-find-index "01234" "0"))
  (assert-equal 1 (text-find-index "01234" "1"))
  (assert-equal 2 (text-find-index "01234" "2"))
  (assert-equal -1 (text-find-index "01234" "5"))

  (assert-equal 0 (text-find-index "01234" "01"))
  (assert-equal 1 (text-find-index "01234" "12"))
  (assert-equal 2 (text-find-index "01234" "23"))
  (assert-equal -1 (text-find-index "01234" "21")))

(define-test text-trim-test
  (assert-equal "abc  " (text-trim-left "  abc  "))
  (assert-equal "  abc" (text-trim-right "  abc  "))
  (assert-equal "abc  " (text-trim-start "  abc  "))
  (assert-equal "  abc" (text-trim-end "  abc  "))
  (assert-equal "abc" (text-trim "  abc  ")))

(define-test text-is-int-test
  (assert (text-is-int "123"))
  (assert (text-is-int "-123"))
  (assert (text-is-int "0"))
  (assert-not (text-is-int "abc"))
  (assert-not (text-is-int "123.0"))
  (assert-not (text-is-int "")))

(define-test text-is-float-test
  (assert (text-is-float "123.0"))
  (assert (text-is-float "-123.5"))
  (assert (text-is-float "0.0"))
  (assert (text-is-float ".5"))
  (assert-not (text-is-float "abc"))
  (assert-not (text-is-float "123"))
  (assert-not (text-is-float "")))

(define-test text-to-int-test
  (assert-equal 123 (text-to-int "123"))
  (assert-equal -123 (text-to-int "-123"))
  (assert-equal 0 (text-to-int "0")))

(define-test text-to-float-test
  (assert-equal 123.0 (text-to-float "123.0"))
  (assert-equal -123.5 (text-to-float "-123.5"))
  (assert-equal 0.0 (text-to-float "0.0"))
  (assert-equal 0.5 (text-to-float ".5")))
