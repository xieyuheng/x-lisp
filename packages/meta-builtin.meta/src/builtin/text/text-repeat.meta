(module builtin)

(claim text-repeat
  (-> text-t int-t
      text-t))

(define (text-repeat text n)
  (if (equal n 0)
    ""
    (text-append text (text-repeat text (isub n 1)))))

(define-test text-repeat-test
  (assert-equal "" (text-repeat "a" 0))
  (assert-equal "a" (text-repeat "a" 1))
  (assert-equal "aa" (text-repeat "a" 2))
  (assert-equal "aaa" (text-repeat "a" 3)))
