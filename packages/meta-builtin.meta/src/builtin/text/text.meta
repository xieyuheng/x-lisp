(module builtin)

(declare-primitive-function is-text 1)
(declare-primitive-function text-length 1)
(declare-primitive-function text-is-empty 1)
(declare-primitive-function text-is-blank 1)
(declare-primitive-function text-slice 3)
(declare-primitive-function text-append 2)
(declare-primitive-function text-concat 1)
(declare-primitive-function text-compare-lexical 2)
(declare-primitive-function text-to-symbol 1)
(declare-primitive-function text-chars 1)
(declare-primitive-function text-lines 1)
(declare-primitive-function text-split 2)
(declare-primitive-function text-join 2)
(declare-primitive-function text-replace 3)
(declare-primitive-function text-starts-with 2)
(declare-primitive-function text-ends-with 2)
(declare-primitive-function text-to-upper-case 1)
(declare-primitive-function text-to-lower-case 1)
(declare-primitive-function text-get-code-point 2)
(declare-primitive-function text-contains 2)
(declare-primitive-function text-find-index 2)
(declare-primitive-function text-trim-left 1)
(declare-primitive-function text-trim-right 1)
(declare-primitive-function text-trim-start 1)
(declare-primitive-function text-trim-end 1)
(declare-primitive-function text-trim 1)
(declare-primitive-function text-is-int 1)
(declare-primitive-function text-is-float 1)
(declare-primitive-function text-to-int 1)
(declare-primitive-function text-to-float 1)

(claim is-text (all (A) (-> A bool-t)))
(claim text-length (-> text-t int-t))
(claim text-is-empty (-> text-t bool-t))
(claim text-is-blank (-> text-t bool-t))
(claim text-slice (-> int-t int-t text-t text-t))
(claim text-append (-> text-t text-t text-t))
(claim text-concat (-> (list-t text-t) text-t))
(claim text-compare-lexical (-> text-t text-t int-t))
(claim text-to-symbol (-> text-t symbol-t))
(claim text-chars (-> text-t (list-t text-t)))
(claim text-lines (-> text-t (list-t text-t)))
(claim text-split (-> text-t text-t (list-t text-t)))
(claim text-join (-> text-t (list-t text-t) text-t))
(claim text-replace (-> text-t text-t text-t text-t))
(claim text-starts-with (-> text-t text-t bool-t))
(claim text-ends-with (-> text-t text-t bool-t))
(claim text-to-upper-case (-> text-t text-t))
(claim text-to-lower-case (-> text-t text-t))
(claim text-get-code-point (-> int-t text-t int-t))
(claim text-contains (-> text-t text-t bool-t))
(claim text-find-index (-> text-t text-t int-t))
(claim text-trim-left (-> text-t text-t))
(claim text-trim-right (-> text-t text-t))
(claim text-trim-start (-> text-t text-t))
(claim text-trim-end (-> text-t text-t))
(claim text-trim (-> text-t text-t))
(claim text-is-int (-> text-t bool-t))
(claim text-is-float (-> text-t bool-t))
(claim text-to-int (-> text-t int-t))
(claim text-to-float (-> text-t float-t))
