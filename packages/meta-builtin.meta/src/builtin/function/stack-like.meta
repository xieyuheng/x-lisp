(module builtin)

(claim swap
  (all (A B C)
    (-> (-> A B C) B A C)))

(define (swap f x y) (f y x))

(claim drop
  (all (A B C)
    (-> (-> A B) (-> C A B))))

(define (drop f)
  (lambda (dropped x) (f x)))

(claim dup
  (all (A B)
    (-> (-> A A B) (-> A B))))

(define (dup f)
  (lambda (x) (f x x)))
