(module builtin)

(claim float-sum
  (-> (list-t float-t)
      float-t))

(define (float-sum xs)
  (if (list-is-empty xs)
    0.0
    (fadd (car xs) (float-sum (cdr xs)))))

(define-test float-sum-test
  (assert-equal 0.0 (float-sum (@list)))
  (assert-equal 6.0 (float-sum (@list 1.0 2.0 3.0)))
  (assert-equal 10.0 (float-sum (@list 1.0 2.0 3.0 4.0))))
