(module builtin)

(claim float-product
  (-> (list-t float-t)
      float-t))

(define (float-product xs)
  (if (list-is-empty xs)
    1.0
    (fmul (car xs) (float-product (cdr xs)))))

(define-test float-product-test
  (assert-equal 1.0 (float-product (@list)))
  (assert-equal 6.0 (float-product (@list 1.0 2.0 3.0)))
  (assert-equal 24.0 (float-product (@list 1.0 2.0 3.0 4.0))))
