(module builtin)

(declare-primitive-function exit 1)
(declare-primitive-function current-directory 0)
(declare-primitive-function current-command-line 0)
(declare-primitive-function current-full-command-line 0)
(declare-primitive-function current-stdout-file 0)
(declare-primitive-function current-stderr-file 0)

(claim exit (-> int-t void-t))
(claim current-directory (-> text-t))
(claim current-command-line (-> (list-t text-t)))
(claim current-full-command-line (-> (list-t text-t)))
(claim current-stdout-file (-> file-t))
(claim current-stderr-file (-> file-t))
