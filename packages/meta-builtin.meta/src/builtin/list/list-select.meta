(module builtin)

(claim list-select
  (all (A)
    (-> (-> A bool-t) (list-t A)
        (list-t A))))

(define (list-select p list)
  (cond ((list-is-empty list) list)
        ((p (car list))
         (cons (car list) (list-select p (cdr list))))
        (else
         (list-select p (cdr list)))))

(define-test list-select-test
  (assert-equal
    (list-select (negation (equal 0)) (@list 0 1 0 2 0 3))
    (@list 1 2 3)))

(claim list-reject
  (all (A)
    (-> (-> A bool-t) (list-t A)
        (list-t A))))

(define (list-reject p list)
  (list-select (negation p) list))

(define-test list-reject-test
  (assert-equal
    (list-reject (equal 0) (@list 0 1 0 2 0 3))
    (@list 1 2 3)))
