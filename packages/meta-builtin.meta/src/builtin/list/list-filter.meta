(module builtin)

(claim list-filter
  (all (A)
    (-> (list-t A) (-> A bool-t)
        (list-t A))))

(define (list-filter list p)
  (cond ((list-is-empty list) list)
        ((p (car list))
         (cons (car list) (list-filter (cdr list) p)))
        (else
         (list-filter (cdr list) p))))

(define-test list-filter-test
  (assert-equal
    (list-filter (@list 0 1 0 2 0 3) (negation (equal 0)))
    (@list 1 2 3)))
