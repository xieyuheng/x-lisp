(module builtin)

(claim list-map-concat
  (all (A B)
    (-> (list-t A)
        (-> A (list-t B))
        (list-t B))))

(define (list-map-concat xs f)
  (list-concat (list-map xs f)))

(define-test list-map-concat-test
  (assert-equal (@list 1 2 3 4)
    (list-map-concat (@list 1 3) (lambda (x) (@list x (iadd x 1)))))
  (assert-equal (@list)
    (list-map-concat (@list 1 2 3) (lambda (x) (@list))))
  (assert-equal (@list 3 2 1 6 5 4)
    (list-map-concat (@list (@list 1 2 3) (@list 4 5 6)) list-copy-reverse)))
