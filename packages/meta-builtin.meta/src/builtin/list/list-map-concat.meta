(module builtin)

(claim list-map-concat
  (all (A B)
    (-> (-> A (list-t B))
        (list-t A)
        (list-t B))))

(define (list-map-concat f xs)
  (list-concat (list-map f xs)))

(define-test list-map-concat-test
  (assert-equal [1 2 3 4]
    (list-map-concat (lambda (x) [x (iadd x 1)]) [1 3]))
  (assert-equal []
    (list-map-concat (lambda (x) []) [1 2 3]))
  (assert-equal [3 2 1 6 5 4]
    (list-map-concat list-copy-reverse [[1 2 3] [4 5 6]])))
