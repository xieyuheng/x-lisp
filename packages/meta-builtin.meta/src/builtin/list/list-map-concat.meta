(module builtin)

(claim list-map-concat
  (all (A B)
    (-> (-> A (list-t B))
        (list-t A)
        (list-t B))))

(define (list-map-concat f xs)
  (list-concat (list-map f xs)))

(define-test list-map-concat-test
  (assert-equal (@list 1 2 3 4)
    (list-map-concat (lambda (x) (@list x (iadd x 1))) (@list 1 3)))
  (assert-equal (@list)
    (list-map-concat (lambda (x) (@list)) (@list 1 2 3)))
  (assert-equal (@list 3 2 1 6 5 4)
    (list-map-concat list-copy-reverse (@list (@list 1 2 3) (@list 4 5 6)))))
