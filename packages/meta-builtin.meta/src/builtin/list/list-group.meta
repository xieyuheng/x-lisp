(module builtin)

(claim list-group
  (all (K V)
    (-> (list-t V) (-> V K)
        (hash-t K (list-t V)))))

(define (list-group list f)
  (let ((new-hash (@hash)))
    (list-each
      list
      (lambda (value)
        (let ((key (f value)))
          (unless (hash-has new-hash key)
            (hash-put new-hash key (make-array)))
          (let ((group (hash-get new-hash key)))
            (array-push group value)))))
    (hash-map-value new-hash array-to-list)))

(define-test list-group-test
  (assert-equal
    (@hash 0 (@list 0 3)
           1 (@list 1 4)
           2 (@list 2 5))
    (list-group (@list 0 1 2 3 4 5) (swap imod 3))))