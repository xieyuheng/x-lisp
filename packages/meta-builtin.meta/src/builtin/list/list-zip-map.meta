(module builtin)

(claim list-zip-map
  (all (A B C)
    (-> (-> A B C) (list-t A) (list-t B)
        (list-t C))))

(define (list-zip-map f left right)
  (list-map
    (lambda (pair)
      (f (pair-first pair)
        (pair-second pair)))
    (list-zip left right)))

(define-test list-zip-map-test
  (assert-equal
    (list-zip-map iadd (@list 1 2 3) (@list 10 20 30))
    (@list 11 22 33)))
