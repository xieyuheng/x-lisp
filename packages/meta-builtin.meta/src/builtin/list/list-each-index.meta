(module builtin)

(claim list-each-index
  (all (A Any)
    (-> (list-t A) (-> int-t A Any) void-t)))

(define (list-each-index list f)
  (list-each-index-aux f list 0))

(claim list-each-index-aux
  (all (A Any)
    (-> (-> int-t A Any) (list-t A) int-t void-t)))

(define (list-each-index-aux f list i)
  (if (list-is-empty list)
    void
    (begin
      (f i (car list))
      (list-each-index-aux f (cdr list) (iadd i 1)))))

(define-test list-each-index-test
  (let ((results (make-array)))
    (list-each-index
      (@list 'a 'b 'c)
      (lambda (i x)
        (array-push results (make-pair i x))))
    (assert-equal (@list (make-pair 0 'a) (make-pair 1 'b) (make-pair 2 'c))
      (array-to-list results))))
