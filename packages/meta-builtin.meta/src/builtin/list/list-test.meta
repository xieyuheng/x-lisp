(module builtin)

(define-test list-test
  (println (the (list-t int-t) (@list 1 2 3)))
  (println (@list 1 2 3))
  (println '(1 2 3))
  (println (@list 1 2 3))

  (println (@list 'a 'b 'c))
  (println '(a b c))

  (assert-equal (@list 1 2 3) '(1 2 3))
  (assert-equal (@list 'a 'b 'c) '(a b c))

  (assert-equal
    (@list (@list 1 2 3)
     (@list 4 5 6)
     (@list 7 8 9))
    (@list (@list 1 2 3)
     (@list 4 5 6)
     (@list 7 8 9)))

  (assert-not-equal
    (@list (@list 1 2 3)
     (@list 4 5 6)
     (@list 7 8 9))
    (@list (@list 1 2 3)
     (@list 4 5 6)
     (@list 7 8 10)))

  (assert (list-is-empty (@list)))
  (assert-not (list-is-empty (@list 1)))

  (assert-equal (cons 1 (cons 2 (cons 3 (@list)))) (@list 1 2 3))
  (assert-equal (car (@list 1 2 3)) 1)
  (assert-equal (cdr (@list 1 2 3)) (@list 2 3))

  (assert-equal (list-head (@list 1 2 3)) 1)
  (assert-equal (list-rest (@list 1 2 3)) (@list 2 3))

  (assert-equal (list-but-last (@list 1 2 3)) (@list 1 2))
  (assert-equal (list-last (@list 1 2 3)) 3)

  (assert-equal (@set 1 2 3) (list-to-set (@list 1 2 3)))

  (assert-equal (list-get (@list 1 2 3) 0) 1)
  (assert-equal (list-get (@list 1 2 3) 1) 2)
  (assert-equal (list-get (@list 1 2 3) 2) 3)

  (assert-equal (list-length (@list)) 0)
  (assert-equal (list-length (@list 1 2 3)) 3)
  (assert-equal
    (list-length (@list (@list 1 2 3)
                  (@list 4 5 6)
                  (@list 7 8 9)))
    3)

  ;; list of functions

  (let ((fs (the (list-t (-> int-t int-t))
              (@list (iadd 1) (iadd 2) (iadd 3)))))
    (assert-equal 1 ((list-get fs 0) 0))
    (assert-equal 2 ((list-get fs 1) 0))
    (assert-equal 3 ((list-get fs 2) 0))))

(define-test list-copy-put-test
  (let ((list (@list 0 0 0))
         (list (list-copy-put list 0 1))
         (list (list-copy-put list 1 2))
         (list (list-copy-put list 2 3)))
    (assert-equal list (@list 1 2 3)))

  ;; list-copy-put has NO side effect:

  (let ((list (@list 0 0 0)))
    (list-copy-put list 0 1)
    (list-copy-put list 1 2)
    (list-copy-put list 2 3)
    (assert-equal list (@list 0 0 0))))

(define-test list-copy-reverse-test
  (assert-equal (list-copy-reverse (@list 1 2 3)) (@list 3 2 1)))