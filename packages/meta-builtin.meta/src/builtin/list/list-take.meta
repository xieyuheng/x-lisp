(module builtin)

(claim list-take
  (all (A)
    (-> int-t (list-t A)
        (list-t A))))

(define (list-take n list)
  (assert (int-is-non-negative n))
  (if (or (equal n 0) (list-is-empty list))
    (@list)
    (cons (car list) (list-take (isub n 1) (cdr list)))))

(define-test list-take-test
  (assert-equal (list-take 0 (@list 1 2 3)) (@list))
  (assert-equal (list-take 1 (@list 1 2 3)) (@list 1))
  (assert-equal (list-take 2 (@list 1 2 3)) (@list 1 2))
  (assert-equal (list-take 3 (@list 1 2 3)) (@list 1 2 3))
  (assert-equal (list-take 4 (@list 1 2 3)) (@list 1 2 3)))

(claim list-drop
  (all (A)
    (-> int-t (list-t A)
        (list-t A))))

(define (list-drop n list)
  (assert (int-is-non-negative n))
  (if (or (equal n 0) (list-is-empty list))
    list
    (list-drop (isub n 1) (cdr list))))

(define-test list-drop-test
  (assert-equal (list-drop 0 (@list 1 2 3)) (@list 1 2 3))
  (assert-equal (list-drop 1 (@list 1 2 3)) (@list 2 3))
  (assert-equal (list-drop 2 (@list 1 2 3)) (@list 3))
  (assert-equal (list-drop 3 (@list 1 2 3)) (@list))
  (assert-equal (list-drop 4 (@list 1 2 3)) (@list)))
