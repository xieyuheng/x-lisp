(module builtin)

(claim list-fold-left-index
  (all (E R)
    (-> (-> int-t R E R) R (list-t E) R)))

(define (list-fold-left-index f folded list)
  (list-fold-left-index-aux f folded list 0))

(claim list-fold-left-index-aux
  (all (E R)
    (-> (-> int-t R E R) R (list-t E) int-t R)))

(define (list-fold-left-index-aux f folded list i)
  (if (list-is-empty list)
    folded
    (list-fold-left-index-aux
     f (f i folded (car list))
     (cdr list)
     (iadd i 1))))

(define-test list-fold-left-index-test
  (assert-equal
    (list-fold-left-index
      (lambda (i folded x) (iadd folded (imul i x)))
      0 (@list 10 20 30))
    80)
  (assert-equal
    (list-fold-left-index
      (lambda (i folded x) (cons i folded))
      (@list) (@list 'a 'b 'c))
    (@list 2 1 0))
  (assert-equal
    (list-fold-left-index
      (lambda (i folded x) (iadd folded x))
      0 (@list))
    0))
