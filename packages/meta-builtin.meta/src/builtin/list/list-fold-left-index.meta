(module builtin)

(claim list-fold-left-index
  (all (E R)
    (-> (list-t E) R (-> int-t R E R) R)))

(define (list-fold-left-index list folded f)
  (list-fold-left-index-aux f folded list 0))

(claim list-fold-left-index-aux
  (all (E R)
    (-> (-> int-t R E R) R (list-t E) int-t R)))

(define (list-fold-left-index-aux f folded list i)
  (if (list-is-empty list)
    folded
    (list-fold-left-index-aux
     f (f i folded (car list))
     (cdr list)
     (iadd i 1))))

(define-test list-fold-left-index-test
  (assert-equal
    (list-fold-left-index
      (@list 10 20 30)
      0 (lambda (i folded x) (iadd folded (imul i x))))
    80)
  (assert-equal
    (list-fold-left-index
      (@list 'a 'b 'c)
      (@list) (lambda (i folded x) (cons i folded)))
    (@list 2 1 0))
  (assert-equal
    (list-fold-left-index
      (@list)
      0 (lambda (i folded x) (iadd folded x)))
    0))
