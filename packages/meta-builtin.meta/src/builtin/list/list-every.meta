(module builtin)

(claim list-every
  (all (A)
    (-> (list-t A) (-> A bool-t)
        bool-t)))

(define (list-every list p)
  (cond ((list-is-empty list) true)
        ((not (p (car list))) false)
        (else (list-every (cdr list) p))))

(define-test list-every-test
  (assert (list-every (@list 0 1 2 3) int-is-non-negative))
  (assert-not (list-every (@list 0 1 -1 2 3) int-is-non-negative)))

(claim list-some
  (all (A)
    (-> (list-t A) (-> A bool-t)
        bool-t)))

(define (list-some list p)
  (cond ((list-is-empty list) false)
        ((p (car list)) true)
        (else (list-some (cdr list) p))))

(define-test list-some-test
  (assert (list-some (@list -1 -2 0) int-is-non-negative))
  (assert-not (list-some (@list -1 -2 -3) int-is-non-negative)))
