(module builtin)

(define (list-product lhs rhs)
  (list-concat
    (list-map
      lhs
      (lambda (left) (list-map rhs (make-pair left))))))

(define-test list-product-test
  (assert-equal
    (@list (make-pair 1 1) (make-pair 1 2) (make-pair 1 3)
     (make-pair 2 1) (make-pair 2 2) (make-pair 2 3)
     (make-pair 3 1) (make-pair 3 2) (make-pair 3 3))
    (list-product (@list 1 2 3) (@list 1 2 3))))
