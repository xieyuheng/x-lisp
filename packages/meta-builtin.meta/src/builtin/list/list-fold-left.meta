(module builtin)

(claim list-fold-left
  (polymorphic (E R)
    (-> (-> R E R)
        R (list-t E)
        R)))

(define (list-fold-left f folded list)
  (if (list-is-empty list)
    folded
    (list-fold-left
     f (f folded (list-head list))
     (list-rest list))))

(define-test list-fold-left-test
  (assert-equal 10 (list-fold-left iadd 0 [1 2 3 4]))
  (assert-equal [4 3 2 1] (list-fold-left (swap cons) [] [1 2 3 4])))
