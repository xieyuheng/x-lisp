(module builtin)

(claim list-fold-left
  (all (E R)
    (-> (list-t E)
        R (-> R E R)
        R)))

(define (list-fold-left list folded f)
  (if (list-is-empty list)
    folded
    (list-fold-left
     (list-rest list) (f folded (list-head list))
     f)))

(define-test list-fold-left-test
  (assert-equal 10 (list-fold-left (@list 1 2 3 4) 0 iadd))
  (assert-equal (@list 4 3 2 1) (list-fold-left (@list 1 2 3 4) (@list) (swap cons))))
