(module builtin)

(claim list-fold-right
  (all (E R)
    (-> (list-t E)
        R (-> E R R)
        R)))

(define (list-fold-right list folded f)
  (if (list-is-empty list)
    folded
    (list-fold-right
     (list-but-last list) (f (list-last list) folded)
     f)))

(define-test list-fold-right-test
  (assert-equal 10 (list-fold-right (@list 1 2 3 4) 0 iadd))
  (assert-equal (@list 1 2 3 4) (list-fold-right (@list 1 2 3 4) (@list) cons)))
