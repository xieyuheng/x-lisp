(module builtin)

(claim list-fold-right
  (all (E R)
    (-> (-> E R R)
        R (list-t E)
        R)))

(define (list-fold-right f folded list)
  (if (list-is-empty list)
    folded
    (list-fold-right
     f (f (list-last list) folded)
     (list-but-last list))))

(define-test list-fold-right-test
  (assert-equal 10 (list-fold-right iadd 0 (@list 1 2 3 4)))
  (assert-equal (@list 1 2 3 4) (list-fold-right cons (@list) (@list 1 2 3 4))))
