(module builtin)

(claim list-map
  (all (A B)
    (-> (list-t A) (-> A B)
        (list-t B))))

(define (list-map list f)
  (if (list-is-empty list)
    (@list)
    (cons (f (car list)) (list-map (cdr list) f))))

(define-test list-map-test
  (assert-equal
    (list-map (@list 1 2 3) (iadd 10))
    (@list 11 12 13)))
