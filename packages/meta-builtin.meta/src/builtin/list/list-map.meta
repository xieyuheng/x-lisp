(module builtin)

(claim list-map
  (all (A B)
    (-> (-> A B) (list-t A)
        (list-t B))))

(define (list-map f list)
  (if (list-is-empty list)
    (@list)
    (cons (f (car list)) (list-map f (cdr list)))))

(define-test list-map-test
  (assert-equal
    (list-map (iadd 10) (@list 1 2 3))
    (@list 11 12 13)))
