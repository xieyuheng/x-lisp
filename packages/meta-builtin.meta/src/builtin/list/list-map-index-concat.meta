(module builtin)

(claim list-map-index-concat
  (all (A B)
    (-> (-> int-t A (list-t B))
        (list-t A)
        (list-t B))))

(define (list-map-index-concat f list)
  (list-concat (list-map-index f list)))

(define-test list-map-index-concat-test
  (assert-equal [0 10 1 20 2 30]
    (list-map-index-concat (lambda (i x) [i x]) [10 20 30]))
  (assert-equal
    [(make-pair 0 'a)
     (make-pair 0 'a)
     (make-pair 1 'b)
     (make-pair 1 'b)
     (make-pair 2 'c)
     (make-pair 2 'c)]
    (list-map-index-concat (lambda (i x) [(make-pair i x) (make-pair i x)])
      ['a 'b 'c]))
  (assert-equal []
    (list-map-index-concat (lambda (i x) []) [1 2 3]))
  (assert-equal []
    (list-map-index-concat (lambda (i x) [i x]) [])))
