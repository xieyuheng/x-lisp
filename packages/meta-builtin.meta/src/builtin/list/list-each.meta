(module builtin)

(claim list-each
  (all (A Any)
    (-> (list-t A) (-> A Any)
        void-t)))

(define (list-each list f)
  (if (list-is-empty list)
    void
    (begin
      (f (car list))
      (list-each (cdr list) f))))

(define-test list-each-test
  (list-each
   (@list 1 2 3)
   (lambda (x)
     (print x)
     (print "\n"))))
