(module builtin)

(claim list-sort
  (polymorphic (E)
    (-> (-> E E int-t) (list-t E)
        void-t)))

(define (list-sort compare list)
  (let ((n (list-length list)))
    (quicksort compare list 0 (isub n 1))))

(claim quicksort
  (polymorphic (E)
    (-> (-> E E int-t) (list-t E) int-t int-t
        void-t)))

(define (quicksort compare list lo hi)
  (when (int-less lo hi)
    (let ((less-box (make-box))
          (greater-box (make-box)))
      ;; use box to save multiple return value of quicksort-partition
      (quicksort-partition compare list lo hi less-box greater-box)
      (quicksort compare list lo (box-get less-box))
      (quicksort compare list (box-get greater-box) hi))))

(claim quicksort-partition
  (polymorphic (E)
    (-> (-> E E int-t) (list-t E) int-t int-t
        (box-t int-t) (box-t int-t)
        void-t)))

(define (quicksort-partition compare list lo hi less-box greater-box)
  (let ((pivot (list-get (idiv (iadd lo hi) 2) list)))
    (quicksort-partition-loop compare list pivot lo lo hi less-box greater-box)))

(claim quicksort-partition-loop
  (polymorphic (E)
    (-> (-> E E int-t) (list-t E) E int-t int-t int-t
        (box-t int-t) (box-t int-t)
        void-t)))

(define (quicksort-partition-loop compare list pivot index less greater less-box greater-box)
  (if (int-greater index greater)
    (begin
      (box-put (isub less 1) less-box)
      (box-put (iadd greater 1) greater-box))
    (let ((cmp (compare (list-get index list) pivot)))
      (cond
        ((int-less cmp 0)
         (list-swap index less list)
         (quicksort-partition-loop compare list pivot (iadd index 1) (iadd less 1) greater
           less-box greater-box))
        ((int-greater cmp 0)
         (list-swap index greater list)
         (quicksort-partition-loop compare list pivot index less (isub greater 1)
           less-box greater-box))
        (else
         (quicksort-partition-loop compare list pivot (iadd index 1) less greater
           less-box greater-box))))))

(define (list-swap i j list)
  (let ((x (list-get i list))
        (y (list-get j list)))
    (list-put i y list)
    (list-put j x list)))

(claim list-copy-sort
  (polymorphic (E)
    (-> (-> E E int-t) (list-t E)
        (list-t E))))

(define (list-copy-sort compare list)
  (let ((new-list (list-copy list)))
    (list-sort compare new-list)
    new-list))
