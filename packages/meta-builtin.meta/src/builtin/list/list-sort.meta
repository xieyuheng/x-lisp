(module builtin)

(claim list-sort
  (all (E)
    (-> (-> E E int-t) (list-t E)
        void-t)))

(define (list-sort compare list)
  (let ((n (list-length list)))
    (quicksort compare list 0 (isub n 1))))

(claim quicksort
  (all (E)
    (-> (-> E E int-t) (list-t E) int-t int-t
        void-t)))

(define (quicksort compare list lo hi)
  (when (int-less lo hi)
    (let ((bounds (quicksort-partition compare list lo hi)))
      (quicksort compare list lo (pair-first bounds))
      (quicksort compare list (pair-second bounds) hi))))

(claim quicksort-partition
  (all (E)
    (-> (-> E E int-t) (list-t E) int-t int-t
        (pair-t int-t int-t))))

(define (quicksort-partition compare list lo hi)
  (let ((pivot (list-get (idiv (iadd lo hi) 2) list)))
    (quicksort-partition-aux compare list pivot lo lo hi)))

(claim quicksort-partition-aux
  (all (E)
    (-> (-> E E int-t) (list-t E) E int-t int-t int-t
        (pair-t int-t int-t))))

(define (quicksort-partition-aux compare list pivot index less greater)
  (if (int-greater index greater)
    (make-pair (isub less 1) (iadd greater 1))
    (let ((cmp (compare (list-get index list) pivot)))
      (cond
        ((int-less cmp 0)
         (list-swap index less list)
         (quicksort-partition-aux compare list pivot (iadd index 1) (iadd less 1) greater))
        ((int-greater cmp 0)
         (list-swap index greater list)
         (quicksort-partition-aux compare list pivot index less (isub greater 1)))
        (else
         (quicksort-partition-aux compare list pivot (iadd index 1) less greater))))))

(define (list-swap i j list)
  (let ((x (list-get i list))
        (y (list-get j list)))
    (list-put i y list)
    (list-put j x list)))

(claim list-copy-sort
  (all (E)
    (-> (-> E E int-t) (list-t E)
        (list-t E))))

(define (list-copy-sort compare list)
  (let ((new-list (list-copy list)))
    (list-sort compare new-list)
    new-list))
