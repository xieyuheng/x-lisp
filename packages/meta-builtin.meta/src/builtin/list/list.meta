(module builtin)

(declare-primitive-function is-list 1)
(declare-primitive-function make-list 0)
(declare-primitive-function car 1)
(declare-primitive-function cdr 1)
(declare-primitive-function cons 2)
(declare-primitive-function list-head 1)
(declare-primitive-function list-rest 1)
(declare-primitive-function list-but-last 1)
(declare-primitive-function list-last 1)
(declare-primitive-function list-length 1)
(declare-primitive-function list-is-empty 1)
(declare-primitive-function list-copy 1)
(declare-primitive-function list-get 2)
(declare-primitive-function list-copy-put 3)
(declare-primitive-function list-put 3)
(declare-primitive-function list-push 2)
(declare-primitive-function list-pop 1)
(declare-primitive-function list-pop-front 1)
(declare-primitive-function list-push-front 2)
(declare-primitive-function list-copy-reverse 1)
(declare-primitive-function list-reverse 1)
(declare-primitive-function list-to-set 1)

(claim is-list (all (A) (-> A bool-t)))
(claim make-list (all (E) (-> (list-t E))))
(claim car (all (E) (-> (list-t E) E)))
(claim cdr (all (E) (-> (list-t E) (list-t E))))
(claim cons (all (E) (-> E (list-t E) (list-t E))))
(claim list-head (all (E) (-> (list-t E) E)))
(claim list-rest (all (E) (-> (list-t E) (list-t E))))
(claim list-but-last (all (E) (-> (list-t E) (list-t E))))
(claim list-last (all (E) (-> (list-t E) E)))
(claim list-length (all (E) (-> (list-t E) int-t)))
(claim list-is-empty (all (E) (-> (list-t E) bool-t)))
(claim list-copy (all (E) (-> (list-t E) (list-t E))))
(claim list-get (all (E) (-> int-t (list-t E) E)))
(claim list-copy-put (all (E) (-> int-t E (list-t E) (list-t E))))
(claim list-put (all (E) (-> int-t E (list-t E) void-t)))
(claim list-push (all (E) (-> E (list-t E) void-t)))
(claim list-pop (all (E) (-> (list-t E) E)))
(claim list-pop-front (all (E) (-> (list-t E) E)))
(claim list-push-front (all (E) (-> E (list-t E) void-t)))
(claim list-copy-reverse (all (E) (-> (list-t E) (list-t E))))
(claim list-reverse (all (E) (-> (list-t E) void-t)))
(claim list-to-set (all (E) (-> (list-t E) (set-t E))))
