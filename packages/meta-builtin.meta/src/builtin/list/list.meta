(module builtin)

(declare-primitive-variable null)
(declare-primitive-function is-list 1)
(declare-primitive-function car 1)
(declare-primitive-function cdr 1)
(declare-primitive-function cons 2)

(claim null (all (E) (list-t E)))
(claim is-list (all (A) (-> A bool-t)))
(claim car (all (E) (-> (list-t E) E)))
(claim cdr (all (E) (-> (list-t E) (list-t E))))
(claim cons (all (E) (-> E (list-t E) (list-t E))))

(claim list-head (all (E) (-> (list-t E) E)))
(define (list-head list) (car list))

(claim list-rest (all (E) (-> (list-t E) (list-t E))))
(define (list-rest list) (cdr list))

(claim list-is-empty (all (E) (-> (list-t E) bool-t)))
(define (list-is-empty list) (equal list null))

(claim list-length
  (all (E)
    (-> (list-t E) int-t)))
(define (list-length list)
  (list-length-aux list 0))

(claim list-length-aux
  (all (E)
    (-> (list-t E) int-t
        int-t)))
(define (list-length-aux list n)
  (if (list-is-empty list)
    n
    (list-length-aux (cdr list) (iadd 1 n))))

(claim list-get
  (all (E)
    (-> (list-t E) int-t E)))
(define (list-get list index)
  (if (equal index 0)
    (car list)
    (list-get (cdr list) (isub index 1))))

(claim list-last
  (all (E)
    (-> (list-t E) E)))
(define (list-last list)
  (if (list-is-empty (cdr list))
    (car list)
    (list-last (cdr list))))

(claim list-copy-reverse
  (all (E)
    (-> (list-t E) (list-t E))))
(define (list-copy-reverse list)
  (list-copy-reverse-aux list null))

(claim list-copy-reverse-aux
  (all (E)
    (-> (list-t E) (list-t E)
        (list-t E))))
(define (list-copy-reverse-aux list acc)
  (if (list-is-empty list)
    acc
    (list-copy-reverse-aux (cdr list) (cons (car list) acc))))

(claim list-but-last
  (all (E)
    (-> (list-t E) (list-t E))))
(define (list-but-last list)
  (list-copy-reverse (cdr (list-copy-reverse list))))

(claim list-copy-put
  (all (E)
    (-> (list-t E) int-t E (list-t E))))
(define (list-copy-put list index value)
  (list-copy-put-aux index value list null))

(claim list-copy-put-aux
  (all (E)
    (-> int-t E (list-t E) (list-t E)
        (list-t E))))
(define (list-copy-put-aux index value list rev)
  (cond
    ((list-is-empty list)
     (error "(list-copy-put) index out of range"))
    ((equal index 0)
     (list-append (list-copy-reverse rev) (cons value (cdr list))))
    (else
     (list-copy-put-aux (isub index 1) value (cdr list) (cons (car list) rev)))))

(claim list-to-set
  (all (E)
    (-> (list-t E) (set-t E))))
(define (list-to-set list)
  (let ((set (make-set)))
    (list-each list (lambda (x) (set-add set x)))
    set))