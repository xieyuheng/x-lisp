(module builtin)

(claim use-input-file
  (polymorphic (A)
    (-> text-t (-> file-t A)
        A)))

(define (use-input-file path f)
  (let ((file (open-input-file path))
         (result (f file)))
    (file-close file)
    result))

(claim use-output-file
  (polymorphic (A)
    (-> text-t (-> file-t A)
        A)))

(define (use-output-file path f)
  (let ((file (open-output-file path))
         (result (f file)))
    (file-close file)
    result))
