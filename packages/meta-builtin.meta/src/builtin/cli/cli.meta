(module builtin)

(define-struct cli-ctx-t
  (args (list-t text-t))
  (options (hash-t text-t text-t))
  (passthrough (list-t text-t)))

(define-struct cli-route-t
  (command text-t)
  (name text-t)
  (arg-names (list-t text-t))
  (option-names (list-t text-t)))

(define-struct cli-router-t
  (name text-t)
  (version text-t)
  (routes (list-t cli-route-t))
  (handlers (hash-t text-t (-> cli-ctx-t void-t))))

(claim cli-make-router (-> text-t text-t cli-router-t))

(define (cli-make-router name version)
  (make-cli-router name version (make-list) (make-hash)))

(claim cli-parse-route (-> text-t cli-route-t))

(define (cli-parse-route command)
  (let ((tokens (list-reject text-is-blank (text-split " " command)))
         (dash-idx (list-find-index (lambda (t) (equal t "--")) tokens))
         (main (if (int-greater-or-equal dash-idx 0)
                 (list-take dash-idx tokens)
                 tokens))
         (name (car main))
         (rest (cdr main))
         (first-opt-idx (list-find-index (lambda (t) (text-starts-with "--" t)) rest))
         (arg-count (if (int-greater-or-equal first-opt-idx 0) first-opt-idx (list-length rest)))
         (args (list-take arg-count rest))
         (options (list-drop arg-count rest)))
    (make-cli-route command name args options)))

(claim cli-route-match (-> cli-route-t (list-t text-t) cli-ctx-t))

(define (cli-route-match route argv)
  (define (loop tokens args options passthrough in-passthrough)
    (cond ((list-is-empty tokens)
           (make-cli-ctx args options passthrough))
          ((equal in-passthrough true)
           (list-push (car tokens) passthrough)
           (loop (cdr tokens) args options passthrough true))
          ((equal (car tokens) "--")
           (loop (cdr tokens) args options passthrough true))
          ((text-starts-with "-" (car tokens))
           (let ((token (car tokens))
                 (rest (cdr tokens)))
             (cond ((list-is-empty rest)
                    (hash-put token "" options)
                    (loop rest args options passthrough false))
                   ((text-starts-with "-" (car rest))
                    (hash-put token "" options)
                    (loop rest args options passthrough false))
                   (else
                    (hash-put token (car rest) options)
                    (loop (cdr rest) args options passthrough false)))))
          (else
           (list-push (car tokens) args)
           (loop (cdr tokens) args options passthrough false))))
  (loop argv (make-list) (make-hash) (make-list) false))

(claim cli-define-route (-> cli-router-t text-t cli-router-t))

(define (cli-define-route router command)
  (let ((routes (cli-router-routes router)))
    (list-push (cli-parse-route command) routes)
    (cli-router-put-routes routes router)))

(claim cli-define-handler (-> cli-router-t text-t (-> cli-ctx-t void-t) cli-router-t))

(define (cli-define-handler router name handler)
  (let ((handlers (cli-router-handlers router)))
    (hash-put name handler handlers)
    (cli-router-put-handlers handlers router)))

(claim cli-print-name-and-version (-> cli-router-t void-t))

(define (cli-print-name-and-version router)
  (println (text-join " " [(cli-router-name router) (cli-router-version router)])))

(claim cli-print-commands (-> cli-router-t void-t))

(define (cli-print-commands router)
  (println "commands:")
  (list-each (lambda (route)
               (println (text-append "  " (cli-route-command route))))
             (cli-router-routes router)))

(claim cli-router-run (-> cli-router-t (list-t text-t) void-t))

(define (cli-router-run router argv)
  (if (list-is-empty argv)
    (begin
      (cli-print-name-and-version router)
      (cli-print-commands router))
    (let ((name (car argv))
          (tokens (cdr argv)))
      (match (list-find (lambda (r) (equal (cli-route-name r) name))
                        (cli-router-routes router))
        ((just route)
         (match (hash-get-maybe name (cli-router-handlers router))
           ((just handler) (handler (cli-route-match route tokens)))
           ((nothing)
            (println (text-join " " ["[cli] undefined handler:" name]))
            (exit 1))))
        ((nothing)
         (println (text-join " " ["unknown command:" name]))
         (cli-print-name-and-version router)
         (cli-print-commands router))))))

(claim cli-arg-count (-> cli-ctx-t int-t))

(define (cli-arg-count ctx)
  (list-length (cli-ctx-args ctx)))

(claim cli-arg-get (-> int-t cli-ctx-t text-t))

(define (cli-arg-get i ctx)
  (list-get i (cli-ctx-args ctx)))

(claim cli-option-has (-> text-t cli-ctx-t bool-t))

(define (cli-option-has name ctx)
  (hash-has name (cli-ctx-options ctx)))

(claim cli-option-get (-> text-t cli-ctx-t text-t))

(define (cli-option-get name ctx)
  (hash-get name (cli-ctx-options ctx)))

(claim cli-passthrough-count (-> cli-ctx-t int-t))

(define (cli-passthrough-count ctx)
  (list-length (cli-ctx-passthrough ctx)))

(claim cli-passthrough-get (-> int-t cli-ctx-t text-t))

(define (cli-passthrough-get i ctx)
  (list-get i (cli-ctx-passthrough ctx)))
