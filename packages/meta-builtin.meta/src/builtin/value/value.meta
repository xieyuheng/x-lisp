(module builtin)

(declare-primitive-function is-atom 1)
(declare-primitive-function same 2)
(declare-primitive-function equal 2)
(declare-primitive-function format 1)
(declare-primitive-function hash-code 1)
(declare-primitive-function total-compare 2)

(claim is-atom (all (A) (-> A bool-t)))
(claim same (all (A B) (-> A B bool-t)))
(claim equal (all (A B) (-> A B bool-t)))
(claim format (all (A) (-> A text-t)))
(claim hash-code (all (A) (-> A int-t)))
(claim total-compare (all (A B) (-> A B int-t)))
