(module builtin)

(declare-primitive-function make-set 0)
(declare-primitive-function set-copy 1)
(declare-primitive-function set-size 1)
(declare-primitive-function set-is-empty 1)
(declare-primitive-function set-member 2)
(declare-primitive-function set-subset 2)
(declare-primitive-function set-to-list 1)
(declare-primitive-function set-copy-add 2)
(declare-primitive-function set-add 2)
(declare-primitive-function set-copy-delete 2)
(declare-primitive-function set-delete 2)
(declare-primitive-function set-clear 1)
(declare-primitive-function set-union 2)
(declare-primitive-function set-inter 2)
(declare-primitive-function set-difference 2)
(declare-primitive-function set-disjoint 2)

(claim make-set (all (E) (-> (set-t E))))
(claim set-copy (all (E) (-> (set-t E) (set-t E))))
(claim set-size (all (E) (-> (set-t E) int-t)))
(claim set-is-empty (all (E) (-> (set-t E) bool-t)))
(claim set-member (all (E) (-> E (set-t E) bool-t)))
(claim set-subset (all (E) (-> (set-t E) (set-t E) bool-t)))
(claim set-to-list (all (E) (-> (set-t E) (list-t E))))
(claim set-copy-add (all (E) (-> E (set-t E) (set-t E))))
(claim set-add (all (E) (-> E (set-t E) void-t)))
(claim set-copy-delete (all (E) (-> E (set-t E) (set-t E))))
(claim set-delete (all (E) (-> E (set-t E) void-t)))
(claim set-clear (all (E) (-> (set-t E) void-t)))
(claim set-union (all (E) (-> (set-t E) (set-t E) (set-t E))))
(claim set-inter (all (E) (-> (set-t E) (set-t E) (set-t E))))
(claim set-difference (all (E) (-> (set-t E) (set-t E) (set-t E))))
(claim set-disjoint (all (E) (-> (set-t E) (set-t E) bool-t)))
