(module builtin)

(claim set-every
  (all (A)
    (-> (set-t A) (-> A bool-t)
        bool-t)))

(define (set-every set p)
  (list-every (set-to-list set) p))

(define-test set-every-test
  (assert (set-every (@set 0 1 2 3) int-is-non-negative))
  (assert-not (set-every (@set 0 1 -1 2 3) int-is-non-negative)))

(claim set-some
  (all (A)
    (-> (set-t A) (-> A bool-t)
        bool-t)))

(define (set-some set p)
  (list-some (set-to-list set) p))

(define-test set-some-test
  (assert (set-some (@set -1 -2 0) int-is-non-negative))
  (assert-not (set-some (@set -1 -2 -3) int-is-non-negative)))
