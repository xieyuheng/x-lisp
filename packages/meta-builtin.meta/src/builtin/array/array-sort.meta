(module builtin)

(claim array-sort
  (all (E)
    (-> (array-t E) (-> E E int-t)
        void-t)))

(define (array-sort array compare)
  (let ((n (array-length array)))
    (array-quicksort compare array 0 (isub n 1))))

(claim array-quicksort
  (all (E)
    (-> (-> E E int-t) (array-t E) int-t int-t
        void-t)))

(define (array-quicksort compare array lo hi)
  (when (int-less lo hi)
    (let ((bounds (array-quicksort-partition compare array lo hi)))
      (array-quicksort compare array lo (pair-first bounds))
      (array-quicksort compare array (pair-second bounds) hi))))

(claim array-quicksort-partition
  (all (E)
    (-> (-> E E int-t) (array-t E) int-t int-t
        (pair-t int-t int-t))))

(define (array-quicksort-partition compare array lo hi)
  (let ((pivot (array-get array (idiv (iadd lo hi) 2))))
    (array-quicksort-partition-aux compare array pivot lo lo hi)))

(claim array-quicksort-partition-aux
  (all (E)
    (-> (-> E E int-t) (array-t E) E int-t int-t int-t
        (pair-t int-t int-t))))

(define (array-quicksort-partition-aux compare array pivot index less greater)
  (if (int-greater index greater)
    (make-pair (isub less 1) (iadd greater 1))
    (let ((cmp (compare (array-get array index) pivot)))
      (cond
        ((int-less cmp 0)
         (array-swap index less array)
         (array-quicksort-partition-aux compare array pivot (iadd index 1) (iadd less 1) greater))
        ((int-greater cmp 0)
         (array-swap index greater array)
         (array-quicksort-partition-aux compare array pivot index less (isub greater 1)))
        (else
         (array-quicksort-partition-aux compare array pivot (iadd index 1) less greater))))))

(define (array-swap i j array)
  (let ((x (array-get array i))
        (y (array-get array j)))
    (array-put array i y)
    (array-put array j x)))

(define-test array-sort-test
  ;; int ascending

  (let ((a (make-array)))
    (array-push a 2)
    (array-push a 3)
    (array-push a 1)
    (array-sort a int-compare-ascending)
    (assert-equal (@list 1 2 3) (array-to-list a)))

  ;; int descending

  (let ((a (list-to-array (@list 2 3 1))))
    (array-sort a int-compare-descending)
    (assert-equal (@list 3 2 1) (array-to-list a)))

  ;; float ascending

  (let ((a (list-to-array (@list 2.0 3.0 1.0))))
    (array-sort a float-compare-ascending)
    (assert-equal (@list 1.0 2.0 3.0) (array-to-list a)))

  ;; text lexical

  (let ((a (list-to-array (@list "b" "c" "a"))))
    (array-sort a text-compare-lexical)
    (assert-equal (@list "a" "b" "c") (array-to-list a))))