(module builtin)

(declare-primitive-function is-array 1)
(declare-primitive-function make-array 0)
(declare-primitive-function array-get 2)
(declare-primitive-function array-put 3)
(declare-primitive-function array-length 1)
(declare-primitive-function array-is-empty 1)
(declare-primitive-function array-push 2)
(declare-primitive-function array-pop 1)
(declare-primitive-function array-push-front 2)
(declare-primitive-function array-pop-front 1)
(declare-primitive-function array-copy 1)
(declare-primitive-function array-reverse 1)
(declare-primitive-function array-to-list 1)
(declare-primitive-function list-to-array 1)

(claim is-array (all (A) (-> A bool-t)))
(claim make-array (all (E) (-> (array-t E))))
(claim array-get (all (E) (-> (array-t E) int-t E)))
(claim array-put (all (E) (-> (array-t E) int-t E void-t)))
(claim array-length (all (E) (-> (array-t E) int-t)))
(claim array-is-empty (all (E) (-> (array-t E) bool-t)))
(claim array-push (all (E) (-> (array-t E) E void-t)))
(claim array-pop (all (E) (-> (array-t E) E)))
(claim array-push-front (all (E) (-> (array-t E) E void-t)))
(claim array-pop-front (all (E) (-> (array-t E) E)))
(claim array-copy (all (E) (-> (array-t E) (array-t E))))
(claim array-reverse (all (E) (-> (array-t E) void-t)))
(claim array-to-list (all (E) (-> (array-t E) (list-t E))))
(claim list-to-array (all (E) (-> (list-t E) (array-t E))))