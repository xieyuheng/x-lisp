(module builtin)

(declare-primitive-function format-as-sexp 1)

(claim format-as-sexp (polymorphic (A) (-> A string-t)))

(claim format-int (-> int-t string-t))
(define (format-int x) (format-as-sexp x))

(claim format-float (-> float-t string-t))
(define (format-float x) (format-as-sexp x))

(claim format-keyword (-> keyword-t string-t))
(define (format-keyword x) (format-as-sexp x))

(claim format-symbol (-> symbol-t string-t))
(define (format-symbol x) (string-append "'" (format-as-sexp x)))

(claim format-bool (-> bool-t string-t))
(define (format-bool x) (format-as-sexp x))

(claim format-string (-> string-t string-t))
(define (format-string x) (format-as-sexp x))
