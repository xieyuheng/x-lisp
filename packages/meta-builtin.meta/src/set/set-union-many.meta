(module builtin)

(claim set-union-many
  (-> (list-t (set-t symbol-t))
      (set-t symbol-t)))

(define (set-union-many sets)
  (list-fold-left set-union (make-set) sets))

(define-test set-union-many-test
  (assert-equal
    (@set 1 2 3 4 5 6)
    (set-union-many
     (@list (@set 1 2)
            (@set 3 4)
            (@set 5 6)))))
