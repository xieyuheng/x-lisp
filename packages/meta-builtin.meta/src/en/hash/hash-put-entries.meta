(module builtin)

(claim hash-put-entries-copy
  (polymorphic (K V)
    (-> (list-t (hash-entry-t K V)) (hash-t K V)
        (hash-t K V))))

(define (hash-put-entries-copy entries hash)
  (hash-put-entries entries (hash-copy hash)))

(claim hash-put-entries
  (polymorphic (K V)
    (-> (list-t (hash-entry-t K V)) (hash-t K V)
        (hash-t K V))))

(define (hash-put-entries entries hash)
  (if (list-is-empty entries)
    hash
    (let ((entry (car entries)))
      (hash-put (hash-entry-key entry) (hash-entry-value entry) hash)
      (hash-put-entries (cdr entries) hash))))

(define-test hash-put-entries-test
  (assert-equal
    (@hash 'a 1 'b 2)
      (hash-put-entries-copy [(make-hash-entry 'a 1)
                       (make-hash-entry 'b 2)]
                      (@hash)))

  (let ((hash (@hash)))
    (assert-equal
      (@hash 'a 1 'b 2)
      (hash-put-entries [(make-hash-entry 'a 1)
                         (make-hash-entry 'b 2)]
        hash))
    (assert-equal
      (@hash 'a 1 'b 2) hash)))
