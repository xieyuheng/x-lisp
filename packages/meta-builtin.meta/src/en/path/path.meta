(module builtin)

(declare-primitive-function path-base-name 1)
(declare-primitive-function path-directory-name 1)
(declare-primitive-function path-extension 1)
(declare-primitive-function path-stem 1)
(declare-primitive-function path-is-absolute 1)
(declare-primitive-function path-is-relative 1)
(declare-primitive-function path-join 2)
(declare-primitive-function path-normalize 1)
(declare-primitive-function path-relative 2)
(declare-primitive-function path-relative-to-cwd 1)
(declare-primitive-function path-resolve 1)
(declare-primitive-function path-exists 1)
(declare-primitive-function path-is-file 1)
(declare-primitive-function path-is-directory 1)
(declare-primitive-function path-read 1)
(declare-primitive-function path-write 2)
(declare-primitive-function path-list 1)
(declare-primitive-function path-list-recursive 1)
(declare-primitive-function path-ensure-file 1)
(declare-primitive-function path-ensure-directory 1)
(declare-primitive-function path-delete-file 1)
(declare-primitive-function path-delete-directory 1)
(declare-primitive-function path-delete 1)
(declare-primitive-function path-rename 2)

(claim path-base-name (-> string-t string-t))
(claim path-directory-name (-> string-t string-t))
(claim path-extension (-> string-t string-t))
(claim path-stem (-> string-t string-t))
(claim path-is-absolute (-> string-t bool-t))
(claim path-is-relative (-> string-t bool-t))
(claim path-join (-> string-t string-t string-t))
(claim path-normalize (-> string-t string-t))
(claim path-relative (-> string-t string-t string-t))
(claim path-relative-to-cwd (-> string-t string-t))
(claim path-resolve (-> string-t string-t))
(claim path-exists (-> string-t bool-t))
(claim path-is-file (-> string-t bool-t))
(claim path-is-directory (-> string-t bool-t))
(claim path-read (-> string-t string-t))
(claim path-write (-> string-t string-t void-t))
(claim path-list (-> string-t (list-t string-t)))
(claim path-list-recursive (-> string-t (list-t string-t)))
(claim path-ensure-file (-> string-t void-t))
(claim path-ensure-directory (-> string-t void-t))
(claim path-delete-file (-> string-t void-t))
(claim path-delete-directory (-> string-t void-t))
(claim path-delete (-> string-t void-t))
(claim path-rename (-> string-t string-t void-t))
