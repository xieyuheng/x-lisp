(module builtin)

(claim list-flat-map-index
  (polymorphic (A B)
    (-> (-> int-t A (list-t B))
        (list-t A)
        (list-t B))))

(define (list-flat-map-index f list)
  (list-concat (list-map-index f list)))

(define-test list-flat-map-index-test
  (assert-equal [0 10 1 20 2 30]
    (list-flat-map-index (lambda (i x) [i x]) [10 20 30]))
  (assert-equal [(make-pair 0 'a) (make-pair 0 'a) (make-pair 1 'b) (make-pair 1 'b) (make-pair 2 'c) (make-pair 2 'c)]
    (list-flat-map-index (lambda (i x) [(make-pair i x) (make-pair i x)]) ['a 'b 'c]))
  (assert-equal []
    (list-flat-map-index (lambda (i x) []) [1 2 3]))
  (assert-equal []
    (list-flat-map-index (lambda (i x) [i x]) [])))
