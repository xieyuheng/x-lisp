(module builtin)

(claim list-sort-copy
  (polymorphic (E) (-> (-> E E int-t) (list-t E) (list-t E))))

(define (list-sort-copy comp lst)
  (list-sort comp (list-copy lst)))

(claim list-sort
  (polymorphic (E) (-> (-> E E int-t) (list-t E) (list-t E))))

(define (list-sort comp lst)
  (let ((n (list-length lst)))
    (quicksort-range comp lst 0 (isub n 1)))
  lst)

(claim quicksort-range
  (polymorphic (E) (-> (-> E E int-t) (list-t E) int-t int-t void-t)))

(define (quicksort-range comp lst lo hi)
  (if (int-less lo hi)
    (let ((bounds (partition-3way comp lst lo hi)))
      (quicksort-range comp lst lo (list-get 0 bounds))
      (quicksort-range comp lst (list-get 1 bounds) hi))
    void))

(claim partition-3way
  (polymorphic (E) (-> (-> E E int-t) (list-t E) int-t int-t (list-t int-t))))

(define (partition-3way comp lst lo hi)
  (let ((pivot (list-get (idiv (iadd lo hi) 2) lst)))
    (partition-3way-aux comp lst pivot lo hi lo)))

(claim partition-3way-aux
  (polymorphic (E) (-> (-> E E int-t) (list-t E) E int-t int-t int-t (list-t int-t))))

(define (partition-3way-aux comp lst pivot less greater i)
  (if (int-greater i greater)
    [(isub less 1) (iadd greater 1)]
    (let ((cmp (comp (list-get i lst) pivot)))
      (cond
        ((int-less cmp 0)
          (let ((tmp (list-get i lst))
                (v   (list-get less lst)))
            (list-put i    v   lst)
            (list-put less tmp lst)
            (partition-3way-aux comp lst pivot (iadd less 1) greater (iadd i 1))))
        ((int-greater cmp 0)
          (let ((tmp (list-get i lst))
                (v   (list-get greater lst)))
            (list-put i       v   lst)
            (list-put greater tmp lst)
            (partition-3way-aux comp lst pivot less (isub greater 1) i)))
        (else
          (partition-3way-aux comp lst pivot less greater (iadd i 1)))))))
