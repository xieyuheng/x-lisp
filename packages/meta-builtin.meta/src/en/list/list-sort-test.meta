(module builtin)

(define-test list-sort-test
  ;; int ascending, list-sort mutates in-place

  (let ((list [2 3 1]))
    (assert-equal [1 2 3] (list-sort int-compare-ascending list))
    (assert-equal [1 2 3] list))

  ;; int ascending, list-sort-copy returns new list

  (let ((list [2 3 1]))
    (assert-equal [1 2 3] (list-sort-copy int-compare-ascending list))
    (assert-equal [2 3 1] list))

  ;; int descending

  (assert-equal [3 2 1] (list-sort-copy int-compare-descending [2 3 1]))

  ;; float ascending

  (assert-equal [1.0 2.0 3.0] (list-sort-copy float-compare-ascending [2.0 3.0 1.0]))

  ;; float descending

  (assert-equal [3.0 2.0 1.0] (list-sort-copy float-compare-descending [2.0 3.0 1.0]))

  ;; string lexical

  (assert-equal
    ["a" "b" "c"]
    (list-sort-copy string-compare-lexical ["b" "c" "a"])))
