(module builtin)

(declare-primitive-variable type-t)
(declare-primitive-variable bool-t)
(declare-primitive-variable void-t)
(declare-primitive-variable int-t)
(declare-primitive-variable float-t)
(declare-primitive-variable string-t)
(declare-primitive-variable symbol-t)
(declare-primitive-variable keyword-t)
(declare-primitive-variable file-t)
(declare-primitive-function list-t 1)
(declare-primitive-function set-t 1)
(declare-primitive-function hash-t 2)

(claim-type type-t)
(claim bool-t type-t)
(claim void-t type-t)
(claim int-t type-t)
(claim float-t type-t)
(claim string-t type-t)
(claim symbol-t type-t)
(claim keyword-t type-t)
(claim file-t type-t)
(claim list-t (-> type-t type-t))
(claim set-t (-> type-t type-t))
(claim hash-t (-> type-t type-t type-t))
