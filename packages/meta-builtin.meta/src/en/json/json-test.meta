(module builtin)

(define-test parse-null-json-test
  (assert-equal (null-json) (parse-json "null")))

(define-test parse-bool-json-test
  (assert-equal (bool-json true) (parse-json "true"))
  (assert-equal (bool-json false) (parse-json "false")))

(define-test parse-number-json-test
  (assert-equal (number-json 0.0) (parse-json "0"))
  (assert-equal (number-json 42.0) (parse-json "42"))
  (assert-equal (number-json -17.0) (parse-json "-17"))
  (assert-equal (number-json 3.14) (parse-json "3.14")))

(define-test parse-string-json-test
  (assert-equal (string-json "hello") (parse-json "\"hello\"")))

(define-test parse-array-json-test
  (assert-equal (array-json [(number-json 1.0) (number-json 2.0) (number-json 3.0)])
                (parse-json "[1, 2, 3]")))

(define-test parse-object-json-test
  (assert-equal (object-json (@hash "x" (number-json 1.0)))
                (parse-json "{\"x\": 1}")))

(define-test format-json-test
  (assert-equal "null" (format-json (null-json)))
  (assert-equal "true" (format-json (bool-json true)))
  (assert-equal "false" (format-json (bool-json false)))
  (assert-equal "0.0" (format-json (number-json 0.0)))
  (assert-equal "42.0" (format-json (number-json 42.0)))
  (println (format-json (number-json 3.14))))

(define-test format-json-string-escape-test
  (println (format-json (string-json "hello")))
  (println (format-json (string-json "a\"b")))
  (println (format-json (string-json "a\\b")))
  (println (format-json (string-json "a\nb")))
  (println (format-json (string-json "a\tb"))))
