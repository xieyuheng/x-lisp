(模块 内置)

(定义测试 解析空结森测试
  (断言相等 (空结森) (解析结森 "null")))

(定义测试 解析真假结森测试
  (断言相等 (真假结森 真) (解析结森 "true"))
  (断言相等 (真假结森 假) (解析结森 "false")))

(定义测试 解析数字结森测试
  (断言相等 (数字结森 0.0) (解析结森 "0"))
  (断言相等 (数字结森 42.0) (解析结森 "42"))
  (断言相等 (数字结森 -17.0) (解析结森 "-17"))
  (断言相等 (数字结森 3.14) (解析结森 "3.14")))

(定义测试 解析文本结森测试
  (断言相等 (文本结森 "hello") (解析结森 "\"hello\"")))

(定义测试 解析数组结森测试
  (断言相等 (数组结森 [(数字结森 1.0) (数字结森 2.0) (数字结森 3.0)])
                (解析结森 "[1, 2, 3]")))

(定义测试 解析对象结森测试
  (断言相等 (对象结森 (@散列 "x" (数字结森 1.0)))
                (解析结森 "{\"x\": 1}")))

(定义测试 呈现结森测试
  (断言相等 "null" (呈现结森 (空结森)))
  (断言相等 "true" (呈现结森 (真假结森 真)))
  (断言相等 "false" (呈现结森 (真假结森 假)))
  (断言相等 "0.0" (呈现结森 (数字结森 0.0)))
  (断言相等 "42.0" (呈现结森 (数字结森 42.0)))
  (打印行 (呈现结森 (数字结森 3.14))))

(定义测试 呈现结森文本转义测试
  (打印行 (呈现结森 (文本结森 "hello")))
  (打印行 (呈现结森 (文本结森 "a\"b")))
  (打印行 (呈现结森 (文本结森 "a\\b")))
  (打印行 (呈现结森 (文本结森 "a\nb")))
  (打印行 (呈现结森 (文本结森 "a\tb"))))
