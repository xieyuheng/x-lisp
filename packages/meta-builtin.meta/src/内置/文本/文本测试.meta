(模块 内置)

(定义测试 文本测试
  (打印行 "abc")

  (断言相等 2 (文本长度 "中文"))

  (断言 (文本为空 ""))
  (断言非 (文本为空 " "))

  (断言 (文本为空白 ""))
  (断言 (文本为空白 " "))
  (断言 (文本为空白 "  "))
  (断言 (文本为空白 " \n "))
  (断言 (文本为空白 " \n\t "))
  (断言非 (文本为空白 " \n.\t "))

  (断言相等 "abcdef" (文本追加 "abc" "def"))

  (断言相等 ["a" "b" "c"] (文本字符 "abc"))

  (断言相等 ["123" "456" "789"] (文本行 "123\n456\n789\n"))
  (断言相等 ["123" "456" "789"] (文本行 "123\n456\n789"))
  (断言相等 ["123" "" "789"] (文本行 "123\n\n789\n"))
  (断言相等 ["123" "" "789"] (文本行 "123\n\n789"))

  (断言相等 "中" (文本截段 0 1 "中文"))
  (断言相等 "文" (文本截段 1 2 "中文")))

(定义测试 文本连接测试
  (断言相等 "a.b.c" (文本连接 "." ["a" "b" "c"]))
  (断言相等 "a..b..c" (文本连接 ".." ["a" "b" "c"])))

(定义测试 文本分割测试
  (断言相等 ["a" "b" "c"] (文本分割 "." "a.b.c"))
  (断言相等 ["a" "b" "c"] (文本分割 ".." "a..b..c")))

(定义测试 文本替换测试
  (断言相等 "a/b/c" (文本替换 "." "/" "a.b.c")))

(定义测试 文本起首测试
  (断言 (文本起首 "" "abc"))
  (断言 (文本起首 "a" "abc"))
  (断言 (文本起首 "ab" "abc"))
  (断言 (文本起首 "abc" "abc"))
  (断言非 (文本起首 "abc~" "abc"))
  (断言非 (文本起首 "b" "abc"))

  (断言 (文本结尾 "" "abc"))
  (断言 (文本结尾 "c" "abc"))
  (断言 (文本结尾 "bc" "abc"))
  (断言 (文本结尾 "abc" "abc"))
  (断言非 (文本结尾 "~abc" "abc"))
  (断言非 (文本结尾 "b" "abc")))

(定义测试 文本转大写测试
  (断言相等 "ABC" (文本转大写 "abc"))
  (断言相等 "abc" (文本转小写 "ABC")))

(定义测试 文本取码点测试
  (断言相等 97 (文本取码点 0 "abc"))
  (断言相等 98 (文本取码点 1 "abc"))
  (断言相等 99 (文本取码点 2 "abc")))

(定义测试 文本含于测试
  (断言 (文本含于 "bb" "aabbcc"))
  (断言 (文本含于 "ab" "aabbcc"))
  (断言非 (文本含于 "ba" "aabbcc")))

(定义测试 文本查找索引测试
  (断言相等 0 (文本查找索引 "0" "01234"))
  (断言相等 1 (文本查找索引 "1" "01234"))
  (断言相等 2 (文本查找索引 "2" "01234"))
  (断言相等 -1 (文本查找索引 "5" "01234"))

  (断言相等 0 (文本查找索引 "01" "01234"))
  (断言相等 1 (文本查找索引 "12" "01234"))
  (断言相等 2 (文本查找索引 "23" "01234"))
  (断言相等 -1 (文本查找索引 "21" "01234")))

(定义测试 文本修剪测试
  (断言相等 "abc  " (文本修剪左端 "  abc  "))
  (断言相等 "  abc" (文本修剪右端 "  abc  "))
  (断言相等 "abc  " (文本修剪首端 "  abc  "))
  (断言相等 "  abc" (文本修剪尾端 "  abc  "))
  (断言相等 "abc" (文本修剪 "  abc  ")))

(定义测试 文本为整数测试
  (断言 (文本为整数 "123"))
  (断言 (文本为整数 "-123"))
  (断言 (文本为整数 "0"))
  (断言非 (文本为整数 "abc"))
  (断言非 (文本为整数 "123.0"))
  (断言非 (文本为整数 "")))

(定义测试 文本为浮点测试
  (断言 (文本为浮点 "123.0"))
  (断言 (文本为浮点 "-123.5"))
  (断言 (文本为浮点 "0.0"))
  (断言 (文本为浮点 ".5"))
  (断言非 (文本为浮点 "abc"))
  (断言非 (文本为浮点 "123"))
  (断言非 (文本为浮点 "")))

(定义测试 文本转整数测试
  (断言相等 123 (文本转整数 "123"))
  (断言相等 -123 (文本转整数 "-123"))
  (断言相等 0 (文本转整数 "0")))

(定义测试 文本转浮点测试
  (断言相等 123.0 (文本转浮点 "123.0"))
  (断言相等 -123.5 (文本转浮点 "-123.5"))
  (断言相等 0.0 (文本转浮点 "0.0"))
  (断言相等 0.5 (文本转浮点 ".5")))
