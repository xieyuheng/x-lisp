(模块 内置)

(声明 呈现符号算式 (-> 符号算式型 文本型))

(定义 (呈现符号算式 符号算式)
  (匹配 符号算式
    ((符号符号算式 内容 位置) (符号转文本 内容))
    ((文本符号算式 内容 位置) (呈现为符号算式 内容))
    ((整数符号算式 内容 位置) (呈现为符号算式 内容))
    ((浮点符号算式 内容 位置) (呈现为符号算式 内容))
    ((列表符号算式 元素 位置)
     (若 (列表为空 元素)
       "()"
       (@文本 "(" (文本连接 " " (列表映射 呈现符号算式 元素)) ")")))))
