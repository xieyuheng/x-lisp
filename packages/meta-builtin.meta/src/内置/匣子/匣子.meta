(模块 内置)

(定义黑盒类型 (匣子型 甲) (数组型 甲)
  (作匣子 (-> (匣子型 甲)))
  (匣子为空 (-> (匣子型 甲) 真假型))
  (匣子存 (-> (匣子型 甲) 甲 空值型))
  (匣子取或有 (-> (匣子型 甲) (或有型 甲))))

(定义 (作匣子)
  (作数组))

(定义 (匣子为空 匣子)
  (数组为空 匣子))

(定义 (匣子存 匣子 值)
  (若 (匣子为空 匣子)
    (数组末入 匣子 值)
    (数组存 匣子 0 值)))

(定义 (匣子取或有 匣子)
  (若 (匣子为空 匣子)
    (无)
    (有 (数组取 匣子 0))))

(声明 匣子取
  (泛型 (甲)
    (-> (匣子型 甲) 甲)))

(定义 (匣子取 匣子)
  (匹配 (匣子取或有 匣子)
    ((有 值) 值)
    ((无) (报错 "匣子为空"))))

(声明 匣子定位取
  (泛型 (甲)
    (-> (匣子型 甲) 源码位置型 甲)))

(定义 (匣子定位取 匣子 位置)
  (匹配 (匣子取或有 匣子)
    ((有 值) 值)
    ((无)
     (文件写
      (当前标准错误文件)
      (呈现定位消息 "匣子为空" 位置))
     (报错 "匣子为空"))))