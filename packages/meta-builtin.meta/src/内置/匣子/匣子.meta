(模块 内置)

(定义黑盒类型 (匣子型 甲) (列表型 甲)
  (作匣子 (-> (匣子型 甲)))
  (匣子为空 (-> (匣子型 甲) 真假型))
  (匣子存 (-> 甲 (匣子型 甲) 空型))
  (匣子取或有 (-> (匣子型 甲) (或有型 甲))))

(定义 (作匣子)
  (作列表))

(定义 (匣子为空 匣子)
  (列表为空 匣子))

(定义 (匣子存 值 匣子)
  (若 (匣子为空 匣子)
    (列表末入 值 匣子)
    (列表存 0 值 匣子)))

(定义 (匣子取或有 匣子)
  (若 (匣子为空 匣子)
    (无)
    (有 (首 匣子))))

(声明 匣子取
  (多态 (甲)
    (-> (匣子型 甲) 甲)))

(定义 (匣子取 匣子)
  (匹配 (匣子取或有 匣子)
    ((有 值) 值)
    ((无) (报错 "匣子为空"))))

(声明 匣子定位取
  (多态 (甲)
    (-> (匣子型 甲) 源码位置型 甲)))

(定义 (匣子定位取 匣子 位置)
  (匹配 (匣子取或有 匣子)
    ((有 值) 值)
    ((无)
     (文件写
      (当前标准错误文件)
      (呈现定位消息 "匣子为空" 位置))
     (报错 "匣子为空"))))

(定义测试 匣子测试
  (@注释
    青霜剑入匣 寒光敛九重
    江湖从此去 唯见月如弓)
  (令 ((匣子 (作匣子)))
    (断言 (匣子为空 匣子))
    (断言相等 (无) (匣子取或有 匣子))
    (匣子存 '青霜 匣子)
    (断言非 (匣子为空 匣子))
    (断言相等 '青霜 (匣子取 匣子))
    (断言相等 (有 '青霜) (匣子取或有 匣子))))
