(模块 内置)

(声明 散列逐值
  (多态 (甲 乙 任意)
    (-> (-> 乙 任意) (散列型 甲 乙)
        空型)))

(定义 (散列逐值 函数 散列)
  (列表逐项 函数 (散列值 散列)))

(声明 散列逐键
  (多态 (甲 乙 任意)
    (-> (-> 甲 任意) (散列型 甲 乙)
        空型)))

(定义 (散列逐键 函数 散列)
  (列表逐项 函数 (散列键 散列)))

(声明 散列逐条目
  (多态 (甲 乙 任意)
    (-> (-> (序对型 甲 乙) 任意) (散列型 甲 乙)
        空型)))

(定义 (散列逐条目 函数 散列)
  (列表逐项 函数 (散列条目 散列)))

(声明 散列逐项
  (多态 (甲 乙 任意)
    (-> (-> 甲 乙 任意) (散列型 甲 乙)
        空型)))

(定义 (散列逐项 函数 散列)
  (列表逐项 (函 (条目) (函数 (序对前项 条目) (序对后项 条目)))
    (散列条目 散列)))

(定义测试 散列逐值测试
  (散列逐值
    (函 (值) (打印行 值))
    (@散列 1 2 3 4)))

(定义测试 散列逐键测试
  (散列逐键
    (函 (键) (打印行 键))
    (@散列 1 2 3 4)))

(定义测试 散列逐条目测试
  (散列逐条目
    (函 (条目) (打印行 条目))
    (@散列 1 2 3 4)))

(定义测试 散列逐项测试
  (散列逐项
    (函 (键 值)
      (打印行 键)
      (打印行 值))
    (@散列 1 2 3 4)))
