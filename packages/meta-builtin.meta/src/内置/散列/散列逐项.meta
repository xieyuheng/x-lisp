(模块 内置)

(声明 散列逐值
  (泛型 (甲 乙 任意)
    (-> (散列型 甲 乙) (-> 乙 任意)
        空值型)))

(定义 (散列逐值 散列 函数)
  (列表逐项 (散列值 散列) 函数))

(声明 散列逐键
  (泛型 (甲 乙 任意)
    (-> (散列型 甲 乙) (-> 甲 任意)
        空值型)))

(定义 (散列逐键 散列 函数)
  (列表逐项 (散列键 散列) 函数))

(声明 散列逐条目
  (泛型 (甲 乙 任意)
    (-> (散列型 甲 乙) (-> (序对型 甲 乙) 任意)
        空值型)))

(定义 (散列逐条目 散列 函数)
  (列表逐项 (散列条目 散列) 函数))

(声明 散列逐项
  (泛型 (甲 乙 任意)
    (-> (散列型 甲 乙) (-> 甲 乙 任意)
        空值型)))

(定义 (散列逐项 散列 函数)
  (列表逐项 (散列条目 散列)
    (函 (条目) (函数 (序对前项 条目) (序对后项 条目)))))

(定义测试 散列逐值测试
  (散列逐值
    (@散列 1 2 3 4)
    (函 (值) (打印行 值))))

(定义测试 散列逐键测试
  (散列逐键
    (@散列 1 2 3 4)
    (函 (键) (打印行 键))))

(定义测试 散列逐条目测试
  (散列逐条目
    (@散列 1 2 3 4)
    (函 (条目) (打印行 条目))))

(定义测试 散列逐项测试
  (散列逐项
    (@散列 1 2 3 4)
    (函 (键 值)
      (打印行 键)
      (打印行 值))))
