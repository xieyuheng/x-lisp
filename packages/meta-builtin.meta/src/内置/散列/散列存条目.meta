(模块 内置)

(声明 散列复制存条目
  (泛型 (甲 乙)
    (-> (列表型 (序对型 甲 乙)) (散列型 甲 乙)
        (散列型 甲 乙))))

(定义 (散列复制存条目 条目组 散列)
  (散列存条目 条目组 (散列复制 散列)))

(声明 散列存条目
  (泛型 (甲 乙)
    (-> (列表型 (序对型 甲 乙)) (散列型 甲 乙)
        (散列型 甲 乙))))

(定义 (散列存条目 条目组 散列)
  (若 (列表为空 条目组)
    散列
    (令 ((条目 (首 条目组)))
      (散列存 (序对前项 条目) (序对后项 条目) 散列)
      (散列存条目 (余 条目组) 散列))))

(定义测试 散列存条目测试
  (断言相等
    (@散列 '甲 1 '乙 2)
    (散列复制存条目 (@列表 (作序对 '甲 1)
                     (作序对 '乙 2))
      (@散列)))

  (令 ((散列 (@散列)))
    (断言相等
      (@散列 '甲 1 '乙 2)
      (散列存条目 (@列表 (作序对 '甲 1)
                   (作序对 '乙 2))
        散列))
    (断言相等
      (@散列 '甲 1 '乙 2) 散列)))
