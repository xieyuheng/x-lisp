(模块 内置)

(声明 散列追加
  (多态 (甲 乙)
    (-> (散列型 甲 乙) (散列型 甲 乙)
        (散列型 甲 乙))))

(定义 (散列追加 散列 剩余)
  (令 ((新散列 (散列复制 散列)))
    (散列逐项
      (函 (键 值)
        (散列存 键 值 新散列)
        空)
      剩余)
    新散列))

(定义测试 散列追加测试
  (断言相等 (@散列 1 2 3 4) (散列追加 (@散列 1 2) (@散列 3 4)))
  (断言相等 (@散列 1 2 3 4) (散列追加 (@散列 1 2 3 5) (@散列 3 4))))
