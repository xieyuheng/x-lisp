(模块 内置)

(声明 散列选取
  (泛型 (甲 乙)
    (-> (散列型 甲 乙) (-> 甲 乙 真假型)
        (散列型 甲 乙))))

(定义 (散列选取 散列 谓词)
  (作散列自条目
    (列表筛选
      (散列条目 散列)
      (函 (条目) (谓词 (序对前项 条目) (序对后项 条目))))))

(声明 散列选取键
  (泛型 (甲 乙)
    (-> (散列型 甲 乙) (-> 甲 真假型)
        (散列型 甲 乙))))

(定义 (散列选取键 散列 谓词)
  (作散列自条目
    (列表筛选
      (散列条目 散列)
      (函 (条目) (谓词 (序对前项 条目))))))

(声明 散列选取值
  (泛型 (甲 乙)
    (-> (散列型 甲 乙) (-> 乙 真假型)
        (散列型 甲 乙))))

(定义 (散列选取值 散列 谓词)
  (作散列自条目
    (列表筛选
      (散列条目 散列)
      (函 (条目) (谓词 (序对后项 条目))))))

(声明 散列剔除
  (泛型 (甲 乙)
    (-> (散列型 甲 乙) (-> 甲 乙 真假型)
        (散列型 甲 乙))))

(定义 (散列剔除 散列 谓词)
  (散列选取 散列
    (函 (键 值) (非 (谓词 键 值)))))

(声明 散列剔除键
  (泛型 (甲 乙)
    (-> (散列型 甲 乙) (-> 甲 真假型)
        (散列型 甲 乙))))

(定义 (散列剔除键 散列 谓词)
  (散列选取键 散列 (否定 谓词)))

(声明 散列剔除值
  (泛型 (甲 乙)
    (-> (散列型 甲 乙) (-> 乙 真假型)
        (散列型 甲 乙))))

(定义 (散列剔除值 散列 谓词)
  (散列选取值 散列 (否定 谓词)))

(定义测试 散列选取测试
  (断言相等
    (@散列 '甲 1 '乙 2)
    (散列选取 (@散列 '甲 1 '乙 2 '丙 -1 '丁 -2) (丢弃参数 整数非负)))

  (断言相等
    (@散列 '甲 1 '乙 2)
    (散列选取值 (@散列 '甲 1 '乙 2 '丙 -1 '丁 -2) 整数非负))

  (断言相等
    (@散列 1 '甲 2 '乙)
    (散列选取键 (@散列 1 '甲 2 '乙 -1 '丙 -2 '丁) 整数非负))

  (断言相等
    (@散列 '丙 -1 '丁 -2)
    (散列剔除 (@散列 '甲 1 '乙 2 '丙 -1 '丁 -2) (丢弃参数 整数非负)))

  (断言相等
    (@散列 '丙 -1 '丁 -2)
    (散列剔除值 (@散列 '甲 1 '乙 2 '丙 -1 '丁 -2) 整数非负))

  (断言相等
    (@散列 -1 '丙 -2 '丁)
    (散列剔除键 (@散列 1 '甲 2 '乙 -1 '丙 -2 '丁) 整数非负)))
