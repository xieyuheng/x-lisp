(模块 内置)

(声明 散列反转
  (多态 (甲 乙)
    (-> (散列型 甲 乙)
        (散列型 乙 甲))))

(定义 (散列反转 散列)
  (散列映射 (函 (键 值) (作序对 值 键))
    散列))

(定义测试 散列反转测试
  (断言相等
    (@散列 2 1 4 3)
    (散列反转 (@散列 1 2 3 4))))

(声明 散列反转归组
  (多态 (甲 乙)
    (-> (散列型 甲 乙)
        (散列型 乙 (集合型 甲)))))

(定义 (散列反转归组 散列)
  (令 ((新散列 (@散列)))
    (散列逐值
      (函 (值)
        (令 ((键组 (散列键 (散列选取值 (相等 值) 散列))))
          (散列存 值 (列表转集合 键组) 新散列)))
      散列)
    新散列))

(定义测试 散列反转归组测试
  (断言相等
    (@散列 2 (@集合 1 2)
           4 (@集合 3 4))
    (散列反转归组
      (@散列 1 2
             3 4
             2 2
             4 4))))
