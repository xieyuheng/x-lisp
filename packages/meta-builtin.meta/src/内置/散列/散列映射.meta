(模块 内置)

(声明 散列映射键
  (泛型 (甲 乙 丙)
    (-> (-> 甲 乙) (散列型 甲 丙)
        (散列型 乙 丙))))

(定义 (散列映射键 函数 散列)
  (作散列自条目
    (列表映射 (函 (条目)
                (作序对 (函数 (序对前项 条目)) (序对后项 条目)))
      (散列条目 散列))))

(定义测试 散列映射键测试
  (断言相等
    (@散列 2 2 4 4)
    (散列映射键 (整数加 1) (@散列 1 2 3 4))))

(声明 散列映射值
  (泛型 (甲 乙 丙)
    (-> (-> 乙 丙) (散列型 甲 乙)
        (散列型 甲 丙))))

(定义 (散列映射值 函数 散列)
  (作散列自条目
    (列表映射 (函 (条目)
                (作序对 (序对前项 条目) (函数 (序对后项 条目))))
      (散列条目 散列))))

(定义测试 散列映射值测试
  (断言相等
    (@散列 1 3 3 5)
    (散列映射值 (整数加 1) (@散列 1 2 3 4))))

(声明 散列映射条目
  (泛型 (甲 乙 丙 丁)
    (-> (-> (序对型 甲 乙)
            (序对型 丙 丁))
        (散列型 甲 乙)
        (散列型 丙 丁))))

(定义 (散列映射条目 函数 散列)
  (作散列自条目
    (列表映射 函数 (散列条目 散列))))

(定义测试 散列映射条目测试
  (断言相等
    (@散列 2 3 4 5)
    (散列映射条目
      (函 (条目)
        (作序对
          (整数加 1 (序对前项 条目))
          (整数加 1 (序对后项 条目))))
      (@散列 1 2 3 4))))

(声明 散列映射
  (泛型 (甲 乙 丙 丁)
    (-> (-> 甲 乙 (序对型 丙 丁))
        (散列型 甲 乙)
        (散列型 丙 丁))))

(定义 (散列映射 函数 散列)
  (作散列自条目
    (列表映射
      (函 (条目)
        (函数 (序对前项 条目) (序对后项 条目)))
      (散列条目 散列))))

(定义测试 散列映射测试
  (断言相等
    (@散列 2 3 4 5)
    (散列映射
      (函 (键 值)
        (作序对 (整数加 1 键) (整数加 1 值)))
      (@散列 1 2 3 4))))
