(模块 内置)

(定义测试 路径测试
  (断言相等 "a/b/c" (路径目录名 "a/b/c/file.test.txt"))
  (断言相等 "file.test.txt" (路径文件名 "a/b/c/file.test.txt"))
  (断言相等 ".txt" (路径扩展名 "a/b/c/file.test.txt"))
  (断言相等 "file.test" (路径主干 "a/b/c/file.test.txt"))

  (断言 (路径为绝对 "/a/b/c/file.test.txt"))
  (断言非 (路径为相对 "/a/b/c/file.test.txt"))
  (断言 (路径为相对 "a/b/c/file.test.txt"))
  (断言 (路径为相对 "./a/b/c/file.test.txt"))
  (断言非 (路径为绝对 "a/b/c/file.test.txt"))
  (断言非 (路径为绝对 "./a/b/c/file.test.txt"))

  (断言相等 "a/b/c/d/e/f" (路径连接 "a/b/c" "d/e/f"))
  (断言相等 "a/b/c/d/e/f" (路径连接 "a/b/c/" "/d/e/f"))
  (断言相等 "/a/b/c/d/e/f" (路径连接 "/a/b/c/" "/d/e/f"))

  (断言相等 "a/b/d" (路径规范化 "a/b/c/../d"))
  (断言相等 "/a/b/c" (路径规范化 "///a/b/c/")))
