(模块 内置)

(声明 集合全部
  (多态 (甲)
    (-> (-> 甲 真假型) (集合型 甲)
        真假型)))

(定义 (集合全部 谓词 集合)
  (列表全部 谓词 (集合转列表 集合)))

(定义测试 集合全部测试
  (断言 (集合全部 整数为非负 (@集合 0 1 2 3)))
  (断言非 (集合全部 整数为非负 (@集合 0 1 -1 2 3))))

(声明 集合有些
  (多态 (甲)
    (-> (-> 甲 真假型) (集合型 甲)
        真假型)))

(定义 (集合有些 谓词 集合)
  (列表有些 谓词 (集合转列表 集合)))

(定义测试 集合有些测试
  (断言 (集合有些 整数为非负 (@集合 -1 -2 0)))
  (断言非 (集合有些 整数为非负 (@集合 -1 -2 -3))))
