(模块 内置)

(声明 集合全部
  (泛型 (甲)
    (-> (集合型 甲) (-> 甲 真假型)
        真假型)))

(定义 (集合全部 集合 谓词)
  (列表全部 (集合转列表 集合) 谓词))

(定义测试 集合全部测试
  (断言 (集合全部 (@集合 0 1 2 3) 整数非负))
  (断言非 (集合全部 (@集合 0 1 -1 2 3) 整数非负)))

(声明 集合有些
  (泛型 (甲)
    (-> (集合型 甲) (-> 甲 真假型)
        真假型)))

(定义 (集合有些 集合 谓词)
  (列表有些 (集合转列表 集合) 谓词))

(定义测试 集合有些测试
  (断言 (集合有些 (@集合 -1 -2 0) 整数非负))
  (断言非 (集合有些 (@集合 -1 -2 -3) 整数非负)))
