(模块 内置)

(声明 集合选取
  (多态 (甲)
    (-> (-> 甲 真假型) (集合型 甲)
        (集合型 甲))))

(定义 (集合选取 谓词 集合)
  (令 ((新集合 (@集合)))
    (集合逐项
      (函 (元素)
        (当 (谓词 元素)
          (集合添加 元素 新集合)))
      集合)
    新集合))

(定义测试 集合选取测试
  (断言相等 (@集合 0 1 2) (集合选取 整数为非负 (@集合 -2 -1 0 1 2))))

(声明 集合剔除
  (多态 (甲)
    (-> (-> 甲 真假型) (集合型 甲)
        (集合型 甲))))

(定义 (集合剔除 谓词 集合)
  (集合选取 (否定 谓词) 集合))

(定义测试 集合剔除测试
  (断言相等 (@集合 -1 -2) (集合剔除 整数为非负 (@集合 -2 -1 0 1 2))))
