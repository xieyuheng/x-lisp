(模块 内置)

(定义测试 数组测试
  ;; 构造与访问

  (令 ((数组 (作数组)))
    (断言 (数组为空 数组))
    (数组末入 数组 1)
    (数组末入 数组 2)
    (数组末入 数组 3)
    (断言不等 (数组为空 数组))
    (断言相等 3 (数组长度 数组))
    (断言相等 1 (数组取 数组 0))
    (断言相等 2 (数组取 数组 1))
    (断言相等 3 (数组取 数组 2)))

  ;; 存 / 末出

  (令 ((数组 (作数组)))
    (数组末入 数组 1)
    (数组存 数组 0 10)
    (断言相等 10 (数组取 数组 0))
    (断言相等 10 (数组末出 数组))
    (断言 (数组为空 数组)))

  ;; 首入 / 首出

  (令 ((数组 (作数组)))
    (数组末入 数组 2)
    (数组首入 数组 1)
    (断言相等 1 (数组首出 数组))
    (断言相等 2 (数组首出 数组))
    (断言 (数组为空 数组)))

  ;; 复制不会共享

  (令 ((数组 (作数组)))
    (数组末入 数组 1)
    (令 ((复制 (数组复制 数组)))
      (数组末入 数组 2)
      (断言相等 1 (数组长度 复制))))

  ;; 反转

  (令 ((数组 (作数组)))
    (数组末入 数组 1)
    (数组末入 数组 2)
    (数组末入 数组 3)
    (数组反转 数组)
    (断言相等 (@列表 3 2 1) (数组转列表 数组)))

  ;; 字面量

  (断言 (为数组 (@数组 1 2 3)))
  (断言相等 3 (数组长度 (@数组 1 2 3)))
  (断言相等 1 (数组取 (@数组 1 2 3) 0))
  (断言相等 (@列表 1 2 3) (数组转列表 (@数组 1 2 3)))

  ;; 转换

  (断言相等 (@列表 1 2 3) (数组转列表 (列表转数组 (@列表 1 2 3))))
  (断言 (数组为空 (列表转数组 (@列表))))

  ;; 为数组

  (断言 (为数组 (作数组)))
  (断言 (为数组 (列表转数组 (@列表 1 2 3))))
  (断言不等 (为数组 (@列表 1 2 3)))
  (断言不等 (为数组 1)))