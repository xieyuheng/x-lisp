(模块 内置)

(声明 数组逐项索引
  (泛型 (甲 任意)
    (-> (数组型 甲) (-> 整数型 甲 任意)
        空值型)))

(定义 (数组逐项索引 数组 函数)
  (数组逐项索引辅助 函数 数组 0))

(声明 数组逐项索引辅助
  (泛型 (甲 任意)
    (-> (-> 整数型 甲 任意) (数组型 甲) 整数型
        空值型)))

(定义 (数组逐项索引辅助 函数 数组 索引)
  (若 (整数大于等于 索引 (数组长度 数组))
    空值
    (循序
      (函数 索引 (数组取 数组 索引))
      (数组逐项索引辅助 函数 数组 (整数加一 索引)))))

(定义测试 数组逐项索引测试
  (令 ((数组 (列表转数组 (@列表 'a 'b 'c)))
        (结果数组 (作数组)))
    (数组逐项索引
      数组
      (函 (索引 元素)
        (数组末入 结果数组 (作序对 索引 元素))))
    (断言相等 (@列表 (作序对 0 'a) (作序对 1 'b) (作序对 2 'c))
      (数组转列表 结果数组))))