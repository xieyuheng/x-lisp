(模块 内置)

(声明 数组排序
  (泛型 (甲)
    (-> (数组型 甲) (-> 甲 甲 整数型)
        空值型)))

(定义 (数组排序 数组 比较)
  (令 ((长度 (数组长度 数组)))
    (数组快排 比较 数组 0 (整数减一 长度))))

(声明 数组快排
  (泛型 (甲)
    (-> (-> 甲 甲 整数型) (数组型 甲) 整数型 整数型
        空值型)))

(定义 (数组快排 比较 数组 下界 上界)
  (当 (整数小于 下界 上界)
    (令 ((边界 (数组快排分区 比较 数组 下界 上界)))
      (数组快排 比较 数组 下界 (序对前项 边界))
      (数组快排 比较 数组 (序对后项 边界) 上界))))

(声明 数组快排分区
  (泛型 (甲)
    (-> (-> 甲 甲 整数型) (数组型 甲) 整数型 整数型
        (序对型 整数型 整数型))))

(定义 (数组快排分区 比较 数组 下界 上界)
  (令 ((枢轴 (数组取 数组 (整数除 (整数加 下界 上界) 二))))
    (数组快排分区辅助 比较 数组 枢轴 下界 下界 上界)))

(声明 数组快排分区辅助
  (泛型 (甲)
    (-> (-> 甲 甲 整数型) (数组型 甲) 甲 整数型 整数型 整数型
        (序对型 整数型 整数型))))

(定义 (数组快排分区辅助 比较 数组 枢轴 索引 较小 较大)
  (若 (整数大于 索引 较大)
    (作序对 (整数减一 较小) (整数加一 较大))
    (令 ((比较结果 (比较 (数组取 数组 索引) 枢轴)))
      (若则
        ((整数小于 比较结果 0)
         (数组交换 索引 较小 数组)
         (数组快排分区辅助 比较 数组 枢轴 (整数加一 索引) (整数加一 较小) 较大))
        ((整数大于 比较结果 0)
         (数组交换 索引 较大 数组)
         (数组快排分区辅助 比较 数组 枢轴 索引 较小 (整数减一 较大)))
        (否则
         (数组快排分区辅助 比较 数组 枢轴 (整数加一 索引) 较小 较大))))))

(定义 (数组交换 索引甲 索引乙 数组)
  (令 ((甲 (数组取 数组 索引甲))
        (乙 (数组取 数组 索引乙)))
    (数组存 数组 索引甲 乙)
    (数组存 数组 索引乙 甲)))

(定义测试 数组排序测试
  ;; 整数升序

  (令 ((数组 (作数组)))
    (数组末入 数组 2)
    (数组末入 数组 3)
    (数组末入 数组 1)
    (数组排序 数组 整数升序比较)
    (断言相等 (@列表 1 2 3) (数组转列表 数组)))

  ;; 整数降序

  (令 ((数组 (列表转数组 (@列表 2 3 1))))
    (数组排序 数组 整数降序比较)
    (断言相等 (@列表 3 2 1) (数组转列表 数组)))

  ;; 浮点升序

  (令 ((数组 (列表转数组 (@列表 2.0 3.0 1.0))))
    (数组排序 数组 浮点升序比较)
    (断言相等 (@列表 1.0 2.0 3.0) (数组转列表 数组)))

  ;; 文本词典序

  (令 ((数组 (列表转数组 (@列表 "b" "c" "a"))))
    (数组排序 数组 文本字典序比较)
    (断言相等 (@列表 "a" "b" "c") (数组转列表 数组))))