(模块 内置)

(声明 数组逐项
  (泛型 (甲 任意)
    (-> (数组型 甲) (-> 甲 任意)
        空值型)))

(定义 (数组逐项 数组 函数)
  (数组逐项辅助 函数 数组 0))

(声明 数组逐项辅助
  (泛型 (甲 任意)
    (-> (-> 甲 任意) (数组型 甲) 整数型
        空值型)))

(定义 (数组逐项辅助 函数 数组 索引)
  (若 (整数大于等于 索引 (数组长度 数组))
    空值
    (循序
      (函数 (数组取 数组 索引))
      (数组逐项辅助 函数 数组 (整数加一 索引)))))

(定义测试 数组逐项测试
  (令 ((数组 (列表转数组 (@列表 1 2 3)))
        (累积 (作数组)))
    (数组逐项
      数组
      (函 (元素)
        (数组末入 累积 元素)))
    (断言相等 (@列表 1 2 3) (数组转列表 累积))))