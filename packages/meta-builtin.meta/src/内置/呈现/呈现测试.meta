(模块 内置)

(定义测试 呈现整数测试
  (断言相等 "42" (呈现整数 42))
  (断言相等 "-1" (呈现整数 -1)))

(定义测试 呈现浮点测试
  (断言相等 "42.0" (呈现浮点 42.0))
  (断言相等 "0.0" (呈现浮点 0.0)))

(定义测试 呈现标签测试
  (断言相等 ":foo" (呈现标签 :foo)))

(定义测试 呈现符号测试
  (断言相等 "'hello" (呈现符号 'hello)))

(定义测试 呈现真假测试
  (断言相等 "#t" (呈现真假 真))
  (断言相等 "#f" (呈现真假 假)))

(定义测试 呈现文本测试
  (断言相等 "\"abc\"" (呈现文本 "abc")))

(定义测试 呈现空测试
  (断言相等 "#void" (呈现空 空)))
