(模块 内置)

(声明基本函数 呈现为符号算式 1)

(声明 呈现为符号算式 (多态 (甲) (-> 甲 文本型)))

(声明 呈现整数 (-> 整数型 文本型))
(定义 (呈现整数 甲) (呈现为符号算式 甲))

(声明 呈现浮点 (-> 浮点型 文本型))
(定义 (呈现浮点 甲) (呈现为符号算式 甲))

(声明 呈现标签 (-> 标签型 文本型))
(定义 (呈现标签 甲) (呈现为符号算式 甲))

(声明 呈现符号 (-> 符号型 文本型))
(定义 (呈现符号 甲) (文本追加 "'" (呈现为符号算式 甲)))

(声明 呈现真假 (-> 真假型 文本型))
(定义 (呈现真假 甲) (呈现为符号算式 甲))

(声明 呈现文本 (-> 文本型 文本型))
(定义 (呈现文本 甲) (呈现为符号算式 甲))

(声明 呈现空 (-> 空型 文本型))
(定义 (呈现空 甲) (呈现为符号算式 甲))
