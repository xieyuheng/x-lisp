(模块 内置)

(声明 列表取前
  (泛型 (甲)
    (-> 整数型 (列表型 甲)
        (列表型 甲))))

(定义 (列表取前 个数 列表)
  (断言 (整数非负 个数))
  (若 (或 (整数为零 个数) (列表为空 列表))
    (@列表)
    (添 (首 列表) (列表取前 (整数减一 个数) (余 列表)))))

(定义测试 列表取前测试
  (断言相等 (列表取前 0 (@列表 1 2 3)) (@列表))
  (断言相等 (列表取前 1 (@列表 1 2 3)) (@列表 1))
  (断言相等 (列表取前 2 (@列表 1 2 3)) (@列表 1 2))
  (断言相等 (列表取前 3 (@列表 1 2 3)) (@列表 1 2 3))
  (断言相等 (列表取前 4 (@列表 1 2 3)) (@列表 1 2 3)))

(声明 列表去前
  (泛型 (甲)
    (-> 整数型 (列表型 甲)
        (列表型 甲))))

(定义 (列表去前 个数 列表)
  (断言 (整数非负 个数))
  (若 (或 (整数为零 个数) (列表为空 列表))
    列表
    (列表去前 (整数减一 个数) (余 列表))))

(定义测试 列表去前测试
  (断言相等 (列表去前 0 (@列表 1 2 3)) (@列表 1 2 3))
  (断言相等 (列表去前 1 (@列表 1 2 3)) (@列表 2 3))
  (断言相等 (列表去前 2 (@列表 1 2 3)) (@列表 3))
  (断言相等 (列表去前 3 (@列表 1 2 3)) (@列表))
  (断言相等 (列表去前 4 (@列表 1 2 3)) (@列表)))
