(模块 内置)

(声明 列表查找
  (泛型 (甲)
    (-> (列表型 甲) (-> 甲 真假型)
        (或有型 甲))))

(定义 (列表查找 列表 谓词)
  (若则 ((列表为空 列表) (无))
        ((谓词 (首 列表)) (有 (首 列表)))
        (否则 (列表查找 (余 列表) 谓词))))

(定义测试 列表查找测试
  (断言相等 (有 3) (列表查找 (@列表 1 2 3 4) (函 (x) (相等 x 3))))
  (断言相等 (无) (列表查找 (@列表 'a 'b 'c 'd) 为整数)))

(声明 列表查找索引
  (泛型 (甲)
    (-> (列表型 甲) (-> 甲 真假型)
        整数型)))

(定义 (列表查找索引 列表 谓词)
  (列表查找索引辅助 谓词 列表 0))

(声明 列表查找索引辅助
  (泛型 (甲)
    (-> (-> 甲 真假型) (列表型 甲) 整数型
        整数型)))

(定义 (列表查找索引辅助 谓词 列表 索引)
  (若则 ((列表为空 列表) -1)
        ((谓词 (首 列表)) 索引)
        (否则 (列表查找索引辅助 谓词 (余 列表) (整数加一 索引)))))

(定义测试 列表查找索引测试
  (断言相等 2 (列表查找索引 (@列表 1 2 3 4) (函 (x) (相等 x 3))))
  (断言相等 -1 (列表查找索引 (@列表 'a 'b 'c 'd) 为整数)))
