(模块 内置)

(声明 列表拉链
  (泛型 (甲 乙)
    (-> (列表型 甲) (列表型 乙)
        (列表型 (序对型 甲 乙)))))

(定义 (列表拉链 左 右)
  (若 (或 (列表为空 左) (列表为空 右))
    []
    (添 (作序对 (首 左) (首 右))
      (列表拉链 (余 左) (余 右)))))


(定义测试 列表拉链测试
  (断言相等
    (列表拉链 ['春 '夏 '秋 '冬] ['生 '长 '收 '藏])
    [(作序对 '春 '生) (作序对 '夏 '长) (作序对 '秋 '收) (作序对 '冬 '藏)])
  (断言相等
    (列表拉链 ['春 '夏 '秋 '冬] ['生 '长 '收])
    [(作序对 '春 '生) (作序对 '夏 '长) (作序对 '秋 '收)]))

(声明 列表解拉链
  (泛型 (甲 乙)
    (-> (列表型 (序对型 甲 乙))
        (序对型 (列表型 甲) (列表型 乙)))))

(定义 (列表解拉链 序对列表)
  (作序对 (列表映射 序对前项 序对列表)
    (列表映射 序对后项 序对列表)))

(定义测试 列表解拉链测试
  (断言相等
    (列表解拉链 [(作序对 '春 '生) (作序对 '夏 '长) (作序对 '秋 '收) (作序对 '冬 '藏)])
    (作序对 ['春 '夏 '秋 '冬] ['生 '长 '收 '藏])))
