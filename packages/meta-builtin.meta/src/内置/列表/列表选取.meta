(模块 内置)

(声明 列表选取
  (泛型 (甲)
    (-> (-> 甲 真假型) (列表型 甲)
        (列表型 甲))))

(定义 (列表选取 谓词 列表)
  (若则 ((列表为空 列表) 列表)
        ((谓词 (首 列表))
         (添 (首 列表) (列表选取 谓词 (余 列表))))
        (否则
         (列表选取 谓词 (余 列表)))))

(定义测试 列表选取测试
  (断言相等
    (列表选取 (否定 (相等 0)) (@列表 0 1 0 2 0 3))
    (@列表 1 2 3)))

(声明 列表剔除
  (泛型 (甲)
    (-> (-> 甲 真假型) (列表型 甲)
        (列表型 甲))))

(定义 (列表剔除 谓词 列表)
  (列表选取 (否定 谓词) 列表))

(定义测试 列表剔除测试
  (断言相等
    (列表剔除 (相等 0) (@列表 0 1 0 2 0 3))
    (@列表 1 2 3)))
