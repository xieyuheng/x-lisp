(模块 内置)

(声明 列表右折叠索引
  (多态 (甲 乙)
    (-> (-> 整数型 甲 乙 乙) 乙 (列表型 甲) 乙)))

(定义 (列表右折叠索引 函数 累积值 列表)
  (列表右折叠索引辅助 函数 累积值 列表 (整数减 (列表长度 列表) 1)))

(声明 列表右折叠索引辅助
  (多态 (甲 乙)
    (-> (-> 整数型 甲 乙 乙) 乙 (列表型 甲) 整数型 乙)))

(定义 (列表右折叠索引辅助 函数 累积值 列表 索引)
  (若 (列表为空 列表)
    累积值
    (列表右折叠索引辅助
      函数 (函数 索引 (列表末项 列表) 累积值)
      (列表去末 列表)
      (整数减 索引 1))))

(定义测试 列表右折叠索引测试
  (断言相等
    (列表右折叠索引
      (函 (索引 元素 累积值) (添 (作序对 索引 元素) 累积值))
      [] ['a 'b 'c])
    [(作序对 0 'a) (作序对 1 'b) (作序对 2 'c)])
  (断言相等
    (列表右折叠索引
      (函 (索引 元素 累积值) (整数加 (整数乘 索引 元素) 累积值))
      0 [10 20 30])
    80)
  (断言相等
    (列表右折叠索引
      (函 (索引 元素 累积值) (整数加 元素 累积值))
      0 [])
    0))
