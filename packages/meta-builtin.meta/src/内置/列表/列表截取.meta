(模块 内置)

(声明 列表截取
  (多态 (甲)
    (-> 整数型 (列表型 甲)
        (列表型 甲))))

(定义 (列表截取 个数 列表)
  (断言 (整数为非负 个数))
  (若 (或 (整数为零 个数) (列表为空 列表))
    []
    (添 (首 列表) (列表截取 (整数减一 个数) (余 列表)))))

(定义测试 列表截取测试
  (断言相等 (列表截取 0 [1 2 3]) [])
  (断言相等 (列表截取 1 [1 2 3]) [1])
  (断言相等 (列表截取 2 [1 2 3]) [1 2])
  (断言相等 (列表截取 3 [1 2 3]) [1 2 3])
  (断言相等 (列表截取 4 [1 2 3]) [1 2 3]))

(声明 列表截去
  (多态 (甲)
    (-> 整数型 (列表型 甲)
        (列表型 甲))))

(定义 (列表截去 个数 列表)
  (断言 (整数为非负 个数))
  (若 (或 (整数为零 个数) (列表为空 列表))
    列表
    (列表截去 (整数减一 个数) (余 列表))))

(定义测试 列表截去测试
  (断言相等 (列表截去 0 [1 2 3]) [1 2 3])
  (断言相等 (列表截去 1 [1 2 3]) [2 3])
  (断言相等 (列表截去 2 [1 2 3]) [3])
  (断言相等 (列表截去 3 [1 2 3]) [])
  (断言相等 (列表截去 4 [1 2 3]) []))
