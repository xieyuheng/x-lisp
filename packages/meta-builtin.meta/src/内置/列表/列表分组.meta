(模块 内置)

(声明 列表分组
  (多态 (甲 乙)
    (-> (-> 乙 甲) (列表型 乙)
        (散列型 甲 (列表型 乙)))))

(定义 (列表分组 函数 列表)
  (令 ((新散列 (@散列)))
    (列表逐项
      (函 (值)
        (令 ((键 (函数 值)))
          (除非 (散列有 键 新散列)
            (散列存 键 [值] 新散列))
          (令 ((分组 (散列取 键 新散列)))
            (列表末入 值 分组))))
      列表)
    新散列))

(定义测试 列表分组测试
  (断言相等
    (@散列 0 [0 3]
           1 [1 4]
           2 [2 5])
    (列表分组 (交换参数 整数模 3) [0 1 2 3 4 5])))
