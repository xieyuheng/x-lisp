(模块 内置)

(声明 列表分组
  (泛型 (甲 乙)
    (-> (列表型 乙) (-> 乙 甲)
        (散列型 甲 (列表型 乙)))))

(定义 (列表分组 列表 函数)
  (令 ((新散列 (@散列)))
    (列表逐项
      列表
      (函 (值)
        (令 ((键 (函数 值)))
          (除非 (散列有 新散列 键)
            (散列存 新散列 键 (作数组)))
          (令 ((分组 (散列取 新散列 键)))
            (数组末入 分组 值)))))
    (散列映射值 新散列 数组转列表)))

(定义测试 列表分组测试
  (断言相等
    (@散列 0 (@列表 0 3)
           1 (@列表 1 4)
           2 (@列表 2 5))
    (列表分组 (@列表 0 1 2 3 4 5) (交换参数 整数模 3))))