(模块 内置)

(声明 列表左折叠索引
  (多态 (甲 乙)
    (-> (-> 整数型 乙 甲 乙) 乙 (列表型 甲) 乙)))

(定义 (列表左折叠索引 函数 累积值 列表)
  (列表左折叠索引辅助 函数 累积值 列表 0))

(声明 列表左折叠索引辅助
  (多态 (甲 乙)
    (-> (-> 整数型 乙 甲 乙) 乙 (列表型 甲) 整数型 乙)))

(定义 (列表左折叠索引辅助 函数 累积值 列表 索引)
  (若 (列表为空 列表)
    累积值
    (列表左折叠索引辅助
      函数 (函数 索引 累积值 (首 列表))
      (余 列表)
      (整数加 索引 1))))

(定义测试 列表左折叠索引测试
  (断言相等
    (列表左折叠索引 (函 (索引 累积值 元素) (整数加 累积值 (整数乘 索引 元素)))
      0 [10 20 30])
    80)
  (断言相等
    (列表左折叠索引 (函 (索引 累积值 元素) (添 索引 累积值))
      [] ['a 'b 'c])
    [2 1 0])
  (断言相等
    (列表左折叠索引
      (函 (索引 累积值 元素) (整数加 累积值 元素)) 0 [])
    0))
