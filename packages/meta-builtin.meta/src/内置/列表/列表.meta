(声明 为列表 (泛型 (甲) (-> 甲 真假型)))
(声明 作列表 (泛型 (甲) (-> (列表型 甲))))
(声明 首 (泛型 (甲) (-> (列表型 甲) 甲)))
(声明 余 (泛型 (甲) (-> (列表型 甲) (列表型 甲))))
(声明 添 (泛型 (甲) (-> 甲 (列表型 甲) (列表型 甲))))
(声明 列表首项 (泛型 (甲) (-> (列表型 甲) 甲)))
(声明 列表去首 (泛型 (甲) (-> (列表型 甲) (列表型 甲))))
(声明 列表去末 (泛型 (甲) (-> (列表型 甲) (列表型 甲))))
(声明 列表末项 (泛型 (甲) (-> (列表型 甲) 甲)))
(声明 列表长度 (泛型 (甲) (-> (列表型 甲) 整数型)))
(声明 列表为空 (泛型 (甲) (-> (列表型 甲) 真假型)))
(声明 列表复制 (泛型 (甲) (-> (列表型 甲) (列表型 甲))))
(声明 列表取 (泛型 (甲) (-> 整数型 (列表型 甲) 甲)))
(声明 列表复制存 (泛型 (甲) (-> 整数型 甲 (列表型 甲) (列表型 甲))))
(声明 列表存 (泛型 (甲) (-> 整数型 甲 (列表型 甲) 空型)))
(声明 列表末入 (泛型 (甲) (-> 甲 (列表型 甲) 空型)))
(声明 列表末出 (泛型 (甲) (-> (列表型 甲) 甲)))
(声明 列表首出 (泛型 (甲) (-> (列表型 甲) 甲)))
(声明 列表首入 (泛型 (甲) (-> 甲 (列表型 甲) 空型)))
(声明 列表复制反转 (泛型 (甲) (-> (列表型 甲) (列表型 甲))))
(声明 列表反转 (泛型 (甲) (-> (列表型 甲) 空型)))
(声明 列表转集合 (泛型 (甲) (-> (列表型 甲) (集合型 甲))))
