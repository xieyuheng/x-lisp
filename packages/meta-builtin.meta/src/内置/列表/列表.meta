(模块 内置)

(声明基本变量 空列表)
(声明基本函数 为列表 1)
(声明基本函数 首 1)
(声明基本函数 余 1)
(声明基本函数 添 2)

(声明 空列表 (泛型 (甲) (列表型 甲)))
(声明 为列表 (泛型 (甲) (-> 甲 真假型)))
(声明 首 (泛型 (甲) (-> (列表型 甲) 甲)))
(声明 余 (泛型 (甲) (-> (列表型 甲) (列表型 甲))))
(声明 添 (泛型 (甲) (-> 甲 (列表型 甲) (列表型 甲))))

(声明 列表首项 (泛型 (甲) (-> (列表型 甲) 甲)))
(定义 (列表首项 列表) (首 列表))

(声明 列表去首 (泛型 (甲) (-> (列表型 甲) (列表型 甲))))
(定义 (列表去首 列表) (余 列表))

(声明 列表为空 (泛型 (甲) (-> (列表型 甲) 真假型)))
(定义 (列表为空 列表) (相等 列表 空列表))

(声明 列表长度
  (泛型 (甲)
    (-> (列表型 甲) 整数型)))
(定义 (列表长度 列表)
  (列表长度辅助 列表 0))

(声明 列表长度辅助
  (泛型 (甲)
    (-> (列表型 甲) 整数型
        整数型)))
(定义 (列表长度辅助 列表 数量)
  (若 (列表为空 列表)
    数量
    (列表长度辅助 (余 列表) (整数加 1 数量))))

(声明 列表取
  (泛型 (甲)
    (-> (列表型 甲) 整数型 甲)))
(定义 (列表取 列表 索引)
  (若 (相等 索引 0)
    (首 列表)
    (列表取 (余 列表) (整数减 索引 1))))

(声明 列表末项
  (泛型 (甲)
    (-> (列表型 甲) 甲)))
(定义 (列表末项 列表)
  (若 (列表为空 (余 列表))
    (首 列表)
    (列表末项 (余 列表))))

(声明 列表复制反转
  (泛型 (甲)
    (-> (列表型 甲) (列表型 甲))))
(定义 (列表复制反转 列表)
  (列表复制反转辅助 列表 空列表))

(声明 列表复制反转辅助
  (泛型 (甲)
    (-> (列表型 甲) (列表型 甲)
        (列表型 甲))))
(定义 (列表复制反转辅助 列表 累积)
  (若 (列表为空 列表)
    累积
    (列表复制反转辅助 (余 列表) (添 (首 列表) 累积))))

(声明 列表去末
  (泛型 (甲)
    (-> (列表型 甲) (列表型 甲))))
(定义 (列表去末 列表)
  (列表复制反转 (余 (列表复制反转 列表))))

(声明 列表复制存
  (泛型 (甲)
    (-> (列表型 甲) 整数型 甲 (列表型 甲))))
(定义 (列表复制存 列表 索引 值)
  (列表复制存辅助 索引 值 列表 空列表))

(声明 列表复制存辅助
  (泛型 (甲)
    (-> 整数型 甲 (列表型 甲) (列表型 甲)
        (列表型 甲))))
(定义 (列表复制存辅助 索引 值 列表 反转累积)
  (若则
    ((列表为空 列表)
     (报错 "(列表复制存) 索引超出范围"))
    ((相等 索引 0)
     (列表追加 (列表复制反转 反转累积) (添 值 (余 列表))))
    (否则
     (列表复制存辅助 (整数减 索引 1) 值 (余 列表) (添 (首 列表) 反转累积)))))

(声明 列表转集合
  (泛型 (甲)
    (-> (列表型 甲) (集合型 甲))))
(定义 (列表转集合 列表)
  (令 ((集合 (作集合)))
    (列表逐项 列表 (函 (元素) (集合添加 集合 元素)))
    集合))