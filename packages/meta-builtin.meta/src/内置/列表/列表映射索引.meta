(模块 内置)

(声明 列表映射索引
  (多态 (甲 乙)
    (-> (-> 整数型 甲 乙) (列表型 甲) (列表型 乙))))

(定义 (列表映射索引 函数 列表)
  (列表映射索引辅助 函数 列表 0))

(声明 列表映射索引辅助
  (多态 (甲 乙)
    (-> (-> 整数型 甲 乙) (列表型 甲) 整数型 (列表型 乙))))

(定义 (列表映射索引辅助 函数 列表 索引)
  (若 (列表为空 列表)
    []
    (添 (函数 索引 (首 列表))
      (列表映射索引辅助 函数 (余 列表) (整数加 索引 1)))))

(定义测试 列表映射索引测试
  (断言相等 (列表映射索引 (函 (索引 元素) (整数加 索引 元素)) [10 20 30])
    [10 21 32])
  (断言相等 (列表映射索引 (函 (索引 元素) 索引) ['a 'b 'c])
    [0 1 2])
  (断言相等 (列表映射索引 (函 (索引 元素) (整数加 索引 元素)) [])
    []))
