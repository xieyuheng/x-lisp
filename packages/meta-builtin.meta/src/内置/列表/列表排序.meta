(模块 内置)

(声明 列表复制排序
  (多态 (甲)
    (-> (-> 甲 甲 整数型) (列表型 甲)
        (列表型 甲))))

(定义 (列表复制排序 比较 列表)
  (令 ((新列表 (列表复制 列表)))
    (列表排序 比较 新列表)
    新列表))

(声明 列表排序
  (多态 (甲)
    (-> (-> 甲 甲 整数型) (列表型 甲)
        空型)))

(定义 (列表排序 比较 列表)
  (令 ((长度 (列表长度 列表)))
    (快速排序区间 比较 列表 0 (整数减 长度 1))))

(声明 快速排序区间
  (多态 (甲)
    (-> (-> 甲 甲 整数型) (列表型 甲) 整数型 整数型
        空型)))

(定义 (快速排序区间 比较 列表 下界 上界)
  (若 (整数小于 下界 上界)
    (令 ((边界 (三路分区 比较 列表 下界 上界)))
      (快速排序区间 比较 列表 下界 (列表取 0 边界))
      (快速排序区间 比较 列表 (列表取 1 边界) 上界))
    空))

(声明 三路分区
  (多态 (甲)
    (-> (-> 甲 甲 整数型) (列表型 甲) 整数型 整数型
        (列表型 整数型))))

(定义 (三路分区 比较 列表 下界 上界)
  (令 ((基准 (列表取 (整数除 (整数加 下界 上界) 2) 列表)))
    (三路分区辅助 比较 列表 基准 下界 上界 下界)))

(声明 三路分区辅助
  (多态 (甲)
    (-> (-> 甲 甲 整数型) (列表型 甲) 甲 整数型 整数型 整数型
        (列表型 整数型))))

(定义 (三路分区辅助 比较 列表 基准 较小 较大 索引)
  (若 (整数大于 索引 较大)
    [(整数减 较小 1) (整数加 较大 1)]
    (令 ((比较结果 (比较 (列表取 索引 列表) 基准)))
      (若则
        ((整数小于 比较结果 0)
         (令 ((暂存 (列表取 索引 列表))
              (值   (列表取 较小 列表)))
           (列表存 索引 值 列表)
           (列表存 较小 暂存 列表)
           (三路分区辅助 比较 列表 基准 (整数加 较小 1) 较大 (整数加 索引 1))))
        ((整数大于 比较结果 0)
         (令 ((暂存 (列表取 索引 列表))
              (值   (列表取 较大 列表)))
           (列表存 索引 值 列表)
           (列表存 较大 暂存 列表)
           (三路分区辅助 比较 列表 基准 较小 (整数减 较大 1) 索引)))
        (否则
         (三路分区辅助 比较 列表 基准 较小 较大 (整数加 索引 1)))))))
