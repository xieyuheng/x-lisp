(模块 内置)

(声明 列表复制排序
  (多态 (甲)
    (-> (-> 甲 甲 整数型) (列表型 甲)
        (列表型 甲))))

(定义 (列表复制排序 比较 列表)
  (令 ((新列表 (列表复制 列表)))
    (列表排序 比较 新列表)
    新列表))

(声明 列表排序
  (多态 (甲)
    (-> (-> 甲 甲 整数型) (列表型 甲)
        空型)))

(定义 (列表排序 比较 列表)
  (令 ((长度 (列表长度 列表)))
    (快排 比较 列表 0 (整数减 长度 1))))

(声明 快排
  (多态 (甲)
    (-> (-> 甲 甲 整数型) (列表型 甲) 整数型 整数型
        空型)))

(定义 (快排 比较 列表 下界 上界)
  (当 (整数小于 下界 上界)
    (令 ((边界 (快排分区 比较 列表 下界 上界)))
      (快排 比较 列表 下界 (序对前项 边界))
      (快排 比较 列表 (序对后项 边界) 上界))))

(声明 快排分区
  (多态 (甲)
    (-> (-> 甲 甲 整数型) (列表型 甲) 整数型 整数型
        (序对型 整数型 整数型))))

(定义 (快排分区 比较 列表 下界 上界)
  (令 ((基准 (列表取 (整数除 (整数加 下界 上界) 2) 列表)))
    (快排分区辅助 比较 列表 基准 下界 下界 上界)))

(声明 快排分区辅助
  (多态 (甲)
    (-> (-> 甲 甲 整数型) (列表型 甲) 甲 整数型 整数型 整数型
        (序对型 整数型 整数型))))

(定义 (快排分区辅助 比较 列表 基准 索引 较小 较大)
  (若 (整数大于 索引 较大)
    (作序对 (整数减 较小 1) (整数加 较大 1))
    (令 ((比较结果 (比较 (列表取 索引 列表) 基准)))
      (若则
        ((整数小于 比较结果 0)
         (列表交换 索引 较小 列表)
         (快排分区辅助 比较 列表 基准 (整数加 索引 1) (整数加 较小 1) 较大))
        ((整数大于 比较结果 0)
         (列表交换 索引 较大 列表)
         (快排分区辅助 比较 列表 基准 索引 较小 (整数减 较大 1)))
        (否则
         (快排分区辅助 比较 列表 基准 (整数加 索引 1) 较小 较大))))))

(定义 (列表交换 甲 乙 列表)
  (令 ((值甲 (列表取 甲 列表))
       (值乙 (列表取 乙 列表)))
    (列表存 甲 值乙 列表)
    (列表存 乙 值甲 列表)))
