(模块 内置)

(声明 列表排序
  (多态 (甲)
    (-> (-> 甲 甲 整数型) (列表型 甲)
        空型)))

(定义 (列表排序 比较 列表)
  (令 ((长度 (列表长度 列表)))
    (快排 比较 列表 0 (整数减一 长度))))

(声明 快排
  (多态 (甲)
    (-> (-> 甲 甲 整数型) (列表型 甲) 整数型 整数型
        空型)))

(定义 (快排 比较 列表 下界 上界)
  (当 (整数小于 下界 上界)
    (令 ((较小匣子 (作匣子))
         (较大匣子 (作匣子)))
      ;; 用匣子来保存 快排分区 的多返回值
      (快排分区 比较 列表 下界 上界 较小匣子 较大匣子)
      (快排 比较 列表 下界 (匣子取 较小匣子))
      (快排 比较 列表 (匣子取 较大匣子) 上界))))

(声明 快排分区
  (多态 (甲)
    (-> (-> 甲 甲 整数型) (列表型 甲) 整数型 整数型
        (匣子型 整数型) (匣子型 整数型)
        空型)))

(定义 (快排分区 比较 列表 下界 上界 较小匣子 较大匣子)
  (令 ((基准 (列表取 (整数除 (整数加 下界 上界) 2) 列表)))
    (快排分区循环 比较 列表 基准 下界 下界 上界 较小匣子 较大匣子)))

(声明 快排分区循环
  (多态 (甲)
    (-> (-> 甲 甲 整数型) (列表型 甲) 甲 整数型 整数型 整数型
        (匣子型 整数型) (匣子型 整数型)
        空型)))

(定义 (快排分区循环 比较 列表 基准 索引 较小 较大 较小匣子 较大匣子)
  (若 (整数大于 索引 较大)
    (循序
      (匣子存 (整数减一 较小) 较小匣子)
      (匣子存 (整数加一 较大) 较大匣子))
    (令 ((大小 (比较 (列表取 索引 列表) 基准)))
      (若则
        ((整数小于 大小 0)
         (列表交换 索引 较小 列表)
         (快排分区循环 比较 列表 基准 (整数加一 索引) (整数加一 较小) 较大 较小匣子 较大匣子))
        ((整数大于 大小 0)
         (列表交换 索引 较大 列表)
         (快排分区循环 比较 列表 基准 索引 较小 (整数减一 较大) 较小匣子 较大匣子))
        (否则
         (快排分区循环 比较 列表 基准 (整数加一 索引) 较小 较大 较小匣子 较大匣子))))))

(定义 (列表交换 甲 乙 列表)
  (令 ((值甲 (列表取 甲 列表))
       (值乙 (列表取 乙 列表)))
    (列表存 甲 值乙 列表)
    (列表存 乙 值甲 列表)))

(声明 列表复制排序
  (多态 (甲)
    (-> (-> 甲 甲 整数型) (列表型 甲)
        (列表型 甲))))

(定义 (列表复制排序 比较 列表)
  (令 ((新列表 (列表复制 列表)))
    (列表排序 比较 新列表)
    新列表))
