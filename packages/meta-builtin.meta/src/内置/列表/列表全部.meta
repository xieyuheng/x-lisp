(模块 内置)

(声明 列表全部
  (泛型 (甲)
    (-> (-> 甲 真假型) (列表型 甲)
        真假型)))

(定义 (列表全部 谓词 列表)
  (若则 ((列表为空 列表) 真)
        ((非 (谓词 (首 列表))) 假)
        (否则 (列表全部 谓词 (余 列表)))))

(定义测试 列表全部测试
  (断言 (列表全部 整数为非负 [0 1 2 3]))
  (断言非 (列表全部 整数为非负 [0 1 -1 2 3])))

(声明 列表有些
  (泛型 (甲)
    (-> (-> 甲 真假型) (列表型 甲)
        真假型)))

(定义 (列表有些 谓词 列表)
  (若则 ((列表为空 列表) 假)
        ((谓词 (首 列表)) 真)
        (否则 (列表有些 谓词 (余 列表)))))

(定义测试 列表有些测试
  (断言 (列表有些 整数为非负 [-1 -2 0]))
  (断言非 (列表有些 整数为非负 [-1 -2 -3])))
