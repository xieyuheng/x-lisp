(模块 内置)

(声明 列表全部
  (泛型 (甲)
    (-> (列表型 甲) (-> 甲 真假型)
        真假型)))

(定义 (列表全部 列表 谓词)
  (若则 ((列表为空 列表) 真)
        ((非 (谓词 (首 列表))) 假)
        (否则 (列表全部 (余 列表) 谓词))))

(定义测试 列表全部测试
  (断言 (列表全部 (@列表 0 1 2 3) 整数非负))
  (断言非 (列表全部 (@列表 0 1 -1 2 3) 整数非负)))

(声明 列表有些
  (泛型 (甲)
    (-> (列表型 甲) (-> 甲 真假型)
        真假型)))

(定义 (列表有些 列表 谓词)
  (若则 ((列表为空 列表) 假)
        ((谓词 (首 列表)) 真)
        (否则 (列表有些 (余 列表) 谓词))))

(定义测试 列表有些测试
  (断言 (列表有些 (@列表 -1 -2 0) 整数非负))
  (断言非 (列表有些 (@列表 -1 -2 -3) 整数非负)))
