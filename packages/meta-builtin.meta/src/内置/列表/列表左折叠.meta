(模块 内置)

(声明 列表左折叠
  (泛型 (甲 乙)
    (-> (列表型 甲)
        乙 (-> 乙 甲 乙)
        乙)))

(定义 (列表左折叠 列表 累积值 函数)
  (若 (列表为空 列表)
    累积值
    (列表左折叠
      (列表去首 列表) (函数 累积值 (列表首项 列表))
      函数)))

(定义测试 列表左折叠测试
  (断言相等 10 (列表左折叠 (@列表 1 2 3 4) 0 整数加))
  (断言相等 (@列表 4 3 2 1) (列表左折叠 (@列表 1 2 3 4) (@列表) (交换参数 添))))
