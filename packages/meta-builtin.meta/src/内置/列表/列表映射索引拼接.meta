(模块 内置)

(声明 列表映射索引拼接
  (泛型 (甲 乙)
    (-> (-> 整数型 甲 (列表型 乙))
        (列表型 甲)
        (列表型 乙))))

(定义 (列表映射索引拼接 函数 列表)
  (列表拼接 (列表映射索引 函数 列表)))

(定义测试 列表映射索引拼接测试
  (断言相等 (@列表 0 10 1 20 2 30)
    (列表映射索引拼接 (函 (索引 元素) (@列表 索引 元素)) (@列表 10 20 30)))
  (断言相等
    (@列表 (作序对 0 'a)
     (作序对 0 'a)
     (作序对 1 'b)
     (作序对 1 'b)
     (作序对 2 'c)
     (作序对 2 'c))
    (列表映射索引拼接 (函 (索引 元素) (@列表 (作序对 索引 元素) (作序对 索引 元素)))
      (@列表 'a 'b 'c)))
  (断言相等 (@列表)
    (列表映射索引拼接 (函 (索引 元素) (@列表)) (@列表 1 2 3)))
  (断言相等 (@列表)
    (列表映射索引拼接 (函 (索引 元素) (@列表 索引 元素)) (@列表))))
