(模块 内置)

(声明 列表编号
  (泛型 (甲)
    (-> (列表型 甲) (列表型 (序对型 整数型 甲)))))

(定义 (列表编号 列表)
  (列表编号辅助 列表 0))

(声明 列表编号辅助
  (泛型 (甲)
    (-> (列表型 甲) 整数型 (列表型 (序对型 整数型 甲)))))

(定义 (列表编号辅助 列表 索引)
  (若 (列表为空 列表)
    []
    (添 (作序对 索引 (首 列表))
        (列表编号辅助 (余 列表) (整数加 索引 1)))))

(定义测试 列表编号测试
  (断言相等 (列表编号 []) [])
  (断言相等 (列表编号 ['a]) [(作序对 0 'a)])
  (断言相等 (列表编号 ['a 'b 'c])
    [(作序对 0 'a) (作序对 1 'b) (作序对 2 'c)]))
