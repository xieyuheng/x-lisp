(模块 内置)

(定义测试 列表排序测试
  ;; 整数升序，列表排序 原地修改

  (令 ((列表 (@列表 2 3 1)))
    (列表排序 整数升序比较 列表)
    (断言相等 (@列表 1 2 3) 列表))

  ;; 整数升序，列表复制排序 返回新列表

  (令 ((列表 (@列表 2 3 1)))
    (断言相等 (@列表 1 2 3) (列表复制排序 整数升序比较 列表))
    (断言相等 (@列表 2 3 1) 列表))

  ;; 整数降序

  (断言相等 (@列表 3 2 1) (列表复制排序 整数降序比较 (@列表 2 3 1)))

  ;; 浮点升序

  (断言相等 (@列表 1.0 2.0 3.0) (列表复制排序 浮点升序比较 (@列表 2.0 3.0 1.0)))

  ;; 浮点降序

  (断言相等 (@列表 3.0 2.0 1.0) (列表复制排序 浮点降序比较 (@列表 2.0 3.0 1.0)))

  ;; 文本字典序

  (断言相等
    (@列表 "a" "b" "c")
    (列表复制排序 文本字典序比较 (@列表 "b" "c" "a"))))
