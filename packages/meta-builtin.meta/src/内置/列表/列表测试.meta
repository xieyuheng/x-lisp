(模块 内置)

(定义测试 列表测试
  (打印行 (型例 (列表型 整数型) (@列表 1 2 3)))
  (打印行 (@列表 1 2 3))
  (打印行 '(1 2 3))
  (打印行 (@列表 1 2 3))

  (打印行 (@列表 'a 'b 'c))
  (打印行 '(a b c))

  (断言相等 (@列表 1 2 3) '(1 2 3))
  (断言相等 (@列表 'a 'b 'c) '(a b c))

  (断言相等
    (@列表 (@列表 1 2 3)
     (@列表 4 5 6)
     (@列表 7 8 9))
    (@列表 (@列表 1 2 3)
     (@列表 4 5 6)
     (@列表 7 8 9)))

  (断言不等
    (@列表 (@列表 1 2 3)
     (@列表 4 5 6)
     (@列表 7 8 9))
    (@列表 (@列表 1 2 3)
     (@列表 4 5 6)
     (@列表 7 8 10)))

  (断言 (列表为空 (@列表)))
  (断言不等 (列表为空 (@列表 1)))

  (断言相等 (添 1 (添 2 (添 3 (@列表)))) (@列表 1 2 3))
  (断言相等 (首 (@列表 1 2 3)) 1)
  (断言相等 (余 (@列表 1 2 3)) (@列表 2 3))

  (断言相等 (列表首项 (@列表 1 2 3)) 1)
  (断言相等 (列表去首 (@列表 1 2 3)) (@列表 2 3))

  (断言相等 (列表去末 (@列表 1 2 3)) (@列表 1 2))
  (断言相等 (列表末项 (@列表 1 2 3)) 3)

  (断言相等 (@集合 1 2 3) (列表转集合 (@列表 1 2 3)))

  (断言相等 (列表取 (@列表 1 2 3) 0) 1)
  (断言相等 (列表取 (@列表 1 2 3) 1) 2)
  (断言相等 (列表取 (@列表 1 2 3) 2) 3)

  (断言相等 (列表长度 (@列表)) 0)
  (断言相等 (列表长度 (@列表 1 2 3)) 3)
  (断言相等
    (列表长度 (@列表 (@列表 1 2 3)
               (@列表 4 5 6)
               (@列表 7 8 9)))
    3)

  ;; 函数列表

  (令 ((函数列表 (型例 (列表型 (-> 整数型 整数型))
                   (@列表 (整数加 1) (整数加 2) (整数加 3)))))
    (断言相等 1 ((列表取 函数列表 0) 0))
    (断言相等 2 ((列表取 函数列表 1) 0))
    (断言相等 3 ((列表取 函数列表 2) 0))))

(定义测试 列表复制存测试
  (令 ((列表 (@列表 0 0 0))
       (列表 (列表复制存 列表 0 1))
       (列表 (列表复制存 列表 1 2))
       (列表 (列表复制存 列表 2 3)))
    (断言相等 列表 (@列表 1 2 3)))

  ;; 列表复制存没有副作用：

  (令 ((列表 (@列表 0 0 0)))
    (列表复制存 列表 0 1)
    (列表复制存 列表 1 2)
    (列表复制存 列表 2 3)
    (断言相等 列表 (@列表 0 0 0))))

(定义测试 列表复制反转测试
  (断言相等 (列表复制反转 (@列表 1 2 3)) (@列表 3 2 1)))