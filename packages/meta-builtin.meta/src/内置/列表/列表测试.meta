(模块 内置)

(定义测试 列表测试
  (令 ((列表 (作列表)))
    (列表末入 1 列表)
    (列表末入 2 列表)
    (列表末入 3 列表)
    (打印行 列表))

  (打印行 (型例 (列表型 整数型) [1 2 3]))
  (打印行 [1 2 3])
  (打印行 '(1 2 3))
  (打印行 (@列表 1 2 3))

  (打印行 ['a 'b 'c])
  (打印行 '(a b c))

  (断言相等 [1 2 3] '(1 2 3))
  (断言相等 ['a 'b 'c] '(a b c))

  (断言相等
    [[1 2 3]
     [4 5 6]
     [7 8 9]]
    [[1 2 3]
     [4 5 6]
     [7 8 9]])

  (断言不等
    [[1 2 3]
     [4 5 6]
     [7 8 9]]
    [[1 2 3]
     [4 5 6]
     [7 8 10]])

  (断言 (列表为空 []))
  (断言非 (列表为空 [1]))

  (断言相等 (添 1 (添 2 (添 3 []))) [1 2 3])
  (断言相等 (首 [1 2 3]) 1)
  (断言相等 (余 [1 2 3]) [2 3])

  (断言相等 (列表首项 [1 2 3]) 1)
  (断言相等 (列表去首 [1 2 3]) [2 3])

  (断言相等 (列表去末 [1 2 3]) [1 2])
  (断言相等 (列表末项 [1 2 3]) 3)

  (断言相等 (@集合 1 2 3) (列表转集合 [1 2 3]))

  (断言相等 (列表复制 [1 2 3]) [1 2 3])

  (断言相等 (列表取 0 [1 2 3]) 1)
  (断言相等 (列表取 1 [1 2 3]) 2)
  (断言相等 (列表取 2 [1 2 3]) 3)

  (断言相等 (列表长度 []) 0)
  (断言相等 (列表长度 [1 2 3]) 3)
  (断言相等
    (列表长度 [[1 2 3]
               [4 5 6]
               [7 8 9]])
    3)

  ;; 函数列表

  (令 ((函数列表 (型例 (列表型 (-> 整数型 整数型))
                   [(整数加 1) (整数加 2) (整数加 3)])))
    (断言相等 1 ((列表取 0 函数列表) 0))
    (断言相等 2 ((列表取 1 函数列表) 0))
    (断言相等 3 ((列表取 2 函数列表) 0))))

(定义测试 列表末出测试
  (令 ((列表 [1 2 3]))
    (断言相等 3 (列表末出 列表))
    (断言相等 2 (列表末出 列表))
    (断言相等 1 (列表末出 列表))
    (断言相等 列表 [])))

(定义测试 列表存测试
  (令 ((列表 [0 0 0])
       (列表 (列表复制存 0 1 列表))
       (列表 (列表复制存 1 2 列表))
       (列表 (列表复制存 2 3 列表)))
    (断言相等 列表 [1 2 3]))

  ;; 列表复制存没有副作用：

  (令 ((列表 [0 0 0]))
    (列表复制存 0 1 列表)
    (列表复制存 1 2 列表)
    (列表复制存 2 3 列表)
    (断言相等 列表 [0 0 0]))

  ;; 列表存有副作用：

  (令 ((列表 [0 0 0]))
    (列表存 0 1 列表)
    (列表存 1 2 列表)
    (列表存 2 3 列表)
    (断言相等 列表 [1 2 3])))

(定义测试 列表反转测试
  (断言相等 (列表复制反转 [1 2 3]) [3 2 1]))

(定义测试 列表首出测试
  (令 ((列表 [1 2 3]))
    (断言相等 1 (列表首出 列表))
    (断言相等 2 (列表首出 列表))
    (断言相等 3 (列表首出 列表))
    (断言相等 列表 []))

  (令 ((列表 []))
    (列表首入 3 列表)
    (列表首入 2 列表)
    (列表首入 1 列表)
    (断言相等 列表 [1 2 3])))
