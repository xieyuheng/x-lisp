(模块 内置)

(声明 列表映射拼接
  (泛型 (甲 乙)
    (-> (-> 甲 (列表型 乙))
        (列表型 甲)
        (列表型 乙))))

(定义 (列表映射拼接 函数 数列)
  (列表拼接 (列表映射 函数 数列)))

(定义测试 列表映射拼接测试
  (断言相等 [1 2 3 4]
    (列表映射拼接 (函 (元素) [元素 (整数加一 元素)]) [1 3]))
  (断言相等 []
    (列表映射拼接 (函 (元素) []) [1 2 3]))
  (断言相等 [3 2 1 6 5 4]
    (列表映射拼接 列表复制反转 [[1 2 3] [4 5 6]])))
