(模块 内置)

(声明 列表映射拼接
  (泛型 (甲 乙)
    (-> (列表型 甲)
        (-> 甲 (列表型 乙))
        (列表型 乙))))

(定义 (列表映射拼接 数列 函数)
  (列表拼接 (列表映射 数列 函数)))

(定义测试 列表映射拼接测试
  (断言相等 (@列表 1 2 3 4)
    (列表映射拼接 (@列表 1 3) (函 (元素) (@列表 元素 (整数加一 元素)))))
  (断言相等 (@列表)
    (列表映射拼接 (@列表 1 2 3) (函 (元素) (@列表))))
  (断言相等 (@列表 3 2 1 6 5 4)
    (列表映射拼接 (@列表 (@列表 1 2 3) (@列表 4 5 6)) 列表复制反转)))
