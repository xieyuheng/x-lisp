(模块 内置)

(声明 列表逐项索引
  (多态 (甲 任意)
    (-> (-> 整数型 甲 任意) (列表型 甲) 空型)))

(定义 (列表逐项索引 函数 列表)
  (列表逐项索引辅助 函数 列表 0))

(声明 列表逐项索引辅助
  (多态 (甲 任意)
    (-> (-> 整数型 甲 任意) (列表型 甲) 整数型 空型)))

(定义 (列表逐项索引辅助 函数 列表 索引)
  (若 (列表为空 列表)
    空
    (循序
      (函数 索引 (首 列表))
      (列表逐项索引辅助 函数 (余 列表) (整数加 索引 1)))))

(定义测试 列表逐项索引测试
  (令 ((结果列表 []))
    (列表逐项索引
      (函 (索引 元素)
        (列表末入 (作二元组 索引 元素) 结果列表))
      ['a 'b 'c])
    (断言相等 结果列表
      [(作二元组 0 'a) (作二元组 1 'b) (作二元组 2 'c)])))
