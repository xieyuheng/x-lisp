(模块 内置)

(声明 列表拉链映射
  (泛型 (甲 乙 丙)
    (-> (列表型 甲) (列表型 乙) (-> 甲 乙 丙)
        (列表型 丙))))

(定义 (列表拉链映射 左 右 函数)
  (列表映射
    (列表拉链 左 右)
    (函 (序对)
      (函数 (序对前项 序对)
        (序对后项 序对)))))

(定义测试 列表拉链映射测试
  (断言相等
    (列表拉链映射 (@列表 1 2 3) (@列表 10 20 30) 整数加)
    (@列表 11 22 33))
  (断言相等
    (列表拉链映射 (@列表 '春 '夏 '秋 '冬) (@列表 '生 '长 '收 '藏) 符号追加)
    (@列表 '春生 '夏长 '秋收 '冬藏)))
