(模块 内置)

(声明 列表拉链映射
  (泛型 (甲 乙 丙)
    (-> (-> 甲 乙 丙) (列表型 甲) (列表型 乙)
        (列表型 丙))))

(定义 (列表拉链映射 函数 左 右)
  (列表映射
    (函 (序对)
      (函数 (序对前项 序对)
        (序对后项 序对)))
    (列表拉链 左 右)))

(定义测试 列表拉链映射测试
  (断言相等
    (列表拉链映射 整数加 [1 2 3] [10 20 30])
    [11 22 33])
  (断言相等
    (列表拉链映射 符号追加 ['春 '夏 '秋 '冬] ['生 '长 '收 '藏])
    ['春生 '夏长 '秋收 '冬藏]))
