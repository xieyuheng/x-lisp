(模块 内置)

(声明 遍历散列值
  (泛型 (甲 乙 任意)
    (-> (散列型 甲 乙) (-> 乙 任意)
        空型)))

(定义 (遍历散列值 数据 函数)
  (散列逐值 函数 数据))

(声明 遍历散列键
  (泛型 (甲 乙 任意)
    (-> (散列型 甲 乙) (-> 甲 任意)
        空型)))

(定义 (遍历散列键 数据 函数)
  (散列逐键 函数 数据))

(声明 遍历散列条目
  (泛型 (甲 乙 任意)
    (-> (散列型 甲 乙) (-> (序对型 甲 乙) 任意)
        空型)))

(定义 (遍历散列条目 数据 函数)
  (散列逐条目 函数 数据))

(声明 遍历散列
  (泛型 (甲 乙 任意)
    (-> (散列型 甲 乙) (-> 甲 乙 任意)
        空型)))

(定义 (遍历散列 数据 函数)
  (散列逐项 函数 数据))

(定义测试 遍历散列值测试
  (遍历散列值 (@散列 1 2 3 4) 打印行))

(定义测试 遍历散列键测试
  (遍历散列键 (@散列 1 2 3 4) 打印行))

(定义测试 遍历散列条目测试
  (遍历散列条目 (@散列 1 2 3 4) 打印行))

(定义测试 遍历散列测试
  (遍历散列 (@散列 1 2 3 4)
    (函 (键 值)
      (打印行 键)
      (打印行 值))))
