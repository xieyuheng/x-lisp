(import-all meta-builtin/builtin)

(module auto-currying)

(define (example-eta-expansion)
  (begin
    (meta-builtin/builtin/iadd 1)
    (lambda (curried.1) (meta-builtin/builtin/iadd 1 curried.1))))

(define (adder n) (lambda (x) (meta-builtin/builtin/iadd n x)))

(define (example-early-apply) (begin (adder 1 2) ((adder 1) 2)))