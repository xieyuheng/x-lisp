(import-all meta-builtin/builtin)

(module desugar)

(define (add1 x) (iadd 1 x))

(define (double x) (iadd x x))

(define (example-let-star) (let ((x 1)) (let ((y (iadd x 1))) (iadd x y))))

(define (example-cond)
  (if (equal? 1 1)
    1
    (if meta-builtin/builtin/true
      2
      (meta-builtin/builtin/error "cond mismatch"))))

(define (example-begin) (begin 1 (begin 2 3)))

(define (example-when)
  (if true (begin 1 meta-builtin/builtin/void) meta-builtin/builtin/void))

(define (example-unless)
  (if false meta-builtin/builtin/void (begin 2 meta-builtin/builtin/void)))

(define (example-and a b) (if a b meta-builtin/builtin/false))

(define (example-or a b) (if a meta-builtin/builtin/true b))

(define (example-pipe) (double (add1 5)))

(define (example-chain) ((lambda (target) (double (add1 target))) 5))

(define (example-compose) ((lambda (target) (add1 (double target))) 5))

(define (example-letrec)
  (let ((even?.1 (meta-builtin/builtin/make-box)))
    (let ((odd?.1 (meta-builtin/builtin/make-box)))
      (let ((even? even?.1))
        (let ((odd? odd?.1))
          (let
              ((even?.value.1
                (lambda (n)
                  (if (equal? n 0)
                    true
                    ((meta-builtin/builtin/box-get odd?) (isub n 1))))))
            (let
                ((odd?.value.1
                  (lambda (n)
                    (if (equal? n 0)
                      false
                      ((meta-builtin/builtin/box-get even?) (isub n 1))))))
              (let ((even?.value even?.value.1))
                (let ((odd?.value odd?.value.1))
                  (begin
                    (meta-builtin/builtin/box-put! even?.value even?)
                    (begin (meta-builtin/builtin/box-put! odd?.value odd?) void)))))))))))

(define (example-letrec-star)
  (let ((even?.1 (meta-builtin/builtin/make-box)))
    (let ((odd?.1 (meta-builtin/builtin/make-box)))
      (let ((even? even?.1))
        (let ((odd? odd?.1))
          (begin
            (meta-builtin/builtin/box-put!
             (lambda (n)
               (if (equal? n 0)
                 true
                 ((meta-builtin/builtin/box-get odd?) (isub n 1))))
             even?)
            (begin
              (meta-builtin/builtin/box-put!
               (lambda (n)
                 (if (equal? n 0)
                   false
                   ((meta-builtin/builtin/box-get even?) (isub n 1))))
               odd?)
              void)))))))

(define (example-local-define)
  (let ((even?.1 (meta-builtin/builtin/make-box)))
    (let ((odd?.1 (meta-builtin/builtin/make-box)))
      (let ((even? even?.1))
        (let ((odd? odd?.1))
          (begin
            (meta-builtin/builtin/box-put!
             (lambda (n)
               (if (equal? n 0)
                 true
                 ((meta-builtin/builtin/box-get odd?) (isub n 1))))
             even?)
            (begin
              (meta-builtin/builtin/box-put!
               (lambda (n)
                 (if (equal? n 0)
                   false
                   ((meta-builtin/builtin/box-get even?) (isub n 1))))
               odd?)
              void)))))))