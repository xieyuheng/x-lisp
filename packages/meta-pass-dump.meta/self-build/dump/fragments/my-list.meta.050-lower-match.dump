(import-all meta-builtin/builtin)

(module my-list)

(define-algebraic-type (my-list-t E)
  ((nil) is-nil)
  ((li (head E) (tail (my-list-t E)))
   is-li
   (head li-head li-put-head)
   (tail li-tail li-put-tail)))

(admit nil (polymorphic (E) (-> (my-list-t E))))

(define (nil) ['nil])

(admit is-nil (polymorphic (E) (-> (my-list-t E) meta-builtin/builtin/bool-t)))

(define (is-nil value)
  (and (meta-builtin/builtin/is-list value)
       (meta-builtin/builtin/equal (meta-builtin/builtin/list-length value) 1)
       (meta-builtin/builtin/equal (meta-builtin/builtin/list-head value) 'nil)))

(admit li (polymorphic (E) (-> E (my-list-t E) (my-list-t E))))

(define (li head tail) ['li head tail])

(admit is-li (polymorphic (E) (-> (my-list-t E) meta-builtin/builtin/bool-t)))

(define (is-li value)
  (and (meta-builtin/builtin/is-list value)
       (meta-builtin/builtin/equal (meta-builtin/builtin/list-length value) 3)
       (meta-builtin/builtin/equal (meta-builtin/builtin/list-head value) 'li)))

(admit li-head (polymorphic (E) (-> (my-list-t E) E)))

(define (li-head target) (meta-builtin/builtin/list-get 1 target))

(admit li-put-head (polymorphic (E) (-> E (my-list-t E) (my-list-t E))))

(define (li-put-head value target)
  (begin (meta-builtin/builtin/list-put 1 value target) target))

(admit li-tail (polymorphic (E) (-> (my-list-t E) (my-list-t E))))

(define (li-tail target) (meta-builtin/builtin/list-get 2 target))

(admit li-put-tail
  (polymorphic (E) (-> (my-list-t E) (my-list-t E) (my-list-t E))))

(define (li-put-tail value target)
  (begin (meta-builtin/builtin/list-put 2 value target) target))

(define (my-list-head list)
  (cond
    ((self/my-list/is-nil list)
     (meta-builtin/builtin/error-with-location
      (@string "pattern mismatch on:" " " (meta-builtin/builtin/format list))
      (meta-builtin/builtin/make-source-location
       "src/my-list.meta"
       (meta-builtin/builtin/make-source-span
        (meta-builtin/builtin/make-source-position 123 7 3)
        (meta-builtin/builtin/make-source-position 128 7 8)))))
    ((self/my-list/is-li list)
     (let ((tail (self/my-list/li-tail list)))
       (let ((head (self/my-list/li-head list))) head)))))

(define (my-list-tail list)
  (cond
    ((self/my-list/is-nil list)
     (meta-builtin/builtin/error-with-location
      (@string "pattern mismatch on:" " " (meta-builtin/builtin/format list))
      (meta-builtin/builtin/make-source-location
       "src/my-list.meta"
       (meta-builtin/builtin/make-source-span
        (meta-builtin/builtin/make-source-position 194 11 3)
        (meta-builtin/builtin/make-source-position 199 11 8)))))
    ((self/my-list/is-li list)
     (let ((tail (self/my-list/li-tail list)))
       (let ((head (self/my-list/li-head list))) tail)))))

(define (my-list-length list)
  (cond
    ((self/my-list/is-nil list) 0)
    ((self/my-list/is-li list)
     (let ((tail (self/my-list/li-tail list)))
       (let ((head (self/my-list/li-head list))) (iadd 1 (my-list-length tail)))))))

(define (my-list-map f list)
  (cond
    ((self/my-list/is-nil list) (nil))
    ((self/my-list/is-li list)
     (let ((tail (self/my-list/li-tail list)))
       (let ((head (self/my-list/li-head list)))
         (li (f head) (my-list-map f tail)))))))

(define (my-list-append left right)
  (cond
    ((self/my-list/is-nil left) right)
    ((self/my-list/is-li left)
     (let ((tail (self/my-list/li-tail left)))
       (let ((head (self/my-list/li-head left)))
         (li head (my-list-append tail right)))))))

(define (my-list-zip-map f list1 list2)
  (cond
    ((self/my-list/is-nil list1) (let ((_ list2)) (nil)))
    ((self/my-list/is-li list1)
     (cond
       ((self/my-list/is-nil list2)
        (let ((tail1 (self/my-list/li-tail list1)))
          (let ((head1 (self/my-list/li-head list1))) (nil))))
       ((self/my-list/is-li list2)
        (let ((tail2 (self/my-list/li-tail list2)))
          (let ((head2 (self/my-list/li-head list2)))
            (let ((tail1 (self/my-list/li-tail list1)))
              (let ((head1 (self/my-list/li-head list1)))
                (li (f head1 head2) (my-list-zip-map f tail1 tail2)))))))))))

(define (my-list-zip-map-2 f list1 list2)
  (cond
    ((self/my-list/is-nil list1) (let ((_ list2)) (nil)))
    ((self/my-list/is-li list1)
     (cond
       ((self/my-list/is-nil list2) (let ((_ list1)) (nil)))
       ((self/my-list/is-li list2)
        (cond
          ((self/my-list/is-nil list1)
           (meta-builtin/builtin/error-with-location
            (@string
              "pattern mismatch on:"
              " "
              (meta-builtin/builtin/format list1)
              " "
              (meta-builtin/builtin/format list2))
            (meta-builtin/builtin/make-source-location
             "src/my-list.meta"
             (meta-builtin/builtin/make-source-span
              (meta-builtin/builtin/make-source-position 873 37 3)
              (meta-builtin/builtin/make-source-position 884 37 14)))))
          ((self/my-list/is-li list1)
           (cond
             ((self/my-list/is-nil list2)
              (meta-builtin/builtin/error-with-location
               (@string
                 "pattern mismatch on:"
                 " "
                 (meta-builtin/builtin/format list1)
                 " "
                 (meta-builtin/builtin/format list2))
               (meta-builtin/builtin/make-source-location
                "src/my-list.meta"
                (meta-builtin/builtin/make-source-span
                 (meta-builtin/builtin/make-source-position 873 37 3)
                 (meta-builtin/builtin/make-source-position 884 37 14)))))
             ((self/my-list/is-li list2)
              (let ((tail2 (self/my-list/li-tail list2)))
                (let ((head2 (self/my-list/li-head list2)))
                  (let ((tail1 (self/my-list/li-tail list1)))
                    (let ((head1 (self/my-list/li-head list1)))
                      (li (f head1 head2) (my-list-zip-map-2 f tail1 tail2)))))))))))))))

(define (my-list-adjacent-dedup list)
  (cond
    ((self/my-list/is-nil list) (nil))
    ((self/my-list/is-li list)
     (cond
       ((self/my-list/is-nil (self/my-list/li-tail list))
        (let ((head (self/my-list/li-head list))) (li head (nil))))
       ((self/my-list/is-li (self/my-list/li-tail list))
        (let ((rest (self/my-list/li-tail (self/my-list/li-tail list))))
          (let ((second (self/my-list/li-head (self/my-list/li-tail list))))
            (let ((first (self/my-list/li-head list)))
              (if (equal first second)
                (my-list-adjacent-dedup (li second rest))
                (li first (my-list-adjacent-dedup (li second rest))))))))))))