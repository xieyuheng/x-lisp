(import-all meta-builtin/builtin)

(module lambda)

(define-algebraic-type term-t
  ((var-term (name symbol-t)) is-var-term (name var-term-name var-term-put-name))
  ((apply-term (target term-t) (arg term-t))
   is-apply-term
   (target apply-term-target apply-term-put-target)
   (arg apply-term-arg apply-term-put-arg))
  ((lambda-term (parameter symbol-t) (body term-t))
   is-lambda-term
   (parameter lambda-term-parameter lambda-term-put-parameter)
   (body lambda-term-body lambda-term-put-body))
  ((let-term (name symbol-t) (rhs term-t) (body term-t))
   is-let-term
   (name let-term-name let-term-put-name)
   (rhs let-term-rhs let-term-put-rhs)
   (body let-term-body let-term-put-body)))

(admit var-term (-> symbol-t term-t))

(define (var-term name)
  (let ((array (meta-builtin/builtin/make-array)))
    (begin
      (meta-builtin/builtin/array-push array var-term)
      (begin (meta-builtin/builtin/array-push array name) array))))

(admit is-var-term (-> term-t meta-builtin/builtin/bool-t))

(define (is-var-term value)
  (if (meta-builtin/builtin/is-array value)
    (if (meta-builtin/builtin/equal (meta-builtin/builtin/array-length value) 2)
      (meta-builtin/builtin/equal
       (meta-builtin/builtin/array-get value 0)
       var-term)
      meta-builtin/builtin/false)
    meta-builtin/builtin/false))

(admit var-term-name (-> term-t symbol-t))

(define (var-term-name target) (meta-builtin/builtin/array-get target 1))

(admit var-term-put-name (-> term-t symbol-t term-t))

(define (var-term-put-name target value)
  (begin (meta-builtin/builtin/array-put target 1 value) target))

(admit apply-term (-> term-t term-t term-t))

(define (apply-term target arg)
  (let ((array (meta-builtin/builtin/make-array)))
    (begin
      (meta-builtin/builtin/array-push array apply-term)
      (begin
        (meta-builtin/builtin/array-push array target)
        (begin (meta-builtin/builtin/array-push array arg) array)))))

(admit is-apply-term (-> term-t meta-builtin/builtin/bool-t))

(define (is-apply-term value)
  (if (meta-builtin/builtin/is-array value)
    (if (meta-builtin/builtin/equal (meta-builtin/builtin/array-length value) 3)
      (meta-builtin/builtin/equal
       (meta-builtin/builtin/array-get value 0)
       apply-term)
      meta-builtin/builtin/false)
    meta-builtin/builtin/false))

(admit apply-term-target (-> term-t term-t))

(define (apply-term-target target) (meta-builtin/builtin/array-get target 1))

(admit apply-term-put-target (-> term-t term-t term-t))

(define (apply-term-put-target target value)
  (begin (meta-builtin/builtin/array-put target 1 value) target))

(admit apply-term-arg (-> term-t term-t))

(define (apply-term-arg target) (meta-builtin/builtin/array-get target 2))

(admit apply-term-put-arg (-> term-t term-t term-t))

(define (apply-term-put-arg target value)
  (begin (meta-builtin/builtin/array-put target 2 value) target))

(admit lambda-term (-> symbol-t term-t term-t))

(define (lambda-term parameter body)
  (let ((array (meta-builtin/builtin/make-array)))
    (begin
      (meta-builtin/builtin/array-push array lambda-term)
      (begin
        (meta-builtin/builtin/array-push array parameter)
        (begin (meta-builtin/builtin/array-push array body) array)))))

(admit is-lambda-term (-> term-t meta-builtin/builtin/bool-t))

(define (is-lambda-term value)
  (if (meta-builtin/builtin/is-array value)
    (if (meta-builtin/builtin/equal (meta-builtin/builtin/array-length value) 3)
      (meta-builtin/builtin/equal
       (meta-builtin/builtin/array-get value 0)
       lambda-term)
      meta-builtin/builtin/false)
    meta-builtin/builtin/false))

(admit lambda-term-parameter (-> term-t symbol-t))

(define (lambda-term-parameter target)
  (meta-builtin/builtin/array-get target 1))

(admit lambda-term-put-parameter (-> term-t symbol-t term-t))

(define (lambda-term-put-parameter target value)
  (begin (meta-builtin/builtin/array-put target 1 value) target))

(admit lambda-term-body (-> term-t term-t))

(define (lambda-term-body target) (meta-builtin/builtin/array-get target 2))

(admit lambda-term-put-body (-> term-t term-t term-t))

(define (lambda-term-put-body target value)
  (begin (meta-builtin/builtin/array-put target 2 value) target))

(admit let-term (-> symbol-t term-t term-t term-t))

(define (let-term name rhs body)
  (let ((array (meta-builtin/builtin/make-array)))
    (begin
      (meta-builtin/builtin/array-push array let-term)
      (begin
        (meta-builtin/builtin/array-push array name)
        (begin
          (meta-builtin/builtin/array-push array rhs)
          (begin (meta-builtin/builtin/array-push array body) array))))))

(admit is-let-term (-> term-t meta-builtin/builtin/bool-t))

(define (is-let-term value)
  (if (meta-builtin/builtin/is-array value)
    (if (meta-builtin/builtin/equal (meta-builtin/builtin/array-length value) 4)
      (meta-builtin/builtin/equal
       (meta-builtin/builtin/array-get value 0)
       let-term)
      meta-builtin/builtin/false)
    meta-builtin/builtin/false))

(admit let-term-name (-> term-t symbol-t))

(define (let-term-name target) (meta-builtin/builtin/array-get target 1))

(admit let-term-put-name (-> term-t symbol-t term-t))

(define (let-term-put-name target value)
  (begin (meta-builtin/builtin/array-put target 1 value) target))

(admit let-term-rhs (-> term-t term-t))

(define (let-term-rhs target) (meta-builtin/builtin/array-get target 2))

(admit let-term-put-rhs (-> term-t term-t term-t))

(define (let-term-put-rhs target value)
  (begin (meta-builtin/builtin/array-put target 2 value) target))

(admit let-term-body (-> term-t term-t))

(define (let-term-body target) (meta-builtin/builtin/array-get target 3))

(admit let-term-put-body (-> term-t term-t term-t))

(define (let-term-put-body target value)
  (begin (meta-builtin/builtin/array-put target 3 value) target))

(define-opaque-type env-t (hash-t symbol-t value-t)
  (empty-env (-> env-t))
  (extend-env (-> env-t symbol-t value-t env-t))
  (env-lookup (-> env-t symbol-t (maybe-t value-t))))

(define empty-env make-hash)

(define extend-env hash-copy-put)

(define env-lookup hash-get-maybe)

(define-algebraic-type value-t
  ((closure-value (env env-t) (parameter symbol-t) (body term-t))
   is-closure-value
   (env closure-value-env closure-value-put-env)
   (parameter closure-value-parameter closure-value-put-parameter)
   (body closure-value-body closure-value-put-body)))

(admit closure-value (-> env-t symbol-t term-t value-t))

(define (closure-value env parameter body)
  (let ((array (meta-builtin/builtin/make-array)))
    (begin
      (meta-builtin/builtin/array-push array closure-value)
      (begin
        (meta-builtin/builtin/array-push array env)
        (begin
          (meta-builtin/builtin/array-push array parameter)
          (begin (meta-builtin/builtin/array-push array body) array))))))

(admit is-closure-value (-> value-t meta-builtin/builtin/bool-t))

(define (is-closure-value value)
  (if (meta-builtin/builtin/is-array value)
    (if (meta-builtin/builtin/equal (meta-builtin/builtin/array-length value) 4)
      (meta-builtin/builtin/equal
       (meta-builtin/builtin/array-get value 0)
       closure-value)
      meta-builtin/builtin/false)
    meta-builtin/builtin/false))

(admit closure-value-env (-> value-t env-t))

(define (closure-value-env target) (meta-builtin/builtin/array-get target 1))

(admit closure-value-put-env (-> value-t env-t value-t))

(define (closure-value-put-env target value)
  (begin (meta-builtin/builtin/array-put target 1 value) target))

(admit closure-value-parameter (-> value-t symbol-t))

(define (closure-value-parameter target)
  (meta-builtin/builtin/array-get target 2))

(admit closure-value-put-parameter (-> value-t symbol-t value-t))

(define (closure-value-put-parameter target value)
  (begin (meta-builtin/builtin/array-put target 2 value) target))

(admit closure-value-body (-> value-t term-t))

(define (closure-value-body target) (meta-builtin/builtin/array-get target 3))

(admit closure-value-put-body (-> value-t term-t value-t))

(define (closure-value-put-body target value)
  (begin (meta-builtin/builtin/array-put target 3 value) target))

(define (evaluate term env)
  (if (self/lambda/is-var-term term)
    (let ((name (self/lambda/var-term-name term)))
      (if (meta-builtin/builtin/is-just (env-lookup env name))
        (let ((value (meta-builtin/builtin/just-value (env-lookup env name))))
          value)
        (if (meta-builtin/builtin/is-nothing (env-lookup env name))
          (error "undefined name")
          (meta-builtin/builtin/error "cond mismatch"))))
    (if (self/lambda/is-apply-term term)
      (let ((arg (self/lambda/apply-term-arg term)))
        (let ((target (self/lambda/apply-term-target term)))
          (apply (evaluate target env) (evaluate arg env))))
      (if (self/lambda/is-lambda-term term)
        (let ((body (self/lambda/lambda-term-body term)))
          (let ((parameter (self/lambda/lambda-term-parameter term)))
            (closure-value env parameter body)))
        (if (self/lambda/is-let-term term)
          (let ((body (self/lambda/let-term-body term)))
            (let ((rhs (self/lambda/let-term-rhs term)))
              (let ((name (self/lambda/let-term-name term)))
                (let ((env (extend-env env name (evaluate rhs env))))
                  (evaluate body env)))))
          (meta-builtin/builtin/error "cond mismatch"))))))

(define (apply target arg)
  (if (self/lambda/is-closure-value target)
    (let ((body (self/lambda/closure-value-body target)))
      (let ((parameter (self/lambda/closure-value-parameter target)))
        (let ((env (self/lambda/closure-value-env target)))
          (evaluate body (extend-env env parameter arg)))))
    (meta-builtin/builtin/error "cond mismatch")))