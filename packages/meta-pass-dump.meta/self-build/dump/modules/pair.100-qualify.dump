(claim pair-t
  (-> meta-builtin/builtin/type-t
      meta-builtin/builtin/type-t
      meta-builtin/builtin/type-t))

(define-enum (pair-t A B) (make-pair (first A) (second B)))

(claim make-pair (polymorphic (A B) (-> A B (pair-t A B))))

(define (make-pair first second)
  (let ((list (meta-builtin/builtin/make-list)))
    (begin
      (meta-builtin/builtin/list-push! make-pair list)
      (begin
        (meta-builtin/builtin/list-push! first list)
        (begin (meta-builtin/builtin/list-push! second list) list)))))

(claim is-pair
  (polymorphic (A B) (-> (pair-t A B) meta-builtin/builtin/bool-t)))

(define (is-pair value)
  (if (meta-builtin/builtin/is-list value)
    (if (meta-builtin/builtin/equal (meta-builtin/builtin/list-length value) 3)
      (meta-builtin/builtin/equal
       (meta-builtin/builtin/list-head value)
       make-pair)
      meta-builtin/builtin/false)
    meta-builtin/builtin/false))

(claim pair-first (polymorphic (A B) (-> (pair-t A B) A)))

(define (pair-first target) (meta-builtin/builtin/list-get 1 target))

(claim pair-put-first! (polymorphic (A B) (-> A (pair-t A B) (pair-t A B))))

(define (pair-put-first! value target)
  (begin (meta-builtin/builtin/list-put! 1 value target) target))

(claim pair-second (polymorphic (A B) (-> (pair-t A B) B)))

(define (pair-second target) (meta-builtin/builtin/list-get 2 target))

(claim pair-put-second! (polymorphic (A B) (-> B (pair-t A B) (pair-t A B))))

(define (pair-put-second! value target)
  (begin (meta-builtin/builtin/list-put! 2 value target) target))

(define (pair-swap p)
  (if (self/pair/is-pair p)
    (let ((b (self/pair/pair-second p)))
      (let ((a (self/pair/pair-first p))) (self/pair/make-pair b a)))
    (meta-builtin/builtin/error "cond mismatch")))