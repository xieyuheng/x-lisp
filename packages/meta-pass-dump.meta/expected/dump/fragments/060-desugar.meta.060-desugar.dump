(import-all meta-builtin/builtin)

(module 060-desugar)

(define (add1 x) (iadd 1 x))

(define (double x) (iadd x x))

(define (example-let-star) (begin (= x 1) (= y (iadd x 1)) (iadd x y)))

(define (example-cond)
  (if (equal? 1 1) 1
      (if meta-builtin/builtin/true 2
          (meta-builtin/builtin/error "cond mismatch"))))

(define (example-begin) (begin 1 2 3))

(define (example-when)
  (if true (begin 1 meta-builtin/builtin/void) meta-builtin/builtin/void))

(define (example-unless)
  (if false meta-builtin/builtin/void (begin 2 meta-builtin/builtin/void)))

(define (example-and a b) (if a b meta-builtin/builtin/false))

(define (example-or a b) (if a meta-builtin/builtin/true b))

(define (example-pipe) (double (add1 5)))

(define (example-chain) ((lambda (target) (double (add1 target))) 5))

(define (example-compose) ((lambda (target) (add1 (double target))) 5))

(define (example-letrec)
  (begin
    (= even?.1 (meta-builtin/builtin/make-box))
    (= odd?.1 (meta-builtin/builtin/make-box))
    (= even? even?.1)
    (= odd? odd?.1)
    (= even?.value.1
       (lambda (n)
         (if (equal? n 0) true ((meta-builtin/builtin/box-get odd?) (isub n 1)))))
    (= odd?.value.1
       (lambda (n)
         (if (equal? n 0) false
             ((meta-builtin/builtin/box-get even?) (isub n 1)))))
    (= even?.value even?.value.1)
    (= odd?.value odd?.value.1)
    (meta-builtin/builtin/box-put! even?.value even?)
    (meta-builtin/builtin/box-put! odd?.value odd?)
    void))

(define (example-letrec-star)
  (begin
    (= even?.1 (meta-builtin/builtin/make-box))
    (= odd?.1 (meta-builtin/builtin/make-box))
    (= even? even?.1)
    (= odd? odd?.1)
    (meta-builtin/builtin/box-put!
     (lambda (n)
       (if (equal? n 0) true ((meta-builtin/builtin/box-get odd?) (isub n 1))))
     even?)
    (meta-builtin/builtin/box-put!
     (lambda (n)
       (if (equal? n 0) false ((meta-builtin/builtin/box-get even?) (isub n 1))))
     odd?)
    void))

(define (example-local-define)
  (begin
    (= even?.1 (meta-builtin/builtin/make-box))
    (= odd?.1 (meta-builtin/builtin/make-box))
    (= even? even?.1)
    (= odd? odd?.1)
    (meta-builtin/builtin/box-put!
     (lambda (n)
       (if (equal? n 0) true ((meta-builtin/builtin/box-get odd?) (isub n 1))))
     even?)
    (meta-builtin/builtin/box-put!
     (lambda (n)
       (if (equal? n 0) false ((meta-builtin/builtin/box-get even?) (isub n 1))))
     odd?)
    void))