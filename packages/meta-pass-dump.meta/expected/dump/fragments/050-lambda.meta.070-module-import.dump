(import-all meta-builtin/builtin)

(module 050-lambda)

(define-algebraic-type exp-t
  ((var-exp (name meta-builtin/builtin/symbol-t))
   var-exp?
   (name var-exp-name var-exp-put-name!))
  ((apply-exp (target exp-t) (arg exp-t))
   apply-exp?
   (target apply-exp-target apply-exp-put-target!)
   (arg apply-exp-arg apply-exp-put-arg!))
  ((lambda-exp (parameter meta-builtin/builtin/symbol-t) (body exp-t))
   lambda-exp?
   (parameter lambda-exp-parameter lambda-exp-put-parameter!)
   (body lambda-exp-body lambda-exp-put-body!))
  ((let-exp (name meta-builtin/builtin/symbol-t) (rhs exp-t) (body exp-t))
   let-exp?
   (name let-exp-name let-exp-put-name!)
   (rhs let-exp-rhs let-exp-put-rhs!)
   (body let-exp-body let-exp-put-body!)))

(admit var-exp (-> meta-builtin/builtin/symbol-t exp-t))

(define (var-exp name)
  (begin
    (= list (meta-builtin/builtin/make-list))
    (meta-builtin/builtin/list-push! var-exp list)
    (meta-builtin/builtin/list-push! name list)
    list))

(admit var-exp? (-> exp-t meta-builtin/builtin/bool-t))

(define (var-exp? value)
  (if (meta-builtin/builtin/list? value)
    (if (meta-builtin/builtin/equal? (meta-builtin/builtin/list-length value) 2)
      (meta-builtin/builtin/equal?
       (meta-builtin/builtin/list-head value)
       var-exp)
      meta-builtin/builtin/false)
    meta-builtin/builtin/false))

(admit var-exp-name (-> exp-t meta-builtin/builtin/symbol-t))

(define (var-exp-name target) (meta-builtin/builtin/list-get 1 target))

(admit var-exp-put-name! (-> meta-builtin/builtin/symbol-t exp-t exp-t))

(define (var-exp-put-name! value target)
  (meta-builtin/builtin/list-put! 1 value target))

(admit apply-exp (-> exp-t exp-t exp-t))

(define (apply-exp target arg)
  (begin
    (= list (meta-builtin/builtin/make-list))
    (meta-builtin/builtin/list-push! apply-exp list)
    (meta-builtin/builtin/list-push! target list)
    (meta-builtin/builtin/list-push! arg list)
    list))

(admit apply-exp? (-> exp-t meta-builtin/builtin/bool-t))

(define (apply-exp? value)
  (if (meta-builtin/builtin/list? value)
    (if (meta-builtin/builtin/equal? (meta-builtin/builtin/list-length value) 3)
      (meta-builtin/builtin/equal?
       (meta-builtin/builtin/list-head value)
       apply-exp)
      meta-builtin/builtin/false)
    meta-builtin/builtin/false))

(admit apply-exp-target (-> exp-t exp-t))

(define (apply-exp-target target) (meta-builtin/builtin/list-get 1 target))

(admit apply-exp-put-target! (-> exp-t exp-t exp-t))

(define (apply-exp-put-target! value target)
  (meta-builtin/builtin/list-put! 1 value target))

(admit apply-exp-arg (-> exp-t exp-t))

(define (apply-exp-arg target) (meta-builtin/builtin/list-get 2 target))

(admit apply-exp-put-arg! (-> exp-t exp-t exp-t))

(define (apply-exp-put-arg! value target)
  (meta-builtin/builtin/list-put! 2 value target))

(admit lambda-exp (-> meta-builtin/builtin/symbol-t exp-t exp-t))

(define (lambda-exp parameter body)
  (begin
    (= list (meta-builtin/builtin/make-list))
    (meta-builtin/builtin/list-push! lambda-exp list)
    (meta-builtin/builtin/list-push! parameter list)
    (meta-builtin/builtin/list-push! body list)
    list))

(admit lambda-exp? (-> exp-t meta-builtin/builtin/bool-t))

(define (lambda-exp? value)
  (if (meta-builtin/builtin/list? value)
    (if (meta-builtin/builtin/equal? (meta-builtin/builtin/list-length value) 3)
      (meta-builtin/builtin/equal?
       (meta-builtin/builtin/list-head value)
       lambda-exp)
      meta-builtin/builtin/false)
    meta-builtin/builtin/false))

(admit lambda-exp-parameter (-> exp-t meta-builtin/builtin/symbol-t))

(define (lambda-exp-parameter target) (meta-builtin/builtin/list-get 1 target))

(admit lambda-exp-put-parameter! (-> meta-builtin/builtin/symbol-t exp-t exp-t))

(define (lambda-exp-put-parameter! value target)
  (meta-builtin/builtin/list-put! 1 value target))

(admit lambda-exp-body (-> exp-t exp-t))

(define (lambda-exp-body target) (meta-builtin/builtin/list-get 2 target))

(admit lambda-exp-put-body! (-> exp-t exp-t exp-t))

(define (lambda-exp-put-body! value target)
  (meta-builtin/builtin/list-put! 2 value target))

(admit let-exp (-> meta-builtin/builtin/symbol-t exp-t exp-t exp-t))

(define (let-exp name rhs body)
  (begin
    (= list (meta-builtin/builtin/make-list))
    (meta-builtin/builtin/list-push! let-exp list)
    (meta-builtin/builtin/list-push! name list)
    (meta-builtin/builtin/list-push! rhs list)
    (meta-builtin/builtin/list-push! body list)
    list))

(admit let-exp? (-> exp-t meta-builtin/builtin/bool-t))

(define (let-exp? value)
  (if (meta-builtin/builtin/list? value)
    (if (meta-builtin/builtin/equal? (meta-builtin/builtin/list-length value) 4)
      (meta-builtin/builtin/equal?
       (meta-builtin/builtin/list-head value)
       let-exp)
      meta-builtin/builtin/false)
    meta-builtin/builtin/false))

(admit let-exp-name (-> exp-t meta-builtin/builtin/symbol-t))

(define (let-exp-name target) (meta-builtin/builtin/list-get 1 target))

(admit let-exp-put-name! (-> meta-builtin/builtin/symbol-t exp-t exp-t))

(define (let-exp-put-name! value target)
  (meta-builtin/builtin/list-put! 1 value target))

(admit let-exp-rhs (-> exp-t exp-t))

(define (let-exp-rhs target) (meta-builtin/builtin/list-get 2 target))

(admit let-exp-put-rhs! (-> exp-t exp-t exp-t))

(define (let-exp-put-rhs! value target)
  (meta-builtin/builtin/list-put! 2 value target))

(admit let-exp-body (-> exp-t exp-t))

(define (let-exp-body target) (meta-builtin/builtin/list-get 3 target))

(admit let-exp-put-body! (-> exp-t exp-t exp-t))

(define (let-exp-put-body! value target)
  (meta-builtin/builtin/list-put! 3 value target))

(define-opaque-type env-t
    (meta-builtin/builtin/hash-t meta-builtin/builtin/symbol-t value-t)
  (empty-env (-> env-t))
  (extend-env (-> meta-builtin/builtin/symbol-t value-t env-t env-t))
  (env-lookup
   (-> meta-builtin/builtin/symbol-t
       env-t
       (meta-builtin/builtin/maybe-t value-t))))

(define empty-env meta-builtin/builtin/make-hash)

(define extend-env meta-builtin/builtin/hash-put)

(define env-lookup meta-builtin/builtin/hash-get-maybe)

(define-algebraic-type value-t
  ((closure-value
    (env env-t)
    (parameter meta-builtin/builtin/symbol-t)
    (body exp-t))
   closure-value?
   (env closure-value-env closure-value-put-env!)
   (parameter closure-value-parameter closure-value-put-parameter!)
   (body closure-value-body closure-value-put-body!)))

(admit closure-value (-> env-t meta-builtin/builtin/symbol-t exp-t value-t))

(define (closure-value env parameter body)
  (begin
    (= list (meta-builtin/builtin/make-list))
    (meta-builtin/builtin/list-push! closure-value list)
    (meta-builtin/builtin/list-push! env list)
    (meta-builtin/builtin/list-push! parameter list)
    (meta-builtin/builtin/list-push! body list)
    list))

(admit closure-value? (-> value-t meta-builtin/builtin/bool-t))

(define (closure-value? value)
  (if (meta-builtin/builtin/list? value)
    (if (meta-builtin/builtin/equal? (meta-builtin/builtin/list-length value) 4)
      (meta-builtin/builtin/equal?
       (meta-builtin/builtin/list-head value)
       closure-value)
      meta-builtin/builtin/false)
    meta-builtin/builtin/false))

(admit closure-value-env (-> value-t env-t))

(define (closure-value-env target) (meta-builtin/builtin/list-get 1 target))

(admit closure-value-put-env! (-> env-t value-t value-t))

(define (closure-value-put-env! value target)
  (meta-builtin/builtin/list-put! 1 value target))

(admit closure-value-parameter (-> value-t meta-builtin/builtin/symbol-t))

(define (closure-value-parameter target)
  (meta-builtin/builtin/list-get 2 target))

(admit closure-value-put-parameter!
  (-> meta-builtin/builtin/symbol-t value-t value-t))

(define (closure-value-put-parameter! value target)
  (meta-builtin/builtin/list-put! 2 value target))

(admit closure-value-body (-> value-t exp-t))

(define (closure-value-body target) (meta-builtin/builtin/list-get 3 target))

(admit closure-value-put-body! (-> exp-t value-t value-t))

(define (closure-value-put-body! value target)
  (meta-builtin/builtin/list-put! 3 value target))

(define (evaluate exp env)
  (if (self/050-lambda/var-exp? exp)
    (begin
      (= name (self/050-lambda/var-exp-name exp))
      (if (meta-builtin/builtin/just? (env-lookup name env))
        (begin
          (= value (meta-builtin/builtin/just-value (env-lookup name env)))
          value)
        (if (meta-builtin/builtin/nothing? (env-lookup name env))
          (meta-builtin/builtin/error "undefined name")
          (meta-builtin/builtin/error "cond mismatch"))))
    (if (self/050-lambda/apply-exp? exp)
      (begin
        (= arg (self/050-lambda/apply-exp-arg exp))
        (= target (self/050-lambda/apply-exp-target exp))
        (apply (evaluate target env) (evaluate arg env)))
      (if (self/050-lambda/lambda-exp? exp)
        (begin
          (= body (self/050-lambda/lambda-exp-body exp))
          (= parameter (self/050-lambda/lambda-exp-parameter exp))
          (closure-value env parameter body))
        (if (self/050-lambda/let-exp? exp)
          (begin
            (= body (self/050-lambda/let-exp-body exp))
            (= rhs (self/050-lambda/let-exp-rhs exp))
            (= name (self/050-lambda/let-exp-name exp))
            (= env (extend-env name (evaluate rhs env) env))
            (evaluate body env))
          (meta-builtin/builtin/error "cond mismatch"))))))

(define (apply target arg)
  (if (self/050-lambda/closure-value? target)
    (begin
      (= body (self/050-lambda/closure-value-body target))
      (= parameter (self/050-lambda/closure-value-parameter target))
      (= env (self/050-lambda/closure-value-env target))
      (evaluate body (extend-env parameter arg env)))
    (meta-builtin/builtin/error "cond mismatch")))