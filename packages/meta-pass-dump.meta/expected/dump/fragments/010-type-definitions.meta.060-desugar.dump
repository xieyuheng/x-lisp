(import-all meta-builtin/builtin)

(module 010-type-definitions)

(define-algebraic-type (my-list-t E)
  ((nil) nil?)
  ((li (head E) (tail (my-list-t E)))
   li?
   (head li-head li-put-head!)
   (tail li-tail li-put-tail!)))

(admit nil (polymorphic (E) (-> (my-list-t E))))

(define (nil) (@list 'nil))

(admit nil? (polymorphic (E) (-> (my-list-t E) bool-t)))

(define (nil? value)
  (and (list? value)
       (equal? (list-length value) 1)
       (equal? (list-head value) 'nil)))

(admit li (polymorphic (E) (-> E (my-list-t E) (my-list-t E))))

(define (li head tail) (@list 'li head tail))

(admit li? (polymorphic (E) (-> (my-list-t E) bool-t)))

(define (li? value)
  (and (list? value)
       (equal? (list-length value) 3)
       (equal? (list-head value) 'li)))

(admit li-head (polymorphic (E) (-> (my-list-t E) E)))

(define (li-head target) (list-get 1 target))

(admit li-put-head!
  (polymorphic (E) (-> E (my-list-t E) (my-list-t E))))

(define (li-put-head! value target) (list-put! 1 value target))

(admit li-tail
  (polymorphic (E) (-> (my-list-t E) (my-list-t E))))

(define (li-tail target) (list-get 2 target))

(admit li-put-tail!
  (polymorphic (E)
    (-> (my-list-t E) (my-list-t E) (my-list-t E))))

(define (li-put-tail! value target) (list-put! 2 value target))

(define-algebraic-type (pair-t A B)
  ((make-pair (first A) (second B))
   pair?
   (first pair-first pair-put-first!)
   (second pair-second pair-put-second!)))

(admit make-pair (polymorphic (A B) (-> A B (pair-t A B))))

(define (make-pair first second)
  (@list 'make-pair first second))

(admit pair? (polymorphic (A B) (-> (pair-t A B) bool-t)))

(define (pair? value)
  (and (list? value)
       (equal? (list-length value) 3)
       (equal? (list-head value) 'make-pair)))

(admit pair-first (polymorphic (A B) (-> (pair-t A B) A)))

(define (pair-first target) (list-get 1 target))

(admit pair-put-first!
  (polymorphic (A B) (-> A (pair-t A B) (pair-t A B))))

(define (pair-put-first! value target)
  (list-put! 1 value target))

(admit pair-second (polymorphic (A B) (-> (pair-t A B) B)))

(define (pair-second target) (list-get 2 target))

(admit pair-put-second!
  (polymorphic (A B) (-> B (pair-t A B) (pair-t A B))))

(define (pair-put-second! value target)
  (list-put! 2 value target))

(define (my-list-length list)
  (cond
    ((self/010-type-definitions/nil? list) (begin 0))
    ((self/010-type-definitions/li? list)
     (begin
       (= tail (self/010-type-definitions/li-tail list))
       (= head (self/010-type-definitions/li-head list))
       (iadd 1 (my-list-length tail))))))

(define (my-list-map f list)
  (cond
    ((self/010-type-definitions/nil? list) (begin (nil)))
    ((self/010-type-definitions/li? list)
     (begin
       (= tail (self/010-type-definitions/li-tail list))
       (= head (self/010-type-definitions/li-head list))
       (li (f head) (my-list-map f tail))))))