(import-all meta-builtin/builtin)

(module 060-desugar)

(define (add1 x) (iadd 1 x))

(define (double x) (iadd x x))

(define (demo-let-star)
  (let* ((x 1) (y (iadd x 1))) (iadd x y)))

(define (demo-cond)
  (cond ((equal? 1 1) 1) (meta-builtin/builtin/true 2)))

(define (demo-begin) (begin 1 2 3))

(define (demo-when) (when true 1))

(define (demo-unless) (unless false 2))

(define (demo-and a b) (and a b))

(define (demo-or a b) (or a b))

(define (demo-pipe) (pipe 5 add1 double))

(define (demo-chain) ((chain add1 double) 5))

(define (demo-compose) ((compose add1 double) 5))