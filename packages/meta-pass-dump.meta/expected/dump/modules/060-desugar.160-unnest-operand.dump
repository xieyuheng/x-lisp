(claim add1 (-> int-t int-t))

(define (add1 x) (meta-builtin/builtin/iadd 1 x))

(claim double (-> int-t int-t))

(define (double x) (meta-builtin/builtin/iadd x x))

(claim example-let-star (-> int-t))

(define (example-let-star)
  (= x.1 1)
  (= y.1 (meta-builtin/builtin/iadd x.1 1))
  (meta-builtin/builtin/iadd x.1 y.1))

(claim example-cond (-> int-t))

(define (example-cond)
  (if (meta-builtin/builtin/equal? 1 1) 1
      (if meta-builtin/builtin/true 2
          (begin
            (= _.1 (meta-builtin/builtin/make-source-position 176 6 24))
            (= _.2 (meta-builtin/builtin/make-source-position 180 6 28))
            (= _.3 (meta-builtin/builtin/make-source-span _.1 _.2))
            (= _.4
               (meta-builtin/builtin/make-source-location
                "src/060-desugar.meta"
                _.3))
            (meta-builtin/builtin/error-with-location "cond mismatch" _.4)))))

(claim example-begin (-> int-t))

(define (example-begin) 1 2 3)

(claim example-when (-> void-t))

(define (example-when)
  (if meta-builtin/builtin/true (begin 1 meta-builtin/builtin/void)
      meta-builtin/builtin/void))

(claim example-unless (-> void-t))

(define (example-unless)
  (if meta-builtin/builtin/false meta-builtin/builtin/void
      (begin 2 meta-builtin/builtin/void)))

(claim example-and (-> bool-t bool-t bool-t))

(define (example-and a b) (if a b meta-builtin/builtin/false))

(claim example-or (-> bool-t bool-t bool-t))

(define (example-or a b) (if a meta-builtin/builtin/true b))

(claim example-pipe (-> int-t))

(define (example-pipe)
  (= _.1 (self/060-desugar/add1 5))
  (self/060-desugar/double _.1))

(claim example-chain (-> int-t))

(define (example-chain) (self/060-desugar/example-chain©λ1 5))

(define (example-chain©λ1 target.1)
  (= _.1 (self/060-desugar/add1 target.1))
  (self/060-desugar/double _.1))

(claim example-compose (-> int-t))

(define (example-compose) (self/060-desugar/example-compose©λ1 5))

(define (example-compose©λ1 target.1)
  (= _.1 (self/060-desugar/double target.1))
  (self/060-desugar/add1 _.1))

(claim example-letrec (-> void-t))

(define (example-letrec)
  (= even?.1.1 (meta-builtin/builtin/make-box))
  (= odd?.1.1 (meta-builtin/builtin/make-box))
  (= even?.1 even?.1.1)
  (= odd?.1 odd?.1.1)
  (= even?.value.1.1 (self/060-desugar/example-letrec©λ1 odd?.1))
  (= odd?.value.1.1 (self/060-desugar/example-letrec©λ2 even?.1))
  (= even?.value.1 even?.value.1.1)
  (= odd?.value.1 odd?.value.1.1)
  (meta-builtin/builtin/box-put! even?.value.1 even?.1)
  (meta-builtin/builtin/box-put! odd?.value.1 odd?.1)
  meta-builtin/builtin/void)

(define (example-letrec©λ1 odd?.1 n.1)
  (if (meta-builtin/builtin/equal? n.1 0) meta-builtin/builtin/true
      (begin
        (= _.1 (meta-builtin/builtin/box-get odd?.1))
        (= _.2 (meta-builtin/builtin/isub n.1 1))
        (_.1 _.2))))

(define (example-letrec©λ2 even?.1 n.2)
  (if (meta-builtin/builtin/equal? n.2 0) meta-builtin/builtin/false
      (begin
        (= _.1 (meta-builtin/builtin/box-get even?.1))
        (= _.2 (meta-builtin/builtin/isub n.2 1))
        (_.1 _.2))))

