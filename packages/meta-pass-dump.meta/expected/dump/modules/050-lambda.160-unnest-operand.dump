  (lambda-exp
   (parameter meta-builtin/builtin/symbol-t)
   (body self/050-lambda/exp-t))
  (let-exp
   (name meta-builtin/builtin/symbol-t)
   (rhs self/050-lambda/exp-t)
   (body self/050-lambda/exp-t)))

(claim var-exp (-> meta-builtin/builtin/symbol-t exp-t))

(define (var-exp name)
  (= list.1 (meta-builtin/builtin/make-list))
  (meta-builtin/builtin/list-push! var-exp list.1)
  (meta-builtin/builtin/list-push! name list.1)
  list.1)

(claim var-exp? (-> exp-t meta-builtin/builtin/bool-t))

(define (var-exp? value)
  (if (meta-builtin/builtin/list? value)
      (if
          (begin
            (= _.1 (meta-builtin/builtin/list-length value))
            (meta-builtin/builtin/equal? _.1 2))
          (begin
            (= _.2 (meta-builtin/builtin/list-head value))
            (meta-builtin/builtin/equal? _.2 var-exp))
          meta-builtin/builtin/false)
      meta-builtin/builtin/false))

