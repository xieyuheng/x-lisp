(claim env-t meta-builtin/builtin/type-t)

(define-opaque-type env-t
    (meta-builtin/builtin/hash-t
     meta-builtin/builtin/symbol-t
     self/050-lambda/value-t)
  (empty-env (-> self/050-lambda/env-t))
  (extend-env
   (-> meta-builtin/builtin/symbol-t
       self/050-lambda/value-t
       self/050-lambda/env-t
       self/050-lambda/env-t))
  (env-lookup
   (-> meta-builtin/builtin/symbol-t
       self/050-lambda/env-t
       (meta-builtin/builtin/maybe-t self/050-lambda/value-t))))

(claim empty-env (polymorphic () (-> env-t)))

(define empty-env meta-builtin/builtin/make-hash)

(claim extend-env
  (polymorphic () (-> meta-builtin/builtin/symbol-t value-t env-t env-t)))

(define extend-env meta-builtin/builtin/hash-put)

(claim env-lookup
  (polymorphic ()
    (-> meta-builtin/builtin/symbol-t
        env-t
        (meta-builtin/builtin/maybe-t value-t))))

(define env-lookup meta-builtin/builtin/hash-get-maybe)

(claim value-t meta-builtin/builtin/type-t)

(define-enum value-t
  (closure-value
   (env self/050-lambda/env-t)
   (parameter meta-builtin/builtin/symbol-t)
