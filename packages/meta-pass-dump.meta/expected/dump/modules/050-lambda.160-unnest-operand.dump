(claim evaluate (-> 050-lambda/exp-t 050-lambda/env-t 050-lambda/value-t))

(define (evaluate exp env)
  (if (self/050-lambda/var-exp? exp)
      (begin
        (= name.1 (self/050-lambda/var-exp-name exp))
        (if
            (begin
              (= _.1 (self/050-lambda/env-lookup name.1 env))
              (meta-builtin/builtin/just? _.1))
            (begin
              (= value.1
              (begin
                (= _.2 (self/050-lambda/env-lookup name.1 env))
                (meta-builtin/builtin/just-value _.2)))
              value.1)
            (if
                (begin
                  (= _.3 (self/050-lambda/env-lookup name.1 env))
                  (meta-builtin/builtin/nothing? _.3))
                (begin
                  (= _.4 (meta-builtin/builtin/make-source-position 719 25 18))
                  (= _.5 (meta-builtin/builtin/make-source-position 743 25 42))
                  (= _.6 (meta-builtin/builtin/make-source-span _.4 _.5))
                  (= _.7
                  (meta-builtin/builtin/make-source-location
                   "src/050-lambda.meta"
                   _.6))
                  (meta-builtin/builtin/error-with-location "undefined name" _.7))
                (begin
                  (= _.8 (meta-builtin/builtin/make-source-position 645 23 6))
                  (= _.9 (meta-builtin/builtin/make-source-position 650 23 11))
                  (= _.10 (meta-builtin/builtin/make-source-span _.8 _.9))
                  (= _.11
                  (meta-builtin/builtin/make-source-location
                   "src/050-lambda.meta"
                   _.10))
                  (meta-builtin/builtin/error-with-location "cond mismatch" _.11)))))
      (if (self/050-lambda/apply-exp? exp)
          (begin
            (= arg.1 (self/050-lambda/apply-exp-arg exp))
            (= target.1 (self/050-lambda/apply-exp-target exp))
            (= _.12 (self/050-lambda/evaluate target.1 env))
            (= _.13 (self/050-lambda/evaluate arg.1 env))
            (self/050-lambda/apply _.12 _.13))
          (if (self/050-lambda/lambda-exp? exp)
              (begin
                (= body.1 (self/050-lambda/lambda-exp-body exp))
                (= parameter.1 (self/050-lambda/lambda-exp-parameter exp))
                (self/050-lambda/closure-value env parameter.1 body.1))
              (if (self/050-lambda/let-exp? exp)
                  (begin
                    (= body.2 (self/050-lambda/let-exp-body exp))
                    (= rhs.1 (self/050-lambda/let-exp-rhs exp))
                    (= name.2 (self/050-lambda/let-exp-name exp))
                    (= env.1
                    (begin
                      (= _.14 (self/050-lambda/evaluate rhs.1 env))
                      (self/050-lambda/extend-env name.2 _.14 env)))
                    (self/050-lambda/evaluate body.2 env.1))
                  (begin
                    (= _.15
                    (meta-builtin/builtin/make-source-position 609 21 3))
                    (= _.16
                    (meta-builtin/builtin/make-source-position 614 21 8))
                    (= _.17 (meta-builtin/builtin/make-source-span _.15 _.16))
                    (= _.18
                    (meta-builtin/builtin/make-source-location
                     "src/050-lambda.meta"
                     _.17))
                    (meta-builtin/builtin/error-with-location
                     "cond mismatch"
                     _.18)))))))

(claim apply (polymorphic (A) (-> 050-lambda/value-t 050-lambda/value-t A)))

(define (apply target arg)
  (if (self/050-lambda/closure-value? target)
      (begin
        (= body.1 (self/050-lambda/closure-value-body target))
        (= parameter.1 (self/050-lambda/closure-value-parameter target))
        (= env.1 (self/050-lambda/closure-value-env target))
        (= _.1 (self/050-lambda/extend-env parameter.1 arg env.1))
        (self/050-lambda/evaluate body.1 _.1))
      (begin
