(claim exp-t meta-builtin/builtin/type-t)

(define-enum exp-t
  (num (value meta-builtin/builtin/int-t))
  (add (left self/050-lambda/exp-t)
       (right self/050-lambda/exp-t))
  (mul (left self/050-lambda/exp-t)
       (right self/050-lambda/exp-t)))

(claim num (-> meta-builtin/builtin/int-t exp-t))

(define (num value)
  (= list.1 (meta-builtin/builtin/make-list))
  (meta-builtin/builtin/list-push! num list.1)
  (meta-builtin/builtin/list-push! value list.1)
  list.1)

(claim num? (-> exp-t meta-builtin/builtin/bool-t))

(define (num? value)
  (if (meta-builtin/builtin/list? value)
      (if
          (begin
            (= _.1 (meta-builtin/builtin/list-length value))
            (meta-builtin/builtin/equal? _.1 2))
          (begin
            (= _.2 (meta-builtin/builtin/list-head value))
            (meta-builtin/builtin/equal? _.2 num))
          meta-builtin/builtin/false)
      meta-builtin/builtin/false))

(claim num-value (-> exp-t meta-builtin/builtin/int-t))

(define (num-value target)
  (meta-builtin/builtin/list-get 1 target))

(claim num-put-value!
  (-> meta-builtin/builtin/int-t exp-t exp-t))

(define (num-put-value! value target)
  (meta-builtin/builtin/list-put! 1 value target))

(claim add (-> exp-t exp-t exp-t))

(define (add left right)
  (= list.1 (meta-builtin/builtin/make-list))
  (meta-builtin/builtin/list-push! add list.1)
  (meta-builtin/builtin/list-push! left list.1)
  (meta-builtin/builtin/list-push! right list.1)
  list.1)

(claim add? (-> exp-t meta-builtin/builtin/bool-t))

(define (add? value)
  (if (meta-builtin/builtin/list? value)
      (if
          (begin
            (= _.1 (meta-builtin/builtin/list-length value))
            (meta-builtin/builtin/equal? _.1 3))
          (begin
            (= _.2 (meta-builtin/builtin/list-head value))
            (meta-builtin/builtin/equal? _.2 add))
          meta-builtin/builtin/false)
      meta-builtin/builtin/false))

(claim add-left (-> exp-t exp-t))

(define (add-left target)
  (meta-builtin/builtin/list-get 1 target))

(claim add-put-left! (-> exp-t exp-t exp-t))

(define (add-put-left! value target)
  (meta-builtin/builtin/list-put! 1 value target))

(claim add-right (-> exp-t exp-t))

(define (add-right target)
  (meta-builtin/builtin/list-get 2 target))

(claim add-put-right! (-> exp-t exp-t exp-t))

(define (add-put-right! value target)
  (meta-builtin/builtin/list-put! 2 value target))

(claim mul (-> exp-t exp-t exp-t))

(define (mul left right)
  (= list.1 (meta-builtin/builtin/make-list))
  (meta-builtin/builtin/list-push! mul list.1)
  (meta-builtin/builtin/list-push! left list.1)
  (meta-builtin/builtin/list-push! right list.1)
  list.1)

(claim mul? (-> exp-t meta-builtin/builtin/bool-t))

(define (mul? value)
  (if (meta-builtin/builtin/list? value)
      (if
          (begin
            (= _.1 (meta-builtin/builtin/list-length value))
            (meta-builtin/builtin/equal? _.1 3))
          (begin
            (= _.2 (meta-builtin/builtin/list-head value))
            (meta-builtin/builtin/equal? _.2 mul))
          meta-builtin/builtin/false)
      meta-builtin/builtin/false))

(claim mul-left (-> exp-t exp-t))

(define (mul-left target)
  (meta-builtin/builtin/list-get 1 target))

(claim mul-put-left! (-> exp-t exp-t exp-t))

(define (mul-put-left! value target)
  (meta-builtin/builtin/list-put! 1 value target))

(claim mul-right (-> exp-t exp-t))

(define (mul-right target)
  (meta-builtin/builtin/list-get 2 target))

(claim mul-put-right! (-> exp-t exp-t exp-t))

(define (mul-put-right! value target)
  (meta-builtin/builtin/list-put! 2 value target))

(claim evaluate (-> 050-lambda/exp-t int-t))

(define (evaluate e)
  (if (self/050-lambda/num? e)
      (begin (= value.1 (self/050-lambda/num-value e)) value.1)
      (if (self/050-lambda/add? e)
          (begin
            (= right.1 (self/050-lambda/add-right e))
            (= left.1 (self/050-lambda/add-left e))
            (= _.1 (self/050-lambda/evaluate left.1))
            (= _.2 (self/050-lambda/evaluate right.1))
            (meta-builtin/builtin/iadd _.1 _.2))
          (if (self/050-lambda/mul? e)
              (begin
                (= right.2 (self/050-lambda/mul-right e))
                (= left.2 (self/050-lambda/mul-left e))
                (= _.3 (self/050-lambda/evaluate left.2))
                (= _.4 (self/050-lambda/evaluate right.2))
                (meta-builtin/builtin/imul _.3 _.4))
              (begin
                (=
                _.5
                (meta-builtin/builtin/make-source-position
                 160
                 8
                 3))
                (=
                _.6
                (meta-builtin/builtin/make-source-position
                 165
                 8
                 8))
                (=
                _.7
                (meta-builtin/builtin/make-source-span _.5 _.6))
                (=
                _.8
                (meta-builtin/builtin/make-source-location
                 "src/050-lambda.meta"
                 _.7))
                (meta-builtin/builtin/error-with-location
                 "cond mismatch"
                 _.8))))))