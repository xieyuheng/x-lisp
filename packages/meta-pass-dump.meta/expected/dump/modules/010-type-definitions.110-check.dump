(claim my-list-t
  (-> meta-builtin/builtin/type-t meta-builtin/builtin/type-t))

(define-enum (my-list-t E)
  nil
  (li (head E) (tail (self/010-type-definitions/my-list-t E))))

(claim nil (polymorphic (E) (-> (my-list-t E))))

(define (nil)
  (= list (meta-builtin/builtin/make-list))
  (meta-builtin/builtin/list-push! nil list)
  list)

(claim nil?
  (polymorphic (E)
    (-> (my-list-t E) meta-builtin/builtin/bool-t)))

(define (nil? value)
  (if (meta-builtin/builtin/list? value)
      (if
          (meta-builtin/builtin/equal?
           (meta-builtin/builtin/list-length value)
           1)
          (meta-builtin/builtin/equal?
           (meta-builtin/builtin/list-head value)
           nil)
          meta-builtin/builtin/false)
      meta-builtin/builtin/false))

(claim li (polymorphic (E) (-> E (my-list-t E) (my-list-t E))))

(define (li head tail)
  (= list (meta-builtin/builtin/make-list))
  (meta-builtin/builtin/list-push! li list)
  (meta-builtin/builtin/list-push! head list)
  (meta-builtin/builtin/list-push! tail list)
  list)

(claim li?
  (polymorphic (E)
    (-> (my-list-t E) meta-builtin/builtin/bool-t)))

(define (li? value)
  (if (meta-builtin/builtin/list? value)
      (if
          (meta-builtin/builtin/equal?
           (meta-builtin/builtin/list-length value)
           3)
          (meta-builtin/builtin/equal?
           (meta-builtin/builtin/list-head value)
           li)
          meta-builtin/builtin/false)
      meta-builtin/builtin/false))

(claim li-head (polymorphic (E) (-> (my-list-t E) E)))

(define (li-head target)
  (meta-builtin/builtin/list-get 1 target))

(claim li-put-head!
  (polymorphic (E) (-> E (my-list-t E) (my-list-t E))))

(define (li-put-head! value target)
  (meta-builtin/builtin/list-put! 1 value target))

(claim li-tail
  (polymorphic (E) (-> (my-list-t E) (my-list-t E))))

(define (li-tail target)
  (meta-builtin/builtin/list-get 2 target))

(claim li-put-tail!
  (polymorphic (E)
    (-> (my-list-t E) (my-list-t E) (my-list-t E))))

(define (li-put-tail! value target)
  (meta-builtin/builtin/list-put! 2 value target))

(claim pair-t
  (-> meta-builtin/builtin/type-t
      meta-builtin/builtin/type-t
      meta-builtin/builtin/type-t))

(define-enum (pair-t A B) (make-pair (first A) (second B)))

(claim make-pair (polymorphic (A B) (-> A B (pair-t A B))))

(define (make-pair first second)
  (= list (meta-builtin/builtin/make-list))
  (meta-builtin/builtin/list-push! make-pair list)
  (meta-builtin/builtin/list-push! first list)
  (meta-builtin/builtin/list-push! second list)
  list)

(claim pair?
  (polymorphic (A B)
    (-> (pair-t A B) meta-builtin/builtin/bool-t)))

(define (pair? value)
  (if (meta-builtin/builtin/list? value)
      (if
          (meta-builtin/builtin/equal?
           (meta-builtin/builtin/list-length value)
           3)
          (meta-builtin/builtin/equal?
           (meta-builtin/builtin/list-head value)
           make-pair)
          meta-builtin/builtin/false)
      meta-builtin/builtin/false))

(claim pair-first (polymorphic (A B) (-> (pair-t A B) A)))

(define (pair-first target)
  (meta-builtin/builtin/list-get 1 target))

(claim pair-put-first!
  (polymorphic (A B) (-> A (pair-t A B) (pair-t A B))))

(define (pair-put-first! value target)
  (meta-builtin/builtin/list-put! 1 value target))

(claim pair-second (polymorphic (A B) (-> (pair-t A B) B)))

(define (pair-second target)
  (meta-builtin/builtin/list-get 2 target))

(claim pair-put-second!
  (polymorphic (A B) (-> B (pair-t A B) (pair-t A B))))

(define (pair-put-second! value target)
  (meta-builtin/builtin/list-put! 2 value target))

(claim my-list-length
  (polymorphic
    (A)
    (-> (010-type-definitions/my-list-t A) int-t)))

(define (my-list-length list)
  (if (self/010-type-definitions/nil? list) 0
      (if (self/010-type-definitions/li? list)
          (begin
            (= tail (self/010-type-definitions/li-tail list))
            (= head (self/010-type-definitions/li-head list))
            (meta-builtin/builtin/iadd
             1
             (self/010-type-definitions/my-list-length tail)))
          (meta-builtin/builtin/error "cond mismatch"))))

(claim my-list-map
  (polymorphic
    (A B)
    (-> (-> A B)
        (010-type-definitions/my-list-t A)
        (010-type-definitions/my-list-t B))))

(define (my-list-map f list)
  (if (self/010-type-definitions/nil? list)
      (self/010-type-definitions/nil)
      (if (self/010-type-definitions/li? list)
          (begin
            (= tail (self/010-type-definitions/li-tail list))
            (= head (self/010-type-definitions/li-head list))
            (self/010-type-definitions/li
             (f head)
             (self/010-type-definitions/my-list-map f tail)))
          (meta-builtin/builtin/error "cond mismatch"))))