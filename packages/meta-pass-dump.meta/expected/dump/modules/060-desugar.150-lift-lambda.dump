(claim example-letrec-star (-> void-t))

(define (example-letrec-star)
  (= even?.1.1 (meta-builtin/builtin/make-box))
  (= odd?.1.1 (meta-builtin/builtin/make-box))
  (= even?.1 even?.1.1)
  (= odd?.1 odd?.1.1)
  (meta-builtin/builtin/box-put!
   (self/060-desugar/example-letrec-star©λ1 odd?.1)
   even?.1)
  (meta-builtin/builtin/box-put!
   (self/060-desugar/example-letrec-star©λ2 even?.1)
   odd?.1)
  meta-builtin/builtin/void)

(define (example-letrec-star©λ1 odd?.1 n.1)
  (if (meta-builtin/builtin/equal? n.1 0) meta-builtin/builtin/true
      ((meta-builtin/builtin/box-get odd?.1) (meta-builtin/builtin/isub n.1 1))))

(define (example-letrec-star©λ2 even?.1 n.2)
  (if (meta-builtin/builtin/equal? n.2 0) meta-builtin/builtin/false
      ((meta-builtin/builtin/box-get even?.1) (meta-builtin/builtin/isub n.2 1))))

