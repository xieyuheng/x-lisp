(define (example-eta-expansion)
  (begin
    (@closure self/auto-currying/©lambda.example-eta-expansion.1)
    (@closure self/auto-currying/©lambda.example-eta-expansion.2)))

(define (adder n) (@closure self/auto-currying/©lambda.adder.1 n))

(define (example-early-apply)
  (begin ((self/auto-currying/adder 1) 2) ((self/auto-currying/adder 1) 2)))

(define (©lambda.example-eta-expansion.1 closure curried.1)
  (meta-builtin/builtin/iadd 1 curried.1))

(define (©lambda.example-eta-expansion.2 closure curried.1.1)
  (meta-builtin/builtin/iadd 1 curried.1.1))

(define (©lambda.adder.1 closure x)
  (let ((n (meta-builtin/builtin/closure-arg 0 closure)))
    (meta-builtin/builtin/iadd n x)))