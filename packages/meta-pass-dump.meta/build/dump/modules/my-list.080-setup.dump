(claim my-list-t (-> meta-builtin/builtin/type-t meta-builtin/builtin/type-t))

(define-enum (my-list-t E) nil (li (head E) (tail (my-list-t E))))

(claim nil (polymorphic (E) (-> (my-list-t E))))

(define (nil)
  (let ((list (meta-builtin/builtin/make-list)))
    (begin (meta-builtin/builtin/list-push nil list) list)))

(claim is-nil (polymorphic (E) (-> (my-list-t E) meta-builtin/builtin/bool-t)))

(define (is-nil value)
  (if (meta-builtin/builtin/is-list value)
    (if (meta-builtin/builtin/equal (meta-builtin/builtin/list-length value) 1)
      (meta-builtin/builtin/equal (meta-builtin/builtin/list-head value) nil)
      meta-builtin/builtin/false)
    meta-builtin/builtin/false))

(claim li (polymorphic (E) (-> E (my-list-t E) (my-list-t E))))

(define (li head tail)
  (let ((list (meta-builtin/builtin/make-list)))
    (begin
      (meta-builtin/builtin/list-push li list)
      (begin
        (meta-builtin/builtin/list-push head list)
        (begin (meta-builtin/builtin/list-push tail list) list)))))

(claim is-li (polymorphic (E) (-> (my-list-t E) meta-builtin/builtin/bool-t)))

(define (is-li value)
  (if (meta-builtin/builtin/is-list value)
    (if (meta-builtin/builtin/equal (meta-builtin/builtin/list-length value) 3)
      (meta-builtin/builtin/equal (meta-builtin/builtin/list-head value) li)
      meta-builtin/builtin/false)
    meta-builtin/builtin/false))

(claim li-head (polymorphic (E) (-> (my-list-t E) E)))

(define (li-head target) (meta-builtin/builtin/list-get 1 target))

(claim li-put-head (polymorphic (E) (-> E (my-list-t E) (my-list-t E))))

(define (li-put-head value target)
  (begin (meta-builtin/builtin/list-put 1 value target) target))

(claim li-tail (polymorphic (E) (-> (my-list-t E) (my-list-t E))))

(define (li-tail target) (meta-builtin/builtin/list-get 2 target))

(claim li-put-tail
  (polymorphic (E) (-> (my-list-t E) (my-list-t E) (my-list-t E))))

(define (li-put-tail value target)
  (begin (meta-builtin/builtin/list-put 2 value target) target))

(define (my-list-head list)
  (if (self/my-list/is-nil list)
    (meta-builtin/builtin/error-with-location
     (meta-builtin/builtin/string-concat
      (let ((list.1 (meta-builtin/builtin/make-list)))
        (begin
          (meta-builtin/builtin/list-push "pattern mismatch on:" list.1)
          (begin
            (meta-builtin/builtin/list-push " " list.1)
            (begin
              (meta-builtin/builtin/list-push
               (meta-builtin/builtin/format list)
               list.1)
              list.1)))))
     (meta-builtin/builtin/make-source-location
      "src/my-list.meta"
      (meta-builtin/builtin/make-source-span
       (meta-builtin/builtin/make-source-position 123 7 3)
       (meta-builtin/builtin/make-source-position 128 7 8))))
    (if (self/my-list/is-li list)
      (let ((tail (self/my-list/li-tail list)))
        (let ((head (self/my-list/li-head list))) head))
      (meta-builtin/builtin/error "cond mismatch"))))

(define (my-list-tail list)
  (if (self/my-list/is-nil list)
    (meta-builtin/builtin/error-with-location
     (meta-builtin/builtin/string-concat
      (let ((list.1 (meta-builtin/builtin/make-list)))
        (begin
          (meta-builtin/builtin/list-push "pattern mismatch on:" list.1)
          (begin
            (meta-builtin/builtin/list-push " " list.1)
            (begin
              (meta-builtin/builtin/list-push
               (meta-builtin/builtin/format list)
               list.1)
              list.1)))))
     (meta-builtin/builtin/make-source-location
      "src/my-list.meta"
      (meta-builtin/builtin/make-source-span
       (meta-builtin/builtin/make-source-position 194 11 3)
       (meta-builtin/builtin/make-source-position 199 11 8))))
    (if (self/my-list/is-li list)
      (let ((tail (self/my-list/li-tail list)))
        (let ((head (self/my-list/li-head list))) tail))
      (meta-builtin/builtin/error "cond mismatch"))))

(define (my-list-length list)
  (if (self/my-list/is-nil list)
    0
    (if (self/my-list/is-li list)
      (let ((tail (self/my-list/li-tail list)))
        (let ((head (self/my-list/li-head list)))
          (meta-builtin/builtin/iadd 1 (my-list-length tail))))
      (meta-builtin/builtin/error "cond mismatch"))))

(define (my-list-map f list)
  (if (self/my-list/is-nil list)
    (nil)
    (if (self/my-list/is-li list)
      (let ((tail (self/my-list/li-tail list)))
        (let ((head (self/my-list/li-head list)))
          (li (f head) (my-list-map f tail))))
      (meta-builtin/builtin/error "cond mismatch"))))

(define (my-list-append left right)
  (if (self/my-list/is-nil left)
    right
    (if (self/my-list/is-li left)
      (let ((tail (self/my-list/li-tail left)))
        (let ((head (self/my-list/li-head left)))
          (li head (my-list-append tail right))))
      (meta-builtin/builtin/error "cond mismatch"))))

(define (my-list-zip-map f list1 list2)
  (if (self/my-list/is-nil list1)
    (let ((_ list2)) (nil))
    (if (self/my-list/is-li list1)
      (if (self/my-list/is-nil list2)
        (let ((tail1 (self/my-list/li-tail list1)))
          (let ((head1 (self/my-list/li-head list1))) (nil)))
        (if (self/my-list/is-li list2)
          (let ((tail2 (self/my-list/li-tail list2)))
            (let ((head2 (self/my-list/li-head list2)))
              (let ((tail1 (self/my-list/li-tail list1)))
                (let ((head1 (self/my-list/li-head list1)))
                  (li (f head1 head2) (my-list-zip-map f tail1 tail2))))))
          (meta-builtin/builtin/error "cond mismatch")))
      (meta-builtin/builtin/error "cond mismatch"))))

(define (my-list-zip-map-2 f list1 list2)
  (if (self/my-list/is-nil list1)
    (let ((_ list2)) (nil))
    (if (self/my-list/is-li list1)
      (if (self/my-list/is-nil list2)
        (let ((_ list1)) (nil))
        (if (self/my-list/is-li list2)
          (if (self/my-list/is-nil list1)
            (meta-builtin/builtin/error-with-location
             (meta-builtin/builtin/string-concat
              (let ((list (meta-builtin/builtin/make-list)))
                (begin
                  (meta-builtin/builtin/list-push "pattern mismatch on:" list)
                  (begin
                    (meta-builtin/builtin/list-push " " list)
                    (begin
                      (meta-builtin/builtin/list-push
                       (meta-builtin/builtin/format list1)
                       list)
                      (begin
                        (meta-builtin/builtin/list-push " " list)
                        (begin
                          (meta-builtin/builtin/list-push
                           (meta-builtin/builtin/format list2)
                           list)
                          list)))))))
             (meta-builtin/builtin/make-source-location
              "src/my-list.meta"
              (meta-builtin/builtin/make-source-span
               (meta-builtin/builtin/make-source-position 872 37 3)
               (meta-builtin/builtin/make-source-position 882 37 13))))
            (if (self/my-list/is-li list1)
              (if (self/my-list/is-nil list2)
                (meta-builtin/builtin/error-with-location
                 (meta-builtin/builtin/string-concat
                  (let ((list (meta-builtin/builtin/make-list)))
                    (begin
                      (meta-builtin/builtin/list-push
                       "pattern mismatch on:"
                       list)
                      (begin
                        (meta-builtin/builtin/list-push " " list)
                        (begin
                          (meta-builtin/builtin/list-push
                           (meta-builtin/builtin/format list1)
                           list)
                          (begin
                            (meta-builtin/builtin/list-push " " list)
                            (begin
                              (meta-builtin/builtin/list-push
                               (meta-builtin/builtin/format list2)
                               list)
                              list)))))))
                 (meta-builtin/builtin/make-source-location
                  "src/my-list.meta"
                  (meta-builtin/builtin/make-source-span
                   (meta-builtin/builtin/make-source-position 872 37 3)
                   (meta-builtin/builtin/make-source-position 882 37 13))))
                (if (self/my-list/is-li list2)
                  (let ((tail2 (self/my-list/li-tail list2)))
                    (let ((head2 (self/my-list/li-head list2)))
                      (let ((tail1 (self/my-list/li-tail list1)))
                        (let ((head1 (self/my-list/li-head list1)))
                          (li (f head1 head2) (my-list-zip-map-2 f tail1 tail2))))))
                  (meta-builtin/builtin/error "cond mismatch")))
              (meta-builtin/builtin/error "cond mismatch")))
          (meta-builtin/builtin/error "cond mismatch")))
      (meta-builtin/builtin/error "cond mismatch"))))

(define (my-list-adjacent-dedup list)
  (if (self/my-list/is-nil list)
    (nil)
    (if (self/my-list/is-li list)
      (if (self/my-list/is-nil (self/my-list/li-tail list))
        (let ((head (self/my-list/li-head list))) (li head (nil)))
        (if (self/my-list/is-li (self/my-list/li-tail list))
          (let ((rest (self/my-list/li-tail (self/my-list/li-tail list))))
            (let ((second (self/my-list/li-head (self/my-list/li-tail list))))
              (let ((first (self/my-list/li-head list)))
                (if (meta-builtin/builtin/equal first second)
                  (my-list-adjacent-dedup (li second rest))
                  (li first (my-list-adjacent-dedup (li second rest)))))))
          (meta-builtin/builtin/error "cond mismatch")))
      (meta-builtin/builtin/error "cond mismatch"))))