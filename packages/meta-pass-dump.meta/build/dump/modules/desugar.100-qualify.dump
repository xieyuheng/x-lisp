(define (add1 x) (meta-builtin/builtin/iadd 1 x))

(define (double x) (meta-builtin/builtin/iadd x x))

(define (example-let-star)
  (let ((x 1))
    (let ((y (meta-builtin/builtin/iadd x 1))) (meta-builtin/builtin/iadd x y))))

(define (example-cond)
  (if (meta-builtin/builtin/equal 1 1)
    1
    (if meta-builtin/builtin/true
      2
      (meta-builtin/builtin/error "cond mismatch"))))

(define (example-begin) (begin 1 (begin 2 3)))

(define (example-when)
  (if meta-builtin/builtin/true
    (begin 1 meta-builtin/builtin/void)
    meta-builtin/builtin/void))

(define (example-unless)
  (if meta-builtin/builtin/false
    meta-builtin/builtin/void
    (begin 2 meta-builtin/builtin/void)))

(define (example-and a b) (if a b meta-builtin/builtin/false))

(define (example-or a b) (if a meta-builtin/builtin/true b))

(define (example-pipe) (self/desugar/double (self/desugar/add1 5)))

(define (example-chain)
  ((lambda (target) (self/desugar/double (self/desugar/add1 target))) 5))

(define (example-compose)
  ((lambda (target) (self/desugar/add1 (self/desugar/double target))) 5))

(define (example-letrec)
  (let ((is-even (meta-builtin/builtin/make-box)))
    (let ((is-odd (meta-builtin/builtin/make-box)))
      (begin
        (meta-builtin/builtin/box-put!
         (lambda (n)
           (if (meta-builtin/builtin/equal n 0)
             meta-builtin/builtin/true
             ((meta-builtin/builtin/box-get is-odd)
              (meta-builtin/builtin/isub n 1))))
         is-even)
        (begin
          (meta-builtin/builtin/box-put!
           (lambda (n)
             (if (meta-builtin/builtin/equal n 0)
               meta-builtin/builtin/false
               ((meta-builtin/builtin/box-get is-even)
                (meta-builtin/builtin/isub n 1))))
           is-odd)
          meta-builtin/builtin/void)))))

(define (example-local-define)
  (let ((is-even (meta-builtin/builtin/make-box)))
    (let ((is-odd (meta-builtin/builtin/make-box)))
      (begin
        (meta-builtin/builtin/box-put!
         (lambda (n)
           (if (meta-builtin/builtin/equal n 0)
             meta-builtin/builtin/true
             ((meta-builtin/builtin/box-get is-odd)
              (meta-builtin/builtin/isub n 1))))
         is-even)
        (begin
          (meta-builtin/builtin/box-put!
           (lambda (n)
             (if (meta-builtin/builtin/equal n 0)
               meta-builtin/builtin/false
               ((meta-builtin/builtin/box-get is-even)
                (meta-builtin/builtin/isub n 1))))
           is-odd)
          meta-builtin/builtin/void)))))