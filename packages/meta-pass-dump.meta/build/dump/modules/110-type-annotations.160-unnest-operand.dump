(claim identity (polymorphic (A) (-> A A)))

(define (identity x) x)

(claim compose2 (polymorphic (A B C) (-> (-> A B) (-> C A) (-> C B))))

(define (compose2 f g x) (= unnested.1 (g x)) (f unnested.1))

(claim double (-> int-t int-t))

(define (double x) (meta-builtin/builtin/iadd x x))

(claim answer int-t)

(define answer 42)