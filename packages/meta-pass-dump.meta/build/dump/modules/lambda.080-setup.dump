(claim exp-t meta-builtin/builtin/type-t)

(define-enum exp-t
  (var-exp (name meta-builtin/builtin/symbol-t))
  (apply-exp (target exp-t) (arg exp-t))
  (lambda-exp (parameter meta-builtin/builtin/symbol-t) (body exp-t))
  (let-exp (name meta-builtin/builtin/symbol-t) (rhs exp-t) (body exp-t)))

(claim var-exp (-> meta-builtin/builtin/symbol-t exp-t))

(define (var-exp name)
  (let ((list (meta-builtin/builtin/make-list)))
    (begin
      (meta-builtin/builtin/list-push var-exp list)
      (begin (meta-builtin/builtin/list-push name list) list))))

(claim is-var-exp (-> exp-t meta-builtin/builtin/bool-t))

(define (is-var-exp value)
  (if (meta-builtin/builtin/is-list value)
    (if (meta-builtin/builtin/equal (meta-builtin/builtin/list-length value) 2)
      (meta-builtin/builtin/equal (meta-builtin/builtin/list-head value) var-exp)
      meta-builtin/builtin/false)
    meta-builtin/builtin/false))

(claim var-exp-name (-> exp-t meta-builtin/builtin/symbol-t))

(define (var-exp-name target) (meta-builtin/builtin/list-get 1 target))

(claim var-exp-put-name (-> meta-builtin/builtin/symbol-t exp-t exp-t))

(define (var-exp-put-name value target)
  (begin (meta-builtin/builtin/list-put 1 value target) target))

(claim apply-exp (-> exp-t exp-t exp-t))

(define (apply-exp target arg)
  (let ((list (meta-builtin/builtin/make-list)))
    (begin
      (meta-builtin/builtin/list-push apply-exp list)
      (begin
        (meta-builtin/builtin/list-push target list)
        (begin (meta-builtin/builtin/list-push arg list) list)))))

(claim is-apply-exp (-> exp-t meta-builtin/builtin/bool-t))

(define (is-apply-exp value)
  (if (meta-builtin/builtin/is-list value)
    (if (meta-builtin/builtin/equal (meta-builtin/builtin/list-length value) 3)
      (meta-builtin/builtin/equal
       (meta-builtin/builtin/list-head value)
       apply-exp)
      meta-builtin/builtin/false)
    meta-builtin/builtin/false))

(claim apply-exp-target (-> exp-t exp-t))

(define (apply-exp-target target) (meta-builtin/builtin/list-get 1 target))

(claim apply-exp-put-target (-> exp-t exp-t exp-t))

(define (apply-exp-put-target value target)
  (begin (meta-builtin/builtin/list-put 1 value target) target))

(claim apply-exp-arg (-> exp-t exp-t))

(define (apply-exp-arg target) (meta-builtin/builtin/list-get 2 target))

(claim apply-exp-put-arg (-> exp-t exp-t exp-t))

(define (apply-exp-put-arg value target)
  (begin (meta-builtin/builtin/list-put 2 value target) target))

(claim lambda-exp (-> meta-builtin/builtin/symbol-t exp-t exp-t))

(define (lambda-exp parameter body)
  (let ((list (meta-builtin/builtin/make-list)))
    (begin
      (meta-builtin/builtin/list-push lambda-exp list)
      (begin
        (meta-builtin/builtin/list-push parameter list)
        (begin (meta-builtin/builtin/list-push body list) list)))))

(claim is-lambda-exp (-> exp-t meta-builtin/builtin/bool-t))

(define (is-lambda-exp value)
  (if (meta-builtin/builtin/is-list value)
    (if (meta-builtin/builtin/equal (meta-builtin/builtin/list-length value) 3)
      (meta-builtin/builtin/equal
       (meta-builtin/builtin/list-head value)
       lambda-exp)
      meta-builtin/builtin/false)
    meta-builtin/builtin/false))

(claim lambda-exp-parameter (-> exp-t meta-builtin/builtin/symbol-t))

(define (lambda-exp-parameter target) (meta-builtin/builtin/list-get 1 target))

(claim lambda-exp-put-parameter (-> meta-builtin/builtin/symbol-t exp-t exp-t))

(define (lambda-exp-put-parameter value target)
  (begin (meta-builtin/builtin/list-put 1 value target) target))

(claim lambda-exp-body (-> exp-t exp-t))

(define (lambda-exp-body target) (meta-builtin/builtin/list-get 2 target))

(claim lambda-exp-put-body (-> exp-t exp-t exp-t))

(define (lambda-exp-put-body value target)
  (begin (meta-builtin/builtin/list-put 2 value target) target))

(claim let-exp (-> meta-builtin/builtin/symbol-t exp-t exp-t exp-t))

(define (let-exp name rhs body)
  (let ((list (meta-builtin/builtin/make-list)))
    (begin
      (meta-builtin/builtin/list-push let-exp list)
      (begin
        (meta-builtin/builtin/list-push name list)
        (begin
          (meta-builtin/builtin/list-push rhs list)
          (begin (meta-builtin/builtin/list-push body list) list))))))

(claim is-let-exp (-> exp-t meta-builtin/builtin/bool-t))

(define (is-let-exp value)
  (if (meta-builtin/builtin/is-list value)
    (if (meta-builtin/builtin/equal (meta-builtin/builtin/list-length value) 4)
      (meta-builtin/builtin/equal (meta-builtin/builtin/list-head value) let-exp)
      meta-builtin/builtin/false)
    meta-builtin/builtin/false))

(claim let-exp-name (-> exp-t meta-builtin/builtin/symbol-t))

(define (let-exp-name target) (meta-builtin/builtin/list-get 1 target))

(claim let-exp-put-name (-> meta-builtin/builtin/symbol-t exp-t exp-t))

(define (let-exp-put-name value target)
  (begin (meta-builtin/builtin/list-put 1 value target) target))

(claim let-exp-rhs (-> exp-t exp-t))

(define (let-exp-rhs target) (meta-builtin/builtin/list-get 2 target))

(claim let-exp-put-rhs (-> exp-t exp-t exp-t))

(define (let-exp-put-rhs value target)
  (begin (meta-builtin/builtin/list-put 2 value target) target))

(claim let-exp-body (-> exp-t exp-t))

(define (let-exp-body target) (meta-builtin/builtin/list-get 3 target))

(claim let-exp-put-body (-> exp-t exp-t exp-t))

(define (let-exp-put-body value target)
  (begin (meta-builtin/builtin/list-put 3 value target) target))

(claim env-t meta-builtin/builtin/type-t)

(define-opaque-type env-t
    (meta-builtin/builtin/hash-t meta-builtin/builtin/symbol-t value-t)
  (empty-env (-> env-t))
  (extend-env (-> meta-builtin/builtin/symbol-t value-t env-t env-t))
  (env-lookup
   (-> meta-builtin/builtin/symbol-t
       env-t
       (meta-builtin/builtin/maybe-t value-t))))

(claim empty-env (-> env-t))

(define empty-env meta-builtin/builtin/make-hash)

(claim extend-env (-> meta-builtin/builtin/symbol-t value-t env-t env-t))

(define extend-env meta-builtin/builtin/hash-put-copy)

(claim env-lookup
  (-> meta-builtin/builtin/symbol-t env-t (meta-builtin/builtin/maybe-t value-t)))

(define env-lookup meta-builtin/builtin/hash-get-maybe)

(claim value-t meta-builtin/builtin/type-t)

(define-enum value-t
  (closure-value
   (env env-t)
   (parameter meta-builtin/builtin/symbol-t)
   (body exp-t)))

(claim closure-value (-> env-t meta-builtin/builtin/symbol-t exp-t value-t))

(define (closure-value env parameter body)
  (let ((list (meta-builtin/builtin/make-list)))
    (begin
      (meta-builtin/builtin/list-push closure-value list)
      (begin
        (meta-builtin/builtin/list-push env list)
        (begin
          (meta-builtin/builtin/list-push parameter list)
          (begin (meta-builtin/builtin/list-push body list) list))))))

(claim is-closure-value (-> value-t meta-builtin/builtin/bool-t))

(define (is-closure-value value)
  (if (meta-builtin/builtin/is-list value)
    (if (meta-builtin/builtin/equal (meta-builtin/builtin/list-length value) 4)
      (meta-builtin/builtin/equal
       (meta-builtin/builtin/list-head value)
       closure-value)
      meta-builtin/builtin/false)
    meta-builtin/builtin/false))

(claim closure-value-env (-> value-t env-t))

(define (closure-value-env target) (meta-builtin/builtin/list-get 1 target))

(claim closure-value-put-env (-> env-t value-t value-t))

(define (closure-value-put-env value target)
  (begin (meta-builtin/builtin/list-put 1 value target) target))

(claim closure-value-parameter (-> value-t meta-builtin/builtin/symbol-t))

(define (closure-value-parameter target)
  (meta-builtin/builtin/list-get 2 target))

(claim closure-value-put-parameter
  (-> meta-builtin/builtin/symbol-t value-t value-t))

(define (closure-value-put-parameter value target)
  (begin (meta-builtin/builtin/list-put 2 value target) target))

(claim closure-value-body (-> value-t exp-t))

(define (closure-value-body target) (meta-builtin/builtin/list-get 3 target))

(claim closure-value-put-body (-> exp-t value-t value-t))

(define (closure-value-put-body value target)
  (begin (meta-builtin/builtin/list-put 3 value target) target))

(define (evaluate exp env)
  (if (self/lambda/is-var-exp exp)
    (let ((name (self/lambda/var-exp-name exp)))
      (if (meta-builtin/builtin/is-just (env-lookup name env))
        (let ((value (meta-builtin/builtin/just-value (env-lookup name env))))
          value)
        (if (meta-builtin/builtin/is-nothing (env-lookup name env))
          (meta-builtin/builtin/error "undefined name")
          (meta-builtin/builtin/error "cond mismatch"))))
    (if (self/lambda/is-apply-exp exp)
      (let ((arg (self/lambda/apply-exp-arg exp)))
        (let ((target (self/lambda/apply-exp-target exp)))
          (apply (evaluate target env) (evaluate arg env))))
      (if (self/lambda/is-lambda-exp exp)
        (let ((body (self/lambda/lambda-exp-body exp)))
          (let ((parameter (self/lambda/lambda-exp-parameter exp)))
            (closure-value env parameter body)))
        (if (self/lambda/is-let-exp exp)
          (let ((body (self/lambda/let-exp-body exp)))
            (let ((rhs (self/lambda/let-exp-rhs exp)))
              (let ((name (self/lambda/let-exp-name exp)))
                (let ((env (extend-env name (evaluate rhs env) env)))
                  (evaluate body env)))))
          (meta-builtin/builtin/error "cond mismatch"))))))

(define (apply target arg)
  (if (self/lambda/is-closure-value target)
    (let ((body (self/lambda/closure-value-body target)))
      (let ((parameter (self/lambda/closure-value-parameter target)))
        (let ((env (self/lambda/closure-value-env target)))
          (evaluate body (extend-env parameter arg env)))))
    (meta-builtin/builtin/error "cond mismatch")))