(define (add1 x) (meta-builtin/builtin/iadd 1 x))

(define (double x) (meta-builtin/builtin/iadd x x))

(define (example-let-star)
  (let ((x 1))
    (let ((y (meta-builtin/builtin/iadd x 1))) (meta-builtin/builtin/iadd x y))))

(define (example-cond)
  (if (meta-builtin/builtin/equal 1 1)
    1
    (if meta-builtin/builtin/true
      2
      (meta-builtin/builtin/error-with-location
       "cond mismatch"
       (meta-builtin/builtin/make-source-location
        "src/desugar.meta"
        (meta-builtin/builtin/make-source-span
         (meta-builtin/builtin/make-source-position 171 6 24)
         (meta-builtin/builtin/make-source-position 175 6 28)))))))

(define (example-begin) (begin 1 (begin 2 3)))

(define (example-when)
  (if meta-builtin/builtin/true
    (begin 1 meta-builtin/builtin/void)
    meta-builtin/builtin/void))

(define (example-unless)
  (if meta-builtin/builtin/false
    meta-builtin/builtin/void
    (begin 2 meta-builtin/builtin/void)))

(define (example-and a b) (if a b meta-builtin/builtin/false))

(define (example-or a b) (if a meta-builtin/builtin/true b))

(define (example-letrec)
  (let ((is-even (meta-builtin/builtin/make-box)))
    (let ((is-odd (meta-builtin/builtin/make-box)))
      (begin
        (meta-builtin/builtin/box-put
         (@closure self/desugar/©lambda.example-letrec.1 is-odd)
         is-even)
        (begin
          (meta-builtin/builtin/box-put
           (@closure self/desugar/©lambda.example-letrec.2 is-even)
           is-odd)
          meta-builtin/builtin/void)))))

(define (example-local-define)
  (let ((is-even (meta-builtin/builtin/make-box)))
    (let ((is-odd (meta-builtin/builtin/make-box)))
      (begin
        (meta-builtin/builtin/box-put
         (@closure self/desugar/©lambda.example-local-define.1 is-odd)
         is-even)
        (begin
          (meta-builtin/builtin/box-put
           (@closure self/desugar/©lambda.example-local-define.2 is-even)
           is-odd)
          meta-builtin/builtin/void)))))

(define (©lambda.example-letrec.1 closure n)
  (let ((is-odd (meta-builtin/builtin/closure-arg 0 closure)))
    (if (meta-builtin/builtin/equal n 0)
      meta-builtin/builtin/true
      ((meta-builtin/builtin/box-get is-odd) (meta-builtin/builtin/isub n 1)))))

(define (©lambda.example-letrec.2 closure n.1)
  (let ((is-even (meta-builtin/builtin/closure-arg 0 closure)))
    (if (meta-builtin/builtin/equal n.1 0)
      meta-builtin/builtin/false
      ((meta-builtin/builtin/box-get is-even) (meta-builtin/builtin/isub n.1 1)))))

(define (©lambda.example-local-define.1 closure n)
  (let ((is-odd (meta-builtin/builtin/closure-arg 0 closure)))
    (if (meta-builtin/builtin/equal n 0)
      meta-builtin/builtin/true
      ((meta-builtin/builtin/box-get is-odd) (meta-builtin/builtin/isub n 1)))))

(define (©lambda.example-local-define.2 closure n.1)
  (let ((is-even (meta-builtin/builtin/closure-arg 0 closure)))
    (if (meta-builtin/builtin/equal n.1 0)
      meta-builtin/builtin/false
      ((meta-builtin/builtin/box-get is-even) (meta-builtin/builtin/isub n.1 1)))))