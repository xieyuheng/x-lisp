(define (sum9 x1 x2 x3 x4 x5 x6 ©rest)
  (let ((x7 (meta-builtin/builtin/list-get 0 ©rest)))
    (let ((x8 (meta-builtin/builtin/list-get 1 ©rest)))
      (let ((x9 (meta-builtin/builtin/list-get 2 ©rest)))
        (meta-builtin/builtin/iadd
         x1
         (meta-builtin/builtin/iadd
          x2
          (meta-builtin/builtin/iadd
           x3
           (meta-builtin/builtin/iadd
            x4
            (meta-builtin/builtin/iadd
             x5
             (meta-builtin/builtin/iadd
              x6
              (meta-builtin/builtin/iadd x7 (meta-builtin/builtin/iadd x8 x9))))))))))))

(define (test)
  (self/limit-arity/sum9
   1
   2
   3
   4
   5
   6
   (meta-builtin/builtin/cons
    7
    (meta-builtin/builtin/cons
