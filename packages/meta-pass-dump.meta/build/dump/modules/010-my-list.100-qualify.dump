        (if (self/010-my-list/li? list2)
          (begin
            (= tail2 (self/010-my-list/li-tail list2))
            (= head2 (self/010-my-list/li-head list2))
            (= tail1 (self/010-my-list/li-tail list1))
            (= head1 (self/010-my-list/li-head list1))
            (self/010-my-list/li
             (f head1 head2)
             (self/010-my-list/my-list-map-zip f tail1 tail2)))
