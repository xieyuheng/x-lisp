(define (my-list-adjacent-dedup list)
  (if (self/010-my-list/nil? list)
    (self/010-my-list/nil)
    (if (self/010-my-list/li? list)
      (if (self/010-my-list/nil? (self/010-my-list/li-tail list))
        (begin
          (= head (self/010-my-list/li-head list))
          (self/010-my-list/li head (self/010-my-list/nil)))
        (if (self/010-my-list/li? (self/010-my-list/li-tail list))
          (begin
            (= rest (self/010-my-list/li-tail (self/010-my-list/li-tail list)))
            (= second
               (self/010-my-list/li-head (self/010-my-list/li-tail list)))
            (= first (self/010-my-list/li-head list))
