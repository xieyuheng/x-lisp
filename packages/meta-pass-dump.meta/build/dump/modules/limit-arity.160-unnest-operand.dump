(define (sum9 x1 x2 x3 x4 x5 ©rest)
  (let ((x6 (meta-builtin/builtin/list-get 0 ©rest)))
    (let ((x7 (meta-builtin/builtin/list-get 1 ©rest)))
      (let ((x8 (meta-builtin/builtin/list-get 2 ©rest)))
        (let ((x9 (meta-builtin/builtin/list-get 3 ©rest)))
          (let ((unnested.1 (meta-builtin/builtin/iadd x8 x9)))
            (let ((unnested.2 (meta-builtin/builtin/iadd x7 unnested.1)))
              (let ((unnested.3 (meta-builtin/builtin/iadd x6 unnested.2)))
                (let ((unnested.4 (meta-builtin/builtin/iadd x5 unnested.3)))
                  (let ((unnested.5 (meta-builtin/builtin/iadd x4 unnested.4)))
                    (let
                        ((unnested.6 (meta-builtin/builtin/iadd x3 unnested.5)))
                      (let
                          ((unnested.7 (meta-builtin/builtin/iadd x2 unnested.6)))
                        (meta-builtin/builtin/iadd x1 unnested.7)))))))))))))

(define (test)
  (let ((unnested.1 (meta-builtin/builtin/make-list)))
    (let ((unnested.2 (meta-builtin/builtin/cons 9 unnested.1)))
      (let ((unnested.3 (meta-builtin/builtin/cons 8 unnested.2)))
        (let ((unnested.4 (meta-builtin/builtin/cons 7 unnested.3)))
          (let ((unnested.5 (meta-builtin/builtin/cons 6 unnested.4)))
            (self/limit-arity/sum9 1 2 3 4 5 unnested.5)))))))