(module my-list)

(define-algebraic-type (my-list-t E)
  ((nil) is-nil)
  ((li (head E) (tail (my-list-t E)))
   is-li
   (head li-head li-put-head)
   (tail li-tail li-put-tail)))

(admit nil (all (E) (-> (my-list-t E))))

(define (nil) (@list 'nil))

(admit is-nil (all (E) (-> (my-list-t E) meta-builtin/builtin/bool-t)))

(define (is-nil value)
  (and (meta-builtin/builtin/is-list value)
       (meta-builtin/builtin/equal (meta-builtin/builtin/list-length value) 1)
       (meta-builtin/builtin/equal (meta-builtin/builtin/list-head value) 'nil)))

(admit li (all (E) (-> E (my-list-t E) (my-list-t E))))

(define (li head tail) (@list 'li head tail))

(admit is-li (all (E) (-> (my-list-t E) meta-builtin/builtin/bool-t)))

(define (is-li value)
  (and (meta-builtin/builtin/is-list value)
       (meta-builtin/builtin/equal (meta-builtin/builtin/list-length value) 3)
       (meta-builtin/builtin/equal (meta-builtin/builtin/list-head value) 'li)))

(admit li-head (all (E) (-> (my-list-t E) E)))

(define (li-head target) (meta-builtin/builtin/list-get 1 target))

(admit li-put-head (all (E) (-> E (my-list-t E) (my-list-t E))))

(define (li-put-head value target)
  (begin (meta-builtin/builtin/list-put 1 value target) target))

(admit li-tail (all (E) (-> (my-list-t E) (my-list-t E))))

(define (li-tail target) (meta-builtin/builtin/list-get 2 target))

(admit li-put-tail (all (E) (-> (my-list-t E) (my-list-t E) (my-list-t E))))

(define (li-put-tail value target)
  (begin (meta-builtin/builtin/list-put 2 value target) target))

(define (my-list-head list) (match list ((li head tail) head)))

(define (my-list-rest list) (match list ((li head tail) tail)))

(define (my-list-length list)
  (match list ((nil) 0) ((li head tail) (iadd 1 (my-list-length tail)))))

(define (my-list-map f list)
  (match list ((nil) (nil)) ((li head tail) (li (f head) (my-list-map f tail)))))

(define (my-list-append left right)
  (match left
    ((nil) right)
    ((li head tail) (li head (my-list-append tail right)))))

(define (my-list-zip-map f list1 list2)
  (multi-match (list1 list2)
    (((nil) _) (nil))
    (((li head1 tail1) (nil)) (nil))
    (((li head1 tail1) (li head2 tail2))
     (li (f head1 head2) (my-list-zip-map f tail1 tail2)))))

(define (my-list-zip-map-2 f list1 list2)
  (multi-match (list1 list2)
    (((nil) _) (nil))
    ((_ (nil)) (nil))
    (((li head1 tail1) (li head2 tail2))
     (li (f head1 head2) (my-list-zip-map-2 f tail1 tail2)))))

(define (my-list-adjacent-dedup list)
  (match list
    ((nil) (nil))
    ((li head (nil)) (li head (nil)))
    ((li first (li second rest))
     (if (equal first second)
       (my-list-adjacent-dedup (li second rest))
       (li first (my-list-adjacent-dedup (li second rest)))))))