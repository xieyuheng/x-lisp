(import-all meta-builtin/builtin)

(module limit-arity)

(define (sum9 x1 x2 x3 x4 x5 x6 x7 x8 x9)
  (meta-builtin/builtin/iadd
   x1
   (meta-builtin/builtin/iadd
    x2
    (meta-builtin/builtin/iadd
     x3
     (meta-builtin/builtin/iadd
      x4
      (meta-builtin/builtin/iadd
       x5
       (meta-builtin/builtin/iadd
        x6
        (meta-builtin/builtin/iadd x7 (meta-builtin/builtin/iadd x8 x9)))))))))

(define (test) (sum9 1 2 3 4 5 6 7 8 9))