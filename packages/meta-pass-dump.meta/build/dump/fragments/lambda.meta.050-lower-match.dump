(import-all meta-builtin/builtin)

(module lambda)

(define-algebraic-type exp-t
  ((var-exp (name symbol-t)) is-var-exp (name var-exp-name var-exp-put-name))
  ((apply-exp (target exp-t) (arg exp-t))
   is-apply-exp
   (target apply-exp-target apply-exp-put-target)
   (arg apply-exp-arg apply-exp-put-arg))
  ((lambda-exp (parameter symbol-t) (body exp-t))
   is-lambda-exp
   (parameter lambda-exp-parameter lambda-exp-put-parameter)
   (body lambda-exp-body lambda-exp-put-body))
  ((let-exp (name symbol-t) (rhs exp-t) (body exp-t))
   is-let-exp
   (name let-exp-name let-exp-put-name)
   (rhs let-exp-rhs let-exp-put-rhs)
   (body let-exp-body let-exp-put-body)))

(admit var-exp (-> symbol-t exp-t))

(define (var-exp name) ['var-exp name])

(admit is-var-exp (-> exp-t bool-t))

(define (is-var-exp value)
  (and (is-list value)
       (equal (list-length value) 2)
       (equal (list-head value) 'var-exp)))

(admit var-exp-name (-> exp-t symbol-t))

(define (var-exp-name target) (list-get 1 target))

(admit var-exp-put-name (-> symbol-t exp-t exp-t))

(define (var-exp-put-name value target)
  (begin (list-put 1 value target) target))

(admit apply-exp (-> exp-t exp-t exp-t))

(define (apply-exp target arg) ['apply-exp target arg])

(admit is-apply-exp (-> exp-t bool-t))

(define (is-apply-exp value)
  (and (is-list value)
       (equal (list-length value) 3)
       (equal (list-head value) 'apply-exp)))

(admit apply-exp-target (-> exp-t exp-t))

(define (apply-exp-target target) (list-get 1 target))

(admit apply-exp-put-target (-> exp-t exp-t exp-t))

(define (apply-exp-put-target value target)
  (begin (list-put 1 value target) target))

(admit apply-exp-arg (-> exp-t exp-t))

(define (apply-exp-arg target) (list-get 2 target))

(admit apply-exp-put-arg (-> exp-t exp-t exp-t))

(define (apply-exp-put-arg value target)
  (begin (list-put 2 value target) target))

(admit lambda-exp (-> symbol-t exp-t exp-t))

(define (lambda-exp parameter body) ['lambda-exp parameter body])

(admit is-lambda-exp (-> exp-t bool-t))

(define (is-lambda-exp value)
  (and (is-list value)
       (equal (list-length value) 3)
       (equal (list-head value) 'lambda-exp)))

(admit lambda-exp-parameter (-> exp-t symbol-t))

(define (lambda-exp-parameter target) (list-get 1 target))

(admit lambda-exp-put-parameter (-> symbol-t exp-t exp-t))

(define (lambda-exp-put-parameter value target)
  (begin (list-put 1 value target) target))

(admit lambda-exp-body (-> exp-t exp-t))

(define (lambda-exp-body target) (list-get 2 target))

(admit lambda-exp-put-body (-> exp-t exp-t exp-t))

(define (lambda-exp-put-body value target)
  (begin (list-put 2 value target) target))

(admit let-exp (-> symbol-t exp-t exp-t exp-t))

(define (let-exp name rhs body) ['let-exp name rhs body])

(admit is-let-exp (-> exp-t bool-t))

(define (is-let-exp value)
  (and (is-list value)
       (equal (list-length value) 4)
       (equal (list-head value) 'let-exp)))

(admit let-exp-name (-> exp-t symbol-t))

(define (let-exp-name target) (list-get 1 target))

(admit let-exp-put-name (-> symbol-t exp-t exp-t))

(define (let-exp-put-name value target)
  (begin (list-put 1 value target) target))

(admit let-exp-rhs (-> exp-t exp-t))

(define (let-exp-rhs target) (list-get 2 target))

(admit let-exp-put-rhs (-> exp-t exp-t exp-t))

(define (let-exp-put-rhs value target) (begin (list-put 2 value target) target))

(admit let-exp-body (-> exp-t exp-t))

(define (let-exp-body target) (list-get 3 target))

(admit let-exp-put-body (-> exp-t exp-t exp-t))

(define (let-exp-put-body value target)
  (begin (list-put 3 value target) target))

(define-opaque-type env-t (hash-t symbol-t value-t)
  (empty-env (-> env-t))
  (extend-env (-> symbol-t value-t env-t env-t))
  (env-lookup (-> symbol-t env-t (maybe-t value-t))))

(define empty-env make-hash)

(define extend-env hash-copy-put)

(define env-lookup hash-get-maybe)

(define-algebraic-type value-t
  ((closure-value (env env-t) (parameter symbol-t) (body exp-t))
   is-closure-value
   (env closure-value-env closure-value-put-env)
   (parameter closure-value-parameter closure-value-put-parameter)
   (body closure-value-body closure-value-put-body)))

(admit closure-value (-> env-t symbol-t exp-t value-t))

(define (closure-value env parameter body) ['closure-value env parameter body])

(admit is-closure-value (-> value-t bool-t))

(define (is-closure-value value)
  (and (is-list value)
       (equal (list-length value) 4)
       (equal (list-head value) 'closure-value)))

(admit closure-value-env (-> value-t env-t))

(define (closure-value-env target) (list-get 1 target))

(admit closure-value-put-env (-> env-t value-t value-t))

(define (closure-value-put-env value target)
  (begin (list-put 1 value target) target))

(admit closure-value-parameter (-> value-t symbol-t))

(define (closure-value-parameter target) (list-get 2 target))

(admit closure-value-put-parameter (-> symbol-t value-t value-t))

(define (closure-value-put-parameter value target)
  (begin (list-put 2 value target) target))

(admit closure-value-body (-> value-t exp-t))

(define (closure-value-body target) (list-get 3 target))

(admit closure-value-put-body (-> exp-t value-t value-t))

(define (closure-value-put-body value target)
  (begin (list-put 3 value target) target))

(define (evaluate exp env)
  (cond
    ((self/lambda/is-var-exp exp)
     (let ((name (self/lambda/var-exp-name exp)))
       (cond
         ((meta-builtin/builtin/is-just (env-lookup name env))
          (let ((value (meta-builtin/builtin/just-value (env-lookup name env))))
            value))
         ((meta-builtin/builtin/is-nothing (env-lookup name env))
          (error "undefined name")))))
    ((self/lambda/is-apply-exp exp)
     (let ((arg (self/lambda/apply-exp-arg exp)))
       (let ((target (self/lambda/apply-exp-target exp)))
         (apply (evaluate target env) (evaluate arg env)))))
    ((self/lambda/is-lambda-exp exp)
     (let ((body (self/lambda/lambda-exp-body exp)))
       (let ((parameter (self/lambda/lambda-exp-parameter exp)))
         (closure-value env parameter body))))
    ((self/lambda/is-let-exp exp)
     (let ((body (self/lambda/let-exp-body exp)))
       (let ((rhs (self/lambda/let-exp-rhs exp)))
         (let ((name (self/lambda/let-exp-name exp)))
           (let ((env (extend-env name (evaluate rhs env) env)))
             (evaluate body env))))))))

(define (apply target arg)
  (cond
    ((self/lambda/is-closure-value target)
     (let ((body (self/lambda/closure-value-body target)))
       (let ((parameter (self/lambda/closure-value-parameter target)))
         (let ((env (self/lambda/closure-value-env target)))
           (evaluate body (extend-env parameter arg env))))))))