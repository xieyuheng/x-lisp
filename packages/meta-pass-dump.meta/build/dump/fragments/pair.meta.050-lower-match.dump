(import-all meta-builtin/builtin)

(module pair)

(define-algebraic-type (pair-t A B)
  ((make-pair (first A) (second B))
   is-pair
   (first pair-first pair-put-first!)
   (second pair-second pair-put-second!)))

(admit make-pair (polymorphic (A B) (-> A B (pair-t A B))))

(define (make-pair first second) ['make-pair first second])

(admit is-pair (polymorphic (A B) (-> (pair-t A B) bool-t)))

(define (is-pair value)
  (and (is-list value)
       (equal (list-length value) 3)
       (equal (list-head value) 'make-pair)))

(admit pair-first (polymorphic (A B) (-> (pair-t A B) A)))

(define (pair-first target) (list-get 1 target))

(admit pair-put-first! (polymorphic (A B) (-> A (pair-t A B) (pair-t A B))))

(define (pair-put-first! value target)
  (begin (list-put! 1 value target) target))

(admit pair-second (polymorphic (A B) (-> (pair-t A B) B)))

(define (pair-second target) (list-get 2 target))

(admit pair-put-second! (polymorphic (A B) (-> B (pair-t A B) (pair-t A B))))

(define (pair-put-second! value target)
  (begin (list-put! 2 value target) target))

(define (pair-swap p)
  (cond
    ((self/pair/is-pair p)
     (let ((b (self/pair/pair-second p)))
       (let ((a (self/pair/pair-first p))) (make-pair b a))))))