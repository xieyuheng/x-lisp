(import-all meta-builtin/builtin)

(module lambda)

(define-algebraic-type term-t
  ((var-term (name meta-builtin/builtin/symbol-t))
   is-var-term
   (name var-term-name var-term-put-name))
  ((apply-term (target term-t) (arg term-t))
   is-apply-term
   (target apply-term-target apply-term-put-target)
   (arg apply-term-arg apply-term-put-arg))
  ((lambda-term (parameter meta-builtin/builtin/symbol-t) (body term-t))
   is-lambda-term
   (parameter lambda-term-parameter lambda-term-put-parameter)
   (body lambda-term-body lambda-term-put-body))
  ((let-term (name meta-builtin/builtin/symbol-t) (rhs term-t) (body term-t))
   is-let-term
   (name let-term-name let-term-put-name)
   (rhs let-term-rhs let-term-put-rhs)
   (body let-term-body let-term-put-body)))

(admit var-term (-> meta-builtin/builtin/symbol-t term-t))

(define (var-term name)
  (let ((list (meta-builtin/builtin/make-list)))
    (begin
      (meta-builtin/builtin/list-push var-term list)
      (begin (meta-builtin/builtin/list-push name list) list))))

(admit is-var-term (-> term-t meta-builtin/builtin/bool-t))

(define (is-var-term value)
  (if (meta-builtin/builtin/is-list value)
    (if (meta-builtin/builtin/equal (meta-builtin/builtin/list-length value) 2)
      (meta-builtin/builtin/equal
       (meta-builtin/builtin/list-head value)
       var-term)
      meta-builtin/builtin/false)
    meta-builtin/builtin/false))

(admit var-term-name (-> term-t meta-builtin/builtin/symbol-t))

(define (var-term-name target) (meta-builtin/builtin/list-get 1 target))

(admit var-term-put-name (-> meta-builtin/builtin/symbol-t term-t term-t))

(define (var-term-put-name value target)
  (begin (meta-builtin/builtin/list-put 1 value target) target))

(admit apply-term (-> term-t term-t term-t))

(define (apply-term target arg)
  (let ((list (meta-builtin/builtin/make-list)))
    (begin
      (meta-builtin/builtin/list-push apply-term list)
      (begin
        (meta-builtin/builtin/list-push target list)
        (begin (meta-builtin/builtin/list-push arg list) list)))))

(admit is-apply-term (-> term-t meta-builtin/builtin/bool-t))

(define (is-apply-term value)
  (if (meta-builtin/builtin/is-list value)
    (if (meta-builtin/builtin/equal (meta-builtin/builtin/list-length value) 3)
      (meta-builtin/builtin/equal
       (meta-builtin/builtin/list-head value)
       apply-term)
      meta-builtin/builtin/false)
    meta-builtin/builtin/false))

(admit apply-term-target (-> term-t term-t))

(define (apply-term-target target) (meta-builtin/builtin/list-get 1 target))

(admit apply-term-put-target (-> term-t term-t term-t))

(define (apply-term-put-target value target)
  (begin (meta-builtin/builtin/list-put 1 value target) target))

(admit apply-term-arg (-> term-t term-t))

(define (apply-term-arg target) (meta-builtin/builtin/list-get 2 target))

(admit apply-term-put-arg (-> term-t term-t term-t))

(define (apply-term-put-arg value target)
  (begin (meta-builtin/builtin/list-put 2 value target) target))

(admit lambda-term (-> meta-builtin/builtin/symbol-t term-t term-t))

(define (lambda-term parameter body)
  (let ((list (meta-builtin/builtin/make-list)))
    (begin
      (meta-builtin/builtin/list-push lambda-term list)
      (begin
        (meta-builtin/builtin/list-push parameter list)
        (begin (meta-builtin/builtin/list-push body list) list)))))

(admit is-lambda-term (-> term-t meta-builtin/builtin/bool-t))

(define (is-lambda-term value)
  (if (meta-builtin/builtin/is-list value)
    (if (meta-builtin/builtin/equal (meta-builtin/builtin/list-length value) 3)
      (meta-builtin/builtin/equal
       (meta-builtin/builtin/list-head value)
       lambda-term)
      meta-builtin/builtin/false)
    meta-builtin/builtin/false))

(admit lambda-term-parameter (-> term-t meta-builtin/builtin/symbol-t))

(define (lambda-term-parameter target) (meta-builtin/builtin/list-get 1 target))

(admit lambda-term-put-parameter
  (-> meta-builtin/builtin/symbol-t term-t term-t))

(define (lambda-term-put-parameter value target)
  (begin (meta-builtin/builtin/list-put 1 value target) target))

(admit lambda-term-body (-> term-t term-t))

(define (lambda-term-body target) (meta-builtin/builtin/list-get 2 target))

(admit lambda-term-put-body (-> term-t term-t term-t))

(define (lambda-term-put-body value target)
  (begin (meta-builtin/builtin/list-put 2 value target) target))

(admit let-term (-> meta-builtin/builtin/symbol-t term-t term-t term-t))

(define (let-term name rhs body)
  (let ((list (meta-builtin/builtin/make-list)))
    (begin
      (meta-builtin/builtin/list-push let-term list)
      (begin
        (meta-builtin/builtin/list-push name list)
        (begin
          (meta-builtin/builtin/list-push rhs list)
          (begin (meta-builtin/builtin/list-push body list) list))))))

(admit is-let-term (-> term-t meta-builtin/builtin/bool-t))

(define (is-let-term value)
  (if (meta-builtin/builtin/is-list value)
    (if (meta-builtin/builtin/equal (meta-builtin/builtin/list-length value) 4)
      (meta-builtin/builtin/equal
       (meta-builtin/builtin/list-head value)
       let-term)
      meta-builtin/builtin/false)
    meta-builtin/builtin/false))

(admit let-term-name (-> term-t meta-builtin/builtin/symbol-t))

(define (let-term-name target) (meta-builtin/builtin/list-get 1 target))

(admit let-term-put-name (-> meta-builtin/builtin/symbol-t term-t term-t))

(define (let-term-put-name value target)
  (begin (meta-builtin/builtin/list-put 1 value target) target))

(admit let-term-rhs (-> term-t term-t))

(define (let-term-rhs target) (meta-builtin/builtin/list-get 2 target))

(admit let-term-put-rhs (-> term-t term-t term-t))

(define (let-term-put-rhs value target)
  (begin (meta-builtin/builtin/list-put 2 value target) target))

(admit let-term-body (-> term-t term-t))

(define (let-term-body target) (meta-builtin/builtin/list-get 3 target))

(admit let-term-put-body (-> term-t term-t term-t))

(define (let-term-put-body value target)
  (begin (meta-builtin/builtin/list-put 3 value target) target))

(define-opaque-type env-t
    (meta-builtin/builtin/hash-t meta-builtin/builtin/symbol-t value-t)
  (empty-env (-> env-t))
  (extend-env (-> meta-builtin/builtin/symbol-t value-t env-t env-t))
  (env-lookup
   (-> meta-builtin/builtin/symbol-t
       env-t
       (meta-builtin/builtin/maybe-t value-t))))

(define empty-env meta-builtin/builtin/make-hash)

(define extend-env meta-builtin/builtin/hash-copy-put)

(define env-lookup meta-builtin/builtin/hash-get-maybe)

(define-algebraic-type value-t
  ((closure-value
    (env env-t)
    (parameter meta-builtin/builtin/symbol-t)
    (body term-t))
   is-closure-value
   (env closure-value-env closure-value-put-env)
   (parameter closure-value-parameter closure-value-put-parameter)
   (body closure-value-body closure-value-put-body)))

(admit closure-value (-> env-t meta-builtin/builtin/symbol-t term-t value-t))

(define (closure-value env parameter body)
  (let ((list (meta-builtin/builtin/make-list)))
    (begin
      (meta-builtin/builtin/list-push closure-value list)
      (begin
        (meta-builtin/builtin/list-push env list)
        (begin
          (meta-builtin/builtin/list-push parameter list)
          (begin (meta-builtin/builtin/list-push body list) list))))))

(admit is-closure-value (-> value-t meta-builtin/builtin/bool-t))

(define (is-closure-value value)
  (if (meta-builtin/builtin/is-list value)
    (if (meta-builtin/builtin/equal (meta-builtin/builtin/list-length value) 4)
      (meta-builtin/builtin/equal
       (meta-builtin/builtin/list-head value)
       closure-value)
      meta-builtin/builtin/false)
    meta-builtin/builtin/false))

(admit closure-value-env (-> value-t env-t))

(define (closure-value-env target) (meta-builtin/builtin/list-get 1 target))

(admit closure-value-put-env (-> env-t value-t value-t))

(define (closure-value-put-env value target)
  (begin (meta-builtin/builtin/list-put 1 value target) target))

(admit closure-value-parameter (-> value-t meta-builtin/builtin/symbol-t))

(define (closure-value-parameter target)
  (meta-builtin/builtin/list-get 2 target))

(admit closure-value-put-parameter
  (-> meta-builtin/builtin/symbol-t value-t value-t))

(define (closure-value-put-parameter value target)
  (begin (meta-builtin/builtin/list-put 2 value target) target))

(admit closure-value-body (-> value-t term-t))

(define (closure-value-body target) (meta-builtin/builtin/list-get 3 target))

(admit closure-value-put-body (-> term-t value-t value-t))

(define (closure-value-put-body value target)
  (begin (meta-builtin/builtin/list-put 3 value target) target))

(define (evaluate term env)
  (if (self/lambda/is-var-term term)
    (let ((name (self/lambda/var-term-name term)))
      (if (meta-builtin/builtin/is-just (env-lookup name env))
        (let ((value (meta-builtin/builtin/just-value (env-lookup name env))))
          value)
        (if (meta-builtin/builtin/is-nothing (env-lookup name env))
          (meta-builtin/builtin/error "undefined name")
          (meta-builtin/builtin/error "cond mismatch"))))
    (if (self/lambda/is-apply-term term)
      (let ((arg (self/lambda/apply-term-arg term)))
        (let ((target (self/lambda/apply-term-target term)))
          (apply (evaluate target env) (evaluate arg env))))
      (if (self/lambda/is-lambda-term term)
        (let ((body (self/lambda/lambda-term-body term)))
          (let ((parameter (self/lambda/lambda-term-parameter term)))
            (closure-value env parameter body)))
        (if (self/lambda/is-let-term term)
          (let ((body (self/lambda/let-term-body term)))
            (let ((rhs (self/lambda/let-term-rhs term)))
              (let ((name (self/lambda/let-term-name term)))
                (let ((env (extend-env name (evaluate rhs env) env)))
                  (evaluate body env)))))
          (meta-builtin/builtin/error "cond mismatch"))))))

(define (apply target arg)
  (if (self/lambda/is-closure-value target)
    (let ((body (self/lambda/closure-value-body target)))
      (let ((parameter (self/lambda/closure-value-parameter target)))
        (let ((env (self/lambda/closure-value-env target)))
          (evaluate body (extend-env parameter arg env)))))
    (meta-builtin/builtin/error "cond mismatch")))