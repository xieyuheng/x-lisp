(module function-reference)

(define (add1 x) (iadd x 1))

(define (sub1 x) (isub x 1))

(define (identity x) x)

(define (apply-to-zero f) (f 0))

(define (compose2 f g x) (f (g x)))

(define (swap f x y) (f y x))

;; add1 passed as value → add1©wrap + closure
(define (example-function-as-argument)
  (apply-to-zero add1))

;; sub1 passed as value → sub1©wrap + closure
(define (example-second-function-as-argument)
  (apply-to-zero sub1))

;; identity passed as value → identity©wrap + closure
(define (example-identity-as-argument)
  (apply-to-zero identity))

;; f and g in call position (not wrapped);
;; add1 and sub1 passed as value (wrapped)
(define (example-compose2)
  (compose2 add1 sub1 5))

;; f in call position (not wrapped)
(define (example-swap)
  (swap iadd 3 4))
