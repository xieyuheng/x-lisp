(模块 元语例子)

(定义测试 列表名字碰撞测试
  (令 ((列表 42)
       (列表.1 "wrong"))
    (断言相等 [42] (@列表 列表))
    (断言相等 [42 42] (@列表 列表 列表))
    (断言相等 [1 2 3] (@列表 1 2 3))))

(定义测试 集合名字碰撞测试
  (令 ((集合 "hello")
       (集合.1 "wrong"))
    (断言相等 (@集合 集合) (@集合 "hello"))))

(定义测试 散列名字碰撞测试
  (令 ((散列 "value")
       (散列.1 "wrong"))
    (断言相等 (@散列 "key" 散列) (@散列 "key" "value"))))

(定义测试 文本名字碰撞测试
  (令 ((列表 "hello"))
    (断言相等 "hello" (@文本 列表))))

(定义测试 嵌套列表名字碰撞测试
  (令 ((列表 42))
    (断言相等 [[42]] (@列表 (@列表 列表)))))
