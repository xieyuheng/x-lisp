(模块 元语例子)

(定义测试 令测试
  (断言相等 3 (令 ((甲 1)
                   (乙 (整数加 1 甲)))
                (整数加 甲 乙)))
  (断言相等 3 (令 ((甲 1)
                   (乙 2))
                (整数加 甲 乙)))
  (断言相等 3 (令 ((甲 1)
                   (乙 2))
                (断言相等 甲 1)
                (断言相等 乙 2)
                (令 ((临时 甲)
                     (甲 乙))
                  (断言相等 甲 2)
                  (令 ((乙 临时))
                    (断言相等 乙 1)
                    (整数加 甲 乙))))))
