(模块 元语例子)

(定义测试 符号算式符号测试
  (令 ((符号算式 (@符号算式 foo)))
    (断言 (为符号符号算式 符号算式))
    (断言相等 'foo (符号符号算式内容 符号算式))
    (断言 (为源码位置 (符号符号算式位置 符号算式)))))

(定义测试 符号算式文本测试
  (令 ((符号算式 (@符号算式 "hello")))
    (断言 (为文本符号算式 符号算式))
    (断言相等 "hello" (文本符号算式内容 符号算式))
    (断言 (为源码位置 (文本符号算式位置 符号算式)))))

(定义测试 符号算式整数测试
  (令 ((符号算式 (@符号算式 42)))
    (断言 (为整数符号算式 符号算式))
    (断言相等 42 (整数符号算式内容 符号算式))
    (断言 (为源码位置 (整数符号算式位置 符号算式)))))

(定义测试 符号算式浮点测试
  (令 ((符号算式 (@符号算式 3.14)))
    (断言 (为浮点符号算式 符号算式))
    (断言相等 3.14 (浮点符号算式内容 符号算式))
    (断言 (为源码位置 (浮点符号算式位置 符号算式)))))

(定义测试 符号算式标签测试
  (令 ((符号算式 (@符号算式 :hello)))
    (断言 (为标签符号算式 符号算式))
    (断言相等 :hello (标签符号算式内容 符号算式))
    (断言 (为源码位置 (标签符号算式位置 符号算式)))))

(定义测试 符号算式空列表测试
  (令 ((符号算式 (@符号算式 ())))
    (断言 (为列表符号算式 符号算式))
    (令 ((元素列表 (列表符号算式元素 符号算式)))
      (断言 (列表为空 元素列表)))
    (断言 (为源码位置 (列表符号算式位置 符号算式)))))

(定义测试 符号算式列表测试
  (令 ((符号算式 (@符号算式 (a b c))))
    (断言 (为列表符号算式 符号算式))
    (令 ((元素列表 (列表符号算式元素 符号算式)))
      (断言相等 3 (列表长度 元素列表))
      (断言 (为符号符号算式 (首 元素列表)))
      (断言相等 'a (符号符号算式内容 (首 元素列表)))
      (断言相等 'b (符号符号算式内容 (首 (余 元素列表))))
      (断言相等 'c (符号符号算式内容 (首 (余 (余 元素列表))))))
    (断言 (为源码位置 (列表符号算式位置 符号算式)))))

(定义测试 符号算式混合列表测试
  (令 ((符号算式 (@符号算式 (1 "two" :three four))))
    (断言 (为列表符号算式 符号算式))
    (令 ((元素列表 (列表符号算式元素 符号算式)))
      (断言相等 4 (列表长度 元素列表))
      (断言 (为整数符号算式 (首 元素列表)))
      (断言相等 1 (整数符号算式内容 (首 元素列表)))
      (断言 (为文本符号算式 (首 (余 元素列表))))
      (断言相等 "two" (文本符号算式内容 (首 (余 元素列表))))
      (断言 (为标签符号算式 (首 (余 (余 元素列表)))))
      (断言相等 :three (标签符号算式内容 (首 (余 (余 元素列表)))))
      (断言 (为符号符号算式 (首 (余 (余 (余 元素列表))))))
      (断言相等 'four (符号符号算式内容 (首 (余 (余 (余 元素列表)))))))))

(定义测试 符号算式嵌套列表测试
  (令 ((符号算式 (@符号算式 (a (b c) d))))
    (断言 (为列表符号算式 符号算式))
    (令 ((元素列表 (列表符号算式元素 符号算式)))
      (断言相等 3 (列表长度 元素列表))
      (断言 (为符号符号算式 (首 元素列表)))
      (断言 (为列表符号算式 (首 (余 元素列表))))
      (令 ((内部元素列表 (列表符号算式元素 (首 (余 元素列表)))))
        (断言相等 2 (列表长度 内部元素列表))
        (断言 (为符号符号算式 (首 内部元素列表)))
        (断言相等 'b (符号符号算式内容 (首 内部元素列表)))
        (断言相等 'c (符号符号算式内容 (首 (余 内部元素列表)))))
      (断言相等 'd (符号符号算式内容 (首 (余 (余 元素列表))))))))

(定义测试 符号算式嵌套嵌套列表测试
  (令 ((符号算式 (@符号算式 ((a b) c))))
    (断言 (为列表符号算式 符号算式))
    (令 ((元素列表 (列表符号算式元素 符号算式)))
      (断言相等 2 (列表长度 元素列表))
      (断言 (为列表符号算式 (首 元素列表)))
      (令 ((内部元素列表 (列表符号算式元素 (首 元素列表))))
        (断言 (为符号符号算式 (首 内部元素列表)))
        (断言相等 'a (符号符号算式内容 (首 内部元素列表)))
        (断言相等 'b (符号符号算式内容 (首 (余 内部元素列表)))))
      (断言 (为符号符号算式 (首 (余 元素列表))))
      (断言相等 'c (符号符号算式内容 (首 (余 元素列表)))))))

(定义测试 符号算式引用对比测试
  (令 ((符号算式值 (@符号算式 (a b c)))
       (引用值 (@引用 (a b c))))
    (断言 (为列表符号算式 符号算式值))
    (断言 (为列表 引用值))))

(定义测试 符号算式负整数测试
  (令 ((符号算式 (@符号算式 -1)))
    (断言 (为整数符号算式 符号算式))
    (断言相等 -1 (整数符号算式内容 符号算式))))

(定义测试 符号算式负浮点测试
  (令 ((符号算式 (@符号算式 -2.5)))
    (断言 (为浮点符号算式 符号算式))
    (断言相等 -2.5 (浮点符号算式内容 符号算式))))
