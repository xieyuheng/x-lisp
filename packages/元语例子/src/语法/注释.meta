(模块 例子)

(定义测试 注释求值为空测试
  (断言 (为空 (@注释 内容)))
  (断言 (为空 (@注释 (结构化注释内容)))))

(定义测试 表达式内注释测试
  (断言相等 42
    (循序
      (@注释 (注释测试))
      42))
  (断言相等 3
    (令 ((甲 1)
         (乙 2))
      (@注释 (整数加 甲 乙))
      (整数加 甲 乙))))

(@注释 (语句注释测试))

(定义测试 任意内容注释测试
  (@注释 符号)
  (@注释 "文本")
  (@注释 42)
  (@注释 (嵌套 内容))
  (断言 真))
