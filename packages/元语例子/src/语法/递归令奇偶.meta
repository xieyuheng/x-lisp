(模块 递归令)

(定义测试 奇偶测试
  (递归令
    ((为偶数 (函 (数) (若 (相等 数 0) 真 (为奇数 (整数减 数 1)))))
     (为奇数 (函 (数) (若 (相等 数 0) 假 (为偶数 (整数减 数 1))))))

    (断言 (为偶数 0))
    (断言非 (为偶数 1))
    (断言 (为偶数 2))
    (断言非 (为偶数 3))
    (断言 (为偶数 4))

    (断言非 (为奇数 0))
    (断言 (为奇数 1))
    (断言非 (为奇数 2))
    (断言 (为奇数 3))
    (断言非 (为奇数 4))))
