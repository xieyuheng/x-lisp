(模块 点记录)

(定义记录类型 点型
  (作点 (横坐标 浮点型) (纵坐标 浮点型))
  为点
  (横坐标 点横坐标 点存横坐标)
  (纵坐标 点纵坐标))

;; - 如果不提供 <修改器名>，修改器就被隐藏。
;; - 通过重新定义来测试隐藏的修改器。

(定义 点存纵坐标 42)

(定义 (点距离平方 点)
  (浮点加
    (浮点乘 (点横坐标 点) (点横坐标 点))
    (浮点乘 (点纵坐标 点) (点纵坐标 点))))

(定义测试 点测试
  (令 ((点 (作点 1.0 2.0)))
    (断言相等 1.0 (点横坐标 点))
    (断言相等 2.0 (点纵坐标 点))
    (断言相等 5.0 (点距离平方 点))))
