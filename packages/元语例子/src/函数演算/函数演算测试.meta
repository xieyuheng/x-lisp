(模块 元语例子)

(定义 (求值并打印 项)
  (打印行 (求值 项 (空环境))))

(定义测试 函数演算解释器测试
  (求值并打印
   (函数项 'x (变量项 'x)))

  (求值并打印
   (作用项
    (函数项 'x (变量项 'x))
    (函数项 'x (变量项 'x))))

  (求值并打印
   (作用项
    (作用项
     (函数项 'x (变量项 'x))
     (函数项 'x (变量项 'x)))
    (作用项
     (函数项 'x (变量项 'x))
     (函数项 'x (变量项 'x)))))

  (求值并打印
   (令项
    'id (函数项 'x (变量项 'x))
    (变量项 'id)))

  (求值并打印
   (令项
    'id (函数项 'x (变量项 'x))
    (作用项 (变量项 'id) (变量项 'id))))

  (求值并打印
   (令项
    'id (函数项 'x (变量项 'x))
    (作用项
     (作用项 (变量项 'id) (变量项 'id))
     (作用项 (变量项 'id) (变量项 'id))))))
