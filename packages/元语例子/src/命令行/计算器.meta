(模块 计算器)

(导入为 命令行/命令行 命令行)

(定义 (主)
  (定义 路由器 (命令行/新建路由器 "calculator" "0.1.0"))

  (命令行/定义路由 路由器 "hello -- say hello")
  (命令行/定义路由 路由器 "add x y -- add two numbers")
  (命令行/定义路由 路由器 "mul --x --y -- multiply two numbers")
  (命令行/定义路由 路由器 "bye -- say bye bye")
  (命令行/定义路由 路由器 "passthrough -- print passthrough args")

  (命令行/定义处理函数 路由器 "hello" 处理你好)
  (命令行/定义处理函数 路由器 "add" 处理加)
  (命令行/定义处理函数 路由器 "mul" 处理乘)
  (命令行/定义处理函数 路由器 "bye" 处理再见)
  (命令行/定义处理函数 路由器 "passthrough" 处理透传)

  (命令行/路由器运行 路由器 (当前命令行)))

(定义 (处理你好 语境)
  (打印行 "hello world"))

(定义 (处理加 语境)
  (令 ((甲 (文本转整数 (命令行/取参数 0 语境)))
       (乙 (文本转整数 (命令行/取参数 1 语境))))
    (打印行 (整数加 甲 乙))))

(定义 (处理乘 语境)
  (令 ((甲 (文本转整数 (命令行/取选项 "--x" 语境)))
       (乙 (文本转整数 (命令行/取选项 "--y" 语境))))
    (打印行 (整数乘 甲 乙))))

(定义 (处理再见 语境)
  (打印行 "bye bye"))

(定义 (处理透传 语境)
  (打印行 (文本连接 " " (命令行/语境透传列表 语境))))
