(模块 例子)

(定义枚举 项型
  (变量项 (名 符号型))
  (作用项 (目标 项型) (参数 项型))
  (函项 (形参 符号型) (体 项型))
  (令项 (名 符号型) (所令 项型) (体 项型)))

(定义黑盒类型 环境型 (散列型 符号型 值型)
  (空环境 (-> 环境型))
  (扩展环境 (-> 符号型 值型 环境型 环境型))
  (环境查找 (-> 符号型 环境型 (或有型 值型))))

(定义 空环境 作散列)
(定义 扩展环境 散列复制存)
(定义 环境查找 散列取或有)

(定义枚举 值型
  (闭包值 (环境 环境型) (形参 符号型) (体 项型)))

(定义 (求值 项 环境)
  (匹配 项
    ((变量项 名)
     (匹配 (环境查找 名 环境)
       ((有 值) 值)
       ((无) (报错 "未定义的名字"))))
    ((作用项 目标 参数)
     (作用 (求值 目标 环境) (求值 参数 环境)))
    ((函项 形参 体)
     (闭包值 环境 形参 体))
    ((令项 名 所令 体)
     (令 ((环境 (扩展环境 名 (求值 所令 环境) 环境)))
       (求值 体 环境)))))

(定义 (作用 目标 参数)
  (匹配 目标
    ((闭包值 环境 形参 体)
     (求值 体 (扩展环境 形参 参数 环境)))))
