(定义测试 文件测试
  (令 ((文件 (打开输入文件 "src/文件/file-1.txt")))
    (断言相等 "abc\n" (文件读 文件))
    (文件关闭 文件))

  (令 ((文件 (打开输出文件 "src/文件/file-2.txt")))
    (文件写 文件 "123\n")
    (文件关闭 文件))

  (令 ((文件 (打开输入文件 "src/文件/file-2.txt")))
    (断言相等 "123\n" (文件读 文件))
    (文件关闭 文件))

  (令 ((文件 (打开输出文件 "src/文件/file-2.txt")))
    (文件写 文件 "abc\n")
    (文件关闭 文件))

