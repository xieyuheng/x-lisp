(module l3-deep-nest)

(define-enum (option-t E)
  (some (value E))
  (none))

(define (process-data input threshold)
  (let* ((input-len (string-length input))
         (is-long (int-greater? input-len threshold))
         (result (if is-long
                   (some input-len)
                   (none))))
    (match result
      ((some len)
       (cond
         ((int-greater? len 100)
          (begin
            (println "large!")
            (ineg len)))
         ((int-positive? len)
          len)
         (else 0)))
      ((none)
       (begin
         (println "empty!")
         0)))))
