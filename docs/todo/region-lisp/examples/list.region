(define-struct (node-t E)
  (prev (nullable (node-t E)))
  (next (nullable (node-t E)))
  (value E))

;; - polymorphic E can only be a pointer-t or a 64-bit value.

(define-struct (list-t E)
  (first (nullable (node-t E)))
  (last (nullable (node-t E)))
  (cursor (nullable (node-t E)))
  (length int-t)
  (free-fn (-> E void-t))
  (equal-fn (-> E E bool-t))
  (copy-fn (-> E E)))

(admit list-first
  (all (E)
    (-> (list-t E)
        (nullable (node-t E)))))

(admit list-put-first
  (all (E)
    (-> (list-t E) (node-t E)
        void-t)))

(claim make-list
  (all (E)
    (-> (list-t E))))

(define (make-list)
  (= self (new list-t))
  (list-put-length self 0)
  self)

(claim list-free
  (all (E)
    (-> (list-t E) void-t)))

(define (list-destroy self)
  (list-purge self)
  (free self))

(claim list-purge
  (all (E)
    (-> (list-t E) void-t)))

(define (list-purge self)
  (= node (list-first self))
  (while (not (is-null node))
    (= next (node-next node))
    (unless (is-null (list-free-fn self))
      ((list-free-fn self) (node-value node)))
    (free node)
    (= node next))
  (list-put-first self null)
  (list-put-last self null)
  (list-put-cursor self null)
  (list-put-length self 0))
