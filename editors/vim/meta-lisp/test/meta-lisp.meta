;; test/meta-lisp.meta --- syntax highlight and indent test.
;;
;; Load this file in vim or neovim with:
;;   :set rtp+=editors/vim
;;   :set filetype=meta-lisp
;;
;; Then verify:
;;   - Syntax colors: all groups below are exercised.
;;   - Indentation: press =G to auto-indent entire buffer.

(module syntax-test)
(import math pi circumference)
(import-as meta m)
(import-all builtin)
(private helper)

;; ---- Atomic values ----
;; metaLispConstant: true false void
;; metaLispType:      int-t float-t string-t symbol-t keyword-t bool-t void-t file-t
;; metaLispNumber:    42 -1 3.14 -2.5
;; metaLispString:    "hello" ""
;; metaLispQuoteSymbol: 'foo
;; metaLispKeywordValue: :key :name :host :port

(claim answer int-t)
(define answer 42)

(claim greeting string-t)
(define greeting "hello world")

(claim flag bool-t)
(define flag true)

(define sym 'hello)
(define config (@hash :host "localhost" :port 8080))
(define xs [1 2 3 4 5])
(define ys (@list 1 2 3 4 5))
(define ss (@set "a" "b" "c"))

;; ---- Simple function -- spec 1: define ----
(define (square x)
  (imul x x))

(define (add1 x)
  (iadd 1 x))

;; ---- Multi-line function-call indent ----
(define (distance-squared p)
  (fadd (fmul (point-x p)
              (point-x p))
        (fmul (point-y p)
              (point-y p))))

;; ---- Polymorphic claim -- spec 1: polymorphic ----
(claim identity (polymorphic (A)
                  (-> A A)))
(define (identity x) x)

;; ---- Conditional: if -- spec 1 ----
(define (abs x)
  (if (int-less? x 0)
    (ineg x)
    x))

;; ---- Conditional: cond -- spec 0 ----
(define (classify x)
  (cond
    ((int-positive? x) "positive")
    ((int-negative? x) "negative")
    (else "zero")))

;; ---- Conditional: when / unless -- spec 1 ----
(when true
  (println "always runs")
  (newline))

(unless false
  (println "also always runs"))

;; ---- Sequencing: begin -- spec 0 ----
(define (demo x)
  (begin
    (println "start")
    (println x)
    (println "end")))

;; ---- Local bindings: let / let* / letrec -- spec 1 ----
(define (compute x)
  (let ((a 1)
        (b 2))
    (let* ((c (iadd a b))
           (d (iadd c x)))
      (imul d 2))))

;; ---- letrec with mutual recursion -- spec 1 ----
(letrec ((even?
          (lambda (n)
            (if (equal? n 0)
              true
              (odd? (isub n 1)))))
         (odd?
          (lambda (n)
            (if (equal? n 0)
              false
              (even? (isub n 1))))))
  (assert (even? 4)))

;; ---- Local define in body ----
(define-test local-define-test
  (define (even? n)
    (if (equal? n 0)
      true
      (odd? n)))
  (define (odd? n)
    (if (equal? n 0)
      false
      (even? n)))
  (assert (even? 0))
  (assert-not (even? 1)))

;; ---- lambda -- spec 1 ----
(define compose
  (lambda (f)
    (lambda (g)
      (lambda (x)
        (f (g x))))))

;; ---- Pipe / chain / compose -- spec 1 / 0 / 0 ----
(define result
  (pipe 5 add1 square))

(define chain-fn
  (chain add1 double))

(define compose-fn
  (compose add1 double))

;; ---- match -- spec 1 ----
(define-enum exp-t
  (var-exp (name symbol-t))
  (apply-exp (target exp-t) (arg exp-t))
  (lambda-exp (parameter symbol-t) (body exp-t)))

(define (evaluate exp env)
  (match exp
    ((var-exp name)
     (match (env-lookup name env)
       ((just value) value)
       ((nothing) (error "undefined name"))))
    ((apply-exp target arg)
     (apply (evaluate target env)
            (evaluate arg env)))
    ((lambda-exp parameter body)
     (closure-value env parameter body))))

;; ---- Struct -- spec 1: define-struct ----
(define-struct point-t
  (x float-t) (y float-t))

(define (point-distance-squared point)
  (fadd (fmul (point-x point) (point-x point))
        (fmul (point-y point) (point-y point))))

;; ---- Record type -- spec 1: define-record-type ----
(define-record-type point3d-t
  (make-point3d (x float-t) (y float-t) (z float-t))
  point3d?
  (x point3d-x point3d-put-x!)
  (y point3d-y point3d-put-y!)
  (z point3d-z))

;; ---- Algebraic type -- spec 1 ----
(define-algebraic-type option-t
  ((some (value int-t))
   some?
   (value some-value some-put-value!))
  ((none)
   none?))

;; ---- Algebraic type with type params ----
(define-algebraic-type (my-list-t E)
  ((nil)
   nil?)
  ((li (head E) (tail (my-list-t E)))
   li?
   (head li-head li-put-head!)
   (tail li-tail li-put-tail!)))

;; ---- Opaque type -- spec 1 ----
(define-opaque-type env-t (hash-t symbol-t value-t)
  (empty-env (-> env-t))
  (extend-env (-> symbol-t value-t env-t env-t))
  (env-lookup (-> symbol-t env-t (maybe-t value-t))))

;; ---- struct* -- spec 1 ----
(define-struct* project-t
  (cons-project
    (root-directory string-t)
    (config project-config-t)
    (fragments (hash-t string-t mod-fragment-t))))

;; ---- the -- spec 1 ----
(define forty-two
  (the int-t 42))

(define add1-typed
  (the (-> int-t int-t)
    (lambda (x)
      (iadd x 1))))

;; ---- claim-type / admit -- spec 1 ----
(claim-type point-t type-t)
(admit make-point (-> float-t float-t point-t))

;; ---- Qualified name highlight ----
(define x builtin/list-length)
(define y meta-lisp/exp-t)

;; ---- Tests -- spec 0: assert-equal, assert  ----
(define-test square-test
  (assert-equal 4 (square 2))
  (assert-equal 9 (square 3)))

(define-test abs-test
  (assert-equal 5 (abs -5))
  (assert-equal 5 (abs 5))
  (assert-equal 0 (abs 0)))

;; ---- [] literal list indent ----
(define matrix
  [[1 2 3]
   [4 5 6]
   [7 8 9]])
