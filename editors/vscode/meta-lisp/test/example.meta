;; test/example.meta --- Syntax highlighting & indentation test file
;; Open this file in VSCode with the meta-lisp extension to verify
;; syntax highlighting and indentation behavior.

(module example)

;; ============================================================
;; Comments
;; ============================================================

;; line comment
;; double semicolon
(define x 42) ; inline comment

;; ============================================================
;; Literals
;; ============================================================

;; numbers
(define zero 0)
(define neg -1)
(define pi 3.14)
(define neg-pi -2.5)

;; strings
(define greeting "hello")
(define escaped "line1\nline2")
(define empty "")

;; keywords
(define config (@hash :host "localhost" :port 8080))

;; symbols
(define sym 'hello)

;; booleans and void
(define flag true)
(define flag2 false)
(define nothing void)

;; builtin types
(claim x int-t)
(claim y float-t)
(claim s string-t)
(claim sym2 symbol-t)
(claim kw keyword-t)
(claim b bool-t)
(claim v void-t)
(claim f file-t)
(claim list list-t)
(claim set set-t)
(claim hash hash-t)
(claim maybe maybe-t)
(claim box box-t)

;; qualified names
(assert-equal builtin/zero 0)
(println builtin/string-length)

;; ============================================================
;; Basic define (spec 1)
;; ============================================================

(define (square x)
  (imul x x))

(define (add1 x)
  (iadd 1 x))

;; variable define (spec 1)
(define answer
  42)

(define long-variable-name
  (imul (iadd 1 2)
        (isub 5 3)))

;; ============================================================
;; Lambda (spec 1)
;; ============================================================

(define (compose f g)
  (lambda (x)
    (f (g x))))

(define long-lambda-body
  (lambda (x)
    (let ((a 1))
      (let* ((b (iadd a x))
             (c (imul b 2)))
        (isub c a)))))

;; ============================================================
;; Let and Let* (spec 1)
;; ============================================================

(define (compute x)
  (let ((a 1)
        (b 2))
    (iadd a b x)))

(define (compute2 x)
  (let* ((a 1)
         (b (iadd a 2)))
    (imul a b x)))

;; ============================================================
;; Letrec and Letrec* (spec 1)
;; ============================================================

(define (test-letrec)
  (letrec ((even?
            (lambda (n)
              (if (equal? n 0)
                true
                (odd? (isub n 1)))))
           (odd?
            (lambda (n)
              (if (equal? n 0)
                false
                (even? (isub n 1))))))
    (even? 4)))

(define (test-letrec*)
  (letrec* ((a 1)
            (b (iadd a 1)))
    (assert-equal 2 b)))

;; ============================================================
;; If / When / Unless (spec 1)
;; ============================================================

(define (absolute x)
  (if (int-less? x 0)
    (ineg x)
    x))

(define (warn-if-negative x)
  (when (int-less? x 0)
    (println "negative")
    (ineg x)))

(define (do-unless x)
  (unless (int-less? x 0)
    (println "non-negative")))

;; ============================================================
;; Cond (spec 0)
;; ============================================================

(define (classify x)
  (cond
    ((int-positive? x) "positive")
    ((int-negative? x) "negative")
    (else "zero")))

(define (classify-verbose x)
  (cond
    ((and (int-positive? x) (int-less? x 10))
     "small positive")
    ((int-positive? x)
     (println "large positive")
     "large positive")
    (else
     (println "non-positive")
     "non-positive")))

;; ============================================================
;; Begin (spec 0)
;; ============================================================

(define (demo-begin)
  (begin
    (println "step 1")
    (println "step 2")
    (println "step 3")
    42))

;; ============================================================
;; Match (spec 1)
;; ============================================================

(define-enum exp-t
  (var-exp (name symbol-t))
  (apply-exp (target exp-t) (arg exp-t))
  (lambda-exp (parameter symbol-t) (body exp-t)))

(define (evaluate exp env)
  (match exp
    ((var-exp name)
     (match (env-lookup name env)
       ((just value) value)
       ((nothing) (error "undefined name"))))
    ((apply-exp target arg)
     (apply (evaluate target env)
            (evaluate arg env)))
    ((lambda-exp parameter body)
     (closure-value env parameter body))))

;; ============================================================
;; Match-many (spec 1)
;; ============================================================

(define (my-list-map-zip f list1 list2)
  (match-many (list1 list2)
    (((nil) _) (nil))
    (((li head1 tail1) (li head2 tail2))
     (li (f head1 head2) (my-list-map-zip f tail1 tail2)))))

;; ============================================================
;; Pipe / Chain / Compose
;; ============================================================

(define (do-pipe)
  (pipe 5
    add1
    square))

(define (do-chain)
  (chain
    add1
    double
    square))

(define (do-compose)
  (compose
    add1
    double))

;; ============================================================
;; Assert forms (spec 0)
;; ============================================================

(define-test my-test
  (assert true)
  (assert-not false)
  (assert-the int-t 42)
  (assert-equal 4 (square 2))
  (assert-not-equal 5 (square 2)))

;; ============================================================
;; define-test (spec 1)
;; ============================================================

(define-test square-test
  (assert-equal 4 (square 2))
  (assert-equal 9 (square 3))
  (assert-equal 16 (square 4)))

;; ============================================================
;; ADT forms (spec 1)
;; ============================================================

(define-enum (my-list-t E)
  (nil)
  (li (head E) (tail (my-list-t E))))

(define-algebraic-type value-t
  ((closure-value (env env-t) (parameter symbol-t) (body exp-t))
   closure-value?
   (env closure-value-env closure-value-put-env!)
   (parameter closure-value-parameter closure-value-put-parameter!)
   (body closure-value-body closure-value-put-body!)))

(define-struct point-t
  (x float-t) (y float-t))

(define-struct* named-point-t
  (make-pt (x float-t) (y float-t) (name string-t)))

(define-record-type color-t
  (make-color (r int-t) (g int-t) (b int-t))
  color?
  (r color-r color-put-r!)
  (g color-g)
  (b color-b color-put-b!))

;; ============================================================
;; Type forms (spec 1)
;; ============================================================

(define-type my-int int-t)

(claim identity
  (polymorphic (A)
    (-> A A)))

;; ============================================================
;; Claim / Admit (spec 1)
;; ============================================================

(claim add (-> int-t int-t int-t))
(admit add (iadd a b))

(claim-type my-type-t)

;; ============================================================
;; Module imports
;; ============================================================

(import math pi circumference area)
(import-as meta m)
(import-all builtin)

;; ============================================================
;; Interface (spec 0)
;; ============================================================

(interface
  (claim add (-> int-t int-t int-t))
  (claim sub (-> int-t int-t int-t)))

(define-interface monoid-t
  (claim empty monoid-t)
  (claim combine (-> monoid-t monoid-t monoid-t)))

(extend-interface monoid-t
  (claim times (-> int-t monoid-t monoid-t)))

;; ============================================================
;; Exempt / Private (spec 0)
;; ============================================================

(exempt
  some-function)

(private
  one
  two
  three)

;; ============================================================
;; Function calls (no keyword, alignment-based)
;; ============================================================

(define (demo-fn-calls)
  (iadd 1
        2
        3)

  (foo bar
       baz
       qux))

;; ============================================================
;; Local define (=) and local bindings
;; ============================================================

(define (demo-local)
  (= x (iadd 1 2))
  (println x)
  (= y (iadd x 1))
  (iadd x y))

(define (demo-local-define)
  (define (helper x)
    (iadd x 1))
  (helper 5))

;; ============================================================
;; The form (spec 1)
;; ============================================================

(define (demo-the)
  (the int-t
    42))

;; ============================================================
;; Square brackets [ ] — literal lists, Clojure-style (spec 0)
;; ============================================================

(define xs
  [1 2 3
   4 5 6])

(define nested-lists
  [1
   [2 3
    4]
   5])

(define empty-list
  [])

(define function-returns-list
  (list-map add1
    [1 2 3
     4 5]))

;; ============================================================
;; Curly brackets { } — literal, spec 0
;; ============================================================

;; (if used in future)
(define some-curly
  {:a 1
   :b 2})

;; ============================================================
;; @-prefixed forms (spec 0)
;; ============================================================

(define list1
  (@list 1 2
         3 4 5))

(define set1
  (@set "a"
        "b"
        "c"))

(define hash1
  (@hash :x 1
         :y 2))

(define record1
  (@record :name "foo"
           :age 42))

;; ============================================================
;; Quote / Unquote / Quasiquote
;; ============================================================

(define demo-quote
  (quote a b c))

(define demo-quote-short
  '(a b c))

(define demo-unquote
  (unquote x))

(define demo-quasiquote
  (quasiquote (a b c)))

;; ============================================================
;; And / Or
;; ============================================================

(define (demo-and-or)
  (and true
       true
       false)

  (or false
      false
      true))

;; ============================================================
;; Deep nesting
;; ============================================================

(define (deep x)
  (let ((a (iadd x 1)))
    (let* ((b (imul a 2))
           (c (isub b x)))
      (match c
        ((0)
         (begin
           (println "zero")
           0))
        ((n)
         (if (int-positive? n)
           (pipe n
             add1
             (lambda (m)
               (imul m 2)))
           (cond
             ((int-negative? n)
              (ineg n))
             (else
              void))))))))

;; ============================================================
;; define-opaque-type (spec 1, from Emacs mode)
;; ============================================================

(define-opaque-type env-t (hash-t symbol-t value-t)
  (empty-env (-> env-t))
  (extend-env (-> symbol-t value-t env-t env-t))
  (env-lookup (-> symbol-t env-t (maybe-t value-t))))

;; ============================================================
;; Polymorphic types (spec 1)
;; ============================================================

(claim swap
  (polymorphic (X Y Z)
    (-> (-> Y X Z) (-> X Y Z))))
