{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "meta-lisp",
  "scopeName": "source.meta",
  "fileTypes": [".meta"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#at-forms" },
    { "include": "#special-forms" },
    { "include": "#builtin-types" },
    { "include": "#builtin-constants" },
    { "include": "#qualified-names" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "match": ";.*$",
      "name": "comment.line.semicolon.meta"
    },
    "strings": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.meta",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.meta"
        }
      ]
    },
    "numbers": {
      "match": "(?<![-a-zA-Z0-9?!+*/=<>_@:#$%.])-?[0-9]+(\\.[0-9]+)?(?![a-zA-Z0-9?!+*/=<>_@:#$%.])",
      "name": "constant.numeric.meta"
    },
    "keywords": {
      "match": "(?<![-a-zA-Z0-9?!+*/=<>_@:#$%.]):[-a-zA-Z0-9?!+*/=<>_%$#]+",
      "name": "constant.keyword.meta"
    },
    "at-forms": {
      "match": "(?<![-a-zA-Z0-9?!+*/=<>_@:#$%.])@(list|set|hash|quote|record)(?![a-zA-Z0-9?!+*/=<>_@:#$%.])",
      "name": "keyword.control.at.meta"
    },
    "special-forms": {
      "match": "(?<![-a-zA-Z0-9?!+*/=<>_@:#$%.])(module|import-as|import-all|import|exempt|private|claim-type|claim|admit|define-algebraic-type|define-record-type|define-opaque-type|define-interface|define-struct\\*|define-struct|define-enum|define-test|define-type|define|interface|extend-interface|let\\*|letrec\\*|letrec|let|the|assert-not-equal|assert-equal|assert-the|assert-not|assert|begin|lambda|match-many|match|pipe|chain|compose|if|when|unless|cond|and|or|polymorphic|=)(?![a-zA-Z0-9?!+*/=<>_@:#$%.])",
      "name": "keyword.control.meta"
    },
    "builtin-types": {
      "match": "(?<![-a-zA-Z0-9?!+*/=<>_@:#$%.])(int-t|float-t|string-t|symbol-t|keyword-t|bool-t|void-t|file-t|list-t|set-t|hash-t|maybe-t|box-t)(?![a-zA-Z0-9?!+*/=<>_@:#$%.])",
      "name": "support.type.meta"
    },
    "builtin-constants": {
      "match": "(?<![-a-zA-Z0-9?!+*/=<>_@:#$%.])(true|false|void)(?![a-zA-Z0-9?!+*/=<>_@:#$%.])",
      "name": "constant.language.meta"
    },
    "qualified-names": {
      "match": "(?<![-a-zA-Z0-9?!+*/=<>_@:#$%.])[-a-zA-Z0-9?!+*/=<>_%$#]*/[-a-zA-Z0-9?!+*/=<>_%$#]+(?![a-zA-Z0-9?!+*/=<>_@:#$%.])",
      "name": "entity.name.qualified.meta"
    },
    "operators": {
      "match": "[',`]",
      "name": "keyword.operator.meta"
    }
  }
}
